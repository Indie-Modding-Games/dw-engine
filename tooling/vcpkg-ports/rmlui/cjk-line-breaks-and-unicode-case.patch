+}
+
+static bool IsNoLineEnd(Character character)
+{
+	static const char32_t opening[] = U"([{\u00AB\u2018\u201C\u3008\u300A\u300C\u300E\u3010\u3014\u3016\u3018\u301D"
+		U"\uFE59\uFE5B\uFE5D\uFF04\uFF08\uFF3B\uFF5B\uFF5F\uFF62\uFFE5";
+	const char32_t c = static_cast<char32_t>(character);
+	for (const char32_t* it = opening; *it; ++it)
+		if (*it == c)
+			return true;
+	return false;
+}
+
+static bool CanBreakBetween(Character before, Character after)
+{
+	if (before == Character::Null || after == Character::Null)
+		return false;
+	if (!IsCjkBreakable(before) && !IsCjkBreakable(after))
+		return false;
+	return !IsNoLineStart(after) && !IsNoLineEnd(before);
+}
