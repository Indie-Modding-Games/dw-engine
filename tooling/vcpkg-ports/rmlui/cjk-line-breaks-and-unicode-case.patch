+// The capitals and small letters RmlUi's text-transform changes beyond a to z: Latin-1, Latin
+// Extended-A, Greek and Cyrillic.
+static char32_t ToUpperCodepoint(char32_t c)
+{
+	if ((c >= 0xE0 && c <= 0xFE && c != 0xF7) || (c >= 0x3B1 && c <= 0x3C9 && c != 0x3C2) || (c >= 0x430 && c <= 0x44F))
+		return c - 0x20;
+	if (c == 0xFF)
+		return 0x178;
+	if (c == 0x3C2)
+		return 0x3A3;
+	if (c >= 0x450 && c <= 0x45F)
+		return c - 0x50;
+	if ((c >= 0x100 && c <= 0x137) || (c >= 0x14A && c <= 0x177) || (c >= 0x460 && c <= 0x481) || (c >= 0x48A && c <= 0x4BF) ||
+		(c >= 0x4D0 && c <= 0x52F))
+		return (c % 2 == 1) ? c - 1 : c;
+	if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E) || (c >= 0x4C1 && c <= 0x4CE))
+		return (c % 2 == 0) ? c - 1 : c;
+	return c;
+}
+
+static char32_t ToLowerCodepoint(char32_t c)
+{
+	if ((c >= 0xC0 && c <= 0xDE && c != 0xD7) || (c >= 0x391 && c <= 0x3A9 && c != 0x3A2) || (c >= 0x410 && c <= 0x42F))
+		return c + 0x20;
+	if (c == 0x178)
+		return 0xFF;
+	if (c >= 0x400 && c <= 0x40F)
+		return c + 0x50;
+	if ((c >= 0x100 && c <= 0x137) || (c >= 0x14A && c <= 0x177) || (c >= 0x460 && c <= 0x481) || (c >= 0x48A && c <= 0x4BF) ||
+		(c >= 0x4D0 && c <= 0x52F))
+		return (c % 2 == 0) ? c + 1 : c;
+	if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E) || (c >= 0x4C1 && c <= 0x4CE))
+		return (c % 2 == 1) ? c + 1 : c;
+	return c;
+}
+
+static void TransformCase(String& token, Style::TextTransform text_transformation)
+{
+	if (text_transformation != Style::TextTransform::Uppercase && text_transformation != Style::TextTransform::Lowercase)
+		return;
+	bool ascii = true;
+	for (char c : token)
+		ascii = ascii && static_cast<unsigned char>(c) < 0x80;
+	if (ascii)
+		return;
+	String result;
+	result.reserve(token.size());
+	for (StringIteratorU8 it(token); it; ++it)
+	{
+		const char32_t c = static_cast<char32_t>(*it);
+		const char32_t changed = text_transformation == Style::TextTransform::Uppercase ? ToUpperCodepoint(c) : ToLowerCodepoint(c);
+		result += StringUtilities::ToUTF8(static_cast<Character>(changed));
+	}
+	token = std::move(result);
+}
+
+static bool BuildTokenWithBreaks(String& token, const char*& token_begin, const char* string_end, bool first_token,
+	bool collapse_white_space, bool break_at_endline, Style::TextTransform text_transformation, bool decode_escape_characters);
+
+static bool BuildToken(String& token, const char*& token_begin, const char* string_end, bool first_token, bool collapse_white_space,
+	bool break_at_endline, Style::TextTransform text_transformation, bool decode_escape_characters)
+{
+	const bool result = BuildTokenWithBreaks(token, token_begin, string_end, first_token, collapse_white_space, break_at_endline,
+		text_transformation, decode_escape_characters);
+	TransformCase(token, text_transformation);
+	return result;
+}
