+// Line breaking for Chinese and Japanese text, which has no spaces between words: a line may break
+// between two characters when either is an ideograph, kana or a full-width sign, unless the
+// second may not start a line or the first may not end one (the kinsoku rules of Japanese and
+// Chinese). Hangul is not in the set: Korean breaks at its spaces, as a word processor does by
+// default for Korean.
+static Character DecodeAt(const char* at, const char* end)
+{
+	return StringUtilities::ToCharacter(at, end);
+}
+
+static bool IsCjkBreakable(Character character)
+{
+	const char32_t c = static_cast<char32_t>(character);
+	return (c >= 0x2E80 && c <= 0x2FDF) ||   // CJK radicals
+		(c >= 0x3000 && c <= 0x30FF) ||       // CJK symbols and punctuation, hiragana, katakana
+		(c >= 0x3100 && c <= 0x31FF) ||       // bopomofo, kanbun, katakana extensions
+		(c >= 0x3400 && c <= 0x4DBF) ||       // CJK extension A
+		(c >= 0x4E00 && c <= 0x9FFF) ||       // CJK unified ideographs
+		(c >= 0xF900 && c <= 0xFAFF) ||       // CJK compatibility ideographs
+		(c >= 0xFE30 && c <= 0xFE4F) ||       // CJK compatibility forms
+		(c >= 0xFF00 && c <= 0xFFEF) ||       // half-width and full-width forms
+		(c >= 0x20000 && c <= 0x3FFFF);       // the supplementary ideographic planes
+}
+
+static bool IsNoLineStart(Character character)
+{
+	static const char32_t closing[] = U"!%),.:;?]}\u00A2\u00B0\u00BB\u2019\u201D\u2026\u2025\u2030\u2032\u2033\u2103"
