{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 30 },
  "configurePresets": [
    {
      "name": "linux-clang",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/tooling/cmake/toolchains/linux-clang-libcxx.cmake",
        "CMAKE_C_COMPILER_LAUNCHER": "$env{DWE_COMPILER_LAUNCHER}",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{DWE_COMPILER_LAUNCHER}",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/tooling/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/tooling/vcpkg-ports",
        "VCPKG_TARGET_TRIPLET": "x64-linux-libcxx",
        "VCPKG_HOST_TRIPLET": "x64-linux-libcxx",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/${presetName}/vcpkg_installed",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=${sourceDir}/build/${presetName}/vcpkg_buildtrees"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux, Clang, debug with sanitizers",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DWE_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux, Clang, release",
      "inherits": "linux-clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "linux-clang-package",
      "displayName": "Linux, Clang, release for a package: no folder of the build machine in the programs",
      "inherits": "linux-clang-release",
      "cacheVariables": {
        "DWE_PACKAGE": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux-libcxx-package",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI: Linux, Clang, debug, warnings as errors",
      "inherits": "linux-clang-debug",
      "cacheVariables": { "DWE_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "windows-cross",
      "displayName": "Windows from Linux: clang-cl, debug, warnings as errors, like windows-ci",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/tooling/cmake/toolchains/windows-cross-clang-cl.cmake",
        "CMAKE_C_COMPILER_LAUNCHER": "$env{DWE_COMPILER_LAUNCHER}",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{DWE_COMPILER_LAUNCHER}",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/tooling/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/tooling/vcpkg-ports",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-cross",
        "VCPKG_HOST_TRIPLET": "x64-linux-libcxx",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/${presetName}/vcpkg_installed",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=${sourceDir}/build/${presetName}/vcpkg_buildtrees",
        "CMAKE_BUILD_TYPE": "Debug",
        "DWE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-cross-package",
      "displayName": "Windows from Linux: clang-cl, release for a package (scripts/package_windows.sh)",
      "inherits": "windows-cross",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DWE_WARNINGS_AS_ERRORS": "OFF",
        "DWE_PACKAGE": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "macos-llvm",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/tooling/cmake/toolchains/macos-llvm-libcxx.cmake",
        "CMAKE_C_COMPILER_LAUNCHER": "$env{DWE_COMPILER_LAUNCHER}",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{DWE_COMPILER_LAUNCHER}",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/tooling/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/tooling/vcpkg-ports",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/${presetName}/vcpkg_installed",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=${sourceDir}/build/${presetName}/vcpkg_buildtrees"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS on Apple silicon, Homebrew LLVM, release with the tests",
      "inherits": "macos-llvm",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "arm64-osx-libcxx", "VCPKG_HOST_TRIPLET": "arm64-osx" }
    },
    {
      "name": "macos-arm64-package",
      "displayName": "macOS on Apple silicon, Homebrew LLVM, release for a package (scripts/package_macos.sh)",
      "inherits": "macos-arm64-release",
      "cacheVariables": { "DWE_PACKAGE": "ON", "BUILD_TESTING": "OFF" }
    },
    {
      "name": "macos-x64-release",
      "displayName": "macOS on Intel, Homebrew LLVM, release with the tests",
      "inherits": "macos-llvm",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-osx-libcxx", "VCPKG_HOST_TRIPLET": "x64-osx" }
    },
    {
      "name": "macos-x64-package",
      "displayName": "macOS on Intel, Homebrew LLVM, release for a package (scripts/package_macos.sh)",
      "inherits": "macos-x64-release",
      "cacheVariables": { "DWE_PACKAGE": "ON", "BUILD_TESTING": "OFF" }
    },
    {
      "name": "windows-clang",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/tooling/cmake/toolchains/windows-clang-cl.cmake",
        "CMAKE_C_COMPILER_LAUNCHER": "$env{DWE_COMPILER_LAUNCHER}",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{DWE_COMPILER_LAUNCHER}",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/tooling/vcpkg-ports",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/${presetName}/vcpkg_installed",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=${sourceDir}/build/${presetName}/vcpkg_buildtrees"
      }
    },
    {
      "name": "windows-clang-debug",
      "displayName": "Windows, clang-cl, debug",
      "inherits": "windows-clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-clang-release",
      "displayName": "Windows, clang-cl, release",
      "inherits": "windows-clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-ci",
      "displayName": "CI: Windows, clang-cl, debug, warnings as errors",
      "inherits": "windows-clang-debug",
      "cacheVariables": { "DWE_WARNINGS_AS_ERRORS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-clang-package", "configurePreset": "linux-clang-package" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "windows-cross", "configurePreset": "windows-cross" },
    { "name": "windows-cross-package", "configurePreset": "windows-cross-package" },
    { "name": "windows-clang-debug", "configurePreset": "windows-clang-debug" },
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release" },
    { "name": "windows-ci", "configurePreset": "windows-ci" },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release" },
    { "name": "macos-arm64-package", "configurePreset": "macos-arm64-package" },
    { "name": "macos-x64-release", "configurePreset": "macos-x64-release" },
    { "name": "macos-x64-package", "configurePreset": "macos-x64-package" }
  ],
  "testPresets": [
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "linux-clang-release",
      "configurePreset": "linux-clang-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-clang-release",
      "configurePreset": "windows-clang-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-ci",
      "configurePreset": "windows-ci",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
