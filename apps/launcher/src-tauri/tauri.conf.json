{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dwe-launcher",
  "mainBinaryName": "dwe-launcher",
  "version": "0.1.2",
  "identifier": "org.indie-modding-games.dwe-launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "dwe",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: dweaddon: http://dweaddon.localhost; style-src 'self'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; frame-src dweaddon: http://dweaddon.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Launcher of dwe",
    "linux": {
      "deb": {
        "recommends": ["mesa-vulkan-drivers | vulkan-icd"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "SET_BY_THE_RELEASE_BUILD",
      "endpoints": []
    }
  }
}
