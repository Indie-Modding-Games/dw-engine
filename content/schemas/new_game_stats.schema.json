{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "New game stats",
  "description": "new_game_stats.yaml: the partner's stats at the start of a new game, which no C code sets: the event script that runs after the introduction does, with SET_STAT, one run per partner its IF asks about.",
  "type": "object",
  "required": ["script", "at", "partners", "others"],
  "additionalProperties": false,
  "properties": {
    "script": { "description": "The DG.SCN script that sets them.", "type": "integer", "minimum": 0 },
    "at": { "description": "Offset in that script of the IF that picks the partner.", "type": "integer", "minimum": 0 },
    "partners": {
      "description": "The partners the IF asks about, each with its stats.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["digimon", "stats"],
        "additionalProperties": false,
        "properties": {
          "digimon": { "description": "Id of the Digimon (digimon.yaml), or its raw type number as text.", "type": ["string", "integer"] },
          "stats": { "$ref": "#/$defs/stats" }
        }
      }
    },
    "others": { "description": "The stats of any other partner.", "$ref": "#/$defs/stats" }
  },
  "$defs": {
    "stats": {
      "type": "object",
      "required": ["offense", "defense", "speed", "brains", "max_hp", "max_mp", "hp", "mp"],
      "additionalProperties": false,
      "properties": {
        "offense": { "type": "integer", "minimum": 0 },
        "defense": { "type": "integer", "minimum": 0 },
        "speed": { "type": "integer", "minimum": 0 },
        "brains": { "type": "integer", "minimum": 0 },
        "max_hp": { "type": "integer", "minimum": 0 },
        "max_mp": { "type": "integer", "minimum": 0 },
        "hp": { "description": "Current HP.", "type": "integer", "minimum": 0 },
        "mp": { "description": "Current MP.", "type": "integer", "minimum": 0 }
      }
    }
  }
}
