{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versus",
  "description": "versus.yaml: the tables of the versus battle overlay (VS_REL.BIN): cameras and arenas.",
  "type": "object",
  "required": [
    "camera_presets",
    "arenas"
  ],
  "additionalProperties": false,
  "properties": {
    "camera_presets": {
      "description": "Six values each, passed in order to the overlay's setCameraParams.",
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6,
        "items": {
          "type": "integer"
        }
      }
    },
    "arenas": {
      "description": "The arenas with files: the model, TIM and collision paths and how many objects and TIMs they hold (loadArenaAssets; the counts live in the executable).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "model",
          "texture",
          "collision",
          "model_count",
          "texture_count"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "model": {
            "type": "string"
          },
          "texture": {
            "type": "string"
          },
          "collision": {
            "type": "string"
          },
          "model_count": {
            "type": "integer",
            "minimum": 0
          },
          "texture_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
