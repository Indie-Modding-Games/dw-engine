          "food_minutes": {
            "type": "integer"
          },
          "poop_steps": {
            "type": "integer"
          },
          "urge_frames": {
            "type": "integer"
          },
          "counts_practice": {
            "type": "boolean"
          },
          "courses": {
            "type": "array",
            "minItems": 1,
