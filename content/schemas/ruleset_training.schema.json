                "energy": {
                  "type": "integer"
                },
                "happiness": {
                  "type": "integer"
                },
                "gains": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "stat",
                      "base",
                      "boosted_by"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "stat": {
                        "enum": [
                          "hp",
                          "mp",
                          "offense",
                          "defense",
                          "speed",
                          "brain"
                        ]
                      },
                      "base": {
                        "type": "integer"
                      },
                      "boosted_by": {
                        "enum": [
                          "hp",
                          "mp",
                          "offense",
                          "defense",
                          "speed",
                          "brain"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
