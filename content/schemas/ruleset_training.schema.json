          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 5,
          "maxItems": 5
        },
        "offense": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 5,
          "maxItems": 5
        },
        "defense": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 5,
          "maxItems": 5
        },
        "speed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 5,
          "maxItems": 5
        },
        "brain": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 5,
          "maxItems": 5
