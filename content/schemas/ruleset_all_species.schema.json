{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ruleset: all_species",
  "description": "rules/<id>/all_species.yaml: every species as a partner (docs/modulos/game/evoluciones-extra.md): species patches in the format of species_extra's, as fallback targets the natural check picks only when none of the original's targets passes, for the species no other section patches; and wake-up specials added after the evolution section's (packages/engine/ruleset: species_extra.hpp; packages/game/evolution: rules.hpp).",
  "type": "object",
  "required": [],
  "additionalProperties": false,
  "$defs": {
    "species": {
      "description": "A species id of data/digimon.",
      "type": "string",
      "pattern": "^([a-z0-9_]{1,64}:)?[a-z0-9_]+$"
    },
    "move": {
      "description": "A move's id in data/moves.",
      "type": "string",
      "pattern": "^([a-z0-9_]{1,64}:)?[a-z0-9_]+$",
      "entryReference": "data/moves"
    },
    "gate": {
      "description": "What must hold before the target even scores.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "triggers": {
          "description": "Story triggers that must be set.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "hours": {
          "description": "Hours of the game day, from `from` to before `to`; wraps past midnight.",
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "to": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            }
          }
        },
        "cup": {
          "description": "A cup that must have been won: its number in data/tournaments (won when the tournaments set its trigger).",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "species_patch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "description": "Its EVOLUTION_REQS row; a value left out asks for nothing (-1).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/species",
              "description": "The form whose partner gets the bonus point."
            },
            "hp": {
              "description": "The least hp.",
              "type": "integer",
              "minimum": -1
            },
            "mp": {
              "description": "The least mp.",
              "type": "integer",
              "minimum": -1
            },
            "offense": {
              "description": "The least offense.",
              "type": "integer",
              "minimum": -1
            },
            "defense": {
              "description": "The least defense.",
              "type": "integer",
              "minimum": -1
            },
            "speed": {
              "description": "The least speed.",
              "type": "integer",
              "minimum": -1
            },
            "brains": {
              "description": "The least brains.",
              "type": "integer",
              "minimum": -1
            },
            "care": {
              "description": "The care mistakes: the most with care_is_maximum, else the least.",
              "type": "integer",
              "minimum": -1
            },
            "care_is_maximum": {
              "type": "boolean"
            },
            "weight": {
              "description": "The weight, give or take the rules' margin.",
              "type": "integer",
              "minimum": -1
            },
            "discipline": {
              "description": "The least discipline (bonus point).",
              "type": "integer",
              "minimum": -1
            },
            "happiness": {
              "description": "The least happiness (bonus point).",
              "type": "integer",
              "minimum": -1
            },
            "battles": {
              "description": "The battles: the most with battles_are_maximum, else the least (bonus point).",
              "type": "integer",
              "minimum": -1
            },
            "battles_are_maximum": {
              "type": "boolean"
            },
            "techs": {
              "description": "The least moves learned (bonus point).",
              "type": "integer",
              "minimum": -1
            }
          }
        },
        "gate": {
          "$ref": "#/$defs/gate"
        },
        "evolves_from": {
          "description": "The forms that evolve into it: it takes the first free `to` slot after each one's last target.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/species"
          }
        },
        "evolves_to": {
          "description": "Its own targets, at most 6.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/species"
          }
        },
        "stats_gains": {
          "description": "Its EVOLUTION_STATS_GAINS row: the stats a partner that evolves into it is brought towards. Either all six stats or only copy, another species' id whose row it takes; the loader rejects a mix or a partial row.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hp": {
              "type": "integer",
              "minimum": 0
            },
            "mp": {
              "type": "integer",
              "minimum": 0
            },
            "offense": {
              "type": "integer",
              "minimum": 0
            },
            "defense": {
              "type": "integer",
              "minimum": 0
            },
            "speed": {
              "type": "integer",
              "minimum": 0
            },
            "brains": {
              "type": "integer",
              "minimum": 0
            },
            "copy": {
              "description": "The species whose row it copies.",
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          }
        },
        "raise": {
          "description": "A raise row copied from another species, with some values changed.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "copy"
          ],
          "properties": {
            "copy": {
              "$ref": "#/$defs/species"
            },
            "favorite_food": {
              "description": "An item id of data/items.",
              "type": "string",
              "pattern": "^([a-z0-9_]{1,64}:)?[a-z0-9_]+$",
              "entryReference": "data/items"
            },
            "default_weight": {
              "type": "integer",
              "minimum": 0
            },
            "energy_cap": {
              "type": "integer",
              "minimum": 0
            },
            "energy_usage": {
              "type": "integer",
              "minimum": 0
            },
            "hunger_times": {
              "description": "The 8 hours it gets hungry at; -1 for none.",
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "integer",
                "minimum": -1,
                "maximum": 23
              }
            }
          }
        },
        "moves": {
          "description": "Moves put in the empty slots of its data/digimon row, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/move"
          }
        },
        "partner_type": {
          "description": "The type its partner fights with (0 vaccine, 1 data, 2 virus, 3 the rules' fourth).",
          "type": "integer",
          "minimum": 0
        },
        "partner_moves": {
          "description": "A move's values when its partner uses it; its enemy form keeps the table's.",
          "type": "object",
          "propertyNames": {
            "pattern": "^([a-z0-9_]{1,64}:)?[a-z0-9_]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "power": {
                "type": "integer",
                "minimum": 0
              },
              "iframes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "effect_type": {
          "$ref": "#/$defs/species",
          "description": "The species whose effect points its moves use."
        },
        "clips": {
          "description": "An original clip id it lacks -> the clip played instead.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "field_scale": {
          "description": "The size of the partner in the field; 1 is the original's.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "chart": {
          "description": "Its cell on the evolution chart, in the chart's pixels, and the icon it borrows.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "icon",
            "palette"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "icon": {
              "$ref": "#/$defs/species"
            },
            "palette": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "special": {
      "type": "object",
      "required": [
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/id"
        },
        "roll_below": {
          "description": "The shared roll must be below this.",
          "type": "integer",
          "minimum": 0
        },
        "from": {
          "description": "The partner must be one of these forms.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "scolded": {
          "description": "Only right after a scold.",
          "type": "boolean"
        },
        "require": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "$ref": "#/$defs/comparison"
            },
            "evolution_timer": {
              "$ref": "#/$defs/comparison"
            },
            "discipline": {
              "$ref": "#/$defs/comparison"
            },
            "happiness": {
              "$ref": "#/$defs/comparison"
            },
            "tiredness": {
              "$ref": "#/$defs/comparison"
            },
            "battles": {
              "$ref": "#/$defs/comparison"
            },
            "defense": {
              "$ref": "#/$defs/comparison"
            },
            "map": {
              "$ref": "#/$defs/map_comparison"
            },
            "discipline_before": {
              "$ref": "#/$defs/comparison"
            },
            "happiness_before": {
              "$ref": "#/$defs/comparison"
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "equals": {
          "type": "integer"
        },
        "at_least": {
          "type": "integer"
        }
      }
    },
    "map_comparison": {
      "type": "object",
      "required": [
        "equals"
      ],
      "additionalProperties": false,
      "properties": {
        "equals": {
          "type": "string",
          "pattern": "^([a-z0-9_]{1,64}:)?[a-z0-9_]+$",
          "entryReference": "data/maps"
        }
      }
    },
    "id": {
      "description": "An id of a table of the packs.",
      "type": "string",
      "pattern": "^([a-z0-9_]{1,64}:)?[a-z0-9_]+$"
    }
  },
  "properties": {
    "species": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/species_patch"
      }
    },
    "wake_up": {
      "description": "Wake-up specials in the format of the evolution section's specials.wake_up, checked after its own.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/special"
      }
    }
  }
}
