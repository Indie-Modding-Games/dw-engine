{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ruleset: gym",
  "description": "rules/<id>/gym.yaml: the town gym's courses (game/gym, docs/reference/vanilla). Frames are frames of the original's game loop; points are world units; object moves are background pixels.",
  "type": "object",
  "required": [
    "map",
    "place",
    "course_variable",
    "course_by_choice",
    "slot_variable",
    "manual_item",
    "sound_slot",
    "cloud_scatter",
    "count",
    "slots",
    "courses"
  ],
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "z"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer"
        },
        "z": {
          "type": "integer"
        }
      }
    },
    "move": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "frames": {
      "type": "integer",
      "minimum": 1
    },
    "point3": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "z": {
          "type": "integer"
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "first",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "points3": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point3"
      }
    },
    "punch": {
      "type": "object",
      "required": [
        "animation",
        "frames"
      ],
      "additionalProperties": false,
      "properties": {
        "animation": {
          "type": "integer",
          "minimum": 0
        },
        "frames": {
          "$ref": "#/$defs/frames"
        }
      }
    }
  },
  "properties": {
    "map": {
      "description": "The map the gym works on.",
      "type": "string",
      "minLength": 1
    },
    "place": {
      "description": "The training place (training.yaml) whose gains the courses give.",
      "type": "string",
      "minLength": 1
    },
    "course_variable": {
      "description": "Story variable that picks the course.",
      "type": "integer",
      "minimum": 0
    },
    "course_by_choice": {
      "description": "Course id for each value of the course variable.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "slot_variable": {
      "description": "Story variable that enables the roulette.",
      "type": "integer",
      "minimum": 0
    },
    "manual_item": {
      "description": "Item that counts as the training manual.",
      "type": "string",
      "minLength": 1
    },
    "sound_slot": {
      "description": "Sound slot of the course sounds.",
      "type": "integer",
      "minimum": 0
    },
    "cloud_scatter": {
      "description": "Each cloud strays below this from its line.",
      "$ref": "#/$defs/frames"
    },
    "count": {
      "description": "The stats box after a session.",
      "type": "object",
      "required": [
        "delay_frames",
        "sound_slot",
        "sound",
        "hp_mp_max",
        "stat_max"
      ],
      "additionalProperties": false,
      "properties": {
        "delay_frames": {
          "type": "integer",
          "minimum": 0
        },
        "sound_slot": {
          "type": "integer",
          "minimum": 0
        },
        "sound": {
          "type": "integer",
          "minimum": 0
        },
        "hp_mp_max": {
          "type": "integer",
          "minimum": 1
        },
        "stat_max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "slots": {
      "description": "The roulette over a course.",
      "type": "object",
      "required": [
        "reels",
        "assist_by_roll",
        "jackpot_symbol",
        "spin_speed",
        "cell_pixels",
        "settle_pixels",
        "result_frames",
        "payouts",
        "sounds"
      ],
      "additionalProperties": false,
      "properties": {
        "reels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "assist_by_roll": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              0,
              1,
              2
            ]
          }
        },
        "jackpot_symbol": {
          "type": "integer",
          "minimum": 1
        },
        "spin_speed": {
          "$ref": "#/$defs/frames"
        },
        "cell_pixels": {
          "$ref": "#/$defs/frames"
        },
        "settle_pixels": {
          "type": "integer"
        },
        "result_frames": {
          "type": "integer",
          "minimum": 0
        },
        "payouts": {
          "type": "object",
          "required": [
            "jackpot",
            "own_symbol",
            "triple",
            "miss"
          ],
          "additionalProperties": false,
          "properties": {
            "jackpot": {
              "type": "integer",
              "minimum": 0
            },
            "own_symbol": {
              "type": "integer",
              "minimum": 0
            },
            "triple": {
              "type": "integer",
              "minimum": 0
            },
            "miss": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "sounds": {
          "type": "object",
          "required": [
            "start",
            "press",
            "stop",
            "jackpot",
            "triple",
            "miss"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "integer"
            },
            "press": {
              "type": "integer"
            },
            "stop": {
              "type": "integer"
            },
            "jackpot": {
              "type": "integer"
            },
            "triple": {
              "type": "integer"
            },
            "miss": {
              "type": "integer"
            }
          }
        }
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "spot",
          "camera_speed",
          "cycle_frames",
          "rest_frames",
          "sounds",
          "animations",
          "slot_symbol"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "hp",
              "mp",
              "offense",
              "defense",
              "speed",
              "brain"
            ]
          },
          "spot": {
            "$ref": "#/$defs/point"
          },
          "camera_speed": {
            "type": "integer",
            "minimum": 0
          },
          "cycle_frames": {
            "$ref": "#/$defs/frames"
          },
          "rest_frames": {
            "type": "integer",
            "minimum": 0
          },
          "sounds": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "integer"
              },
              "end": {
                "type": "integer"
              }
            }
          },
          "animations": {
            "type": "object",
            "required": [
              "walk",
              "done"
            ],
            "additionalProperties": false,
            "properties": {
              "walk": {
                "type": "integer"
              },
              "done": {
                "type": "integer"
              }
            }
          },
          "slot_symbol": {
            "type": "integer",
            "minimum": 1
          },
          "hp": {
            "type": "object",
            "required": [
              "facing",
              "objects",
              "work_animation",
              "beat_frames",
              "beat_move",
              "jitter",
              "beat_sound_every",
              "beat_sound",
              "return_move",
              "clouds"
            ],
            "additionalProperties": false,
            "properties": {
              "facing": {
                "type": "integer"
              },
              "objects": {
                "$ref": "#/$defs/group"
              },
              "work_animation": {
                "type": "integer"
              },
              "beat_frames": {
                "$ref": "#/$defs/frames"
              },
              "beat_move": {
                "$ref": "#/$defs/move"
              },
              "jitter": {
                "type": "integer"
              },
              "beat_sound_every": {
                "$ref": "#/$defs/frames"
              },
              "beat_sound": {
                "type": "integer"
              },
              "return_move": {
                "$ref": "#/$defs/move"
              },
              "clouds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "every",
                    "x",
                    "z",
                    "dx",
                    "dz",
                    "count"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "every": {
                      "$ref": "#/$defs/frames"
                    },
                    "x": {
                      "type": "integer"
                    },
                    "z": {
                      "type": "integer"
                    },
                    "dx": {
                      "type": "integer"
                    },
                    "dz": {
                      "type": "integer"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "mp": {
            "type": "object",
            "required": [
              "waypoint",
              "facing",
              "objects",
              "hidden",
              "shown",
              "head_lift",
              "work_animation",
              "loop_sound",
              "leave_animation"
            ],
            "additionalProperties": false,
            "properties": {
              "waypoint": {
                "$ref": "#/$defs/point"
              },
              "facing": {
                "type": "integer"
              },
              "objects": {
                "$ref": "#/$defs/group"
              },
              "hidden": {
                "$ref": "#/$defs/group"
              },
              "shown": {
                "$ref": "#/$defs/group"
              },
              "head_lift": {
                "type": "integer"
              },
              "work_animation": {
                "type": "integer"
              },
              "loop_sound": {
                "type": "integer"
              },
              "leave_animation": {
                "type": "integer"
              }
            }
          },
          "offense": {
            "type": "object",
            "required": [
              "facing",
              "objects",
              "particles",
              "hit_sound",
              "recoil_frames",
              "recoil_move",
              "rebound_frames",
              "swing_frames",
              "swing_base",
              "swing_divisor",
              "leave_animation",
              "punch",
              "punch_by_species"
            ],
            "additionalProperties": false,
            "properties": {
              "facing": {
                "type": "integer"
              },
              "objects": {
                "$ref": "#/$defs/group"
              },
              "particles": {
                "$ref": "#/$defs/points3"
              },
              "hit_sound": {
                "type": "integer"
              },
              "recoil_frames": {
                "type": "integer",
                "minimum": 0
              },
              "recoil_move": {
                "$ref": "#/$defs/move"
              },
              "rebound_frames": {
                "type": "integer",
                "minimum": 0
              },
              "swing_frames": {
                "$ref": "#/$defs/frames"
              },
              "swing_base": {
                "type": "integer"
              },
              "swing_divisor": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "$ref": "#/$defs/frames"
                  },
                  "y": {
                    "$ref": "#/$defs/frames"
                  }
                }
              },
              "leave_animation": {
                "type": "integer"
              },
              "punch": {
                "$ref": "#/$defs/punch"
              },
              "punch_by_species": {
                "description": "The punch of a species, by its id.",
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/punch"
                }
              }
            }
          },
          "defense": {
            "type": "object",
            "required": [
              "facing",
              "objects",
              "particles",
              "loop_sound",
              "work_animation",
              "push",
              "dust_behind",
              "swings"
            ],
            "additionalProperties": false,
            "properties": {
              "facing": {
                "type": "integer"
              },
              "objects": {
                "$ref": "#/$defs/group"
              },
              "particles": {
                "$ref": "#/$defs/points3"
              },
              "loop_sound": {
                "type": "integer"
              },
              "work_animation": {
                "type": "integer"
              },
              "push": {
                "type": "integer"
              },
              "dust_behind": {
                "type": "integer"
              },
              "swings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "dx",
                    "limit",
                    "push"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "dx": {
                      "type": "integer",
                      "not": {
                        "const": 0
                      }
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "push": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "speed": {
            "type": "object",
            "required": [
              "facing",
              "run_animation",
              "lap_frames",
              "restart_x"
            ],
            "additionalProperties": false,
            "properties": {
              "facing": {
                "type": "integer"
              },
              "run_animation": {
                "type": "integer"
              },
              "lap_frames": {
                "$ref": "#/$defs/frames"
              },
              "restart_x": {
                "type": "integer"
              }
            }
          },
          "brain": {
            "type": "object",
            "required": [
              "tamer_spot",
              "tamer_walk",
              "tamer_stand",
              "tamer_teach",
              "partner_stand",
              "partner_learn",
              "teach_every_frames",
              "teach_sound",
              "learn_every_frames",
              "learning"
            ],
            "additionalProperties": false,
            "properties": {
              "tamer_spot": {
                "$ref": "#/$defs/point"
              },
              "tamer_walk": {
                "type": "integer"
              },
              "tamer_stand": {
                "type": "integer"
              },
              "tamer_teach": {
                "type": "integer"
              },
              "partner_stand": {
                "type": "integer"
              },
              "partner_learn": {
                "type": "integer"
              },
              "teach_every_frames": {
                "$ref": "#/$defs/frames"
              },
              "teach_sound": {
                "type": "integer"
              },
              "learn_every_frames": {
                "$ref": "#/$defs/frames"
              },
              "learning": {
                "type": "object",
                "required": [
                  "order_thresholds",
                  "move_thresholds",
                  "move_cap",
                  "moves_by_special",
                  "weights"
                ],
                "additionalProperties": false,
                "properties": {
                  "order_thresholds": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "move_thresholds": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "move_cap": {
                    "type": "integer"
                  },
                  "moves_by_special": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "weights": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "description": "A course: what every course has, and the choreography of its id under the key of that id.",
        "oneOf": [
          {
            "properties": {
              "id": {
                "const": "hp"
              }
            },
            "required": [
              "hp"
            ]
          },
          {
            "properties": {
              "id": {
                "const": "mp"
              }
            },
            "required": [
              "mp"
            ]
          },
          {
            "properties": {
              "id": {
                "const": "offense"
              }
            },
            "required": [
              "offense"
            ]
          },
          {
            "properties": {
              "id": {
                "const": "defense"
              }
            },
            "required": [
              "defense"
            ]
          },
          {
            "properties": {
              "id": {
                "const": "speed"
              }
            },
            "required": [
              "speed"
            ]
          },
          {
            "properties": {
              "id": {
                "const": "brain"
              }
            },
            "required": [
              "brain"
            ]
          }
        ]
      }
    }
  }
}
