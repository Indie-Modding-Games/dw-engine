{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cards",
  "description": "cards.yaml: CARD_PRICES, CARD_DATA and CARD_SPRITE_CLUT of the executable (script.h: CardData).",
  "type": "object",
  "required": ["prices", "cards"],
  "additionalProperties": false,
  "properties": {
    "prices": { "type": "array", "items": { "type": "integer" } },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "digimon", "sprite_id", "merit_value"],
        "additionalProperties": false,
        "properties": {
          "index": { "description": "The card id.", "type": "integer", "minimum": 0 },
          "digimon": { "description": "Id of the Digimon (digimon.yaml).", "type": ["string", "integer", "null"] },
          "sprite_id": { "type": "integer" },
          "merit_value": { "type": "integer" },
          "icon_palette": { "description": "The palette of the card's icon in texture/etcdat/sboy, the 16 x 16 cell at ((index % 8) * 32, (index / 8) * 16) (CARD_SPRITE_CLUT; game_menu.c: renderCardsView). Without it the card list shows the card with palette 0.", "type": "integer", "minimum": 0, "maximum": 15 }
        }
      }
    }
  }
}
