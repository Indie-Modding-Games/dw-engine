{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ruleset: life",
  "description": "rules/<id>/life.yaml: the partner's lifetime, lives, death and rebirth (packages/game/partner, docs/reference/care.md).",
  "type": "object",
  "required": [
    "lifetime_hours",
    "lives",
    "unhappy_lifetime",
    "rebirth"
  ],
  "additionalProperties": false,
  "properties": {
    "lifetime_hours": {
      "type": "integer"
    },
    "lives": {
      "type": "integer"
    },
    "unhappy_lifetime": {
      "type": "object",
      "required": [
        "every_hours",
        "happiness_below",
        "happiness_divisor",
        "extra_hours"
      ],
      "additionalProperties": false,
      "properties": {
        "every_hours": {
          "type": "integer"
        },
        "happiness_below": {
          "type": "integer"
        },
        "happiness_divisor": {
          "type": "integer"
        },
        "extra_hours": {
          "type": "integer"
        }
      }
    },
    "rebirth": {
      "type": "object",
      "required": [
        "baby_choice",
        "babies",
        "inherit_percent_per_tamer_level",
        "random_egg_without_lives"
      ],
      "additionalProperties": false,
      "properties": {
        "baby_choice": {
          "type": "string",
          "minLength": 1
        },
        "babies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "digimon",
              "hp",
              "mp",
              "offense",
              "defense",
              "speed",
              "brain"
            ],
            "additionalProperties": false,
            "properties": {
              "digimon": {
                "type": "string",
                "minLength": 1
              },
              "hp": {
                "type": "integer"
              },
              "mp": {
                "type": "integer"
              },
              "offense": {
                "type": "integer"
              },
              "defense": {
                "type": "integer"
              },
              "speed": {
                "type": "integer"
              },
              "brain": {
                "type": "integer"
              }
            }
          }
        },
        "inherit_percent_per_tamer_level": {
          "type": "integer"
        },
        "random_egg_without_lives": {
          "description": "A partner with no lives left gets a random egg (dooa.c: DOOA_getSequenceState); false lets the egg box's egg count too.",
          "type": "boolean"
        }
      }
    },
    "scenes": {
      "description": "The scenes of a lost life, a death and a rebirth, in frames of the original (murd.c, dooa.c). Without them the partner changes at once.",
      "type": "object",
      "required": [
        "lost_life",
        "wake_map",
        "death"
      ],
      "additionalProperties": false,
      "properties": {
        "lost_life": {
          "type": "object",
          "required": [
            "iris_frames",
            "alone_until",
            "fade_out_end",
            "map_back",
            "fade_in_end",
            "shade_max",
            "shade_hold"
          ],
          "additionalProperties": false,
          "properties": {
            "iris_frames": {
              "type": "integer",
              "minimum": 1
            },
            "alone_until": {
              "type": "integer",
              "minimum": 1
            },
            "fade_out_end": {
              "type": "integer",
              "minimum": 1
            },
            "map_back": {
              "type": "integer",
              "minimum": 1
            },
            "fade_in_end": {
              "type": "integer",
              "minimum": 1
            },
            "shade_max": {
              "type": "integer",
              "minimum": 1
            },
            "shade_hold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "wake_map": {
          "type": "object",
          "required": [
            "story_map",
            "early_map",
            "exit",
            "story_triggers",
            "story_variable",
            "story_variable_at_least",
            "story_map_start_x"
          ],
          "additionalProperties": false,
          "properties": {
            "story_map": {
              "type": "integer",
              "minimum": 0
            },
            "early_map": {
              "type": "integer",
              "minimum": 0
            },
            "exit": {
              "type": "integer",
              "minimum": 0
            },
            "story_triggers": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "story_variable": {
              "type": "integer",
              "minimum": 0
            },
            "story_variable_at_least": {
              "type": "integer"
            },
            "story_map_start_x": {
              "description": "Original pixels right of the screen's centre where the death's camera starts on the story map (dooa.c: 0xBC instead of 0xA0).",
              "type": "integer"
            }
          }
        },
        "death": {
          "type": "object",
          "required": [
            "sound_bank",
            "map_frame",
            "stand_frame",
            "burst",
            "sink",
            "vanish",
            "rise",
            "host_frame",
            "end_frame",
            "glow",
            "hatch",
            "swap_frame",
            "shown_frame",
            "sparkle_sound",
            "finish_frame",
            "clips"
          ],
          "additionalProperties": false,
          "properties": {
            "sound_bank": {
              "type": "integer",
              "minimum": 0
            },
            "map_frame": {
              "type": "integer",
              "minimum": 1
            },
            "stand_frame": {
              "type": "integer",
              "minimum": 1
            },
            "burst": {
              "type": "object",
              "required": [
                "frame",
                "sound"
              ],
              "additionalProperties": false,
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 1
                },
                "sound": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "sink": {
              "type": "object",
              "required": [
                "frame",
                "sound"
              ],
              "additionalProperties": false,
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 1
                },
                "sound": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "vanish": {
              "type": "object",
              "required": [
                "frame",
                "sound"
              ],
              "additionalProperties": false,
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 1
                },
                "sound": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "rise": {
              "type": "object",
              "required": [
                "frame",
                "sound"
              ],
              "additionalProperties": false,
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 1
                },
                "sound": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "host_frame": {
              "description": "The frame the wake map's first character shows again on black (dooa.c: 0x185, ENTITY_TABLE[2]->isOnMap = 1).",
              "type": "integer",
              "minimum": 1
            },
            "end_frame": {
              "type": "integer",
              "minimum": 1
            },
            "glow": {
              "type": "object",
              "required": [
                "frame",
                "sound"
              ],
              "additionalProperties": false,
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 1
                },
                "sound": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "hatch": {
              "type": "object",
              "required": [
                "frame",
                "sound"
              ],
              "additionalProperties": false,
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 1
                },
                "sound": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "swap_frame": {
              "type": "integer",
              "minimum": 1
            },
            "shown_frame": {
              "type": "integer",
              "minimum": 1
            },
            "sparkle_sound": {
              "type": "integer",
              "minimum": 0
            },
            "finish_frame": {
              "type": "integer",
              "minimum": 1
            },
            "clips": {
              "type": "object",
              "required": [
                "alive",
                "last_life",
                "burst",
                "vanish",
                "reborn",
                "finish"
              ],
              "additionalProperties": false,
              "properties": {
                "alive": {
                  "type": "integer",
                  "minimum": 0
                },
                "last_life": {
                  "type": "integer",
                  "minimum": 0
                },
                "burst": {
                  "type": "integer",
                  "minimum": 0
                },
                "vanish": {
                  "type": "integer",
                  "minimum": 0
                },
                "reborn": {
                  "type": "integer",
                  "minimum": 0
                },
                "finish": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
