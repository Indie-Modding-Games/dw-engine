{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Items",
  "description": "items.yaml: ITEM_PARA, ITEM_DESCS and ITEM_CLUT_DATA of the executable (item.h: Item).",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "value", "merit_value", "sorting_value", "item_color", "droppable", "unknown_1e"],
        "additionalProperties": false,
        "properties": {
          "id": { "description": "The item's name in lowercase; <pack id>:<name> for one a pack adds.", "type": "string", "pattern": "^([a-z0-9_]{1,64}:)?[a-z0-9_]+$" },
          "index": { "type": "integer", "minimum": 0 },
          "name": { "description": "Escaped text: \\\\ and \\xNN for bytes that are not printable ASCII.", "type": "string" },
          "description": { "type": ["string", "null"] },
          "value": { "description": "Price.", "type": "integer" },
          "merit_value": { "type": "integer" },
          "sorting_value": { "type": "integer" },
          "item_color": { "type": "integer" },
          "droppable": { "type": "integer" },
          "unknown_1e": { "type": "integer" },
          "icon_palette": { "description": "The palette of the item's icon, the cell of its index in texture/etcdat/item (ITEM_CLUT_DATA; utils2.c: setItemTexture). Without it the item has no icon.", "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    }
  }
}
