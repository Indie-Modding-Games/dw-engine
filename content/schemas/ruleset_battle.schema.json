    "partner_ai",
    "enemy_ai",
    "hit",
    "damage",
    "status",
    "finisher",
    "condition",
    "ending",
    "item_throw",
    "hud",
    "consequences",
    "rewards",
    "joining",
    "timing",
    "quirks"
