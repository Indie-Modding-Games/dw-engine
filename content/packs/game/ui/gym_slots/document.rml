<rml>
<head>
	<title>Gym slots</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="outline" class="hidden"></div>
	<div id="box" class="hidden">
		<div id="panel" class="original-box"></div>
		<div class="reel" id="reel-0"><div class="strip" id="strip-0"><div class="cell" id="cell-0-0"></div><div class="cell" id="cell-0-1"></div><div class="cell" id="cell-0-2"></div><div class="cell" id="cell-0-3"></div></div><div class="shade top"></div><div class="shade bottom"></div></div>
		<div class="reel" id="reel-1"><div class="strip" id="strip-1"><div class="cell" id="cell-1-0"></div><div class="cell" id="cell-1-1"></div><div class="cell" id="cell-1-2"></div><div class="cell" id="cell-1-3"></div></div><div class="shade top"></div><div class="shade bottom"></div></div>
		<div class="reel" id="reel-2"><div class="strip" id="strip-2"><div class="cell" id="cell-2-0"></div><div class="cell" id="cell-2-1"></div><div class="cell" id="cell-2-2"></div><div class="cell" id="cell-2-3"></div></div><div class="shade top"></div><div class="shade bottom"></div></div>
		<p class="payout hidden" id="payout"></p>
	</div>
</body>
</rml>
