/* The island map (M), a dwe improvement: the original has no map of the island (docs/modulos/apps/game.md, «Mapa de
   la isla»). A 960 x 720dp frame centred on a wide screen over a scrim: the title and where the player is on top, the
   painted island (generated by the game, world_map.image) with the areas' names and the player's pulsing marker, the
   places his map's exits lead to in a band below it, and a legend with the close key at the bottom. This is the layout and the modern look; the
   original-look skin restyles it (ui/skins/original/world_map). */

body {
	width: 100%;
	height: 100%;
}

#backdrop {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: #0b0f15d8;
}

#frame {
	position: absolute;
	left: 50%;
	top: 0;
	width: 960dp;
	height: 720dp;
	margin-left: -480dp;
}

#header {
	position: absolute;
	left: 24dp;
	top: 14dp;
	width: 912dp;
	height: 44dp;
}

#title {
	position: absolute;
	left: 0;
	top: 0;
	font-size: 30dp;
	font-weight: bold;
	color: #f0a73a;
}

#here {
	position: absolute;
	right: 0;
	top: 8dp;
	font-size: 22dp;
	color: #e8edf3;
	text-align: right;
}

#here-label {
	color: #c9d3de;
}

#map {
	position: absolute;
	left: 24dp;
	top: 60dp;
	width: 912dp;
	height: 520dp;
	border: 3dp #c9b48a;
	border-radius: 6dp;
	background-color: #4f7f93;
}

#map-image {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

#labels {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

/* An area's name, centred on the area: ink on the parchment with a light halo. */
.region {
	position: absolute;
	width: 180dp;
	height: 20dp;
	margin-left: -90dp;
	margin-top: -10dp;
	text-align: center;
	font-size: 14dp;
	font-weight: bold;
	color: #2a2017;
	font-effect: outline(2dp #f2e8cfd0);
}

.region.unknown {
	color: #5d5548;
	font-weight: normal;
}

/* A place the player's map leads to straight away. */
.region.exit {
	color: #7a2e00;
	font-effect: outline(2dp #ffd58a);
}

.region.here {
	color: #000000;
	font-effect: outline(3dp #ffe14a);
}

/* The marker stands just above its area's name. */
#marker {
	position: absolute;
	width: 0;
	height: 0;
	margin-top: -20dp;
}

#marker-dot {
	position: absolute;
	left: -9dp;
	top: -9dp;
	width: 18dp;
	height: 18dp;
	border-radius: 9dp;
	border: 3dp #1a1f27;
	background-color: #ff5a3c;
}

#marker-pulse {
	position: absolute;
	left: -22dp;
	top: -22dp;
	width: 44dp;
	height: 44dp;
	border-radius: 22dp;
	border: 3dp #ff5a3c;
	animation: 1.2s cubic-out infinite world-map-pulse;
}

@keyframes world-map-pulse {
	from { transform: scale(0.4); opacity: 1; }
	to { transform: scale(1.2); opacity: 0; }
}


/* The places the exits lead to, in a row that wraps under the map (three lines of the original look's font). */
#exits {
	position: absolute;
	left: 24dp;
	top: 590dp;
	width: 912dp;
	height: 82dp;
	font-size: 16dp;
	line-height: 26dp;
	color: #e8edf3;
}

#exits-title {
	font-weight: bold;
	color: #f0a73a;
	margin-right: 12dp;
}

.exit-row {
	display: inline-block;
	white-space: nowrap;
	margin-right: 18dp;
}

.exit-row.hidden {
	display: none;
}

.exit-area {
	font-size: 14dp;
	color: #9aa6b4;
	margin-left: 6dp;
}

#no-exits {
	color: #9aa6b4;
}

#footer {
	position: absolute;
	left: 24dp;
	top: 682dp;
	width: 912dp;
	height: 28dp;
	font-size: 14dp;
	line-height: 24dp;
	color: #c9d3de;
}

.legend-dot {
	display: inline-block;
	width: 12dp;
	height: 12dp;
	border-radius: 6dp;
	margin: 0 6dp 0 0;
	vertical-align: middle;
}

.legend {
	margin-right: 20dp;
}

.legend-here { background-color: #ff5a3c; }
.legend-exit { background-color: #ffd58a; }
.legend-unknown { background-color: #9b927e; }

#close {
	position: absolute;
	right: 0;
	top: 0;
}
