<rml>
<head>
	<title>Main menu</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="../common/ui_skin_choice.lua"></script>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="scrim" onmousemove="pointer_moved(document)">
		<!-- The original look's screen before the menu: the whole screen is the button, so any confirm or click goes on. -->
		<button id="press-start" class="hidden" onclick="leave_boot(document)"><span id="press-start-text"></span></button>
		<div id="panel">
			<h1 id="title" text-key="main_menu.title"></h1>
			<button id="play" autofocus="autofocus" onclick="play()"></button>
			<button id="continue" onclick="continue_game()"></button>
			<button id="erase" class="hidden" onclick="erase_game()" text-key="main_menu.original.erase"></button>
			<button id="battle" class="hidden" onclick="open_view(document, 'battle')" text-key="main_menu.original.battle_mode"></button>
			<button id="options" class="hidden" onclick="open_view(document, 'options')" text-key="main_menu.original.options"></button>
			<button id="language" class="option" onclick="language_entry(document)">
				<span class="label" text-key="main_menu.language"></span><span class="label-original" text-key="main_menu.original.option.language"></span><span class="value" id="language-value"></span>
			</button>
			<button id="text-font" class="option" onclick="change_text_font()">
				<span class="label" text-key="main_menu.text_font"></span><span class="label-original" text-key="main_menu.original.option.text_font"></span><span class="value" id="text-font-value"></span>
			</button>
			<button id="ui-skin" class="option" onclick="skin_choice.change(1)">
				<span class="label" text-key="main_menu.ui_skin"></span><span class="label-original" text-key="main_menu.original.option.ui_skin"></span><span class="value" id="ui-skin-value"></span>
			</button>
			<button id="minimap" class="option hidden" onclick="change_option('minimap', 1)">
				<span class="label" text-key="pause_menu.minimap_mode"></span><span class="label-original" text-key="main_menu.original.option.minimap"></span><span class="value" id="minimap-value"></span>
			</button>
			<button id="minimap-size" class="option hidden" onclick="change_option('minimap-size', 1)">
				<span class="label" text-key="pause_menu.minimap_size"></span><span class="label-original" text-key="main_menu.original.option.minimap_size"></span><span class="value" id="minimap-size-value"></span>
			</button>
			<button id="display-mode" class="option hidden" onclick="change_option('display-mode', 1)">
				<span class="label" text-key="pause_menu.display_mode"></span><span class="label-original" text-key="main_menu.original.option.display_mode"></span><span class="value" id="display-mode-value"></span>
			</button>
			<button id="ui-scale" class="option hidden" onclick="change_option('ui-scale', 1)">
				<span class="label" text-key="pause_menu.ui_scale"></span><span class="label-original" text-key="main_menu.original.option.ui_scale"></span><span class="value" id="ui-scale-value"></span>
			</button>
			<button id="quit" onclick="ui.send('quit')" text-key="main_menu.quit"></button>

			<div id="prompts">
				<span class="prompt"><span class="key" id="prompt-confirm"></span><span text-key="common.accept"></span></span>
				<span class="prompt hidden" id="prompt-back"><span class="key" id="prompt-cancel"></span><span text-key="common.back"></span></span>
			</div>
		</div>
		<!-- The original look's language box: one row per language the packs offer, its flag and its name in its own language. -->
		<div id="language-box" class="hidden">
			<h2 id="language-heading" text-key="main_menu.original.language_heading"></h2>
			<button id="language-1" class="language-row" onclick="pick_language(document, 1)"><img id="language-flag-1" class="flag hidden"/><span id="language-name-1" class="language-name"></span></button>
			<button id="language-2" class="language-row" onclick="pick_language(document, 2)"><img id="language-flag-2" class="flag hidden"/><span id="language-name-2" class="language-name"></span></button>
			<button id="language-3" class="language-row" onclick="pick_language(document, 3)"><img id="language-flag-3" class="flag hidden"/><span id="language-name-3" class="language-name"></span></button>
			<button id="language-4" class="language-row" onclick="pick_language(document, 4)"><img id="language-flag-4" class="flag hidden"/><span id="language-name-4" class="language-name"></span></button>
			<button id="language-5" class="language-row" onclick="pick_language(document, 5)"><img id="language-flag-5" class="flag hidden"/><span id="language-name-5" class="language-name"></span></button>
			<button id="language-6" class="language-row" onclick="pick_language(document, 6)"><img id="language-flag-6" class="flag hidden"/><span id="language-name-6" class="language-name"></span></button>
			<button id="language-7" class="language-row" onclick="pick_language(document, 7)"><img id="language-flag-7" class="flag hidden"/><span id="language-name-7" class="language-name"></span></button>
			<button id="language-8" class="language-row" onclick="pick_language(document, 8)"><img id="language-flag-8" class="flag hidden"/><span id="language-name-8" class="language-name"></span></button>
			<button id="language-done" onclick="close_language(document)" text-key="main_menu.original.language_done"></button>
		</div>
		<!-- The original look's battle mode question. -->
		<div id="battle-box" class="hidden">
			<div id="battle-heading"><p text-key="main_menu.original.battle_mode"></p></div>
			<div id="battle-message"><p text-key="main_menu.original.battle_mode_message"></p></div>
			<div id="battle-answers">
				<button id="battle-yes" onclick="close_view(document)" text-key="common.yes"></button>
				<button id="battle-no" onclick="close_view(document)" text-key="common.no"></button>
			</div>
		</div>
		<!-- The original's fades from and to black (fade.c: fadeFromBlack, fadeToBlack), drawn over everything. -->
		<div id="fade" class="hidden"></div>
	</div>
</body>
</rml>
