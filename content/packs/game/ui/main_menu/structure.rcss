/* How the main menu behaves whatever the skin: the list wraps around, up from the first entry to the last and down
   from the last to the first. The look is the skin's (docs/architecture/ui.md#aspectos). */

#play { nav-up: #quit; }
#quit { nav-down: #play; }
/* Continue with no save to continue, greyed in any skin and skipped, as the original greys it with no memory card. */
#continue.unavailable { opacity: 0.45; focus: none; tab-index: none; }
