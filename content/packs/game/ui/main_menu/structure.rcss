/* How the main menu behaves whatever the skin: the list wraps around, up from the first entry to the last and down
   from the last to the first. The look is the skin's (docs/architecture/ui.md#aspectos). */

#play { nav-up: #quit; }
#quit { nav-down: #play; }
/* Continue with no save to continue, greyed in any skin and skipped, as the original greys it with no memory card. */
#continue.unavailable { opacity: 0.45; focus: none; tab-index: none; }
#coop-info {
	position: relative;
	width: 100%;
	margin-top: 8dp;
}
#coop-info h2 { margin: 0 0 8dp 0; }
#coop-info h3 { margin: 0 0 10dp 0; font-size: 22dp; }
#coop-info p { margin: 0 0 10dp 0; white-space: normal; }
.coop-room-heading { margin: 0 0 18dp 0; }
.coop-room-heading p { font-size: 17dp; }
.coop-room-grid {
	display: block;
	position: relative;
	width: 100%;
	height: 220dp;
}
.coop-room-card {
	position: absolute;
	top: 0;
	box-sizing: border-box;
	height: 210dp;
	padding: 12dp;
	border: 2dp #6a9fce;
	background-color: #10283be8;
}
.coop-room-details { left: 0; width: 26%; }
.coop-room-mode { left: 28%; width: 40%; }
.coop-room-players { right: 0; width: 30%; }
.coop-room-details p { font-size: 17dp; }
.coop-room-mode p:first-of-type { font-size: 22dp; }
#coop-info p.coop-room-note { margin-top: 12dp; font-size: 15dp; color: #b7c8da; }
.coop-player-row {
	display: block;
	position: relative;
	height: 60dp;
	margin: 4dp 0;
	padding: 6dp;
	border: 1dp #52728f;
	background-color: #071a2c;
}
.coop-player-row div { margin-left: 38dp; }
.coop-player-row p { margin: 0; }
.coop-player-icon {
	position: absolute;
	left: 8dp;
	top: 7dp;
	width: 32dp;
	height: 32dp;
	border-radius: 16dp;
	text-align: center;
	line-height: 32dp;
	background-color: #22558c;
}
.coop-player-state { font-size: 16dp; color: #85d69b; }
.coop-ready-mark { position: absolute; right: 8dp; top: 12dp; color: #72e894; }
.coop-room-actions { margin-top: 12dp; text-align: center; }
.coop-room-actions button { display: inline-block; margin: 4dp 6dp; font-size: 18dp; }
.coop-room-actions .unavailable { opacity: 0.45; focus: none; tab-index: none; }
#coop-room-code-entry { margin: 0 auto 8dp auto; font-size: 22dp; letter-spacing: 5dp; }
#coop-info.coop-home .coop-room-grid { display: none; }
#coop-info.coop-home .coop-room-actions { margin-top: 28dp; }
#coop-info.coop-join-entry .coop-room-grid { display: none; }
#coop-info.coop-join-entry #coop-host, #coop-info.coop-join-entry #coop-ready,
#coop-info.coop-join-entry #coop-start { display: none; }
#coop-info.coop-join-entry #coop-connect { display: inline-block; }
#coop-info.coop-lobby #coop-host, #coop-info.coop-lobby #coop-join { display: none; }
#coop-info.coop-join-entry #coop-room-code-entry { display: block; }
#panel.coop-room {
	position: absolute;
	left: 3%;
	top: 4%;
	width: 94%;
	min-width: 0;
	height: 92%;
	margin: 0;
	padding: 22dp;
	box-sizing: border-box;
	border: 2dp #5c91bd;
	border-radius: 10dp;
	background-color: #081522f2;
}
#panel.coop-room #title { display: none; }
#panel.coop-room #coop-info { margin-top: 0; }
#panel.coop-room #coop-room-code { color: #ffda46; font-size: 28dp; letter-spacing: 5dp; }
#panel.coop-room .coop-room-details p { padding-bottom: 8dp; border-bottom: 1dp #44617c; }
/* The original's layout of the entries (skin.yaml layout: main_menu: menu: original, the body's class
   layout-menu-original): logic.lua moves the cursor and stops it at the ends, as the original's, so the wrapping moves
   above stay out; the line of the screen before the menu blinks by its class; the fade over everything never takes
   the pointer. */
.layout-menu-original #panel button, .layout-menu-original #panel ~ div button, #press-start { nav: none; }
.blink-off { visibility: hidden; }
#fade { pointer-events: none; }
/* The title picture filling the window (../common/title_picture.lua): only a skin that draws it shows it. */
#picture, .picture-fade { display: none; pointer-events: none; }
