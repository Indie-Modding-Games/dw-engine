/* How the main menu behaves whatever the skin: the list wraps around, up from the first entry to the last and down
   from the last to the first. The look is the skin's (docs/architecture/ui.md#aspectos). */

#play { nav-up: #quit; }
#quit { nav-down: #play; }
/* Continue with no save to continue, greyed in any skin and skipped, as the original greys it with no memory card. */
#continue.unavailable { opacity: 0.45; focus: none; tab-index: none; }
/* The original's layout of the entries (skin.yaml layout: main_menu: menu: original, the body's class
   layout-menu-original): logic.lua moves the cursor and stops it at the ends, as the original's, so the wrapping moves
   above stay out; the line of the screen before the menu blinks by its class; the fade over everything never takes
   the pointer. */
.layout-menu-original #panel button, .layout-menu-original #panel ~ div button, #press-start { nav: none; }
.blink-off { visibility: hidden; }
#fade { pointer-events: none; }
/* The title picture filling the window (../common/title_picture.lua): only a skin that draws it shows it. */
#picture, .picture-fade { display: none; pointer-events: none; }
