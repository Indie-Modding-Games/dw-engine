/* The HUD: always shown over the game and never in the way of the pointer. */

body {
	pointer-events: none;
}

#minimap {
	position: absolute;
	right: 20dp;
	top: 20dp;
	padding: 10dp;
	border-radius: 12dp;
	background-color: #0d121ab8;
	border: 1dp #2e3a4a;
}

#minimap-map {
	position: relative;
}

.size-small #minimap-map { width: 140dp; height: 140dp; }
.size-medium #minimap-map { width: 200dp; height: 200dp; }
.size-large #minimap-map { width: 280dp; height: 280dp; }

/* The game sets the frame's size and position so the map keeps its proportions inside the square. */
#minimap-frame {
	position: absolute;
}

#minimap-image {
	width: 100%;
	height: 100%;
}

.marker {
	position: absolute;
	width: 16dp;
	height: 16dp;
	margin-left: -8dp;
	margin-top: -8dp;
}

#minimap-player {
	image-color: #f0a73a;
}

#minimap-partner {
	width: 12dp;
	height: 12dp;
	margin-left: -6dp;
	margin-top: -6dp;
	image-color: #5cc8ff;
}

#minimap-name {
	margin-top: 6dp;
	font-size: 14dp;
	font-weight: bold;
	text-align: center;
	color: #c9d3de;
}

/* Opens the pause menu with the pointer; the prompt names the key or button that also opens it. */
#menu-button {
	pointer-events: auto;
	position: absolute;
	left: 20dp;
	top: 20dp;
	margin: 0;
	padding: 6dp 14dp 6dp 8dp;
	font-size: 15dp;
	background-color: #0d121ab8;
	border: 1dp #2e3a4a;
}

#menu-button:hover {
	background-color: #1c2633;
}

/* The name of the map a map change goes to, while the original shows it (map.c: renderMapName): in the middle of
   the screen, light grey, with no box and no shadow, over the fade that the game draws under the UI. */
#map-title {
	position: absolute;
	left: 0;
	right: 0;
	top: 50%;
	height: 40dp;
	margin-top: -20dp;
	line-height: 40dp;
	text-align: center;
	font-size: 30dp;
	color: #d6d6d6;
	display: none;
}

#map-title.shown {
	display: block;
}
