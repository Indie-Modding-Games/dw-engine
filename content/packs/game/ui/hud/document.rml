<rml>
<head>
	<title>HUD</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<button id="menu-button" onclick="ui.send('open_menu')"><span class="key" id="prompt-menu"></span><span text-key="hud.menu"></span></button>
	<div id="minimap" class="size-medium">
		<div id="minimap-map">
			<div id="minimap-frame">
				<img id="minimap-image"/>
				<img id="minimap-partner" class="marker" src="generated:minimap_marker"/>
				<img id="minimap-player" class="marker" src="generated:minimap_marker"/>
			</div>
		</div>
		<div id="minimap-name"></div>
	</div>
	<div id="map-title" class="original-look"></div>
</body>
</rml>
