<rml>
<head>
	<title>HUD</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<button id="menu-button" onclick="ui.send('open_menu')"><span class="key" id="prompt-menu"></span><span text-key="hud.menu"></span></button>
	<div id="minimap" class="size-medium">
		<div id="minimap-map">
			<div id="minimap-frame">
				<img id="minimap-image"/>
				<img id="minimap-partner" class="marker" src="generated:minimap_marker"/>
				<img id="minimap-player" class="marker" src="generated:minimap_marker"/>
			</div>
		</div>
		<div id="minimap-name"></div>
	</div>
	<div id="field-status">
		<div id="field-clock">
			<div id="field-clock-dial"><div id="field-clock-hour-dot"></div><div id="field-clock-minute-hand"></div></div>
			<span id="field-time"></span>
			<span id="field-date"></span>
		</div>
		<div class="field-meter" id="field-meter-0"><span class="label" id="field-meter-0-label"></span><div class="bar" id="field-meter-0-bar"><div class="fill" id="field-meter-0-fill"></div><div class="fill high" id="field-meter-0-high"></div></div><span class="value" id="field-meter-0-value"></span></div>
		<div class="field-meter" id="field-meter-1"><span class="label" id="field-meter-1-label"></span><div class="bar" id="field-meter-1-bar"><div class="fill" id="field-meter-1-fill"></div><div class="fill high" id="field-meter-1-high"></div></div><span class="value" id="field-meter-1-value"></span></div>
		<div id="field-needs">
			<span class="need" id="field-need-0"></span><span class="need" id="field-need-1"></span><span class="need" id="field-need-2"></span>
		</div>
		<div id="field-pools">
			<div class="field-pool"><span class="label" id="field-pool-0-label"></span><div class="bar" id="field-pool-0-bar"><div class="fill" id="field-pool-0-fill"></div></div><span class="value" id="field-pool-0-value"></span></div>
			<div class="field-pool"><span class="label" id="field-pool-1-label"></span><div class="bar" id="field-pool-1-bar"><div class="fill" id="field-pool-1-fill"></div></div><span class="value" id="field-pool-1-value"></span></div>
		</div>
	</div>
	<div id="map-title" class="original-look"></div>
</body>
</rml>
