/* How the HUD behaves whatever the skin: the need bubble hangs from the point the script places it at (the partner's
   head, hud.partner.x and hud.partner.y), by the middle of its bottom edge, so a skin only gives it a size and a
   look (docs/architecture/ui.md#estado-del-campo). */

#field-partner-bubble {
	position: absolute;
	transform: translate(-50%, -100%);
}

/* The enemies' dots (the option minimap_enemies): the UI puts one <img class="marker enemy"> per enemy in view in
   #minimap-enemies, placed in percent of the disc as the partner; the layer covers the disc and lies under the partner
   and the player, which come after it. */
#minimap-enemies {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

/* While a window lies over the minimap the game hides it (hud.minimap_covered): it keeps its place, so the game can
   tell when nothing lies there any more, and draws nothing. */
#minimap.covered {
	visibility: hidden;
}

/* The shop job's bar (the option shop_job_bar): centred at the top of the screen, between the clock and the minimap,
   only while the game shows it (the class shown). The script sizes the fill and puts the better pay's mark and its
   label at their share of the bar (left in percent); the join's mark is the bar's end. */
#shop-job {
	display: none;
	position: absolute;
	top: 20dp;
	left: 50%;
}

#shop-job.shown {
	display: block;
}

#shop-job-head, #shop-job-foot {
	display: block;
	position: relative;
}

#shop-job-customers {
	position: absolute;
	right: 0;
	top: 0;
}

#shop-job-bar {
	display: block;
	position: relative;
}

#shop-job-fill {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
}

.shop-job-mark {
	position: absolute;
	top: 0;
	bottom: 0;
}

#shop-job-mark-join {
	right: 0;
}

#shop-job-next {
	position: absolute;
	top: 0;
	right: 0;
}
