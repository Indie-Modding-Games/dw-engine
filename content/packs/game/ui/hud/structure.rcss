/* How the HUD behaves whatever the skin: the need bubble hangs from the point the script places it at (the partner's
   head, hud.partner.x and hud.partner.y), by the middle of its bottom edge, so a skin only gives it a size and a
   look (docs/architecture/ui.md#estado-del-campo). */

#field-partner-bubble {
	position: absolute;
	transform: translate(-50%, -100%);
}

/* The enemies' dots (the option minimap_enemies): the UI puts one <img class="marker enemy"> per enemy in view in
   #minimap-enemies, placed in percent of the disc as the partner; the layer covers the disc and lies under the partner
   and the player, which come after it. */
/* The items on the ground (the option minimap_items) the same way, one <img class="marker item"> each in
   #minimap-items, which lies under the enemies' layer. */
#minimap-items,
#minimap-enemies {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

/* While a window lies over the minimap the game hides it (hud.minimap_covered): it keeps its place, so the game can
   tell when nothing lies there any more, and draws nothing. */
#minimap.covered {
	visibility: hidden;
}

/* The shop job's bar (the option shop_job_bar): centred at the top of the screen, between the clock and the minimap,
   only while the game shows it (the class shown). The head holds the title, the customers served and the rules' "?"
   button in a row; then the bar with its marks; then the foot with the tally and the next mark. The script sizes the
   fill and puts each mark at its share of the bar (left in percent). Each mark's label is centred on it: the main one,
   the join (.main), above the bar, with the bonus item's icon; the better pay's and the bonus's under it. A skin
   leaves room for both bands with the bar's top margin and the foot's top margin. In the original job the join's mark
   ends the bar, so its label ends there. */
#shop-job {
	display: none;
	position: absolute;
	top: 20dp;
	left: 50%;
}

#shop-job.shown {
	display: block;
}

#shop-job-head {
	display: flex;
	flex-direction: row;
	align-items: center;
}

#shop-job-title {
	flex: 1 1 auto;
	white-space: nowrap;
}

#shop-job-customers {
	flex: 0 0 auto;
	white-space: nowrap;
}

/* The rules' "?" button, at the head's end, apart from the customers; a click opens the shop_job_rules panel. */
#shop-job-rules {
	flex: 0 0 auto;
	margin-left: 14dp;
	text-align: center;
}

#shop-job-foot {
	display: block;
	position: relative;
}

#shop-job-bar {
	display: block;
	position: relative;
}

#shop-job-fill {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
}

.shop-job-mark {
	position: absolute;
	top: 0;
	bottom: 0;
}

#shop-job-mark-join {
	right: 0;
}

/* The bonus item's mark (the improved job): only when the bar reaches it (the class shown). */
#shop-job-mark-bonus {
	display: none;
}

#shop-job-mark-bonus.shown {
	display: block;
}

.shop-job-mark-label {
	position: absolute;
	top: 100%;
	left: -120dp;
	width: 240dp;
	margin-top: 4dp;
	text-align: center;
	white-space: nowrap;
}

#shop-job-mark-join .shop-job-mark-label {
	top: auto;
	bottom: 100%;
	margin-top: 0;
	margin-bottom: 2dp;
}

#shop-job:not(.improved) #shop-job-mark-join .shop-job-mark-label {
	left: auto;
	right: 0;
	text-align: right;
}

/* The bonus item's icon, above the bar on its mark (the join's label sits above the bar too, further left). */
#shop-job-mark-bonus-icon {
	position: absolute;
	bottom: 100%;
	left: -11dp;
	width: 22dp;
	height: 22dp;
	margin-bottom: 4dp;
}

#shop-job-mark-bonus-icon.hidden {
	display: none;
}

#shop-job-next {
	position: absolute;
	top: 0;
	right: 0;
}

/* The minimap clock's day-part chip (morning, day, late, night): a picture only a skin paints;
   the document carries it hidden otherwise (ui/hud/logic.lua: clock_phase sets its class). */
#minimap-phase { display: none; }
