/* How the HUD behaves whatever the skin: the need bubble hangs from the point the script places it at (the partner's
   head, hud.partner.x and hud.partner.y), by the middle of its bottom edge, so a skin only gives it a size and a
   look (docs/architecture/ui.md#estado-del-campo). */

#field-partner-bubble {
	position: absolute;
	transform: translate(-50%, -100%);
}

/* The enemies' dots (the option minimap_enemies): the UI puts one <img class="marker enemy"> per enemy in view in
   #minimap-enemies, placed in percent of the disc as the partner; the layer covers the disc and lies under the partner
   and the player, which come after it. */
/* The items on the ground (the option minimap_items) the same way, one <img class="marker item"> each in
   #minimap-items, which lies under the enemies' layer. */
#minimap-items,
#minimap-enemies {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

/* While a window lies over the minimap the game hides it (hud.minimap_covered): it keeps its place, so the game can
   tell when nothing lies there any more, and draws nothing. */
#minimap.covered {
	visibility: hidden;
}

/* The shop job's bar (the option shop_job_bar): centred at the top of the screen, between the clock and the minimap,
   only while the game shows it (the class shown). The script sizes the fill and puts the better pay's mark and its
   label at their share of the bar (left in percent); the join's mark is the bar's end. */
#shop-job {
	display: none;
	position: absolute;
	top: 20dp;
	left: 50%;
}

#shop-job.shown {
	display: block;
}

#shop-job-head, #shop-job-foot {
	display: block;
	position: relative;
}

/* The marks' labels hang under the bar: the foot leaves them a band. */
#shop-job-foot {
	margin-top: 16dp;
}

/* Room on the head's right for the rules' "?" button. */
#shop-job-customers {
	position: absolute;
	right: 36dp;
	top: 0;
}

#shop-job-bar {
	display: block;
	position: relative;
}

#shop-job-fill {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
}

.shop-job-mark {
	position: absolute;
	top: 0;
	bottom: 0;
}

#shop-job-mark-join {
	right: 0;
}

/* The bonus item's mark (the improved job): only when the bar reaches it (the class shown), with the item's icon and
   its label. Every mark carries its label (.shop-job-mark-label); the join's is the main one (.main). */
#shop-job-mark-bonus {
	display: none;
}

#shop-job-mark-bonus.shown {
	display: block;
}

.shop-job-mark-label {
	position: absolute;
	top: 100%;
	left: 4dp;
	margin-top: 1dp;
	font-size: 13dp;
	line-height: 14dp;
	white-space: nowrap;
}

/* The join's label goes before its mark: in the original job that mark ends the bar. */
#shop-job-mark-join .shop-job-mark-label {
	left: auto;
	right: 4dp;
}

/* The bonus item's icon, in the labels' band just before its mark. */
#shop-job-mark-bonus-icon {
	position: absolute;
	top: 100%;
	right: 2dp;
	margin-top: 0;
	width: 15dp;
	height: 15dp;
}

/* The rules' "?" button, at the head's end; a click opens the shop_job_rules panel. */
#shop-job-rules {
	position: absolute;
	top: 0;
	right: 0;
	width: 22dp;
	text-align: center;
}

#shop-job-next {
	position: absolute;
	top: 0;
	right: 0;
}

/* The minimap clock's day-part chip (morning, day, late, night): a picture only a skin paints;
   the document carries it hidden otherwise (ui/hud/logic.lua: clock_phase sets its class). */
#minimap-phase { display: none; }
