/* How the shop behaves whatever the skin: the choices and the list wrap around. The look is the pause menu's (the
   skins' pause_menu style). */

/* The money box (createShopBitsBox, renderShopBitsBox): one pixel of the original is 3dp on the 960 x 720dp frame
   centred on a wide screen. Measured on the original: the box from x 8 to 89 and y 22 to 54, the word on the first
   row from x 30 and the money on the second, right-aligned to end at x 67 whatever its digits. */
#frame {
	position: absolute;
	left: 50%;
	top: 0;
	width: 960dp;
	height: 720dp;
	margin-left: -480dp;
}

#bits-box {
	position: absolute;
	left: 24dp;
	top: 66dp;
	width: 246dp;
	height: 99dp;
	padding: 6dp 0 0 63dp;
	box-sizing: border-box;
	border: 3dp #d0d0d0;
	background-color: #000000c0;
	font-size: 33dp;
	line-height: 39dp;
}

#bits-box.hidden { display: none; }

.bits-row {
	display: block;
	height: 39dp;
	white-space: pre;
}

#bits-value {
	width: 111dp;
	text-align: right;
}

/* tickItemMenuDescriptionBox: pause (Start) on a row of the list opens the item's description in a box 264 x 22 like
   the original's (createItemMenuDescriptionBox). The original puts it by the row; this list sits in the middle of the
   screen, so the box goes right under it, over everything (from x 28 to 292, y 196 to 218). */
#description {
	position: absolute;
	z-index: 10;
	left: 84dp;
	top: 588dp;
	width: 792dp;
	height: 66dp;
	padding: 9dp 9dp;
	box-sizing: border-box;
	background-color: #000000e0;
	border: 3dp #d0d0d0;
	font-size: 33dp;
	line-height: 39dp;
	white-space: pre;
}

#description.hidden, #list-description.hidden, #amount-owned.hidden, #amount-after.hidden { display: none; }

/* Shop extras: the focused item's description under the list. */
#list-description {
	display: block;
	white-space: pre-wrap;
}

#choice-1 { nav-up: #choice-3; }
#choice-3 { nav-down: #choice-1; }
#row-1 { nav-up: #list-back; }
#list-back { nav-down: #row-1; }

/* The partner's favourite food (the favorite_food option, an engine improvement): its row in gold with a gold bar at
   its left, so it does not rest on the colour alone. Both skins. */
#list .row.favorite { color: #ffd34a; border-left: 6dp #ffd34a; }

/* The row split into name and price (draw_row) is for skins that set the price in its own column. */
.row-name,
.row-price {
	display: none;
}
