<rml>
<head>
	<title>Shop menu</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="scrim">
		<div id="frame">
			<div id="bits-box" class="original-box original-look hidden">
				<div class="bits-row" id="bits-label"></div>
				<div class="bits-row" id="bits-value"></div>
			</div>
			<div id="description" class="original-box original-look hidden"><span id="description-text"></span></div>
		</div>
		<div id="panel">
			<p id="line"></p>
			<button id="next" onclick="ui.send('shop_next', true)" text-key="shop.next"></button>

			<div id="choices">
				<button id="choice-1" class="choice" onclick="choose(1)"></button>
				<button id="choice-2" class="choice" onclick="choose(2)"></button>
				<button id="choice-3" class="choice" onclick="choose(3)"></button>
			</div>

			<div id="list">
				<button id="row-1" class="row" onclick="pick(1)" onfocus="row_focus(document, 1)"><span id="row-1-text" class="row-text"></span><span id="row-1-name" class="row-name"></span><span id="row-1-price" class="row-price"></span></button>
				<button id="row-2" class="row" onclick="pick(2)" onfocus="row_focus(document, 2)"><span id="row-2-text" class="row-text"></span><span id="row-2-name" class="row-name"></span><span id="row-2-price" class="row-price"></span></button>
				<button id="row-3" class="row" onclick="pick(3)" onfocus="row_focus(document, 3)"><span id="row-3-text" class="row-text"></span><span id="row-3-name" class="row-name"></span><span id="row-3-price" class="row-price"></span></button>
				<button id="row-4" class="row" onclick="pick(4)" onfocus="row_focus(document, 4)"><span id="row-4-text" class="row-text"></span><span id="row-4-name" class="row-name"></span><span id="row-4-price" class="row-price"></span></button>
				<button id="row-5" class="row" onclick="pick(5)" onfocus="row_focus(document, 5)"><span id="row-5-text" class="row-text"></span><span id="row-5-name" class="row-name"></span><span id="row-5-price" class="row-price"></span></button>
				<button id="row-6" class="row" onclick="pick(6)" onfocus="row_focus(document, 6)"><span id="row-6-text" class="row-text"></span><span id="row-6-name" class="row-name"></span><span id="row-6-price" class="row-price"></span></button>
				<button id="row-7" class="row" onclick="pick(7)" onfocus="row_focus(document, 7)"><span id="row-7-text" class="row-text"></span><span id="row-7-name" class="row-name"></span><span id="row-7-price" class="row-price"></span></button>
				<button id="row-8" class="row" onclick="pick(8)" onfocus="row_focus(document, 8)"><span id="row-8-text" class="row-text"></span><span id="row-8-name" class="row-name"></span><span id="row-8-price" class="row-price"></span></button>
				<p id="empty" text-key="shop.empty"></p>
				<p id="page"></p>
				<button id="previous" class="page-turn" onclick="turn(document, -1)" text-key="shop.previous"></button>
				<button id="next-page" class="page-turn" onclick="turn(document, 1)" text-key="shop.next_page"></button>
				<button id="list-back" class="back" onclick="ui.send('shop_back', true)" onfocus="row_focus(document, 0)" text-key="shop.back"></button>
				<p id="list-description" class="hidden"></p>
			</div>

			<div id="amount">
				<p id="amount-name"></p>
				<p id="amount-price"></p>
				<p id="amount-value"></p>
				<p id="amount-total"></p>
				<p id="amount-owned" class="hidden"></p>
				<p id="amount-after" class="hidden"></p>
				<button id="amount-less" onclick="ui.send('shop_amount', -1)" text-key="shop.less"></button>
				<button id="amount-more" onclick="ui.send('shop_amount', 1)" text-key="shop.more"></button>
				<button id="amount-max" onclick="ui.send('shop_amount_max', true)" text-key="shop.max"></button>
				<button id="amount-confirm" onclick="ui.send('shop_confirm', true)" text-key="common.accept"></button>
				<button id="amount-back" class="back" onclick="ui.send('shop_back', true)" text-key="shop.back"></button>
			</div>

			<div id="prompts">
				<span class="prompt"><span class="key" id="prompt-confirm"></span><span text-key="common.accept"></span></span>
				<span class="prompt"><span class="key" id="prompt-cancel"></span><span text-key="shop.back"></span></span>
			</div>
		</div>
	</div>
</body>
</rml>
