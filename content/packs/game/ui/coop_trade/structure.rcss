/* An item trade between two players of a co-op game (apps/game/src/coop_trades.hpp): the ask (a small box with its
   answer buttons) and the table, three columns as the item trader's lists (trade_menu): this player's bag, what this
   player gives and what the other gives, each offer with its ready mark, and the buttons under them. This is the plain
   look; a skin restyles it (skins/<skin>/coop_trade/style.rcss). Over the field and its HUD. */
body {
	width: 100%;
	height: 100%;
	z-index: 110;
	pointer-events: none;
	color: #f2f4f7;
	font-size: 18dp;
}

#scrim {
	display: block;
	width: 100%;
	height: 100%;
	pointer-events: auto;
}

.box {
	position: absolute;
	padding: 14dp 18dp;
	border: 3dp #c9d3de;
	border-radius: 8dp;
	background-color: #1a1f27f0;
}

#ask {
	left: 30%;
	top: 36%;
	width: 40%;
	text-align: center;
}

#ask-text {
	display: block;
	margin-bottom: 12dp;
}

#window {
	left: 8%;
	top: 10%;
	width: 84%;
	height: 80%;
}

#title {
	display: block;
	font-size: 22dp;
	margin-bottom: 10dp;
}

#columns {
	display: flex;
	flex-direction: row;
	height: 78%;
}

.column {
	display: block;
	width: 33%;
	margin-right: 1%;
	padding: 6dp 8dp;
	border: 2dp #3a4350;
	border-radius: 5dp;
	overflow: hidden;
}

.heading {
	display: block;
	color: #aeb8c4;
	padding-bottom: 4dp;
	margin-bottom: 4dp;
	border-bottom: 1dp #3a4350;
}

.more {
	display: block;
	text-align: center;
	color: #aeb8c4;
	font-size: 14dp;
}

.row {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
	height: 30dp;
	padding: 0 6dp;
	border: 2dp transparent;
	border-radius: 4dp;
	box-sizing: border-box;
}

button.row:hover,
button.row:focus {
	border-color: #ffe08a;
	background-color: #2b333f;
}

.row .icon {
	width: 22dp;
	height: 22dp;
	margin-right: 6dp;
}

.row .name {
	flex: 1;
}

.row .count {
	margin-left: 6dp;
	color: #c9d3de;
}

.row.item-field .name { color: #f2f4f7; }
.row.item-battle .name { color: #ff9b8a; }
.row.item-shared .name { color: #8ad3ff; }

/* Offered from the bag: a mark of colour on the count; given all of it: dim. */
.row.offered .count { color: #ffe08a; }
.row.spent { opacity: 0.55; }
/* What the original does not let go of (it cannot be thrown away either). */
.row.locked { opacity: 0.4; }

.none {
	display: block;
	color: #7d8794;
	margin: 4dp 0;
}

.state {
	display: block;
	margin-top: 8dp;
	color: #aeb8c4;
}

.state.ready {
	color: #5fd16b;
}

#actions {
	display: block;
	margin-top: 10dp;
	text-align: center;
}

button {
	display: inline-block;
	margin: 3dp 6dp;
	padding: 4dp 14dp;
	border: 2dp #6d7a8a;
	border-radius: 5dp;
	background-color: #2b333f;
	color: #f2f4f7;
}

button:hover,
button:focus {
	border-color: #ffe08a;
}

button.ready {
	background-color: #2f5a35;
}

button.unavailable {
	opacity: 0.45;
}

#help {
	display: block;
	margin-top: 8dp;
	text-align: center;
	color: #aeb8c4;
	font-size: 16dp;
}

#scrim.hidden,
.hidden,
.row.hidden,
.box.hidden {
	display: none;
}
