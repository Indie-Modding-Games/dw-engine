<rml>
<head>
	<title>Award notice</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="../story_textbox/structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="box" class="original-look">
		<div id="rows">
			<div class="row" id="line-1"><span class="color-10 hidden" id="name"></span><span id="text-1"></span></div>
			<div class="row" id="line-2"><span id="text-2"></span></div>
			<div class="row" id="line-3"><span id="text-3"></span></div>
		</div>
		<div id="confirm-icon" class="prompt-icon"></div>
	</div>
</body>
</rml>
