<rml>
<head>
	<title>Lives box</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="box">
		<div id="lives">
			<img id="label" src="/texture/etchi/life" rect="48 0 64 24"/>
			<p id="label-text" text-key="hud.lives_box.label"></p>
			<div id="slot-0" class="slot"><img id="life-0" class="life" src="/texture/etchi/life" rect="0 0 24 24"/></div>
			<div id="slot-1" class="slot"><img id="life-1" class="life" src="/texture/etchi/life" rect="0 0 24 24"/></div>
			<div id="slot-2" class="slot"><img id="life-2" class="life" src="/texture/etchi/life" rect="0 0 24 24"/></div>
			<div id="slot-3" class="slot"><img id="life-3" class="life" src="/texture/etchi/life" rect="0 0 24 24"/></div>
			<div id="slot-4" class="slot"><img id="life-4" class="life" src="/texture/etchi/life" rect="0 0 24 24"/></div>
		</div>
	</div>
</body>
</rml>
