<rml>
<head>
	<title>Lives box</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="box">
		<div id="lives">
			<img id="label" src="/texture/etchi/life" rect="48 0 64 24"/>
			<img id="slot-0" class="slot" src="/texture/etchi/life" rect="0 0 24 24"/>
			<img id="slot-1" class="slot" src="/texture/etchi/life" rect="0 0 24 24"/>
			<img id="slot-2" class="slot" src="/texture/etchi/life" rect="0 0 24 24"/>
			<img id="slot-3" class="slot" src="/texture/etchi/life" rect="0 0 24 24"/>
			<img id="slot-4" class="slot" src="/texture/etchi/life" rect="0 0 24 24"/>
		</div>
	</div>
</body>
</rml>
