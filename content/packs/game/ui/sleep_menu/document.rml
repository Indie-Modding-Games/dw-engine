<rml>
<head>
	<title>Sleep menu</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="scrim">
		<div id="panel">
			<button id="sleep" autofocus="autofocus" onclick="ui.send('sleep_only')" text-key="save.sleep"></button>
			<button id="save-and-sleep" onclick="ui.send('sleep_and_save')" text-key="save.sleep_and_save"></button>

			<div id="prompts">
				<span class="prompt"><span class="key" id="prompt-confirm"></span><span text-key="common.accept"></span></span>
			</div>
		</div>
	</div>
</body>
</rml>
