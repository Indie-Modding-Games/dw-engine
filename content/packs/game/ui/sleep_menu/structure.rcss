/* How the sleep menu behaves whatever the skin: its two entries wrap around. The look is the pause menu's (the skins'
   pause_menu style). */

#sleep { nav-up: #save-and-sleep; }
#save-and-sleep { nav-down: #sleep; }

/* A co-op guest's wait for the world's morning takes the entries' place in the same panel. */
#panel .hidden { display: none; }

#wait {
	padding: 12dp 8dp;
	text-align: center;
}
