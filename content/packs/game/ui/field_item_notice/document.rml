<rml>
<head>
	<title>Field item notice</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="scrim">
		<div id="panel">
			<p id="text"></p>
			<button id="ok" autofocus="autofocus" onclick="ui.send('field_item_notice_ok')" text-key="common.accept"></button>

			<div id="prompts">
				<span class="prompt"><span class="key" id="prompt-confirm"></span><span text-key="common.accept"></span></span>
			</div>
		</div>
	</div>
</body>
</rml>
