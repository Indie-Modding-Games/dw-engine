<button id="tech-choice-19" class="tech-choice" onclick="toggle_technique(document, 19)"><span class="tech-cell" id="tech-cell-19"></span></button>
<button id="tech-choice-20" class="tech-choice" onclick="toggle_technique(document, 20)"><span class="tech-cell" id="tech-cell-20"></span></button>
<button id="tech-choice-21" class="tech-choice" onclick="toggle_technique(document, 21)"><span class="tech-cell" id="tech-cell-21"></span></button>
<button id="tech-choice-22" class="tech-choice" onclick="toggle_technique(document, 22)"><span class="tech-cell" id="tech-cell-22"></span></button>
<button id="tech-choice-23" class="tech-choice" onclick="toggle_technique(document, 23)"><span class="tech-cell" id="tech-cell-23"></span></button>
<button id="tech-choice-24" class="tech-choice" onclick="toggle_technique(document, 24)"><span class="tech-cell" id="tech-cell-24"></span></button>
<button id="tech-choice-25" class="tech-choice" onclick="toggle_technique(document, 25)"><span class="tech-cell" id="tech-cell-25"></span></button>
<button id="tech-choice-26" class="tech-choice" onclick="toggle_technique(document, 26)"><span class="tech-cell" id="tech-cell-26"></span></button>
<button id="tech-choice-27" class="tech-choice" onclick="toggle_technique(document, 27)"><span class="tech-cell" id="tech-cell-27"></span></button>
<button id="tech-choice-28" class="tech-choice" onclick="toggle_technique(document, 28)"><span class="tech-cell" id="tech-cell-28"></span></button>
<button id="tech-choice-29" class="tech-choice" onclick="toggle_technique(document, 29)"><span class="tech-cell" id="tech-cell-29"></span></button>
<button id="tech-choice-30" class="tech-choice" onclick="toggle_technique(document, 30)"><span class="tech-cell" id="tech-cell-30"></span></button>
<button id="tech-choice-31" class="tech-choice" onclick="toggle_technique(document, 31)"><span class="tech-cell" id="tech-cell-31"></span></button>
<button id="tech-choice-32" class="tech-choice" onclick="toggle_technique(document, 32)"><span class="tech-cell" id="tech-cell-32"></span></button>
<button id="tech-choice-33" class="tech-choice" onclick="toggle_technique(document, 33)"><span class="tech-cell" id="tech-cell-33"></span></button>
<button id="tech-choice-34" class="tech-choice" onclick="toggle_technique(document, 34)"><span class="tech-cell" id="tech-cell-34"></span></button>
<button id="tech-choice-35" class="tech-choice" onclick="toggle_technique(document, 35)"><span class="tech-cell" id="tech-cell-35"></span></button>
<button id="tech-choice-36" class="tech-choice" onclick="toggle_technique(document, 36)"><span class="tech-cell" id="tech-cell-36"></span></button>
<button id="tech-choice-37" class="tech-choice" onclick="toggle_technique(document, 37)"><span class="tech-cell" id="tech-cell-37"></span></button>
<button id="tech-choice-38" class="tech-choice" onclick="toggle_technique(document, 38)"><span class="tech-cell" id="tech-cell-38"></span></button>
<button id="tech-choice-39" class="tech-choice" onclick="toggle_technique(document, 39)"><span class="tech-cell" id="tech-cell-39"></span></button>
<button id="tech-choice-40" class="tech-choice" onclick="toggle_technique(document, 40)"><span class="tech-cell" id="tech-cell-40"></span></button>
<button id="tech-choice-41" class="tech-choice" onclick="toggle_technique(document, 41)"><span class="tech-cell" id="tech-cell-41"></span></button>
<button id="tech-choice-42" class="tech-choice" onclick="toggle_technique(document, 42)"><span class="tech-cell" id="tech-cell-42"></span></button>
<button id="tech-choice-43" class="tech-choice" onclick="toggle_technique(document, 43)"><span class="tech-cell" id="tech-cell-43"></span></button>
<button id="tech-choice-44" class="tech-choice" onclick="toggle_technique(document, 44)"><span class="tech-cell" id="tech-cell-44"></span></button>
<button id="tech-choice-45" class="tech-choice" onclick="toggle_technique(document, 45)"><span class="tech-cell" id="tech-cell-45"></span></button>
<button id="tech-choice-46" class="tech-choice" onclick="toggle_technique(document, 46)"><span class="tech-cell" id="tech-cell-46"></span></button>
<button id="tech-choice-47" class="tech-choice" onclick="toggle_technique(document, 47)"><span class="tech-cell" id="tech-cell-47"></span></button>
<button id="tech-choice-48" class="tech-choice" onclick="toggle_technique(document, 48)"><span class="tech-cell" id="tech-cell-48"></span></button>
<button id="tech-choice-49" class="tech-choice" onclick="toggle_technique(document, 49)"><span class="tech-cell" id="tech-cell-49"></span></button>
<button id="tech-choice-50" class="tech-choice" onclick="toggle_technique(document, 50)"><span class="tech-cell" id="tech-cell-50"></span></button>
<button id="tech-choice-51" class="tech-choice" onclick="toggle_technique(document, 51)"><span class="tech-cell" id="tech-cell-51"></span></button>
<button id="tech-choice-52" class="tech-choice" onclick="toggle_technique(document, 52)"><span class="tech-cell" id="tech-cell-52"></span></button>
<button id="tech-choice-53" class="tech-choice" onclick="toggle_technique(document, 53)"><span class="tech-cell" id="tech-cell-53"></span></button>
<button id="tech-choice-54" class="tech-choice" onclick="toggle_technique(document, 54)"><span class="tech-cell" id="tech-cell-54"></span></button>
<button id="tech-choice-55" class="tech-choice" onclick="toggle_technique(document, 55)"><span class="tech-cell" id="tech-cell-55"></span></button>
<span class="tech-category category-0 category-left"></span><span class="tech-category category-0 category-right"></span>
<span class="tech-category category-1 category-left"></span><span class="tech-category category-1 category-right"></span>
<span class="tech-category category-2 category-left"></span><span class="tech-category category-2 category-right"></span>
<span class="tech-category category-3 category-left"></span><span class="tech-category category-3 category-right"></span>
<span class="tech-category category-4 category-left"></span><span class="tech-category category-4 category-right"></span>
<span class="tech-category category-5 category-left"></span><span class="tech-category category-5 category-right"></span>
<span class="tech-category category-6 category-left"></span><span class="tech-category category-6 category-right"></span>
<span class="tech-column column-0"></span>
<span class="tech-column column-1"></span>
<span class="tech-column column-2"></span>
<span class="tech-column column-3"></span>
<span class="tech-column column-4"></span>
<span class="tech-column column-5"></span>
<span class="tech-column column-6"></span>
<span class="tech-column column-7"></span>
</div><div id="tech-info" class="hidden"><span id="tech-info-heading"></span><span id="tech-info-tl" class="info-corner"></span><span id="tech-info-tr" class="info-corner"></span><span id="tech-info-bl" class="info-corner"></span><span id="tech-info-br" class="info-corner"></span><span id="tech-info-notch" class="info-corner"></span><div id="tech-info-name" class="original-look"></div><div id="tech-info-stats"><span class="info-label info-power" text-key="partner_menu.tech.power"></span><span class="info-colon info-power"></span><span class="info-value original-look info-power" id="tech-info-power"></span><span class="info-label info-mp" text-key="partner_menu.tech.mp"></span><span class="info-colon info-mp"></span><span class="info-value original-look info-mp" id="tech-info-mp"></span><span class="info-label info-range" text-key="partner_menu.tech.range"></span><span class="info-colon info-range"></span><span class="info-value original-look info-range" id="tech-info-range"></span><span class="info-label info-effect" text-key="partner_menu.tech.effect"></span><span class="info-colon info-effect"></span><span class="info-value original-look info-effect" id="tech-info-effect"></span></div></div><div id="tech-message"></div>
            </div>

			<div id="page-items" class="page hidden">
				<div id="bag-grid">
					<button id="slot-0" class="slot hidden" onclick="pick_slot(document, 0)"><img class="slot-icon hidden" id="slot-0-icon"/><span class="original-look slot-name" id="slot-0-name"></span><span class="original-look slot-count" id="slot-0-count"></span></button>
					<button id="slot-1" class="slot hidden" onclick="pick_slot(document, 1)"><img class="slot-icon hidden" id="slot-1-icon"/><span class="original-look slot-name" id="slot-1-name"></span><span class="original-look slot-count" id="slot-1-count"></span></button>
					<button id="slot-2" class="slot hidden" onclick="pick_slot(document, 2)"><img class="slot-icon hidden" id="slot-2-icon"/><span class="original-look slot-name" id="slot-2-name"></span><span class="original-look slot-count" id="slot-2-count"></span></button>
					<button id="slot-3" class="slot hidden" onclick="pick_slot(document, 3)"><img class="slot-icon hidden" id="slot-3-icon"/><span class="original-look slot-name" id="slot-3-name"></span><span class="original-look slot-count" id="slot-3-count"></span></button>
					<button id="slot-4" class="slot hidden" onclick="pick_slot(document, 4)"><img class="slot-icon hidden" id="slot-4-icon"/><span class="original-look slot-name" id="slot-4-name"></span><span class="original-look slot-count" id="slot-4-count"></span></button>
					<button id="slot-5" class="slot hidden" onclick="pick_slot(document, 5)"><img class="slot-icon hidden" id="slot-5-icon"/><span class="original-look slot-name" id="slot-5-name"></span><span class="original-look slot-count" id="slot-5-count"></span></button>
					<button id="slot-6" class="slot hidden" onclick="pick_slot(document, 6)"><img class="slot-icon hidden" id="slot-6-icon"/><span class="original-look slot-name" id="slot-6-name"></span><span class="original-look slot-count" id="slot-6-count"></span></button>
					<button id="slot-7" class="slot hidden" onclick="pick_slot(document, 7)"><img class="slot-icon hidden" id="slot-7-icon"/><span class="original-look slot-name" id="slot-7-name"></span><span class="original-look slot-count" id="slot-7-count"></span></button>
					<button id="slot-8" class="slot hidden" onclick="pick_slot(document, 8)"><img class="slot-icon hidden" id="slot-8-icon"/><span class="original-look slot-name" id="slot-8-name"></span><span class="original-look slot-count" id="slot-8-count"></span></button>
					<button id="slot-9" class="slot hidden" onclick="pick_slot(document, 9)"><img class="slot-icon hidden" id="slot-9-icon"/><span class="original-look slot-name" id="slot-9-name"></span><span class="original-look slot-count" id="slot-9-count"></span></button>
					<button id="slot-10" class="slot hidden" onclick="pick_slot(document, 10)"><img class="slot-icon hidden" id="slot-10-icon"/><span class="original-look slot-name" id="slot-10-name"></span><span class="original-look slot-count" id="slot-10-count"></span></button>
					<button id="slot-11" class="slot hidden" onclick="pick_slot(document, 11)"><img class="slot-icon hidden" id="slot-11-icon"/><span class="original-look slot-name" id="slot-11-name"></span><span class="original-look slot-count" id="slot-11-count"></span></button>
					<button id="slot-12" class="slot hidden" onclick="pick_slot(document, 12)"><img class="slot-icon hidden" id="slot-12-icon"/><span class="original-look slot-name" id="slot-12-name"></span><span class="original-look slot-count" id="slot-12-count"></span></button>
