					<button id="slot-22" class="slot hidden" onclick="pick_slot(document, 22)"><img class="slot-icon hidden" id="slot-22-icon"/><span class="original-look slot-name" id="slot-22-name"></span><span class="original-look slot-count" id="slot-22-count"></span></button>
					<button id="slot-23" class="slot hidden" onclick="pick_slot(document, 23)"><img class="slot-icon hidden" id="slot-23-icon"/><span class="original-look slot-name" id="slot-23-name"></span><span class="original-look slot-count" id="slot-23-count"></span></button>
					<button id="slot-24" class="slot hidden" onclick="pick_slot(document, 24)"><img class="slot-icon hidden" id="slot-24-icon"/><span class="original-look slot-name" id="slot-24-name"></span><span class="original-look slot-count" id="slot-24-count"></span></button>
