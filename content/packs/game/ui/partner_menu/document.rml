					<button id="slot-19" class="slot hidden" onclick="pick_slot(document, 19)"><img class="slot-icon hidden" id="slot-19-icon"/><span class="original-look slot-name" id="slot-19-name"></span><span class="original-look slot-count" id="slot-19-count"></span></button>
					<button id="slot-20" class="slot hidden" onclick="pick_slot(document, 20)"><img class="slot-icon hidden" id="slot-20-icon"/><span class="original-look slot-name" id="slot-20-name"></span><span class="original-look slot-count" id="slot-20-count"></span></button>
