					<button id="slot-27" class="slot hidden" onclick="pick_slot(document, 27)"><img class="slot-icon hidden" id="slot-27-icon"/><span class="original-look slot-name" id="slot-27-name"></span><span class="original-look slot-count" id="slot-27-count"></span></button>
					<button id="slot-28" class="slot hidden" onclick="pick_slot(document, 28)"><img class="slot-icon hidden" id="slot-28-icon"/><span class="original-look slot-name" id="slot-28-name"></span><span class="original-look slot-count" id="slot-28-count"></span></button>
