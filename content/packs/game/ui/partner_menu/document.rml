<rml>
<head>
	<title>Partner menu</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<script src="../common/original_box.lua"></script>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="scrim">
		<div id="panel">
			<div id="tabs">
				<button id="tab-status" class="tab" onclick="open_page(document, 'status')"><span class="tab-edge tab-left"></span><span class="tab-edge tab-middle"></span><span class="tab-edge tab-right"></span><span class="tab-label" text-key="partner_menu.tab.status"></span></button>
				<button id="tab-tech" class="tab" onclick="open_page(document, 'tech')"><span class="tab-edge tab-left"></span><span class="tab-edge tab-middle"></span><span class="tab-edge tab-right"></span><span class="tab-label" text-key="partner_menu.tab.tech"></span></button>
                <button id="tab-items" class="tab" onclick="open_page(document, 'items')" text-key="partner_menu.tab.items"></button>
				<button id="tab-care" class="tab" onclick="open_page(document, 'care')" text-key="partner_menu.tab.care"></button>
				<button id="close" class="tab" onclick="close_menu()" text-key="common.back"></button>
			</div>

			<div id="page-status" class="page">
                <div id="partner-portrait-clip" class="original-look"><img id="partner-portrait" src="/runtime/partner-portrait"/></div>
                <div id="profile-heading" class="status-decoration" text-key="partner_menu.section.profile"></div>
                <div id="condition-heading" class="status-decoration" text-key="partner_menu.section.condition"></div>
                <div id="parameter-heading" class="status-decoration" text-key="partner_menu.section.parameter"></div>
                <div id="status-horizontal" class="status-decoration"><span class="separator-first"></span><span class="separator-light"></span><span class="separator-last"></span></div>
                <div id="status-vertical" class="status-decoration"><span class="separator-first"></span><span class="separator-light"></span><span class="separator-last"></span></div>
                <span id="status-name-label" class="status-decoration" text-key="partner_menu.name"></span>
                <span id="status-special-heading" class="profile-meta"></span><span id="status-type-heading" class="profile-meta"></span><span id="status-active-heading" class="profile-meta"></span>
                <div id="status-specials" class="profile-meta"><span id="status-special-0" class="status-special"></span><span id="status-special-1" class="status-special"></span><span id="status-special-2" class="status-special"></span></div>
                <span id="status-type" class="profile-meta"></span><span id="status-active" class="profile-meta original-look"></span>
				<div id="status-head">
					<span class="original-look" id="status-name"></span>
					<span class="original-look head-value" id="status-lives"></span>
				</div>
                <span id="status-life-label" class="status-native-life original-look"></span><div id="status-life-hearts" class="status-native-life"><span class="life-heart" id="life-heart-0"><span class="life-outline"></span><span class="life-fill" id="life-fill-0"></span></span><span class="life-heart" id="life-heart-1"><span class="life-outline"></span><span class="life-fill" id="life-fill-1"></span></span><span class="life-heart" id="life-heart-2"><span class="life-outline"></span><span class="life-fill" id="life-fill-2"></span></span></div>
				<div class="status-line" id="status-species-line"><span id="status-species-label" class="original-look" text-key="partner_menu.species"></span><span class="original-look line-value" id="status-species"></span></div>
				<div class="status-line" id="status-age-line"><span id="status-age-label" class="original-look" text-key="partner_menu.age"></span><span class="original-look line-value" id="status-age"></span></div>
				<div class="status-line" id="status-weight-line"><span id="status-weight-label" class="original-look" text-key="partner_menu.weight"></span><span class="original-look line-value" id="status-weight"></span></div>
				<div class="status-bars" id="status-parameters">
					<div class="bar-row pool"><span class="label original-look" id="pool-0-label"></span><div class="bar stat"><div class="fill" id="pool-0-fill"></div></div><span class="value original-look" id="pool-0"></span><span class="pool-max original-look" id="pool-0-max"></span></div>
					<div class="bar-row pool"><span class="label original-look" id="pool-1-label"></span><div class="bar stat"><div class="fill" id="pool-1-fill"></div></div><span class="value original-look" id="pool-1"></span><span class="pool-max original-look" id="pool-1-max"></span></div>
					<div class="bar-row"><span class="label original-look" id="stat-0-label"></span><div class="bar stat"><div class="fill" id="stat-0-fill"></div></div><span class="value original-look" id="stat-0"></span></div>
					<div class="bar-row"><span class="label original-look" id="stat-1-label"></span><div class="bar stat"><div class="fill" id="stat-1-fill"></div></div><span class="value original-look" id="stat-1"></span></div>
					<div class="bar-row"><span class="label original-look" id="stat-2-label"></span><div class="bar stat"><div class="fill" id="stat-2-fill"></div></div><span class="value original-look" id="stat-2"></span></div>
					<div class="bar-row"><span class="label original-look" id="stat-3-label"></span><div class="bar stat"><div class="fill" id="stat-3-fill"></div></div><span class="value original-look" id="stat-3"></span></div>
				</div>
				<div class="status-bars" id="status-condition">
					<div class="bar-row"><span class="label original-look" id="meter-0-label"></span><span class="status-native-happiness"></span><div class="bar meter"><div class="fill" id="meter-0-fill"></div><div class="fill high" id="meter-0-high"></div></div><span class="value original-look" id="meter-0"></span></div>
					<div class="bar-row"><span class="label original-look" id="meter-1-label"></span><div class="bar meter"><div class="fill" id="meter-1-fill"></div><div class="fill high" id="meter-1-high"></div></div><span class="value original-look" id="meter-1"></span></div>
					<div class="bar-row"><span class="label original-look" id="meter-2-label"></span><div class="bar meter"><div class="fill" id="meter-2-fill"></div><div class="fill high" id="meter-2-high"></div></div><span class="value original-look" id="meter-2"></span></div>
				</div>
				<div id="conditions"><span class="condition original-look hidden" id="condition-0"></span><span class="condition original-look hidden" id="condition-1"></span><span class="condition original-look hidden" id="condition-2"></span><span class="condition original-look hidden" id="condition-3"></span><span class="condition original-look hidden" id="condition-4"></span><span class="condition original-look hidden" id="condition-5"></span><span class="condition original-look hidden" id="condition-6"></span><span class="original-look" id="no-condition" text-key="partner_menu.condition.none"></span></div>
			</div>

            <div id="page-tech" class="page hidden">
                <div id="techset-separator" class="tech-separator original-look"><span class="separator-first"></span><span class="separator-light"></span><span class="separator-last"></span></div>
                <div id="tech-final-separator" class="tech-separator original-look"><span class="separator-first"></span><span class="separator-light"></span><span class="separator-last"></span></div>
                <div id="tech-dots" class="original-look"><span class="tech-dot dot-power dot-row-0"></span><span class="tech-dot dot-mp dot-row-0"></span><span class="tech-dot dot-range dot-row-0"></span><span class="tech-dot dot-power dot-row-1"></span><span class="tech-dot dot-mp dot-row-1"></span><span class="tech-dot dot-range dot-row-1"></span><span class="tech-dot dot-power dot-row-2"></span><span class="tech-dot dot-mp dot-row-2"></span><span class="tech-dot dot-range dot-row-2"></span></div>
                <span id="tech-final-dot" class="tech-dot original-look"></span>
                <div id="techset-heading" class="tech-heading original-look" text-key="partner_menu.tech.set"></div>
                <div id="tech-columns" class="tech-columns original-look"><span class="tech-power" text-key="partner_menu.tech.power"></span><span class="tech-mp" text-key="partner_menu.tech.mp"></span><span class="tech-range" text-key="partner_menu.tech.range"></span><span class="tech-effect" text-key="partner_menu.tech.effect"></span></div>
<div id="tech-row-0" class="tech-row"><span id="tech-name-0" class="tech-name original-look"></span><span id="tech-power-0" class="tech-power original-look"></span><span id="tech-mp-0" class="tech-mp original-look"></span><span id="tech-range-0" class="tech-range original-look"></span><span id="tech-effect-0" class="tech-effect original-look"></span></div>
<div id="tech-row-1" class="tech-row"><span id="tech-name-1" class="tech-name original-look"></span><span id="tech-power-1" class="tech-power original-look"></span><span id="tech-mp-1" class="tech-mp original-look"></span><span id="tech-range-1" class="tech-range original-look"></span><span id="tech-effect-1" class="tech-effect original-look"></span></div>
<div id="tech-row-2" class="tech-row"><span id="tech-name-2" class="tech-name original-look"></span><span id="tech-power-2" class="tech-power original-look"></span><span id="tech-mp-2" class="tech-mp original-look"></span><span id="tech-range-2" class="tech-range original-look"></span><span id="tech-effect-2" class="tech-effect original-look"></span></div>

                <div id="final-heading" class="tech-heading original-look" text-key="partner_menu.tech.final"></div>
                <div id="final-columns" class="tech-columns original-look"><span class="tech-power" text-key="partner_menu.tech.power"></span><span class="tech-range" text-key="partner_menu.tech.range"></span><span class="tech-effect" text-key="partner_menu.tech.effect"></span></div>
<div id="tech-row-3" class="tech-row"><span id="tech-name-3" class="tech-name original-look"></span><span id="tech-power-3" class="tech-power original-look"></span><span id="tech-mp-3" class="tech-mp original-look"></span><span id="tech-range-3" class="tech-range original-look"></span><span id="tech-effect-3" class="tech-effect original-look"></span></div>
                <button id="tech-change" class="original-look" onclick="start_tech_edit(document)"><span id="tech-change-icon" class="tech-action-symbol"></span><span class="tech-action-label" text-key="partner_menu.tech.change"></span></button>
                <div id="tech-cancel" class="original-look"><span id="tech-cancel-icon" class="tech-action-symbol"></span><span class="tech-action-label" text-key="common.cancel"></span></div>
                <div id="tech-picker" class="hidden"><button id="tech-choice-0" class="tech-choice" onclick="toggle_technique(document, 0)"><span class="tech-cell" id="tech-cell-0"></span></button>
<button id="tech-choice-1" class="tech-choice" onclick="toggle_technique(document, 1)"><span class="tech-cell" id="tech-cell-1"></span></button>
<button id="tech-choice-2" class="tech-choice" onclick="toggle_technique(document, 2)"><span class="tech-cell" id="tech-cell-2"></span></button>
<button id="tech-choice-3" class="tech-choice" onclick="toggle_technique(document, 3)"><span class="tech-cell" id="tech-cell-3"></span></button>
<button id="tech-choice-4" class="tech-choice" onclick="toggle_technique(document, 4)"><span class="tech-cell" id="tech-cell-4"></span></button>
