<rml>
<head>
	<title>Discard menu</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="frame">
		<div id="window" class="original-box">
			<div class="label label-menu" text-key="list_labels.menu"></div><div class="label label-count" text-key="list_labels.count"></div>
			<div class="cursor" id="cursor"></div>
			<div class="row" id="row-0"><img class="icon hidden" id="icon-0"/><span class="name" id="name-0"></span><span class="count" id="count-0"></span></div><div class="row" id="row-1"><img class="icon hidden" id="icon-1"/><span class="name" id="name-1"></span><span class="count" id="count-1"></span></div><div class="row" id="row-2"><img class="icon hidden" id="icon-2"/><span class="name" id="name-2"></span><span class="count" id="count-2"></span></div><div class="row" id="row-3"><img class="icon hidden" id="icon-3"/><span class="name" id="name-3"></span><span class="count" id="count-3"></span></div><div class="row" id="row-4"><img class="icon hidden" id="icon-4"/><span class="name" id="name-4"></span><span class="count" id="count-4"></span></div><div class="row" id="row-5"><img class="icon hidden" id="icon-5"/><span class="name" id="name-5"></span><span class="count" id="count-5"></span></div>
			<div class="scrollbar"><div class="thumb" id="thumb"></div></div>
		</div>
		<div id="prompts">
			<span class="prompt"><span class="key" id="prompt-confirm"></span><span text-key="common.accept"></span></span>
			<span class="prompt" id="prompt-back"><span class="key" id="prompt-cancel"></span><span text-key="common.back"></span></span>
		</div>
		<div id="confirm" class="original-box original-look">
			<div id="question"></div>
			<div class="answer" id="yes"></div>
			<div class="answer" id="no"></div>
		</div>
		<div id="description" class="original-box original-look"><span id="description-text"></span></div>
	</div>
</body>
</rml>
