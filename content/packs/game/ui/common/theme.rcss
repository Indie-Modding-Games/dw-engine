/* Shared look of the game's documents. RmlUi has no default style sheet, so the basic layout of every element the
   documents use is declared here. Sizes are in dp: one dp is one pixel at 720 lines, scaled with the window and the
   player's UI scale option. */

body, div, h1, h2, p, button, img {
	display: block;
}

span {
	display: inline;
}

body {
	font-family: "Noto Sans";
	font-weight: normal;
	font-size: 18dp;
	color: #e8edf3;
	width: 100%;
	height: 100%;
	margin: 0;
}

.hidden {
	display: none;
}

/* A focusable entry of a menu. Focus is what the keyboard and the gamepad move and what confirm activates; the pointer
   moves it too, so there is only ever one highlighted entry. */
button {
	tab-index: auto;
	focus: auto;
	nav: auto;
	padding: 9dp 18dp;
	margin: 3dp 0;
	border-radius: 8dp;
	color: #c9d3de;
	background-color: transparent;
	transition: background-color color 0.12s cubic-out;
}

button:focus {
	background-color: #f0a73a;
	color: #1a1f27;
}

button:active {
	background-color: #ffc36b;
}

/* A button prompt: the name of the key or gamepad button that does something. */
.key {
	display: inline-block;
	min-width: 18dp;
	padding: 1dp 8dp;
	margin-right: 6dp;
	border-radius: 5dp;
	border: 1dp #c9d3de;
	font-weight: bold;
	font-size: 14dp;
	text-align: center;
	color: #e8edf3;
}

/* Text with the original's look (the map name, and others later): the original-look family draws with the original's
   bitmap font or a modern one, as the player's text_font setting picks (ui/fonts/original_look.yaml). The bitmap font
   grows in whole steps of its 11-pixel cells, so a size near a multiple of 11 px at 720 lines keeps its shape. Its
   ink takes this color: the font's own, color 1 of its CLUT (0x6B5A, font.c: drawString). */
.original-look {
	font-family: original-look;
	font-weight: normal;
	color: #d6d6d6;
}
