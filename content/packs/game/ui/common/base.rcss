/* What every document needs whatever the skin: RmlUi has no default style sheet, so the layout of every element the
   documents use is declared here, with the entries the keyboard and the gamepad move to and the class that hides
   what the scripts hide. The look is the skin's (ui/skins/<id>/, docs/architecture/ui.md#aspectos). */

body, div, h1, h2, p, button, img {
	display: block;
}

span {
	display: inline;
}

body {
	width: 100%;
	height: 100%;
	margin: 0;
}

.hidden {
	display: none;
}

/* A focusable entry of a menu. Focus is what the keyboard and the gamepad move and what confirm activates; the pointer
   moves it too, so there is only ever one highlighted entry. */
button {
	tab-index: auto;
	focus: auto;
	nav: auto;
}

/* Text with the original's look (the map name, and others later): the original-look family draws with the original's
   bitmap font or a modern one, as the player's text_font setting picks (ui/fonts/original_look.yaml). The bitmap font
   grows in whole steps of its 11-pixel cells, so a size near a multiple of 11 px at 720 lines keeps its shape. Its
   ink takes this color: the font's own, color 1 of its CLUT (0x6B5A, font.c: drawString). */
.original-look {
	font-family: original-look;
	font-weight: normal;
	color: #d6d6d6;
}
