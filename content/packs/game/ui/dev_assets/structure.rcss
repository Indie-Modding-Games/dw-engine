/* The banner of the dev assets (--dev-assets): over every other document while they are in use, and never in the way
   of the pointer. It is a developer's warning, not part of the game's look, so it is the same with every skin. */

body {
	pointer-events: none;
	z-index: 1000;
}

#dev-assets-banner {
	position: absolute;
	left: 50%;
	top: 8dp;
	width: 460dp;
	margin-left: -230dp;
	padding: 6dp 12dp;
	border-radius: 8dp;
	background-color: #8a1c1cd9;
	border: 1dp #e26a6a;
	color: #ffffff;
	font-size: 16dp;
	text-align: center;
}
