/* The save indicator (an engine improvement, apps/game/src/save_indicator.hpp): a small figure running back and
   forth in a strip next to "Saving" in the bottom right corner while the game saves. The game keeps this document shown for the whole game,
   transparent between saves, and moves the indicator up from its corner (margin-bottom) when a window is there; it
   never takes the pointer or the focus. */

body {
	pointer-events: none;
	z-index: 900;
}

#indicator {
	position: absolute;
	right: 24dp;
	bottom: 24dp;
	display: flex;
	align-items: center;
	padding: 2dp 12dp 2dp 6dp;
	border-radius: 8dp;
	background-color: #101820c0;
	color: #ffffff;
	font-size: 20dp;
	opacity: 0;
}

/* The strip the figure runs in (SaveFigure's texture, three times as wide as tall): the figure whole, a little
   taller than the text's capitals. */
#figure {
	width: 72dp;
	height: 24dp;
	margin-right: 6dp;
}

#label {
	white-space: nowrap;
}
