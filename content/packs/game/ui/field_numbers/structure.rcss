/* The numbers over the partner on the field (apps/game/src/field_numbers.hpp): the damage a story script deals
   (script_interp.c: deal_damage, addEntityText), drawn as the battle draws its numbers; each skin styles the digits
   with its battle style (.dn, .dd, .di). The document never takes the pointer or the focus. */

body {
	pointer-events: none;
}

#damage {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}
