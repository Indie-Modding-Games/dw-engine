<rml>
<head>
	<title>Naming box</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="panel">
		<p id="title" text-key="naming.title"></p>
		<p id="whose"></p>
		<div id="buttons">
			<span class="button" id="button-back" text-key="naming.back"></span>
			<span class="button" id="button-ok" text-key="naming.ok"></span>
		</div>
		<div id="grid">
			<div class="grid-row" id="row-0"><span class="cell" id="cell-0-0"></span><span class="cell" id="cell-0-1"></span><span class="cell" id="cell-0-2"></span><span class="cell" id="cell-0-3"></span><span class="cell" id="cell-0-4"></span><span class="cell" id="cell-0-5"></span><span class="cell" id="cell-0-6"></span><span class="cell" id="cell-0-7"></span><span class="cell" id="cell-0-8"></span><span class="cell" id="cell-0-9"></span></div>
			<div class="grid-row" id="row-1"><span class="cell" id="cell-1-0"></span><span class="cell" id="cell-1-1"></span><span class="cell" id="cell-1-2"></span><span class="cell" id="cell-1-3"></span><span class="cell" id="cell-1-4"></span><span class="cell" id="cell-1-5"></span><span class="cell" id="cell-1-6"></span><span class="cell" id="cell-1-7"></span><span class="cell" id="cell-1-8"></span><span class="cell" id="cell-1-9"></span></div>
			<div class="grid-row" id="row-2"><span class="cell" id="cell-2-0"></span><span class="cell" id="cell-2-1"></span><span class="cell" id="cell-2-2"></span><span class="cell" id="cell-2-3"></span><span class="cell" id="cell-2-4"></span><span class="cell" id="cell-2-5"></span><span class="cell" id="cell-2-6"></span><span class="cell" id="cell-2-7"></span><span class="cell" id="cell-2-8"></span><span class="cell" id="cell-2-9"></span></div>
			<div class="grid-row" id="row-3"><span class="cell" id="cell-3-0"></span><span class="cell" id="cell-3-1"></span><span class="cell" id="cell-3-2"></span><span class="cell" id="cell-3-3"></span><span class="cell" id="cell-3-4"></span><span class="cell" id="cell-3-5"></span><span class="cell" id="cell-3-6"></span><span class="cell" id="cell-3-7"></span><span class="cell" id="cell-3-8"></span><span class="cell" id="cell-3-9"></span></div>
			<div class="grid-row" id="row-4"><span class="cell" id="cell-4-0"></span><span class="cell" id="cell-4-1"></span><span class="cell" id="cell-4-2"></span><span class="cell" id="cell-4-3"></span><span class="cell" id="cell-4-4"></span><span class="cell" id="cell-4-5"></span><span class="cell" id="cell-4-6"></span><span class="cell" id="cell-4-7"></span><span class="cell" id="cell-4-8"></span><span class="cell" id="cell-4-9"></span></div>
			<div class="grid-row" id="row-5"><span class="cell" id="cell-5-0"></span><span class="cell" id="cell-5-1"></span><span class="cell" id="cell-5-2"></span><span class="cell" id="cell-5-3"></span><span class="cell" id="cell-5-4"></span><span class="cell" id="cell-5-5"></span><span class="cell" id="cell-5-6"></span><span class="cell" id="cell-5-7"></span><span class="cell" id="cell-5-8"></span><span class="cell" id="cell-5-9"></span></div>
			<div class="grid-row" id="row-6"><span class="cell" id="cell-6-0"></span><span class="cell" id="cell-6-1"></span><span class="cell" id="cell-6-2"></span><span class="cell" id="cell-6-3"></span><span class="cell" id="cell-6-4"></span><span class="cell" id="cell-6-5"></span><span class="cell" id="cell-6-6"></span><span class="cell" id="cell-6-7"></span><span class="cell" id="cell-6-8"></span><span class="cell" id="cell-6-9"></span></div>
			<div class="grid-row" id="row-7"><span class="cell" id="cell-7-0"></span><span class="cell" id="cell-7-1"></span><span class="cell" id="cell-7-2"></span><span class="cell" id="cell-7-3"></span><span class="cell" id="cell-7-4"></span><span class="cell" id="cell-7-5"></span><span class="cell" id="cell-7-6"></span><span class="cell" id="cell-7-7"></span><span class="cell" id="cell-7-8"></span><span class="cell" id="cell-7-9"></span></div>
			<div class="grid-row" id="row-8"><span class="cell" id="cell-8-0"></span><span class="cell" id="cell-8-1"></span><span class="cell" id="cell-8-2"></span><span class="cell" id="cell-8-3"></span><span class="cell" id="cell-8-4"></span><span class="cell" id="cell-8-5"></span><span class="cell" id="cell-8-6"></span><span class="cell" id="cell-8-7"></span><span class="cell" id="cell-8-8"></span><span class="cell" id="cell-8-9"></span></div>
		</div>
		<div id="prompts">
			<span class="prompt"><span class="key" id="prompt-confirm"></span><span text-key="naming.write"></span></span>
			<span class="prompt"><span class="key" id="prompt-cancel"></span><span text-key="naming.back"></span></span>
			<span class="prompt"><span class="key" id="prompt-menu"></span><span text-key="common.accept"></span></span>
			<span class="prompt"><span class="key" id="prompt-extra"></span><span text-key="naming.clear"></span></span>
		</div>
	</div>
	<div id="name-box">
		<div id="name"><span class="letter" id="letter-0"></span><span class="letter" id="letter-1"></span><span class="letter" id="letter-2"></span><span class="letter" id="letter-3"></span><span class="letter" id="letter-4"></span><span class="letter" id="letter-5"></span><span class="letter" id="letter-6"></span><span class="letter" id="letter-7"></span></div>
		<p id="typing" class="prompt" text-key="naming.typing"></p>
	</div>
</body>
</rml>
