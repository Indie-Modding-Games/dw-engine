/* The story's textboxes (packages/game/story: Dialogue). One pixel of the original is 3dp (240 lines over 720 dp).

   The speech box: 21 columns and 4 rows of 12 x 13 pixels, from x 30 to 292 and y 162 to 221 of the original's
   320 x 240 screen (script_textbox.c: setupDialogueBox, x -130 from the screen's centre: one pixel right of centred),
   with the 4:3 screen centred on a wide one. A sized box (set_textbox_size) is centred on the screen; the script sets
   its size. The text colours are the font's CLUT (font.c: FONT_CLUT, colour N of a {color:N} tag). */

body {
	width: 100%;
	height: 100%;
	pointer-events: none;
}

#box {
	position: absolute;
	left: 50%;
	top: 486dp;
	width: 786dp;
	height: 177dp;
	margin-left: -390dp;
	padding: 6dp 15dp;
	box-sizing: border-box;
	background-color: #000000c0;
	border: 3dp #d0d0d0;
	font-size: 33dp;
	line-height: 39dp;
}

#box.sized {
	top: 50%;
}

/* The opening's questions put the speech box at the top, from y 42 to 101 (script_menu.c:
   setupNewGameDialogueBox). */
#box.top {
	top: 126dp;
}

.row {
	display: block;
	height: 39dp;
	white-space: pre;
}

.cursor {
	display: inline-block;
	width: 0dp;
}

/* The original look's selection bar (a skin shows it on .row.barred); the script sets its width. */
.bar {
	display: none;
}

.row.selected .cursor {
	width: 18dp;
	height: 18dp;
	margin-right: 6dp;
	background-color: #f8f800;
}

/* The confirm button the box shows while it waits, and the notices' one (#confirm-icon): the glyph of the device in
   use (element:set_prompt("confirm", true), ../common/base.rcss), here as a small badge in the box's bottom right
   corner that breathes slowly. The original look draws its own (skins/original/story_textbox/style.rcss). */
.prompt-icon {
	position: absolute;
	right: 12dp;
	bottom: 6dp;
	min-width: 14dp;
	padding: 0 6dp;
	border: 1dp #8a96a8;
	border-radius: 5dp;
	background-color: #1a1f27c0;
	font-family: "Noto Sans";
	font-size: 14dp;
	font-weight: bold;
	line-height: 22dp;
	color: #e8edf3;
	text-align: center;
	animation: 0.9s sine-in-out infinite alternate prompt-icon-breathe;
}

.prompt-icon.glyph-face {
	padding: 0 4dp;
	border-radius: 11dp;
}

.prompt-icon.glyph-none {
	display: none;
}

@keyframes prompt-icon-breathe {
	from { opacity: 1; }
	to { opacity: 0.55; }
}

/* A glyph in a run (element:set_prompt_text) takes the run's colour, as the original's button characters do. */
.color-0, .color-0 .key { color: #000000; }
.color-1, .color-1 .key { color: #d0d0d0; }
.color-2, .color-2 .key { color: #0000f8; }
.color-3, .color-3 .key { color: #e03028; }
.color-4, .color-4 .key { color: #f898d0; }
.color-5, .color-5 .key { color: #98d890; }
.color-6, .color-6 .key { color: #90a8f8; }
.color-7, .color-7 .key { color: #f8f800; }
.color-8, .color-8 .key { color: #000008; }
.color-9, .color-9 .key { color: #808080; }
.color-10, .color-10 .key { color: #e08858; }
