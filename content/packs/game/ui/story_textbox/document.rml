<rml>
<head>
	<title>Story textbox</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="../common/fit_text.lua"></script>
	<script src="../common/screen_fit.lua"></script>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="box" class="original-look">
		<div id="rows">
			<div class="row" id="row-0"><span class="bar" id="row-0-bar"></span><span class="cursor" id="row-0-cursor"></span><span class="run" id="row-0-run-0"></span><span class="run" id="row-0-run-1"></span><span class="run" id="row-0-run-2"></span><span class="run" id="row-0-run-3"></span><span class="run" id="row-0-run-4"></span><span class="run" id="row-0-run-5"></span><span class="run" id="row-0-run-6"></span><span class="run" id="row-0-run-7"></span></div>
			<div class="row" id="row-1"><span class="bar" id="row-1-bar"></span><span class="cursor" id="row-1-cursor"></span><span class="run" id="row-1-run-0"></span><span class="run" id="row-1-run-1"></span><span class="run" id="row-1-run-2"></span><span class="run" id="row-1-run-3"></span><span class="run" id="row-1-run-4"></span><span class="run" id="row-1-run-5"></span><span class="run" id="row-1-run-6"></span><span class="run" id="row-1-run-7"></span></div>
			<div class="row" id="row-2"><span class="bar" id="row-2-bar"></span><span class="cursor" id="row-2-cursor"></span><span class="run" id="row-2-run-0"></span><span class="run" id="row-2-run-1"></span><span class="run" id="row-2-run-2"></span><span class="run" id="row-2-run-3"></span><span class="run" id="row-2-run-4"></span><span class="run" id="row-2-run-5"></span><span class="run" id="row-2-run-6"></span><span class="run" id="row-2-run-7"></span></div>
			<div class="row" id="row-3"><span class="bar" id="row-3-bar"></span><span class="cursor" id="row-3-cursor"></span><span class="run" id="row-3-run-0"></span><span class="run" id="row-3-run-1"></span><span class="run" id="row-3-run-2"></span><span class="run" id="row-3-run-3"></span><span class="run" id="row-3-run-4"></span><span class="run" id="row-3-run-5"></span><span class="run" id="row-3-run-6"></span><span class="run" id="row-3-run-7"></span></div>
			<div class="row" id="row-4"><span class="bar" id="row-4-bar"></span><span class="cursor" id="row-4-cursor"></span><span class="run" id="row-4-run-0"></span><span class="run" id="row-4-run-1"></span><span class="run" id="row-4-run-2"></span><span class="run" id="row-4-run-3"></span><span class="run" id="row-4-run-4"></span><span class="run" id="row-4-run-5"></span><span class="run" id="row-4-run-6"></span><span class="run" id="row-4-run-7"></span></div>
			<div class="row" id="row-5"><span class="bar" id="row-5-bar"></span><span class="cursor" id="row-5-cursor"></span><span class="run" id="row-5-run-0"></span><span class="run" id="row-5-run-1"></span><span class="run" id="row-5-run-2"></span><span class="run" id="row-5-run-3"></span><span class="run" id="row-5-run-4"></span><span class="run" id="row-5-run-5"></span><span class="run" id="row-5-run-6"></span><span class="run" id="row-5-run-7"></span></div>
			<div class="row" id="row-6"><span class="bar" id="row-6-bar"></span><span class="cursor" id="row-6-cursor"></span><span class="run" id="row-6-run-0"></span><span class="run" id="row-6-run-1"></span><span class="run" id="row-6-run-2"></span><span class="run" id="row-6-run-3"></span><span class="run" id="row-6-run-4"></span><span class="run" id="row-6-run-5"></span><span class="run" id="row-6-run-6"></span><span class="run" id="row-6-run-7"></span></div>
			<div class="row" id="row-7"><span class="bar" id="row-7-bar"></span><span class="cursor" id="row-7-cursor"></span><span class="run" id="row-7-run-0"></span><span class="run" id="row-7-run-1"></span><span class="run" id="row-7-run-2"></span><span class="run" id="row-7-run-3"></span><span class="run" id="row-7-run-4"></span><span class="run" id="row-7-run-5"></span><span class="run" id="row-7-run-6"></span><span class="run" id="row-7-run-7"></span></div>
			<div class="row" id="row-8"><span class="bar" id="row-8-bar"></span><span class="cursor" id="row-8-cursor"></span><span class="run" id="row-8-run-0"></span><span class="run" id="row-8-run-1"></span><span class="run" id="row-8-run-2"></span><span class="run" id="row-8-run-3"></span><span class="run" id="row-8-run-4"></span><span class="run" id="row-8-run-5"></span><span class="run" id="row-8-run-6"></span><span class="run" id="row-8-run-7"></span></div>
			<div class="row" id="row-9"><span class="bar" id="row-9-bar"></span><span class="cursor" id="row-9-cursor"></span><span class="run" id="row-9-run-0"></span><span class="run" id="row-9-run-1"></span><span class="run" id="row-9-run-2"></span><span class="run" id="row-9-run-3"></span><span class="run" id="row-9-run-4"></span><span class="run" id="row-9-run-5"></span><span class="run" id="row-9-run-6"></span><span class="run" id="row-9-run-7"></span></div>
			<div class="row" id="row-10"><span class="bar" id="row-10-bar"></span><span class="cursor" id="row-10-cursor"></span><span class="run" id="row-10-run-0"></span><span class="run" id="row-10-run-1"></span><span class="run" id="row-10-run-2"></span><span class="run" id="row-10-run-3"></span><span class="run" id="row-10-run-4"></span><span class="run" id="row-10-run-5"></span><span class="run" id="row-10-run-6"></span><span class="run" id="row-10-run-7"></span></div>
			<div class="row" id="row-11"><span class="bar" id="row-11-bar"></span><span class="cursor" id="row-11-cursor"></span><span class="run" id="row-11-run-0"></span><span class="run" id="row-11-run-1"></span><span class="run" id="row-11-run-2"></span><span class="run" id="row-11-run-3"></span><span class="run" id="row-11-run-4"></span><span class="run" id="row-11-run-5"></span><span class="run" id="row-11-run-6"></span><span class="run" id="row-11-run-7"></span></div>
		</div>
		<div id="prompt" class="prompt-icon hidden"></div>
	</div>
</body>
</rml>
