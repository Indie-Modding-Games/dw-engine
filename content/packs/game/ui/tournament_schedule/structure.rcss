/* The registration at the arena's counter (dget/dget.c). One pixel of the original is 3dp; the 320 x 240 screen is a
   960 x 720dp frame centred on a wide screen. From the decomp, boxes placed from the screen's centre:
   - the title (buildScheduleLabels): (-54, -98), 108 x 20, its text at (6, 3);
   - the schedule (buildScheduleEntries, renderTournamentSchedule): (-130, -62), 260 x 124; column lines at x 52 + 51n
     (y 2 to 21 and 22 to 122), the header line at y 20 from x 3, 254 long; the days at x 16 + 51n, y 5; the grades at
     x 24 + 51n, y 27 + 16n; the cursor 42 x 13 at x 7 + 51n, y 25 + 16n;
   - a cup's text (initTournamentInfo): 252 x 99 at (-126, -49) over the schedule, at (-126, -79) once a cup is picked;
     seven rows 13 pixels apart from (6, 3);
   - the question and the choice: the story's speech box.
   The skins give the look; this is the layout and a plain look for any skin. */

body {
	width: 100%;
	height: 100%;
}

#frame {
	position: absolute;
	left: 50%;
	top: 0;
	width: 960dp;
	height: 720dp;
	margin-left: -480dp;
	font-size: 33dp;
	line-height: 39dp;
}

#title, #grid, #info, #talk {
	position: absolute;
	box-sizing: border-box;
	border: 3dp #d0d0d0;
	background-color: #000000c0;
	display: none;
}

/* The original's box is 108 pixels wide (318dp from 324dp); this font is wider, so the box keeps its centre and
   height and grows to hold the title (an adaptation). */
#title { left: 210dp; top: 66dp; width: 540dp; height: 60dp; }
#title-text { position: absolute; left: 0; top: 6dp; width: 100%; text-align: center; white-space: pre; }

#grid { left: 90dp; top: 174dp; width: 780dp; height: 372dp; }

/* The schedule from its opening until a cup is picked or it is closed (states 2 and 3). */
#frame.phase-schedule #title, #frame.phase-schedule #grid,
#frame.phase-peek #title, #frame.phase-peek #grid { display: block; }

.vline { position: absolute; width: 3dp; background-color: #d0d0d0; }
.vline-top { top: 3dp; height: 57dp; }
.vline-rows { top: 63dp; height: 300dp; }
#vline-top-0, #vline-rows-0 { left: 153dp; }
#vline-top-1, #vline-rows-1 { left: 306dp; }
#vline-top-2, #vline-rows-2 { left: 459dp; }
#vline-top-3, #vline-rows-3 { left: 612dp; }
#vline-top-4, #vline-rows-4 { left: 765dp; }
.hline { position: absolute; left: 6dp; top: 57dp; width: 762dp; height: 3dp; background-color: #d0d0d0; }

.cell-cursor {
	position: absolute;
	left: 21dp;
	top: 75dp;
	width: 126dp;
	height: 39dp;
	box-sizing: border-box;
	border-width: 3dp;
	border-color: #b0b0b0 #121212 #121212 #b0b0b0;
	background-color: #80808080;
}

.day, .cell { position: absolute; white-space: pre; }
.day { width: 60dp; top: 6dp; text-align: right; }
#day-0 { left: 39dp; }
#day-1 { left: 192dp; }
#day-2 { left: 345dp; }
#day-3 { left: 498dp; }
#day-4 { left: 651dp; }

/* buildScheduleEntries: colour 1 for a cup the partner may enter, 7 when it is too strong for it, 3 otherwise. */
.cell { width: 36dp; color: #d0d0d0; }
.cell.closed { color: #e03028; }
.cell.overlevel { color: #f8f800; }
#cell-0-0, #cell-0-1, #cell-0-2, #cell-0-3, #cell-0-4, #cell-0-5 { left: 63dp; }
#cell-1-0, #cell-1-1, #cell-1-2, #cell-1-3, #cell-1-4, #cell-1-5 { left: 216dp; }
#cell-2-0, #cell-2-1, #cell-2-2, #cell-2-3, #cell-2-4, #cell-2-5 { left: 369dp; }
#cell-3-0, #cell-3-1, #cell-3-2, #cell-3-3, #cell-3-4, #cell-3-5 { left: 522dp; }
#cell-4-0, #cell-4-1, #cell-4-2, #cell-4-3, #cell-4-4, #cell-4-5 { left: 675dp; }
#cell-0-0, #cell-1-0, #cell-2-0, #cell-3-0, #cell-4-0 { top: 72dp; }
#cell-0-1, #cell-1-1, #cell-2-1, #cell-3-1, #cell-4-1 { top: 120dp; }
#cell-0-2, #cell-1-2, #cell-2-2, #cell-3-2, #cell-4-2 { top: 168dp; }
#cell-0-3, #cell-1-3, #cell-2-3, #cell-3-3, #cell-4-3 { top: 216dp; }
#cell-0-4, #cell-1-4, #cell-2-4, #cell-3-4, #cell-4-4 { top: 264dp; }
#cell-0-5, #cell-1-5, #cell-2-5, #cell-3-5, #cell-4-5 { top: 312dp; }

/* A cup's text: over the schedule from the pause key (Start), at the top once a cup is picked. */
#info { left: 102dp; top: 213dp; width: 756dp; height: 297dp; padding: 9dp 18dp; }
#frame.phase-peek #info { display: block; }
#frame.phase-question #info, #frame.phase-choice #info { display: block; top: 123dp; }

/* The question and the choice in the story's speech box. */
#talk { left: 87dp; top: 486dp; width: 786dp; height: 177dp; padding: 6dp 15dp; }
#frame.phase-question #talk, #frame.phase-choice #talk { display: block; }

.text-row { display: block; height: 39dp; white-space: pre; }
.text-row.hidden { display: none; }
#info .text-row { height: 39dp; }
.text-row.selected .run { background-color: #80808080; }

.color-0 { color: #000000; }
.color-1 { color: #d0d0d0; }
.color-2 { color: #0000f8; }
.color-3 { color: #e03028; }
.color-4 { color: #f898d0; }
.color-5 { color: #98d890; }
.color-6 { color: #90a8f8; }
.color-7 { color: #f8f800; }
.color-8 { color: #000008; }
.color-9 { color: #808080; }
.color-10 { color: #e08858; }
