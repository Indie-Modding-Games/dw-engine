/* The end of the host's battle on a co-op guest's screen (apps/game/src/coop_battles.hpp): a box low in the middle
   with what the end waits on and, for the starter, the button that closes it. This is the plain look; a skin restyles
   it (skins/<skin>/coop_battle/style.rcss). Over the field, under the interface's own notices. */
body {
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: 100;
}

#panel {
	position: absolute;
	left: 30%;
	bottom: 16%;
	width: 40%;
	padding: 12dp 16dp;
	border: 3dp #c9d3de;
	border-radius: 8dp;
	background-color: #1a1f27e0;
	color: #f2f4f7;
	font-size: 18dp;
	text-align: center;
	pointer-events: auto;
}

#title {
	font-size: 20dp;
	margin-bottom: 4dp;
}

#phase {
	color: #aeb8c4;
	margin-bottom: 8dp;
}

#close {
	display: inline-block;
	margin-top: 4dp;
	padding: 4dp 16dp;
	border: 2dp #c9d3de;
	border-radius: 4dp;
}

#close:hover,
#close:focus {
	background-color: #3a4350;
}
