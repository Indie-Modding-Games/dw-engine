<rml>
<head>
	<title>Co-op battle</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="panel" class="hidden">
		<p id="title"></p>
		<p id="phase"></p>
		<div id="fighters">
			<div id="fighter-0" class="fighter hidden">
				<span id="fighter-0-name" class="name"></span>
				<div class="bar"><div id="fighter-0-fill" class="fill"></div></div>
				<span id="fighter-0-hp" class="hp"></span>
				<span id="fighter-0-mp" class="mp hidden"></span>
				<span id="fighter-0-revive" class="revive hidden"></span>
				<button id="fighter-0-target" class="target hidden" onclick="pick_target(0)"></button>
			</div>
			<div id="fighter-1" class="fighter hidden">
				<span id="fighter-1-name" class="name"></span>
				<div class="bar"><div id="fighter-1-fill" class="fill"></div></div>
				<span id="fighter-1-hp" class="hp"></span>
				<span id="fighter-1-mp" class="mp hidden"></span>
				<span id="fighter-1-revive" class="revive hidden"></span>
				<button id="fighter-1-target" class="target hidden" onclick="pick_target(1)"></button>
			</div>
			<div id="fighter-2" class="fighter hidden">
				<span id="fighter-2-name" class="name"></span>
				<div class="bar"><div id="fighter-2-fill" class="fill"></div></div>
				<span id="fighter-2-hp" class="hp"></span>
				<span id="fighter-2-mp" class="mp hidden"></span>
				<span id="fighter-2-revive" class="revive hidden"></span>
				<button id="fighter-2-target" class="target hidden" onclick="pick_target(2)"></button>
			</div>
			<div id="fighter-3" class="fighter hidden">
				<span id="fighter-3-name" class="name"></span>
				<div class="bar"><div id="fighter-3-fill" class="fill"></div></div>
				<span id="fighter-3-hp" class="hp"></span>
				<span id="fighter-3-mp" class="mp hidden"></span>
				<span id="fighter-3-revive" class="revive hidden"></span>
				<button id="fighter-3-target" class="target hidden" onclick="pick_target(3)"></button>
			</div>
			<div id="fighter-4" class="fighter hidden">
				<span id="fighter-4-name" class="name"></span>
				<div class="bar"><div id="fighter-4-fill" class="fill"></div></div>
				<span id="fighter-4-hp" class="hp"></span>
				<span id="fighter-4-mp" class="mp hidden"></span>
				<span id="fighter-4-revive" class="revive hidden"></span>
				<button id="fighter-4-target" class="target hidden" onclick="pick_target(4)"></button>
			</div>
			<div id="fighter-5" class="fighter hidden">
				<span id="fighter-5-name" class="name"></span>
				<div class="bar"><div id="fighter-5-fill" class="fill"></div></div>
				<span id="fighter-5-hp" class="hp"></span>
				<span id="fighter-5-mp" class="mp hidden"></span>
				<span id="fighter-5-revive" class="revive hidden"></span>
				<button id="fighter-5-target" class="target hidden" onclick="pick_target(5)"></button>
			</div>
			<div id="fighter-6" class="fighter hidden">
				<span id="fighter-6-name" class="name"></span>
				<div class="bar"><div id="fighter-6-fill" class="fill"></div></div>
				<span id="fighter-6-hp" class="hp"></span>
				<span id="fighter-6-mp" class="mp hidden"></span>
				<span id="fighter-6-revive" class="revive hidden"></span>
				<button id="fighter-6-target" class="target hidden" onclick="pick_target(6)"></button>
			</div>
		</div>
		<div id="orders">
			<button id="order-0" class="order hidden" onclick="order(0)"></button>
			<button id="order-1" class="order hidden" onclick="order(1)"></button>
			<button id="order-2" class="order hidden" onclick="order(2)"></button>
			<button id="order-3" class="order hidden" onclick="order(3)"></button>
			<button id="order-4" class="order hidden" onclick="order(4)"></button>
			<button id="order-5" class="order hidden" onclick="order(5)"></button>
			<button id="order-6" class="order hidden" onclick="order(6)"></button>
			<button id="order-7" class="order hidden" onclick="order(7)"></button>
			<button id="order-8" class="order hidden" onclick="order(8)"></button>
			<button id="order-9" class="order hidden" onclick="order(9)"></button>
			<button id="order-10" class="order hidden" onclick="order(10)"></button>
			<button id="order-11" class="order hidden" onclick="order(11)"></button>
		</div>
		<div id="help">
			<button id="cheer" onclick="cheer()"></button>
			<p id="items-title"></p>
			<button id="item-0" class="item hidden" onclick="throw_item(0)"></button>
			<button id="item-1" class="item hidden" onclick="throw_item(1)"></button>
			<button id="item-2" class="item hidden" onclick="throw_item(2)"></button>
			<button id="item-3" class="item hidden" onclick="throw_item(3)"></button>
			<button id="item-4" class="item hidden" onclick="throw_item(4)"></button>
			<button id="item-5" class="item hidden" onclick="throw_item(5)"></button>
			<button id="item-6" class="item hidden" onclick="throw_item(6)"></button>
			<button id="item-7" class="item hidden" onclick="throw_item(7)"></button>
			<p id="no-items" class="hidden"></p>
		</div>
		<button id="close" class="hidden" onclick="close_end()"></button>
	</div>
</body>
</rml>
