/* The online versus (apps/game/src/versus_screen.cpp): the pause menu's panel with one view at a time. The bars and the
   command strip are this document's own; the skins give the panel, the buttons and the texts. */

#panel { width: 760dp; }
.view { display: block; }
.view.hidden { display: none; }
.label { margin-top: 10dp; }
.entry { margin: 4dp 0 4dp 18dp; font-size: 26dp; white-space: pre-line; }
.entry.code { font-size: 44dp; letter-spacing: 8dp; }
.warning { color: #ffb070; }
.about { margin: 10dp 0 0 0; font-size: 18dp; }
.row { display: block; }

#match-top { text-align: center; font-size: 20dp; }
.fighter { display: block; margin: 4dp 0; }
.fighter-name { margin-bottom: 2dp; font-size: 20dp; }
.bar { display: block; height: 10dp; margin: 2dp 0; background-color: #00000080; border: 1dp #d0d0d0; }
.bar.thin { height: 4dp; }
.fill { display: block; height: 100%; width: 0%; }
.fill.hp { background-color: #50d060; }
.fill.mp { background-color: #5080e0; }
.fill.finisher { background-color: #e0c040; }
.numbers { font-size: 16dp; }
#commands { display: block; margin: 6dp 0; }
.command { display: inline-block; width: auto; margin: 2dp 6dp 2dp 0; padding: 1dp 6dp; font-size: 20dp; }
.command.current { text-decoration: underline; }
.log { font-size: 15dp; margin: 0; }

/* A battle on its arena (apps/game/src/versus_arena.hpp), laid out as the original's versus screen (vs_hud.c), in its
   pixels at 3dp each: each side's bars, finisher letters, command name and strip, and the clock between them. Each
   side keeps to its edge of a wide window at the original's distance (as the story battle's panels); the clock stays in
   the middle. The original skin draws the pieces with the original's sprites (ui/skins/original/versus/style.rcss);
   here they are plain shapes. Like the story battle, the screen lines are the decompilation's less 6. */
#scrim.hidden, #hud.hidden, #intro.hidden, #score.hidden, .hidden { display: none; }

#hud, #intro, #score {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

/* VS_renderFighterStatusBars: the 104 x 8 frames from x 20 (1P) and 196 (2P), y 20 and 32. */
.vs-side {
	position: absolute;
	top: 0;
	width: 312dp;
	height: 100%;
}

.side-0 { left: 60dp; }
.side-1 { right: 60dp; }

.vs-bar {
	position: absolute;
	left: 0;
	width: 312dp;
	height: 24dp;
}

.vs-bar.hp { top: 42dp; }
.vs-bar.mp { top: 78dp; }

/* The icon at the frame's (4, -2), the fill from (18, 3), 50 pixels at most and 2 tall, and the four digits up to the
   frame's x 99. */
.vs-icon {
	position: absolute;
	left: 12dp;
	top: -6dp;
	width: 33dp;
	height: 33dp;
}

.vs-gauge {
	position: absolute;
	left: 54dp;
	top: 9dp;
	width: 150dp;
	height: 6dp;
	background-color: #00000080;
}

.vs-fill {
	height: 3dp;
	width: 0;
}

.hp .vs-fill { border-top: 3dp #f8d8c8; background-color: #d04848; }
.mp .vs-fill { border-top: 3dp #c8e0f0; background-color: #0068b8; }

.vs-value {
	position: absolute;
	left: 219dp;
	top: 0;
	width: 84dp;
	height: 24dp;
}

.vs-value-text {
	display: block;
	width: 78dp;
	font-size: 24dp;
	line-height: 24dp;
	text-align: right;
	color: #d0d0d0;
}

/* The value as the original's digit sprites, for the skins that have them (skins/original/versus). */
.vs-digit { display: none; }

/* VS_renderHPBarDigits: "FINISH!!" from the frame's x -1, y 41 (35 here): one letter per sixth of the gauge. */
.vs-finish {
	position: absolute;
	left: -3dp;
	top: 105dp;
	width: 150dp;
	height: 45dp;
}

.vs-word {
	position: absolute;
	left: 0;
	top: 0;
	height: 45dp;
	line-height: 45dp;
	font-size: 33dp;
	white-space: nowrap;
	color: #f8c800;
}

.vs-seg {
	position: absolute;
	top: 0;
	height: 45dp;
}

.seg-0 { left: 0dp; width: 18dp; }
.seg-1 { left: 18dp; width: 12dp; }
.seg-2 { left: 30dp; width: 24dp; }
.seg-3 { left: 54dp; width: 12dp; }
.seg-4 { left: 66dp; width: 24dp; }
.seg-5 { left: 90dp; width: 24dp; }
.seg-6 { left: 114dp; width: 15dp; }
.seg-7 { left: 129dp; width: 15dp; }

/* The "PUSH" box once the gauge is full: 41 x 11 at x 72 (1P) and 268 (2P), y 44 (38 here), at half opacity; the
   word 2 pixels in. The local side's box shows the finisher's key where the original's sprite has the pad's square
   button (a documented delta, as the story battle's). */
.vs-push {
	position: absolute;
	top: 114dp;
	min-width: 111dp;
	height: 27dp;
	padding: 3dp 6dp;
	white-space: nowrap;
	text-align: right;
	background-color: #80808080;
}

.side-0 .vs-push { left: 156dp; }
.side-1 .vs-push { left: 216dp; }

.vs-push .key {
	display: inline-block;
	vertical-align: top;
	min-width: 15dp;
	height: 21dp;
	line-height: 21dp;
	padding: 0 3dp;
	margin-right: 3dp;
	text-align: center;
}

.vs-push .key.hidden { display: none; }

.vs-push-word {
	display: inline-block;
	vertical-align: top;
	min-width: 81dp;
	height: 27dp;
	line-height: 27dp;
	font-size: 22dp;
	color: #f8a800;
}

/* VS_renderMoveName: the hovered command's name at x 20 (1P) and 180 (2P), y 174 (168 here). */
.vs-name {
	position: absolute;
	top: 504dp;
	width: 600dp;
	margin: 0;
	font-size: 33dp;
	color: #d0d0d0;
	white-space: nowrap;
}

.side-0 .vs-name { left: 0; }
.side-1 .vs-name { left: -48dp; }

/* VS_renderCommandMenu: the story battle's strip at the foot of the screen, its frame's top at y 188 (182 here), from
   x 17 (1P) and 183 (2P): the last command's icon first, each one 14 pixels on and every other one 10 lower; the
   hovered one under the 22 x 22 cursor, 3 up and left of it. The frame's pieces run at half opacity, one per
   command. */
.vs-strip {
	position: absolute;
	left: 0;
	top: 546dp;
	width: 600dp;
	height: 93dp;
}

.side-1 .vs-strip { left: -30dp; }

.vs-frame {
	position: absolute;
	top: 0;
	width: 42dp;
	height: 93dp;
	opacity: 0.5;
	background-color: #303848;
}

.vs-frame.frame-left, .vs-frame.frame-right-odd, .vs-frame.frame-right-even { width: 33dp; }

.vs-frame.piece-0 { left: -9dp; }
.vs-frame.piece-1 { left: 24dp; }
.vs-frame.piece-2 { left: 66dp; }
.vs-frame.piece-3 { left: 108dp; }
.vs-frame.piece-4 { left: 150dp; }
.vs-frame.piece-5 { left: 192dp; }
.vs-frame.piece-6 { left: 234dp; }
.vs-frame.piece-7 { left: 276dp; }
.vs-frame.piece-8 { left: 318dp; }
.vs-frame.piece-9 { left: 360dp; }
.vs-frame.piece-10 { left: 402dp; }

.vs-cmd {
	position: absolute;
	top: 0;
	width: 42dp;
	height: 66dp;
}

.vs-cmd.down { top: 30dp; }

.vs-cmd.place-0 { left: 3dp; }
.vs-cmd.place-1 { left: 45dp; }
.vs-cmd.place-2 { left: 87dp; }
.vs-cmd.place-3 { left: 129dp; }
.vs-cmd.place-4 { left: 171dp; }
.vs-cmd.place-5 { left: 213dp; }
.vs-cmd.place-6 { left: 255dp; }
.vs-cmd.place-7 { left: 297dp; }
.vs-cmd.place-8 { left: 339dp; }
.vs-cmd.place-9 { left: 381dp; }
.vs-cmd.place-10 { left: 423dp; }

.vs-cursor {
	position: absolute;
	top: 0;
	width: 66dp;
	height: 66dp;
	border: 3dp #f8d800;
}

.vs-cursor.down { top: 30dp; }

.vs-cursor.place-0 { left: -9dp; }
.vs-cursor.place-1 { left: 33dp; }
.vs-cursor.place-2 { left: 75dp; }
.vs-cursor.place-3 { left: 117dp; }
.vs-cursor.place-4 { left: 159dp; }
.vs-cursor.place-5 { left: 201dp; }
.vs-cursor.place-6 { left: 243dp; }
.vs-cursor.place-7 { left: 285dp; }
.vs-cursor.place-8 { left: 327dp; }
.vs-cursor.place-9 { left: 369dp; }
.vs-cursor.place-10 { left: 411dp; }

/* Without the original's sprites each command is a small square in its technique's or order's colour. */
.vs-cmd { background-color: #c0c0c080; }

/* The clock (the STD clock: TIME.TIM's panel and STDTIM's digits) between the bars, its 1P and 2P pieces at its
   sides. */
#vs-clock {
	position: absolute;
	left: 50%;
	top: 48dp;
	width: 198dp;
	height: 87dp;
	margin-left: -99dp;
	background-color: #200808c0;
}

.vs-clock-side {
	position: absolute;
	top: 15dp;
	width: 24dp;
	height: 54dp;
}

#vs-clock-side-0 { left: 15dp; }
#vs-clock-side-1 { left: 159dp; }

.vs-clock-digit {
	position: absolute;
	top: 21dp;
	width: 36dp;
	height: 45dp;
	font-size: 42dp;
	line-height: 45dp;
	text-align: center;
	color: #f04030;
}

#vs-clock-d-0 { left: 60dp; }
#vs-clock-d-1 { left: 102dp; }

/* While the banner shows the HUD is there without the cursor or the name (as the story battle's). */
.vs-warning {
	position: absolute;
	top: 45%;
	left: 0;
	width: 100%;
	text-align: center;
	color: #ffb070;
}

/* ------------------------------------------------------------------------------------------------------------------
   The "BATTLE" banner (the story battle's pieces, packages/screens: battle_intro.hpp): each piece sits at the banner's
   corner and moves by its transform. */
#banner {
	position: absolute;
	left: 50%;
	top: 0;
	width: 960dp;
	height: 720dp;
	margin-left: -480dp;
}

.bp, .bs {
	position: absolute;
	left: 0;
	top: 0;
}

.bp { background-color: #c03838; }
.bs { background-color: #000000; }

.bt {
	position: absolute;
	top: 0;
	height: 100%;
	background-color: #c0383880;
}

/* ------------------------------------------------------------------------------------------------------------------
   The score screen (vs_scene.c: VS_renderVersusIntro), in the original's screen pixels from the middle 320 x 240:
   two panels, 1P's (0x5b, 0x70, 0x80) from (12, 37) and 2P's (0x80, 0x5b, 0x5b) from (160, 37), 148 x 151, framed by
   VS_VERSUS_TEXT_PIECES; "VS MODE" at (121, 43); "1P" at (25, 45) and "2P" at (275, 45); a row per battle at y 61 +
   20 per row, each with its face at x 41 (1P) or 195 (2P), its pip at x 128 or 282 and the round's flash at x 121; the
   wins and losses in their boxes at y 167. The original draws the panels opaque under the winner's 3D letters; the UI
   is over the 3D scene here, so the panels go at half opacity with their colours doubled: over the black screen they
   are the original's colours, and the letters show through (a documented delta). */
#score-board {
	position: absolute;
	left: 50%;
	top: 0;
	width: 960dp;
	height: 720dp;
	margin-left: -480dp;
}

#score-black {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: #000000;
	opacity: 0;
}

.score-panel {
	position: absolute;
	top: 111dp;
	width: 444dp;
	height: 453dp;
}

#score-panel-0 { left: 36dp; background-color: #b6e0ff80; }
#score-panel-1 { left: 480dp; background-color: #ffb6b680; }

/* The frame: the corners, edges and the line between the panels (VS_VERSUS_TEXT_PIECES 11 to 20). */
.score-edge { position: absolute; background-color: #c8d8e8; }

#score-edge-11 { left: 24dp; top: 102dp; width: 12dp; height: 12dp; }
#score-edge-12 { left: 24dp; top: 561dp; width: 12dp; height: 12dp; }
#score-edge-13 { left: 24dp; top: 114dp; width: 12dp; height: 450dp; }
#score-edge-14 { left: 36dp; top: 102dp; width: 447dp; height: 9dp; }
#score-edge-15 { left: 36dp; top: 564dp; width: 447dp; height: 9dp; }
#score-edge-16 { left: 480dp; top: 102dp; width: 447dp; height: 9dp; }
#score-edge-17 { left: 480dp; top: 564dp; width: 447dp; height: 9dp; }
#score-edge-18 { left: 924dp; top: 102dp; width: 12dp; height: 12dp; }
#score-edge-19 { left: 924dp; top: 561dp; width: 12dp; height: 12dp; }
#score-edge-20 { left: 924dp; top: 114dp; width: 12dp; height: 450dp; }

#score-title {
	position: absolute;
	left: 363dp;
	top: 129dp;
	width: 231dp;
	height: 42dp;
	font-size: 36dp;
	line-height: 42dp;
	text-align: center;
	color: #40d040;
}

.score-player {
	position: absolute;
	top: 135dp;
	width: 60dp;
	height: 30dp;
	font-size: 27dp;
	line-height: 30dp;
	color: #e0e0e0;
}

#score-player-0 { left: 75dp; }
#score-player-1 { left: 825dp; }

/* VS_renderVersusBanner: each row's 134 x 20 bar at x 16 (1P) or 170 (2P). */
.score-row {
	position: absolute;
	width: 402dp;
	height: 60dp;
	background-color: #30405080;
}

.score-row.slot-0 { left: 48dp; }
.score-row.slot-1 { left: 510dp; }

#score-row-0-0, #score-row-1-0 { top: 183dp; }
#score-row-0-1, #score-row-1-1 { top: 243dp; }
#score-row-0-2, #score-row-1-2 { top: 303dp; }
#score-row-0-3, #score-row-1-3 { top: 363dp; }
#score-row-0-4, #score-row-1-4 { top: 423dp; }

/* VS_renderFighterNamePlate: the face, 16 x 16 at the bar's x 25 and y 2. VS_renderRoundPips: the won or lost pip,
   16 x 16 at the bar's x 112. */
.score-face {
	position: absolute;
	left: 75dp;
	top: 6dp;
	width: 48dp;
	height: 48dp;
}

.score-pip {
	position: absolute;
	left: 336dp;
	top: 6dp;
	width: 48dp;
	height: 48dp;
	font-size: 42dp;
	line-height: 48dp;
	text-align: center;
}

.score-pip.won { color: #f0c040; }
.score-pip.lost { color: #4060f0; }

/* VS_renderVersusFlash: 78 x 24 over the round's row at x 121. */
#score-flash {
	position: absolute;
	left: 363dp;
	width: 234dp;
	height: 72dp;
	background-color: #ffffffa0;
}

#score-flash.row-0 { top: 189dp; }
#score-flash.row-1 { top: 249dp; }
#score-flash.row-2 { top: 309dp; }
#score-flash.row-3 { top: 369dp; }
#score-flash.row-4 { top: 429dp; }

/* The wins and losses (VS_renderRoundScores): "Win" at x 21 and 175, "Lose" at 81 and 235, y 168; each number in its
   14 x 14 box at x 59, 131, 213 and 285, y 167. */
.score-label {
	position: absolute;
	top: 498dp;
	height: 36dp;
	font-size: 30dp;
	line-height: 36dp;
	color: #e0e0e0;
	white-space: nowrap;
}

#score-win-label-0 { left: 63dp; }
#score-lose-label-0 { left: 243dp; }
#score-win-label-1 { left: 525dp; }
#score-lose-label-1 { left: 705dp; }

.score-number {
	position: absolute;
	top: 501dp;
	width: 42dp;
	height: 42dp;
	font-size: 30dp;
	line-height: 42dp;
	text-align: center;
	color: #e0e0e0;
	border: 3dp #c8d8e8;
	box-sizing: border-box;
}

#score-wins-0 { left: 177dp; }
#score-losses-0 { left: 393dp; }
#score-wins-1 { left: 639dp; }
#score-losses-1 { left: 855dp; }

/* The host's setup: each value with its arrows right beside it, as the other steppers. */
.stepper { display: block; white-space: nowrap; }
.stepper.hidden { display: none; }
.stepper-label { display: block; }
.stepper .arrow.less { margin-left: 18dp; }
.stepper .arrow {
	display: inline-block;
	vertical-align: middle;
	width: 30dp;
	height: 30dp;
	margin: 0 6dp;
	image-color: #9aa8ba;
}

.stepper .arrow.less { decorator: image(/glyph/modern/@left contain center center); }
.stepper .arrow.more { decorator: image(/glyph/modern/@right contain center center); }
.stepper:focus .arrow { image-color: #f2a93b; }
.stepper-value { display: inline-block; text-align: center; }

