<rml>
<head>
	<title>Online versus</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<!-- A battle on its arena (apps/game/src/versus_arena.hpp), as the original's versus screen draws it (vs_hud.c):
	     each side's bars, finisher letters, command name and command strip, and the clock between them. -->
	<div id="hud" class="hidden">
		<div id="side-0" class="vs-side side-0">
			<div class="vs-bar hp"><div class="vs-icon"></div><div class="vs-gauge"><div id="f0-hp-fill" class="vs-fill"></div></div><div class="vs-value"><div id="f0-hp-d-0" class="vs-digit place-0 hidden"></div><div id="f0-hp-d-1" class="vs-digit place-1 hidden"></div><div id="f0-hp-d-2" class="vs-digit place-2 hidden"></div><div id="f0-hp-d-3" class="vs-digit place-3 hidden"></div><span id="f0-hp-value" class="vs-value-text original-look"></span></div></div>
			<div class="vs-bar mp"><div class="vs-icon"></div><div class="vs-gauge"><div id="f0-mp-fill" class="vs-fill"></div></div><div class="vs-value"><div id="f0-mp-d-0" class="vs-digit place-0 hidden"></div><div id="f0-mp-d-1" class="vs-digit place-1 hidden"></div><div id="f0-mp-d-2" class="vs-digit place-2 hidden"></div><div id="f0-mp-d-3" class="vs-digit place-3 hidden"></div><span id="f0-mp-value" class="vs-value-text original-look"></span></div></div>
			<div class="vs-finish"><span id="f0-word" class="vs-word original-look"></span><div id="f0-seg-0" class="vs-seg seg-0"></div><div id="f0-seg-1" class="vs-seg seg-1"></div><div id="f0-seg-2" class="vs-seg seg-2"></div><div id="f0-seg-3" class="vs-seg seg-3"></div><div id="f0-seg-4" class="vs-seg seg-4"></div><div id="f0-seg-5" class="vs-seg seg-5"></div><div id="f0-seg-6" class="vs-seg seg-6"></div><div id="f0-seg-7" class="vs-seg seg-7"></div></div>
			<div id="f0-push" class="vs-push hidden" onclick="act('finisher')"><span class="key" id="f0-push-key"></span><div class="vs-push-word" text-key="battle.finisher_push"></div></div>
			<p id="f0-command" class="vs-name original-look"></p>
			<div class="vs-strip">
				<div id="f0-frame-0" class="vs-frame hidden"></div>
				<div id="f0-frame-1" class="vs-frame hidden"></div>
				<div id="f0-frame-2" class="vs-frame hidden"></div>
				<div id="f0-frame-3" class="vs-frame hidden"></div>
				<div id="f0-frame-4" class="vs-frame hidden"></div>
				<div id="f0-frame-5" class="vs-frame hidden"></div>
				<div id="f0-frame-6" class="vs-frame hidden"></div>
				<div id="f0-frame-7" class="vs-frame hidden"></div>
				<div id="f0-frame-8" class="vs-frame hidden"></div>
				<div id="f0-frame-9" class="vs-frame hidden"></div>
				<div id="f0-frame-10" class="vs-frame hidden"></div>
				<div id="f0-cmd-0" class="vs-cmd hidden" onclick="pick_command(0, 0)"></div>
				<div id="f0-cmd-1" class="vs-cmd hidden" onclick="pick_command(0, 1)"></div>
				<div id="f0-cmd-2" class="vs-cmd hidden" onclick="pick_command(0, 2)"></div>
				<div id="f0-cmd-3" class="vs-cmd hidden" onclick="pick_command(0, 3)"></div>
				<div id="f0-cmd-4" class="vs-cmd hidden" onclick="pick_command(0, 4)"></div>
				<div id="f0-cmd-5" class="vs-cmd hidden" onclick="pick_command(0, 5)"></div>
				<div id="f0-cmd-6" class="vs-cmd hidden" onclick="pick_command(0, 6)"></div>
				<div id="f0-cmd-7" class="vs-cmd hidden" onclick="pick_command(0, 7)"></div>
				<div id="f0-cmd-8" class="vs-cmd hidden" onclick="pick_command(0, 8)"></div>
				<div id="f0-cmd-9" class="vs-cmd hidden" onclick="pick_command(0, 9)"></div>
				<div id="f0-cmd-10" class="vs-cmd hidden" onclick="pick_command(0, 10)"></div>
				<div id="f0-cursor" class="vs-cursor hidden"></div>
			</div>
		</div>
		<div id="side-1" class="vs-side side-1">
			<div class="vs-bar hp"><div class="vs-icon"></div><div class="vs-gauge"><div id="f1-hp-fill" class="vs-fill"></div></div><div class="vs-value"><div id="f1-hp-d-0" class="vs-digit place-0 hidden"></div><div id="f1-hp-d-1" class="vs-digit place-1 hidden"></div><div id="f1-hp-d-2" class="vs-digit place-2 hidden"></div><div id="f1-hp-d-3" class="vs-digit place-3 hidden"></div><span id="f1-hp-value" class="vs-value-text original-look"></span></div></div>
			<div class="vs-bar mp"><div class="vs-icon"></div><div class="vs-gauge"><div id="f1-mp-fill" class="vs-fill"></div></div><div class="vs-value"><div id="f1-mp-d-0" class="vs-digit place-0 hidden"></div><div id="f1-mp-d-1" class="vs-digit place-1 hidden"></div><div id="f1-mp-d-2" class="vs-digit place-2 hidden"></div><div id="f1-mp-d-3" class="vs-digit place-3 hidden"></div><span id="f1-mp-value" class="vs-value-text original-look"></span></div></div>
			<div class="vs-finish"><span id="f1-word" class="vs-word original-look"></span><div id="f1-seg-0" class="vs-seg seg-0"></div><div id="f1-seg-1" class="vs-seg seg-1"></div><div id="f1-seg-2" class="vs-seg seg-2"></div><div id="f1-seg-3" class="vs-seg seg-3"></div><div id="f1-seg-4" class="vs-seg seg-4"></div><div id="f1-seg-5" class="vs-seg seg-5"></div><div id="f1-seg-6" class="vs-seg seg-6"></div><div id="f1-seg-7" class="vs-seg seg-7"></div></div>
			<div id="f1-push" class="vs-push hidden" onclick="act('finisher')"><span class="key" id="f1-push-key"></span><div class="vs-push-word" text-key="battle.finisher_push"></div></div>
			<p id="f1-command" class="vs-name original-look"></p>
			<div class="vs-strip">
				<div id="f1-frame-0" class="vs-frame hidden"></div>
				<div id="f1-frame-1" class="vs-frame hidden"></div>
				<div id="f1-frame-2" class="vs-frame hidden"></div>
				<div id="f1-frame-3" class="vs-frame hidden"></div>
				<div id="f1-frame-4" class="vs-frame hidden"></div>
				<div id="f1-frame-5" class="vs-frame hidden"></div>
				<div id="f1-frame-6" class="vs-frame hidden"></div>
				<div id="f1-frame-7" class="vs-frame hidden"></div>
				<div id="f1-frame-8" class="vs-frame hidden"></div>
				<div id="f1-frame-9" class="vs-frame hidden"></div>
				<div id="f1-frame-10" class="vs-frame hidden"></div>
				<div id="f1-cmd-0" class="vs-cmd hidden" onclick="pick_command(1, 0)"></div>
				<div id="f1-cmd-1" class="vs-cmd hidden" onclick="pick_command(1, 1)"></div>
				<div id="f1-cmd-2" class="vs-cmd hidden" onclick="pick_command(1, 2)"></div>
				<div id="f1-cmd-3" class="vs-cmd hidden" onclick="pick_command(1, 3)"></div>
				<div id="f1-cmd-4" class="vs-cmd hidden" onclick="pick_command(1, 4)"></div>
				<div id="f1-cmd-5" class="vs-cmd hidden" onclick="pick_command(1, 5)"></div>
				<div id="f1-cmd-6" class="vs-cmd hidden" onclick="pick_command(1, 6)"></div>
				<div id="f1-cmd-7" class="vs-cmd hidden" onclick="pick_command(1, 7)"></div>
				<div id="f1-cmd-8" class="vs-cmd hidden" onclick="pick_command(1, 8)"></div>
				<div id="f1-cmd-9" class="vs-cmd hidden" onclick="pick_command(1, 9)"></div>
				<div id="f1-cmd-10" class="vs-cmd hidden" onclick="pick_command(1, 10)"></div>
				<div id="f1-cursor" class="vs-cursor hidden"></div>
			</div>
		</div>
		<div id="vs-clock"><div id="vs-clock-side-0" class="vs-clock-side"></div><div id="vs-clock-side-1" class="vs-clock-side"></div><div id="vs-clock-d-0" class="vs-clock-digit hidden"></div><div id="vs-clock-d-1" class="vs-clock-digit hidden"></div></div>
		<p id="hud-stalled" class="vs-warning hidden" text-key="versus.match.stalled"></p>
		<p id="hud-leave" class="vs-warning hidden" text-key="versus.match.leave"></p>
	</div>

