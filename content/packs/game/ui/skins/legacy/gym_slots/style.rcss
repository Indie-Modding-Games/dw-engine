/* The gym's roulette in the original look (trn_slots.c: TRN_renderSlotMachine; captures orig_slot_idle,
   orig_slot_spin and orig_slot_result, 2026-10-30): each cell is the symbol's picture (TRN_SLOT_SPRITE1: 32 x 32 at
   u = (symbol - 1) x 32, v 216 of the map's texture at (704, 0), CLUT (48, 486)) instead of its number, and the
   original shows no rate under the reels. The frame is the pause menu's box. */

body .cell {
	color: transparent;
}

body .cell.symbol-1 { decorator: image(slot-symbol-1); }
body .cell.symbol-2 { decorator: image(slot-symbol-2); }
body .cell.symbol-3 { decorator: image(slot-symbol-3); }
body .cell.symbol-4 { decorator: image(slot-symbol-4); }
body .cell.symbol-5 { decorator: image(slot-symbol-5); }
body .cell.symbol-6 { decorator: image(slot-symbol-6); }
body .cell.symbol-7 { decorator: image(slot-symbol-7); }

/* TRN_renderSlotMachine draws the reel's background sprite (u 224, v 216, CLUT 4) subtracted over the symbols: the
   capture's white goes from about 130 at the window's top and bottom edges up to 255 in its middle. The subtraction
   is close to darkening with black at up to 48 % (Suposición: a blend, not the subtraction itself). */
body .shade.top { decorator: vertical-gradient(#0000007a #00000000); }
body .shade.bottom { decorator: vertical-gradient(#00000000 #0000007a); }

body .payout {
	display: none;
}
