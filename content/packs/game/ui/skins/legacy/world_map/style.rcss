/* The island map in the original look (the original has no island map): one of the original's boxes (theme.rcss
   .original-box) and its font, at the 22dp the bitmap font draws sharp. The title is yellow as a speaker's name
   (colour 2), the rest the font's grey (0x6B5A). */

body #backdrop { background-color: #000000c8; }

#title, #here, #exits, #exits-title, .exit-area, #footer {
	font-family: original-look;
	font-weight: normal;
}

body #title { font-size: 33dp; color: #f8f800; }
body #here, body #here-label { font-size: 22dp; color: #d0d0d0; }

body #frame {
	border: 3dp transparent;
	background-color: #2d3840c0;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
}

body #map {
	border: 3dp #d0d0d0;
	border-radius: 0;
}

/* The areas' names keep the small modern font: at 22dp the original's would cover the island. */
body .region {
	font-family: "Noto Sans";
	font-weight: bold;
	color: #f0f0f0;
	font-effect: outline(2dp #000000);
}
body .region.unknown { color: #b8b8b8; font-weight: normal; font-effect: outline(2dp #000000); }
body .region.exit { color: #f8f800; font-effect: outline(2dp #000000); }
body .region.here { color: #f8f800; font-effect: outline(3dp #e03028); }

body #marker-dot { border: 3dp #000000; background-color: #f8f800; border-radius: 9dp; }
body #marker-pulse { border: 3dp #f8f800; }

body #exits-title { font-size: 22dp; color: #f8f800; }
body #exits { font-size: 22dp; line-height: 26dp; color: #d0d0d0; }
body .exit-row { margin-right: 22dp; }
body .exit-area { font-size: 22dp; color: #a0a0a0; }
body #no-exits { font-size: 22dp; color: #a0a0a0; }

body #footer { font-size: 22dp; color: #d0d0d0; }
body .legend-here { background-color: #f8f800; }
body .legend-exit { background-color: #f8f800; border-radius: 0; }
body .legend-unknown { background-color: #a0a0a0; }
