/* The HUD: always shown over the game and never in the way of the pointer. */

body {
	pointer-events: none;
}

#minimap {
	position: absolute;
	right: 20dp;
	top: 20dp;
	padding: 10dp;
	border-radius: 12dp;
	background-color: #0d121ab8;
	border: 1dp #2e3a4a;
}

#minimap-map {
	position: relative;
}

.size-small #minimap-map { width: 140dp; height: 140dp; }
.size-medium #minimap-map { width: 200dp; height: 200dp; }
.size-large #minimap-map { width: 280dp; height: 280dp; }

/* The game sets the frame's size and position so the map keeps its proportions inside the square. */
#minimap-frame {
	position: absolute;
}

#minimap-image {
	width: 100%;
	height: 100%;
}

.marker {
	position: absolute;
	width: 16dp;
	height: 16dp;
	margin-left: -8dp;
	margin-top: -8dp;
}

#minimap-player {
	image-color: #f0a73a;
}

#minimap-partner {
	width: 12dp;
	height: 12dp;
	margin-left: -6dp;
	margin-top: -6dp;
	image-color: #5cc8ff;
}

#minimap-name {
	margin-top: 6dp;
	font-size: 14dp;
	font-weight: bold;
	text-align: center;
	color: #c9d3de;
}

/* Opens the pause menu with the pointer; the prompt names the key or button that also opens it. */
#menu-button {
	pointer-events: auto;
	position: absolute;
	left: 20dp;
	top: 20dp;
	margin: 0;
	padding: 6dp 14dp 6dp 8dp;
	font-size: 14dp;
	background-color: #0d121ab8;
	border: 1dp #2e3a4a;
}

#menu-button:hover {
	background-color: #1c2633;
}

/* The hint goes with the field's clock and bars (hud.shown): not in battles, events or menus, where the field stands
   still and the original shows none. */
#menu-button {
	visibility: hidden;
}

#menu-button.shown {
	visibility: visible;
}

/* The name of the map a map change goes to, while the original shows it (map.c: renderMapName): in the middle of
   the screen, with the original look (light grey, in the font the player picks), with no box and no shadow, over the
   fade that the game draws under the UI. */
#map-title {
	position: absolute;
	left: 0;
	right: 0;
	top: 50%;
	height: 40dp;
	margin-top: -20dp;
	line-height: 40dp;
	text-align: center;
	font-size: 30dp;
	display: none;
}

#map-title.shown {
	display: block;
}

/* The field status (the hud.* settings, docs/architecture/ui.md#estado-del-campo): the game time and the partner's
   state, at the bottom left, in from the edges as far as the other panels. Next to the original's field, which shows
   only a dial clock and the happiness and discipline bars, this skin adds the day, the bars' numbers, the needs and
   HP and MP, and fills the bars continuously (no "pips" class); the whole panel is this skin's look. */
#field-status {
	position: absolute;
	left: 20dp;
	bottom: 20dp;
	width: 300dp;
	padding: 10dp 12dp;
	border-radius: 12dp;
	background-color: #0d121ab8;
	border: 1dp #2e3a4a;
	color: #c9d3de;
	font-size: 14dp;
}

/* While a menu or a battle stops the field the panel is gone at once, as the minimap is when hidden. */
#field-status {
	display: none;
}

#field-status.shown {
	display: block;
}

/* This skin tells the time in figures: the original's dial is for the original-look skin. */
#field-clock-dial {
	display: none;
}

#field-clock {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	margin-bottom: 6dp;
}

/* The time in figures goes with the option digital_time (the class digital on #field-clock), on by default; off,
   the panel tells only the day. */
#field-time {
	display: none;
	font-size: 22dp;
	font-weight: bold;
	color: #f2f5f8;
}

#field-clock.digital #field-time {
	display: block;
}

#field-date {
	font-size: 14dp;
}

.field-meter, .field-pool {
	display: flex;
	align-items: center;
	margin: 3dp 0;
}

#field-status .label {
	width: 92dp;
}

/* Happiness and discipline fill in two tones, as the original's bars: the first colour to the middle of the range,
   the second over it from the middle on. HP and MP fill with what is left over the maximum. */
#field-status .bar {
	position: relative;
	flex: 1;
	height: 8dp;
	margin: 0 8dp;
	background-color: #2a323d;
	border-radius: 3dp;
}

#field-status .fill {
	height: 100%;
	width: 0%;
	border-radius: 3dp;
}

.field-meter .fill { background-color: #6fc3ff; }

.field-meter .fill.high {
	position: absolute;
	left: 0;
	top: 0;
	background-color: #ffd34f;
}

#field-pool-0-fill { background-color: #6fd38a; }
#field-pool-1-fill { background-color: #b58cff; }

#field-status .value {
	width: 40dp;
	text-align: right;
}

#field-status .field-pool .value {
	width: 92dp;
}

/* The needs: always in place, dim while the partner does not have them; one it has stands out with a light box and
   dark text, so it reads without telling colours apart. */
#field-needs {
	display: flex;
	justify-content: space-between;
	margin: 6dp 0 4dp 0;
}

.need {
	padding: 2dp 8dp;
	border-radius: 6dp;
	border: 1dp #2e3a4a;
	color: #6b7785;
}

.need.active {
	background-color: #f0a73a;
	border-color: #f0a73a;
	color: #12161c;
	font-weight: bold;
}

/* The needs panel already shows every need, so this skin leaves out the bubble over the partner. */
#field-partner-bubble {
	display: none;
}

/* The shop job's bar (an engine improvement, the option shop_job_bar): a panel like the minimap's at the top centre;
   the fill turns blue past the better pay's mark and green once the shopkeeper joins. */
#shop-job {
	width: 420dp;
	margin-left: -220dp;
	padding: 8dp 10dp 6dp 10dp;
	border-radius: 12dp;
	background-color: #0d121ab8;
	border: 1dp #2e3a4a;
	font-size: 14dp;
	color: #c9d3de;
}

#shop-job-title {
	font-weight: bold;
}

#shop-job-bar {
	height: 10dp;
	margin: 6dp 0 4dp 0;
	border-radius: 5dp;
	background-color: #2e3a4a;
}

#shop-job-fill {
	border-radius: 5dp;
	background-color: #f0a73a;
}

#shop-job.better #shop-job-fill { background-color: #5cc8ff; }
#shop-job.joins #shop-job-fill { background-color: #6fdc6f; }

.shop-job-mark {
	width: 2dp;
	margin-left: -1dp;
	background-color: #ffffff;
}

#shop-job-foot {
	height: 20dp;
	font-size: 14dp;
}

#shop-job-next {
	color: #8d9aab;
}
