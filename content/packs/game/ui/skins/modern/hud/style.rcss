/* The HUD: always shown over the game and never in the way of the pointer. */

body {
	pointer-events: none;
}

/* The round minimap (an engine improvement, docs/modulos/engine/ui.md): at the top right, clear of the time and the
   partner's panel at the bottom left and of the menu's hint at the top left. The map's name on a banner above it, a
   disc of the map round the player, north-up, with a glowing ring (decorator minimap-disc: ring style, disc fill,
   ring colour, glow colour, ring width, glow width) and the north mark on the ring, and the day and time under it.
   #minimap-frame is the disc itself: the markers go in percent of it, the player always in its middle. */
#minimap {
	position: absolute;
	right: 16dp;
	top: 12dp;
	text-align: center;
}

#minimap.size-small { width: 156dp; }
#minimap.size-medium { width: 196dp; }
#minimap.size-large { width: 246dp; }

#minimap-name {
	display: block;
	margin: 0 6dp -6dp 6dp;
	padding: 3dp 10dp;
	border-radius: 8dp;
	background-color: #0d121ae0;
	border: 1dp #4f7da8;
	font-size: 14dp;
	font-weight: bold;
	color: #e6eef6;
	position: relative;
	z-index: 1;
}

#minimap-map {
	position: relative;
	padding: 18dp;
}

#minimap-frame {
	position: relative;
	decorator: minimap-disc(plain #0d121ad8 #8fd8ff #3aa8ff70 3dp 10dp);
}

.size-small #minimap-frame { width: 120dp; height: 120dp; }
.size-medium #minimap-frame { width: 160dp; height: 160dp; }
.size-large #minimap-frame { width: 210dp; height: 210dp; }

/* The north mark sits on the top of the ring. */
#minimap-north {
	position: absolute;
	left: 50%;
	top: 6dp;
	width: 20dp;
	height: 20dp;
	margin-left: -10dp;
	border-radius: 10dp;
	background-color: #0d121a;
	border: 1dp #8fd8ff;
	font-size: 14dp;
	font-weight: bold;
	line-height: 18dp;
	color: #8fd8ff;
}

.marker {
	position: absolute;
	width: 18dp;
	height: 18dp;
	margin-left: -9dp;
	margin-top: -9dp;
}

#minimap-player {
	image-color: #ffc14d;
}

#minimap-partner {
	width: 13dp;
	height: 13dp;
	margin-left: -6.5dp;
	margin-top: -6.5dp;
	image-color: #5cc8ff;
}

/* A partner out of view waits on the rim, dimmed. */
#minimap-partner.pinned {
	opacity: 0.6;
}

#minimap-clock {
	display: inline-block;
	position: relative;
	z-index: 1;
	margin-top: -8dp;
	padding: 2dp 10dp;
	border-radius: 9dp;
	background-color: #0d121ae0;
	border: 1dp #4f7da8;
	font-size: 14dp;
	color: #c9d3de;
}

#minimap-time {
	margin-left: 6dp;
	font-weight: bold;
	color: #e6eef6;
}

/* Opens the pause menu with the pointer; the prompt names the key or button that also opens it. */
#menu-button {
	pointer-events: auto;
	position: absolute;
	left: 20dp;
	top: 20dp;
	margin: 0;
	padding: 6dp 14dp 6dp 8dp;
	font-size: 14dp;
	background-color: #0d121ab8;
	border: 1dp #2e3a4a;
}

#menu-button:hover {
	background-color: #1c2633;
}

/* The hint goes with the field's clock and bars (hud.shown): not in battles, events or menus, where the field stands
   still and the original shows none. */
#menu-button {
	visibility: hidden;
}

#menu-button.shown {
	visibility: visible;
}

/* The name of the map a map change goes to, while the original shows it (map.c: renderMapName): in the middle of
   the screen, with the original look (light grey, in the font the player picks), with no box and no shadow, over the
   fade that the game draws under the UI. */
#map-title {
	position: absolute;
	left: 0;
	right: 0;
	top: 50%;
	height: 40dp;
	margin-top: -20dp;
	line-height: 40dp;
	text-align: center;
	font-size: 30dp;
	display: none;
}

#map-title.shown {
	display: block;
}

/* The field status (the hud.* settings, docs/architecture/ui.md#estado-del-campo): the game time and the partner's
   state, at the bottom left, in from the edges as far as the other panels. Next to the original's field, which shows
   only a dial clock and the happiness and discipline bars, this skin adds the day, the bars' numbers, the needs and
   HP and MP, and fills the bars continuously (no "pips" class); the whole panel is this skin's look. */
#field-status {
	position: absolute;
	left: 20dp;
	bottom: 20dp;
	width: 300dp;
	padding: 10dp 12dp;
	border-radius: 12dp;
	background-color: #0d121ab8;
	border: 1dp #2e3a4a;
	color: #c9d3de;
	font-size: 14dp;
}

/* While a menu or a battle stops the field the panel is gone at once, as the minimap is when hidden. */
#field-status {
	display: none;
}

#field-status.shown {
	display: block;
}

/* This skin tells the time in figures: the original's dial is for the original-look skin. */
#field-clock-dial {
	display: none;
}

#field-clock {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	margin-bottom: 6dp;
}

/* The time in figures goes with the option digital_time (the class digital on #field-clock), on by default; off,
   the panel tells only the day. */
#field-time {
	display: none;
	font-size: 22dp;
	font-weight: bold;
	color: #f2f5f8;
}

#field-clock.digital #field-time {
	display: block;
}

#field-date {
	font-size: 14dp;
}

.field-meter, .field-pool {
	display: flex;
	align-items: center;
	margin: 3dp 0;
}

#field-status .label {
	width: 92dp;
}

/* Happiness and discipline fill in two tones, as the original's bars: the first colour to the middle of the range,
   the second over it from the middle on. HP and MP fill with what is left over the maximum. */
#field-status .bar {
	position: relative;
	flex: 1;
	height: 8dp;
	margin: 0 8dp;
	background-color: #2a323d;
	border-radius: 3dp;
}

#field-status .fill {
	height: 100%;
	width: 0%;
	border-radius: 3dp;
}

.field-meter .fill { background-color: #6fc3ff; }

.field-meter .fill.high {
	position: absolute;
	left: 0;
	top: 0;
	background-color: #ffd34f;
}

#field-pool-0-fill { background-color: #6fd38a; }
#field-pool-1-fill { background-color: #b58cff; }

#field-status .value {
	width: 40dp;
	text-align: right;
}

#field-status .field-pool .value {
	width: 92dp;
}

/* The needs: always in place, dim while the partner does not have them; one it has stands out with a light box and
   dark text, so it reads without telling colours apart. */
#field-needs {
	display: flex;
	justify-content: space-between;
	margin: 6dp 0 4dp 0;
}

.need {
	padding: 2dp 8dp;
	border-radius: 6dp;
	border: 1dp #2e3a4a;
	color: #6b7785;
}

.need.active {
	background-color: #f0a73a;
	border-color: #f0a73a;
	color: #12161c;
	font-weight: bold;
}

/* The needs panel already shows every need, so this skin leaves out the bubble over the partner. */
#field-partner-bubble {
	display: none;
}

/* The shop job's bar (an engine improvement, the option shop_job_bar): a panel like the minimap's at the top centre;
   the fill turns blue past the better pay's mark and green once the shopkeeper joins. */
#shop-job {
	width: 420dp;
	margin-left: -220dp;
	padding: 8dp 10dp 6dp 10dp;
	border-radius: 12dp;
	background-color: #0d121ab8;
	border: 1dp #2e3a4a;
	font-size: 14dp;
	color: #c9d3de;
}

#shop-job-title {
	font-weight: bold;
}

#shop-job-bar {
	height: 10dp;
	margin: 6dp 0 4dp 0;
	border-radius: 5dp;
	background-color: #2e3a4a;
}

#shop-job-fill {
	border-radius: 5dp;
	background-color: #f0a73a;
}

#shop-job.better #shop-job-fill { background-color: #5cc8ff; }
#shop-job.joins #shop-job-fill { background-color: #6fdc6f; }

.shop-job-mark {
	width: 2dp;
	margin-left: -1dp;
	background-color: #ffffff;
}

#shop-job-foot {
	height: 20dp;
	font-size: 14dp;
}

#shop-job-next {
	color: #8d9aab;
}
