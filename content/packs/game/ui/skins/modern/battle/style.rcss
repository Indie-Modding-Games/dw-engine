/* The battle screen over the field: the command row at the top (command_menu.c: BTL_renderCommandMenu), the
   partner's bars and finisher gauge (battle_hud.c: BTL_renderPartnerStatusBars, BTL_renderFinisherGauge), the
   enemies' bars, the revive countdown, and the end box (battle_ui.c: handleBattleEndBox). */

#fight, #end {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

/* The command row: one entry per command the partner's brains allow, the focused one named below the row. */
#commands {
	position: absolute;
	top: 18dp;
	left: 0;
	width: 100%;
	text-align: center;
}

#command-row {
	display: inline-block;
	padding: 6dp 8dp;
	background-color: #10161ee0;
	border: 1dp #3a4a5e;
	border-radius: 8dp;
}

.command {
	display: inline-block;
	margin: 0 3dp;
	padding: 6dp 10dp;
	font-size: 22dp;
}

.command.current {
	border: 2dp #6fc3ff;
}

.command.unavailable {
	color: #6b7480;
}

#command-name {
	margin-top: 6dp;
	font-size: 22dp;
}

/* The fighters' panels: name, status, then HP and MP bars with four-digit values. */
.fighter {
	width: 330dp;
	padding: 8dp 12dp;
	margin-bottom: 8dp;
	background-color: #10161ee0;
	border: 1dp #3a4a5e;
	border-radius: 8dp;
}

.fighter.fainted {
	color: #6b7480;
}

.fighter-head {
	margin-bottom: 4dp;
}

.fighter-name {
	font-size: 22dp;
}

.fighter-status {
	float: right;
	color: #e07ad0;
	font-size: 16dp;
}

.bar-row {
	display: flex;
	align-items: center;
	margin: 2dp 0;
}

.bar-label {
	width: 40dp;
	font-size: 22dp;
}

.bar {
	flex: 1;
	height: 10dp;
	margin: 0 8dp;
	background-color: #2a323d;
	border-radius: 3dp;
}

.fill {
	height: 100%;
	width: 0%;
	border-radius: 3dp;
}

.hp .fill { background-color: #54d16a; }
.mp .fill { background-color: #4f9cff; }
.charge .fill { background-color: #ffd34f; }

.bar-value {
	width: 60dp;
	text-align: right;
	font-size: 22dp;
}

#enemies {
	position: absolute;
	/* Below the HUD's minimap. */
	top: 290dp;
	right: 24dp;
	width: 356dp;
}

#partner-panel {
	position: absolute;
	left: 24dp;
	bottom: 56dp;
}

/* The finisher gauge: six segments that fill as the partner's gauge does, and lit when full. */
#finisher {
	padding: 6dp 12dp;
	width: 330dp;
	background-color: #10161ee0;
	border: 1dp #3a4a5e;
	border-radius: 8dp;
}

#finisher-label {
	font-size: 22dp;
	margin-right: 10dp;
}

#finisher-segments {
	display: inline-block;
}

.segment {
	display: inline-block;
	width: 30dp;
	height: 12dp;
	margin-right: 4dp;
	background-color: #2a323d;
	border-radius: 2dp;
}

.segment.filled { background-color: #ff9a3c; }
#finisher.ready .segment { background-color: #ffd34f; }

/* The finisher's charge: confirm or a click adds to it while the aura lasts (command_menu.c:
   BTL_tickFinisherChargeup). */
#charge {
	position: absolute;
	left: 50%;
	top: 40%;
	width: 360dp;
	margin-left: -180dp;
	padding: 12dp 16dp;
	text-align: center;
	background-color: #10161ef0;
	border: 2dp #ffd34f;
	border-radius: 8dp;
}

#charge-title {
	font-size: 22dp;
	margin-bottom: 8dp;
}

.charge-hint {
	margin-top: 8dp;
	font-size: 15dp;
	color: #9aa7b6;
}

#revive {
	position: absolute;
	left: 0;
	top: 45%;
	width: 100%;
	text-align: center;
	font-size: 33dp;
}

/* The prompts sit on a panel of their own, so the field under them never hides them. */
#prompts {
	position: absolute;
	right: 24dp;
	bottom: 16dp;
	padding: 4dp 10dp;
	font-size: 15dp;
	color: #9aa7b6;
	background-color: #10161ee0;
	border-radius: 8dp;
}

#prompt-bag {
	margin-left: 14dp;
}

/* The tamer's bag (inventory.c: addInventoryUI) while the battle goes on; items that cannot be thrown in battle are
   greyed out. It takes the command row's place on the left, below the HUD's menu hint: on the narrowest screen the UI
   lays out (960dp wide, 4:3) it ends left of the enemies' panels, and a full bag of 30 slots in three columns ends
   above the partner's panel. */
.bag-button {
	margin-left: 12dp;
}

#bag {
	position: absolute;
	left: 24dp;
	top: 64dp;
	width: 520dp;
	padding: 10dp 14dp;
	background-color: #10161ef0;
	border: 1dp #3a4a5e;
	border-radius: 8dp;
}

#bag h2 {
	font-size: 24dp;
	margin-bottom: 6dp;
}

.bag-slot {
	display: inline-block;
	box-sizing: border-box;
	width: 31.33%;
	margin: 1dp 1%;
	padding: 2dp 8dp;
	font-size: 18dp;
}

.bag-slot.unusable {
	color: #6b7480;
}

.slot-count {
	float: right;
}

#bag-description {
	min-height: 48dp;
	margin-top: 8dp;
	font-size: 20dp;
}

#item-in-flight {
	position: absolute;
	left: 0;
	top: 36%;
	width: 100%;
	text-align: center;
	font-size: 26dp;
}

/* The end box: the outcome, the stats with their raises counting up, the bits moving into the balance, then the lines
   of drops, injury and moves learned typed in two rows. */
#end {
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #05080c80;
}

#end-panel {
	width: 560dp;
	padding: 18dp 24dp 14dp 24dp;
	background-color: #151b24f0;
	border: 1dp #2e3a4a;
	border-radius: 14dp;
}

#end-title {
	font-size: 33dp;
	color: #f0a73a;
	margin-bottom: 10dp;
}

#end-boxes {
	display: block;
}

#gains {
	padding: 8dp 12dp;
	background-color: #10161ee0;
	border: 1dp #3a4a5e;
	border-radius: 8dp;
}

#gains-divider, #bits-line, .gain-arrow {
	display: none;
}

.gain {
	display: block;
	position: relative;
	height: 30dp;
	font-size: 22dp;
	line-height: 26dp;
}

.gain-stat {
	position: absolute;
	left: 150dp;
	width: 80dp;
	text-align: right;
}

.stat-bar {
	position: absolute;
	left: 250dp;
	top: 10dp;
	width: 160dp;
	height: 8dp;
	background-color: #2a3442;
	border-radius: 4dp;
}

.stat-fill {
	width: 0;
	height: 8dp;
	background-color: #8a96a8;
	border-radius: 4dp;
}

.stat-bar.raised .stat-fill {
	background-color: #6cc4ff;
}

.gain-value {
	position: absolute;
	left: 430dp;
	color: #6cc4ff;
}

#bits, #balance {
	margin-top: 8dp;
	padding: 8dp 12dp;
	font-size: 22dp;
	background-color: #10161ee0;
	border: 1dp #3a4a5e;
	border-radius: 8dp;
}

#bits-value, #balance-value {
	float: right;
}

/* The rows of text show only when the battle left any. */
#end-text {
	display: none;
	margin-top: 10dp;
	height: 60dp;
}

#end-boxes.with-text #end-text {
	display: block;
}

.end-row {
	display: block;
	height: 30dp;
	font-size: 22dp;
	white-space: pre;
}

.end-name {
	color: #f0a73a;
}

/* The battle's opening (btl.c: setFleeBubble; battle_hud.c: BTL_renderBattleStartText): a red mark over each enemy,
   then the "BATTLE" banner, its pieces placed on the original's 320 x 240 screen, which stands in the middle of the
   window at 3dp a pixel. The strip's frame, the cursor and the extra marks of the finisher's word are the original
   look's. While the banner shows, the HUD is there under it without the hovered command's name. */
#intro {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.anger {
	position: absolute;
	width: 48dp;
	height: 48dp;
	margin: -24dp 0 0 -24dp;
	border-radius: 24dp;
	background-color: #d03030;
}

#banner {
	position: absolute;
	left: 50%;
	top: 0;
	width: 960dp;
	height: 720dp;
	margin-left: -480dp;
}

.bp, .bs {
	position: absolute;
}

.bp {
	background-color: #c03838;
}

.bs {
	background-color: #000000;
}

.bt {
	position: absolute;
	top: 0;
	height: 100%;
	background-color: #c0383880;
}

/* While the anger mark shows, the fight's panels are there but unseen (logic.lua: draw_intro). */
#fight.veiled, #fight.veiled .command, #fight.veiled .command-frame {
	opacity: 0;
}

#fight.opening #command-name {
	visibility: hidden;
}

.command-frame, #command-cursor, .segment.extra, #finisher-ready {
	display: none;
}

/* Hidden wins over the display of the elements above. */
#fight.hidden, #end.hidden, #charge.hidden, #revive.hidden, .command.hidden, .fighter.hidden, #balance.hidden,
#commands.hidden, #bag.hidden, .bag-slot.hidden, #item-in-flight.hidden, .bar-row.hidden, .gain-arrow.hidden,
#intro.hidden, .anger.hidden, .bp.hidden, .bs.hidden, .bt.hidden, .command-frame.hidden, #command-cursor.hidden {
	display: none;
}

/* The focused bag slot's text keeps the focus colours over the original look's ink. */
.bag-slot:focus .original-look {
	color: #1a1f27;
}
