/* The registration in the original look: the original's boxes (theme.rcss .original-box), its ink, and the
   selection's grey bar of the story's boxes (script_textbox.c: renderDialogueSelectionCursor). */

body #title, body #grid, body #info, body #talk {
	border: 3dp transparent;
	background-color: #2d384080;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
}

#frame { font-family: original-look; color: #d0d0d0; }
body .vline, body .hline { background-color: #90d9fa; }

body .text-row.selected .run {
	background-color: #525a63;
	border-top: 3dp #b5b5b5;
}
