/* The pause menu in the original look: one of the original's boxes over the field, which stays undimmed.

   The box (ui.c: renderUIBoxBorder; capture field_pause_start and menu_main): a light cyan rim (#90D9FA, the right
   side's inner line the darker #4A9FC5), the rounded corner sprites of SYSTEM_W, and the fill #2D3840 at half
   opacity (the box's semi-transparent mode). The original draws each side as three or four 1-pixel lines, black, cyan,
   black; RCSS without shaders gives an element one border colour per side, so the black lines are left out. A
   documented limit of this skin.

   Placement: the original's menu box (game_menu.c: renderGameMenu) is centred and 40 pixels from the top. Its 132
   pixels hold six icons with their names in small capitals; the main page here is that box, 132 pixels wide (396dp),
   headed by the Year/Day line. The six field commands occupy three columns and two rows, with their FI_INFO icons
   above their labels. Engine settings live under Player instead of occupying the field grid. */

#scrim {
	background-color: transparent;
	display: block;
}

#panel {
	position: absolute;
	left: 50%;
	top: 120dp;
	width: 552dp;
	margin-left: -276dp;
	padding: 6dp 9dp 9dp 9dp;
	border-radius: 0;
	border: 3dp transparent;
	background-color: #2d384080;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
}

#panel.on-main {
	width: 390dp;
	height: 324dp;
	padding: 0;
	margin-left: -198dp;
}

#panel.on-main #title {
	display: none;
}

#panel.on-main #title-date {
	display: block;
	position: absolute;
	top: 0;
	left: 0;
	width: 390dp;
	height: 66dp;
	margin: 0;
	padding: 0;
	border: 0;
	line-height: 36dp;
}

#title, #title-date {
	font-size: 33dp;
	font-weight: normal;
	color: #fff371;
	margin: 0 0 6dp 0;
	padding: 0 12dp 3dp 12dp;
	border-bottom: 3dp #90d9fa;
}

.option .value {
	font-weight: normal;
	color: #fff371;
}

/* The settings pages (the engine's own, the original has none): a row is its label and its value on one line, 12
   pixels like the other rows, and cuts what does not fit (the text-fit check finds it). The box is wide enough for the
   longest pair of the packs' languages, Spanish's "Mostrar minimapa" and "Según el aspecto". */
#panel.on-settings {
	width: 780dp;
	margin-left: -390dp;
}
.option {
	height: 30dp;
	overflow: hidden;
	white-space: nowrap;
}

.back {
	margin-top: 6dp;
	color: #b2b2b2;
}

#prompts {
	margin-top: 12dp;
	padding-top: 6dp;
	border-top: 3dp #90d9fa;
	font-size: 22dp;
	color: #b2b2b2;
}

#page-main button {
	text-align: center;
	text-transform: uppercase;
	font-size: 24dp;
	line-height: 30dp;
}

#panel.on-main #page-main {
	position: absolute;
	top: 0;
	left: 0;
	width: 390dp;
	height: 324dp;
	display: block;
}

#panel.on-main #page-main .menu-utility, #panel.on-main #prompts {
	display: none;
}

#panel.on-main #page-main .field-entry {
	position: absolute;
	width: 84dp;
	height: 105dp;
	padding: 0;
	margin: 0;
	border-width: 0;
	border-radius: 0;
	background-color: transparent;
}

#panel.on-main .field-menu-icon {
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 60dp;
	height: 60dp;
	padding: 6dp 9dp;
	margin: 0;
	border: 3dp transparent;
	border-radius: 6dp;
}

#panel.on-main .menu-label {
	display: block;
	position: absolute;
	top: 84dp;
	left: -12dp;
	width: 108dp;
	margin: 0;
	font-size: 15dp;
	line-height: 24dp;
	text-align: center;
	color: #d6d6d6;
}

.menu-item { decorator: image(menu-item scale-none center center); }
.menu-digimon { decorator: image(menu-digimon scale-none center center); }
.menu-player { decorator: image(menu-player scale-none center center); }
.menu-praise { decorator: image(menu-praise scale-none center center); }
.menu-scold { decorator: image(menu-scold scale-none center center); }
.menu-sleep { decorator: image(menu-sleep scale-none center center); }
.menu-fish { decorator: image(menu-fish scale-none center center); }
#panel.on-main .menu-fish { height: 57dp; padding-bottom: 9dp; }

/* English labels are FI_INFO sprites; translated labels retain localized text. */
#panel.on-main.use-menu-art .menu-label {
	width: 84dp;
	height: 21dp;
	margin: 0 auto;
	line-height: 21dp;
	color: transparent;
}
.use-menu-art .menu-item-label { decorator: image(menu-label-item scale-none center center); }
.use-menu-art .menu-digimon-label { decorator: image(menu-label-digimon scale-none center center); }
.use-menu-art .menu-player-label { decorator: image(menu-label-player scale-none center center); }
.use-menu-art .menu-praise-label { decorator: image(menu-label-praise scale-none center center); }
.use-menu-art .menu-scold-label { decorator: image(menu-label-scold scale-none center center); }
.use-menu-art .menu-sleep-label { decorator: image(menu-label-sleep scale-none center center); }
.use-menu-art .menu-fish-label { decorator: image(menu-label-fish scale-none center center); }

/* Unavailable commands remain selectable as in the original; their handlers reject them. */
#panel.on-main #sleep.unavailable, #panel.on-main #fish.unavailable {
	focus: auto;
	tab-index: auto;
}

.player-line { color: #fff371; padding: 6dp 12dp; }
.player-value { color: #d6d6d6; }

/* Field stage: 132 × 110 original pixels (149 with the fishing entry).
   The six regular icons start at (20,31), (56,31), (91,31), then y=71.
   Coordinates below account for the panel's one-pixel RCSS border. */

#panel.on-main.has-fishing { height: 441dp; }

#panel.on-main #open-items { left: 45dp; top: 81dp; }
#panel.on-main #open-partner { left: 153dp; top: 81dp; }
#panel.on-main #open-player { left: 258dp; top: 81dp; }
#panel.on-main #praise { left: 45dp; top: 201dp; }
#panel.on-main #scold { left: 153dp; top: 201dp; }
#panel.on-main #sleep { left: 258dp; top: 201dp; }
#panel.on-main #fish { left: 45dp; top: 81dp; }
#panel.on-main.has-fishing #open-items, #panel.on-main.has-fishing #open-partner, #panel.on-main.has-fishing #open-player { top: 201dp; }
#panel.on-main.has-fishing #praise, #panel.on-main.has-fishing #scold, #panel.on-main.has-fishing #sleep { top: 321dp; }
#panel.on-main.use-menu-art .menu-item-label { left: 9dp; width: 72dp; }
#panel.on-main.use-menu-art .menu-digimon-label { left: 3dp; width: 84dp; }
#panel.on-main.use-menu-art .menu-player-label { left: 9dp; width: 84dp; }
#panel.on-main.use-menu-art .menu-praise-label { left: 15dp; width: 60dp; }
#panel.on-main.use-menu-art .menu-scold-label { left: 15dp; width: 60dp; }
#panel.on-main.use-menu-art .menu-sleep-label { left: 27dp; width: 60dp; }
#panel.on-main.use-menu-art .menu-fish-label { left: 21dp; width: 48dp; }
#panel.on-main.icon-flash .field-entry:focus .menu-item { decorator: image(menu-item-active scale-none center center); }
#panel.on-main.icon-flash .field-entry:focus .menu-digimon { decorator: image(menu-digimon-active scale-none center center); }
#panel.on-main.icon-flash .field-entry:focus .menu-player { decorator: image(menu-player-active scale-none center center); }
#panel.on-main.icon-flash .field-entry:focus .menu-praise { decorator: image(menu-praise-active scale-none center center); }
#panel.on-main.icon-flash .field-entry:focus .menu-scold { decorator: image(menu-scold-active scale-none center center); }
#panel.on-main.icon-flash .field-entry:focus .menu-sleep { decorator: image(menu-sleep-active scale-none center center); }
#panel.on-main.icon-flash .field-entry:focus .menu-fish { decorator: image(menu-fish-active scale-none center center); }

/* Keep the selection frame bright even when the command is unavailable. */
#panel.on-main .field-menu-focus { position: absolute; left: 0; top: 0; width: 87dp; height: 78dp; }
#panel.on-main .field-entry:focus .field-menu-focus { display: block; }
#panel.on-main #sleep.unavailable, #panel.on-main #fish.unavailable { opacity: 1; }
#panel.on-main .unavailable .field-menu-icon, #panel.on-main .unavailable .menu-label { opacity: 0.45; }

/* The selection frame uses the same three small sprites as the original. */
.cursor-part { display: block; position: absolute; pointer-events: none; }
.cursor-left, .cursor-right { top: 0; width: 12dp; height: 66dp; decorator: image(menu-cursor-side); }
.cursor-left { left: 0; }
.cursor-right { left: 75dp; }
.cursor-top, .cursor-bottom { left: 12dp; width: 72dp; height: 12dp; decorator: image(menu-cursor-bar); }
.cursor-top { top: 0; }
.cursor-bottom { top: 66dp; transform: scaleY(-1); }
.cursor-tl, .cursor-tr, .cursor-bl, .cursor-br { width: 12dp; height: 12dp; decorator: image(menu-cursor-corner); }
.cursor-tl { left: 0; top: 0; }
.cursor-tr { left: 72dp; top: 0; transform: scaleX(-1); }
.cursor-bl { left: 0; top: 66dp; transform: scaleY(-1); }
.cursor-br { left: 72dp; top: 66dp; transform: scale(-1, -1); }


#field-year-label, #field-day-label { position: absolute; top: 18dp; font-size: 33dp; line-height: 36dp; }
#field-year-label { left: 15dp; }
#field-day-label { left: 213dp; }
#field-year-digits, #field-day-digits { position: absolute; top: 15dp; height: 36dp; white-space: nowrap; font-size: 0dp; }
#field-year-digits { left: 129dp; }
#field-day-digits { left: 312dp; }
.date-digit { display: inline-block; width: 21dp; height: 36dp; margin-right: 6dp; color: transparent; }
.date-digit.hidden { display: none; }
#field-date-separator { position: absolute; left: 9dp; top: 60dp; width: 372dp; height: 3dp; background-color: #90d9fa; border-top: 3dp #020202; border-bottom: 3dp #020202; }
.digit-0 { decorator: image(menu-digit-0 scale-none center center); }
.digit-1 { decorator: image(menu-digit-1 scale-none center center); }
.digit-2 { decorator: image(menu-digit-2 scale-none center center); }
.digit-3 { decorator: image(menu-digit-3 scale-none center center); }
.digit-4 { decorator: image(menu-digit-4 scale-none center center); }
.digit-5 { decorator: image(menu-digit-5 scale-none center center); }
.digit-6 { decorator: image(menu-digit-6 scale-none center center); }
.digit-7 { decorator: image(menu-digit-7 scale-none center center); }
.digit-8 { decorator: image(menu-digit-8 scale-none center center); }
.digit-9 { decorator: image(menu-digit-9 scale-none center center); }

/* The title follows the actual tamer level (renderPlayerInfoView), from the local disc's table. */
.player-rank { display: block; clear: both; margin-top: 3dp; text-align: right; color: #d6d6d6; }

/* renderPlayerInfoView: a 300x190 box; one native pixel is 3dp. */
#panel.on-player { top: 93dp; width: 900dp; height: 570dp; margin-left: -450dp; padding: 0; box-sizing: border-box; background-color: #2d3840; }
#panel.on-player #title, #panel.on-player #title-date, #panel.on-player #prompts, #panel.on-player #player-tools { display: none; }
#panel.on-player #page-player { position: relative; height: 564dp; padding: 0; margin: 0; }
#panel.on-player .player-native { display: block; }
#panel.on-player #player-profile { position: relative; height: 564dp; }
#player-tabs { position: absolute; left: 12dp; top: -48dp; height: 48dp; }
#panel.on-player .player-tab, #panel.on-player .player-tab:focus, #panel.on-player .player-tab:disabled { position: absolute; top: 0; height: 45dp; padding: 0; margin: 0; border-width: 0; box-sizing: border-box; background-color: transparent; opacity: 1; color: #288ad0; font-size: 36dp; text-align: left; }
#panel.on-player .player-tab.selected { height: 48dp; color: #243640; }
#player-tab-player { left: 0; width: 222dp; }
#player-tab-chart { left: 225dp; width: 222dp; }
#player-tab-medals { left: 450dp; width: 150dp; }
#player-tab-card { left: 603dp; width: 150dp; }
/* renderMenuTab: an idle tab is the same texture shaded to 0x32/0x80 of its colour (renderRectPolyFT4 flag 1), not
   faded into what lies behind it. */
.player-tab-left, .player-tab-middle, .player-tab-right { position: absolute; display: block; top: 0; height: 100%; image-color: #646464; }
.player-tab-left { left: 0; width: 21dp; decorator: image(digimon-tab-left-idle); }
.player-tab-middle { left: 21dp; right: 21dp; decorator: image(digimon-tab-middle-idle); }
.player-tab-right { right: 0; width: 21dp; decorator: image(digimon-tab-right-idle); }
.selected .player-tab-left { decorator: image(digimon-tab-left-active); image-color: #ffffff; }
.selected .player-tab-middle { decorator: image(digimon-tab-middle-active); image-color: #ffffff; }
.selected .player-tab-right { decorator: image(digimon-tab-right-active); image-color: #ffffff; }
.player-tab-label { position: relative; left: 21dp; top: 9dp; white-space: nowrap; }
#panel.on-player .player-line { position: absolute; margin: 0; padding: 0; height: 36dp; line-height: 36dp; font-size: 36dp; color: #fff371; }
#panel.on-player .player-value { position: absolute; top: -3dp; float: none; color: #d6d6d6; }
/* The label ends 6dp before the name's box (the original's NAME begins 25 pixels in, and longer labels, Spanish
   "Nombre", grow to the left); the name keeps its place in the box. */
#player-name-line { left: 0; top: 21dp; width: 183dp; text-align: right; }
#panel.on-player #player-name { left: 195dp; top: 3dp; width: 216dp; white-space: nowrap; text-align: left; }
#player-level-line { left: 336dp; top: 105dp; }
#panel.on-player #player-level, #panel.on-player #player-raised, #panel.on-player #player-medals { left: 270dp; width: 48dp; text-align: right; }
#panel.on-player #player-rank { position: absolute; display: block; clear: none; left: 231dp; top: 51dp; width: 288dp; margin: 0; text-align: left; white-space: nowrap; }
#player-raised-line { left: 336dp; top: 216dp; }
#player-bits-line { left: 336dp; top: 273dp; }
#panel.on-player #player-bits { left: 234dp; width: 144dp; text-align: right; }
#player-time-line { left: 336dp; top: 333dp; }
#panel.on-player #player-time { left: 261dp; width: 228dp; white-space: nowrap; }
#player-items-line-label { left: 336dp; top: 438dp; }
#player-medals-line { left: 336dp; top: 498dp; }
.player-inset { position: absolute; height: 45dp; box-sizing: border-box; border: 3dp #020202; border-right-color: #6987a0; border-bottom-color: #6987a0; background-color: #354b5c; }
#player-name-box { left: 189dp; top: 18dp; width: 228dp; }
#player-level-box { left: 600dp; top: 96dp; width: 84dp; }
#player-rank-box { left: 561dp; top: 150dp; width: 300dp; }
#player-raised-box { left: 600dp; top: 207dp; width: 84dp; }
#player-bits-box { left: 564dp; top: 264dp; width: 228dp; }
#player-time-box { left: 564dp; top: 324dp; width: 228dp; }
#player-medals-box { left: 600dp; top: 489dp; width: 84dp; }
#panel.on-player .player-item-box { top: 426dp; width: 57dp; height: 57dp; }
#player-item-box-0 { left: 600dp; } #player-item-box-1 { left: 660dp; } #player-item-box-2 { left: 720dp; } #player-item-box-3 { left: 780dp; }
.player-separator, .player-separator span { position: absolute; }
.player-separator span { display: block; background-color: #020202; }
.player-separator .rule-light { background-color: #6987a0; }
#player-header-line { left: 6dp; top: 69dp; width: 885dp; height: 9dp; }
#player-header-line span { height: 3dp; }
#player-header-line .rule-first { left: 3dp; right: 3dp; top: 0; }
#player-header-line .rule-light { left: 0; right: 0; top: 3dp; }
#player-header-line .rule-last { left: 3dp; right: 3dp; top: 6dp; }
#player-vertical-line { left: 306dp; top: 72dp; width: 9dp; height: 495dp; }
#player-vertical-line span { width: 3dp; }
#player-vertical-line .rule-first { left: 0; top: 3dp; bottom: 6dp; }
#player-vertical-line .rule-light { left: 3dp; top: 0; bottom: 3dp; }
#player-vertical-line .rule-last { left: 6dp; top: 3dp; height: 321dp; }
#player-vertical-line .rule-tail { left: 6dp; top: 333dp; bottom: 0; }
#player-items-line { left: 309dp; top: 396dp; width: 582dp; height: 9dp; }
#player-items-line span { height: 3dp; }
#player-items-line .rule-first { left: 0; right: 6dp; top: 0; }
#player-items-line .rule-light { left: 3dp; right: 0; top: 3dp; }
#player-items-line .rule-last { left: 3dp; right: 6dp; top: 6dp; }
#player-portrait-clip { position: absolute; left: 0; top: 75dp; width: 306dp; height: 492dp; overflow: hidden; }
#player-portrait { position: absolute; left: -33dp; top: -171dp; width: 960dp; height: 720dp; }
/* Tab opens the engine's utilities separately; they are not part of the original profile. */
#panel.on-player.player-tools-open { top: 120dp; width: 552dp; height: auto; margin-left: -276dp; padding: 6dp 9dp 9dp 9dp; box-sizing: content-box; background-color: #2d384080; }
#panel.on-player.player-tools-open #title, #panel.on-player.player-tools-open #prompts, #panel.on-player.player-tools-open #player-tools { display: block; }
#panel.on-player.player-tools-open #page-player { height: auto; }
#panel.on-player.player-tools-open #player-tabs, #panel.on-player.player-tools-open #player-profile { display: none; }

#panel.on-player #player-chart { display: none; position: relative; height: 564dp; }
#panel.on-player.player-chart #player-profile { display: none; }
#panel.on-player.player-chart #player-chart { display: block; }
#panel.on-player.player-tools-open #player-chart { display: none; }
#panel.on-player .player-tab.unavailable { focus: none; tab-index: none; }
.chart-stage { position: absolute; top: 21dp; height: 480dp; box-sizing: border-box; border: 3dp #bebebe; }
#chart-stage-0 { left: 30dp; width: 105dp; border-color: #c8a0aa; border-right-color: #8c3c5a; border-bottom-color: #8c3c5a; background-color: #a55a73; }
#chart-stage-1 { left: 141dp; width: 105dp; border-color: #a578a0; border-right-color: #4b1446; border-bottom-color: #4b1446; background-color: #6e2d5a; }
#chart-stage-2 { left: 252dp; width: 105dp; height: 531dp; border-color: #5082c8; border-right-color: #0a375f; border-bottom-color: #0a375f; background-color: #0f5082; }
#chart-stage-3 { left: 363dp; width: 321dp; border-color: #5aaf6e; border-right-color: #005a28; border-bottom-color: #005a28; background-color: #008741; }
#chart-stage-4 { left: 690dp; width: 171dp; border-color: #d29669; border-right-color: #78411e; border-bottom-color: #78411e; background-color: #af642d; }
#panel.on-player .chart-cell, #panel.on-player .chart-cell:focus { position: absolute; width: 57dp; height: 57dp; margin: 0; padding: 0; border: 3dp #bebebe; border-right-color: #3c3c3c; border-bottom-color: #3c3c3c; box-sizing: border-box; background-color: #878787; }
#panel.on-player .chart-cell.hidden, .chart-icon.hidden { display: none; }
.chart-icon { display: block; width: 48dp; height: 48dp; pointer-events: none; }
#chart-cursor { position: absolute; width: 72dp; height: 60dp; pointer-events: none; }
#chart-cursor.hidden { display: none; }

#panel.on-player.chart-detail-open #player-chart { display: none; }
#panel.on-player.chart-detail-open #chart-detail { display: block; }
#panel.on-player #chart-detail { display: none; position: absolute; left: 0; top: 0; width: 894dp; height: 564dp; }
.chart-detail-cell { position: absolute; width: 57dp; height: 57dp; padding: 0; border: 3dp #bebebe; border-right-color: #3c3c3c; border-bottom-color: #3c3c3c; box-sizing: border-box; background-color: #878787; }
.chart-detail-cell.hidden, .chart-detail-line.hidden { display: none; }
.chart-detail-line { position: absolute; height: 3dp; transform-origin: 0dp 0dp; pointer-events: none; }
#chart-detail-tree, #chart-detail-level, #chart-detail-name { position: absolute; font-size: 36dp; line-height: 36dp; color: #d6d6d6; white-space: nowrap; }
#chart-detail-tree { left: 387dp; top: 27dp; color: #fff371; }
#chart-detail-level { left: 81dp; top: 438dp; width: 324dp; text-align: center; }
#chart-detail-name { left: 45dp; top: 495dp; width: 396dp; text-align: center; }

#panel.on-player #chart-detail-transition { display: block; position: absolute; box-sizing: border-box; border: 3dp #808080; background-color: transparent; pointer-events: none; }
#panel.on-player #chart-detail-transition.hidden { display: none; }

#panel.on-player #player-medals-view { display: none; position: relative; height: 564dp; }
#panel.on-player.player-medals #player-profile, #panel.on-player.player-medals #player-chart { display: none; }
#panel.on-player.player-medals #player-medals-view { display: block; }
#panel.on-player.player-tools-open #player-medals-view { display: none; }
#medals-title { position: absolute; left: 285dp; top: 21dp; width: 324dp; font-size: 36dp; line-height: 36dp; text-align: center; color: #fff371; }
.medals-rule { position: absolute; left: 6dp; width: 885dp; height: 9dp; }
.medals-rule span { position: absolute; height: 3dp; background-color: #020202; }
.medals-rule .first { left: 3dp; right: 3dp; top: 0; }
.medals-rule .light { left: 0; right: 0; top: 3dp; background-color: #90d9fa; }
.medals-rule .last { left: 3dp; right: 3dp; top: 6dp; }
#medals-rule-header { top: 63dp; }
#medals-rule-middle { top: 306dp; }
#medals-rule-footer { top: 501dp; }
#medals-rule-vertical { left: 654dp; top: 72dp; width: 9dp; height: 234dp; }
#medals-rule-vertical .first { left: 0; right: auto; top: 0; width: 3dp; height: 228dp; }
#medals-rule-vertical .light { left: 3dp; right: auto; top: -3dp; width: 3dp; height: 243dp; }
#medals-rule-vertical .last { left: 6dp; right: auto; top: 0; width: 3dp; height: 234dp; }
#panel.on-player .medal-cell, #panel.on-player .medal-cell:focus { position: absolute; width: 51dp; height: 72dp; margin: 0; padding: 0; border-width: 0; background-color: transparent; }
.medal-ribbon, .medal-shadow { position: absolute; top: 0; width: 45dp; height: 72dp; pointer-events: none; }
.medal-ribbon { left: 6dp; } .medal-shadow { left: 0; }
#medals-cursor { position: absolute; width: 72dp; height: 72dp; pointer-events: none; }
#medals-cursor.hidden { display: none; }
#medals-name-box { left: 153dp; top: 327dp; width: 531dp; height: 45dp; }

/* The card list (game_menu.c: renderCardsView): "Card List" in colour 3 at (-36, -80) from the screen's centre, which
   is (113, 8) of the page; 66 slots that renderBorderBox draws 18 x 18 with a #BEBEBE line on the top and the left, a
   #3C3C3C one on the bottom and the right and a #696969 fill; the cursor's 24 x 20 frame; the prompts at y 83. */
#panel.on-player #player-cards-view { display: none; position: relative; height: 564dp; }
#panel.on-player.player-cards #player-profile, #panel.on-player.player-cards #player-chart, #panel.on-player.player-cards #player-medals-view { display: none; }
#panel.on-player.player-cards #player-cards-view { display: block; }
#panel.on-player.player-tools-open #player-cards-view { display: none; }
#cards-title { position: absolute; left: 339dp; top: 24dp; width: 216dp; font-size: 36dp; line-height: 36dp; text-align: center; color: #fff371; white-space: nowrap; }
/* The pages' Select and Cancel prompts, where the original draws its pad glyphs (blue and green) and words: here the
   key of the device in use in the glyph's colour, the two prompts one after the other and ending at the panel's
   right edge, since a key's name is wider than a glyph. */
.page-prompts { position: absolute; height: 36dp; font-size: 36dp; color: #d6d6d6; white-space: nowrap; }
.page-prompt { display: inline-block; margin-right: 54dp; }
.page-prompt:last-child { margin-right: 0; }
.prompt-key { color: #90a8f8; margin-right: 6dp; }
.prompt-key.cancel-key { color: #3cff3c; }
/* The chart's prompts stay right of the rookie column, which reaches down past them: a key's name is wider than the
   original's pad glyph, so this row is drawn a pixel tighter, closer together and nearer the edge. */
#chart-prompts { right: 15dp; top: 516dp; letter-spacing: -3dp; }
#chart-prompts .page-prompt { margin-right: 24dp; }
#chart-prompts .page-prompt:last-child { margin-right: 0; }
#chart-prompts .prompt-key { margin-right: 3dp; }
#medals-prompts { right: 30dp; top: 519dp; }
#cards-prompts { right: 30dp; top: 513dp; }
.card-cell { position: absolute; width: 57dp; height: 57dp; box-sizing: border-box; border: 3dp #3c3c3c; border-top-color: #bebebe; border-left-color: #bebebe; background-color: #696969; }
#cards-cursor { position: absolute; width: 72dp; height: 60dp; pointer-events: none; }
#cards-cursor.hidden { display: none; }

/* The item boxes' icons (renderPlayerInfoView): 16 x 16 of SYSTEM_W, palette 7, one pixel inside each box. */
.player-item-icon { position: absolute; top: 0; width: 48dp; height: 48dp; }
/* game_menu.c: renderPlayerInfoView draws the icons 21 pixels apart, the boxes are 20 apart. */
#player-item-0 { left: 0; decorator: image(player-item-0); } #player-item-1 { left: 3dp; decorator: image(player-item-1); }
#player-item-2 { left: 6dp; decorator: image(player-item-2); } #player-item-3 { left: 9dp; decorator: image(player-item-3); }
.player-item-icon.hidden { display: none; }

/* renderMedalView: a held medal has no dark cover; the selected one's name in the box at (56, 111) of the page and its
   three lines from (23, 127), 13 pixels apart. */
.medal-cell.held .medal-shadow { display: none; }
.medal-text { position: absolute; height: 36dp; font-size: 36dp; line-height: 36dp; color: #d6d6d6; white-space: nowrap; }
#medal-name { left: 168dp; top: 333dp; }
.medal-line { left: 69dp; }
#medal-line-0 { top: 381dp; } #medal-line-1 { top: 420dp; } #medal-line-2 { top: 459dp; }

/* The card list's icons (renderCardsView), one pixel inside the slot; a card's picture (renderCardImage, 150 x 180) and
   copies (renderCardCount) in their boxes. */
.card-icon { position: absolute; left: 0; top: 0; width: 48dp; height: 48dp; }
.card-icon.hidden { display: none; }
#card-detail { position: absolute; left: 222dp; top: 15dp; width: 450dp; height: 540dp; box-sizing: border-box; z-index: 5; }
#card-detail-image { position: absolute; left: -3dp; top: -6dp; width: 450dp; height: 540dp; }
#card-count-box { position: absolute; left: 669dp; top: 471dp; width: 162dp; height: 72dp; box-sizing: border-box; z-index: 6; }
#card-count { position: absolute; left: 42dp; top: 15dp; font-size: 36dp; line-height: 36dp; color: #d6d6d6; }
