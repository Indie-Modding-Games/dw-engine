/* ------------------------------------------------------------------------------------------------------------------
   The map's name over the fade (map.c: renderMapName): the ink colour, centred on line 114, no box. */

#map-title {
	top: 342dp;
	height: 36dp;
	margin-top: -18dp;
	line-height: 36dp;
	font-size: 33dp;
	color: #d0d0d0;
}

/* ------------------------------------------------------------------------------------------------------------------
   Deltas of this skin. The round minimap (an engine improvement, on unless turned off; the original has none) keeps
   the modern skin's layout, everything centred on the disc, in the original's look: the map's name and the time in
   the original's windows (the original-box border with the corner sprites extracted from the disc, black-filled so
   they read over any ground, in the original-look font), the ring as the windows' border drawn round (four stripes of
   one original pixel, 3dp: black, light cyan, dark cyan and black from the inside out), the north mark and the player
   in the original's text yellow (#fff371) and the partner in the light cyan of its borders. A long name breaks into
   centred lines inside its box instead of running past the disc. The menu button is a small box with the
   prompt. */

#minimap {
	right: 24dp;
	top: 18dp;
}

#minimap-name {
	display: block;
	margin: 0 0 -3dp 0;
	text-align: center;
	padding: 4dp 4dp 2dp 4dp;
	border: 3dp transparent;
	border-radius: 0;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
	font-family: original-look;
	font-weight: normal;
	background-color: #000000c0;
	font-size: 18dp;
	line-height: 22dp;
	color: #d0d0d0;
	white-space: normal;
}

#minimap-frame {
	decorator: minimap-disc(original #000000a8 #90d9fa #00000000 3dp 0dp);
}

/* The north mark on a black badge with the ring's light cyan round it, drawn over the ring as the modern skin's is:
   bare, the letter's foot lay across the ring's stripes. */
#minimap-north {
	top: 2dp;
	width: 26dp;
	height: 26dp;
	margin-left: -13dp;
	border-radius: 13dp;
	border: 1dp #90d9fa;
	background-color: #000000;
	font-family: original-look;
	font-size: 18dp;
	font-weight: normal;
	line-height: 26dp;
	color: #fff371;
}

#minimap-player { image-color: #fff371; }
#minimap-partner { image-color: #90d9fa; }
/* The enemies (the option minimap_enemies): small orange-red dots, the modern skin's size. */
#minimap-enemies .enemy {
	width: 10dp;
	height: 10dp;
	margin-left: -5dp;
	margin-top: -5dp;
	image-color: #ff6a3a;
}
/* The items on the ground (the option minimap_items): small light green diamonds, under the enemies. */
#minimap-items .item {
	width: 11dp;
	height: 11dp;
	margin-left: -5.5dp;
	margin-top: -5.5dp;
	image-color: #8dff7a;
}

#minimap-clock {
	margin-top: -6dp;
	padding: 1dp 10dp;
	border: 3dp transparent;
	border-radius: 0;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
	font-family: original-look;
	font-weight: normal;
	background-color: #000000;
	font-size: 20dp;
	line-height: 24dp;
}

/* Only the time, white, as the box under the dial: the original's field shows no date. */
#minimap-day {
	display: none;
}

#minimap-time {
	margin-left: 0;
	font-weight: normal;
	color: #ffffff;
}

#menu-button {
	left: 30dp;
	top: auto;
	bottom: 27dp;
	padding: 0 9dp;
	font-size: 22dp;
	line-height: 30dp;
	border: 3dp transparent;
	background-color: #2d384080;
}

#menu-button:hover {
	background-color: #2d3840c0;
}

/* ------------------------------------------------------------------------------------------------------------------
   The shop job's bar (an engine improvement, the option shop_job_bar; the original has none): one of the original's
   boxes at the top centre, in the original-look font at twice its cells, with a bar in the field bars' colours, pink
   up to the better pay's mark, blue past it and white once the shopkeeper joins. This sheet goes over the modern
   skin's, so it sets again every property that one gives the bar. */

#shop-job {
	width: 600dp;
	margin-left: -306dp;
	padding: 6dp 9dp;
	border: 3dp transparent;
	border-radius: 0;
	background-color: #000000c0;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
	font-family: original-look;
	font-size: 22dp;
	line-height: 24dp;
	color: #d0d0d0;
}

#shop-job-title {
	font-weight: normal;
}

#shop-job-bar {
	height: 12dp;
	margin: 6dp 0;
	border-radius: 0;
	background-color: #303030;
}

#shop-job-fill {
	border-radius: 0;
	border-top: 3dp #f0b8d0;
	background-color: #e05890;
}

#shop-job.better #shop-job-fill { border-top-color: #90c8f0; background-color: #0080d0; }
#shop-job.joins #shop-job-fill { border-top-color: #ffffff; background-color: #d0d0d0; }

.shop-job-mark {
	width: 3dp;
	margin-left: -1dp;
	background-color: #fff371;
}

#shop-job-foot {
	height: 24dp;
	font-size: 22dp;
}

#shop-job-next {
	color: #fff371;
}
