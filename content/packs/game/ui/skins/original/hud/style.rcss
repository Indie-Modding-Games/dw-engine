/* The field HUD in the original look: the dial clock at the top left, the happiness and discipline bars at the bottom
   right, the need bubble over the partner and the map's name; nothing else, as the original.

   Positions are the captures' (field_hud_day, field_clock_day, field_partner_bars): the decompilation's screen
   coordinates plus 6 lines, the constant offset between where the original draws and the picture it shows. On a
   wide screen the clock keeps to the left edge and the bars to the right one, at the original's distances.

   The panels the original lacks are hidden here: the date in figures, the bars' numbers and labels, the needs
   panel, HP and MP. The menu button, the minimap and the time in digits stay as documented deltas: the button is how
   the pointer opens the menu, the round minimap is an option, on by default, laid out as the modern skin's and drawn in
   the original's look (see below), and the time in digits is an option, on by default, in a small box under the dial. */

body {
	pointer-events: none;
}

/* ------------------------------------------------------------------------------------------------------------------
   The clock (clock.c: renderGameClock). The dial (48 x 40) at (25, 32), the bells at (23, 30) and (59, 30), the sun or
   the moon (32 x 16) at (33, 20), the minute hand turning on its pixel (3, 13) at the dial's centre (48, 54), and the
   hour dot (6 x 6) on a ring round it. All from the clock's box at (23, 26): 6 lines added to the decompilation's
   (23, 20). The script turns the hand (rotate) and places the dot (left and top in percent of #field-clock-dial);
   the ring is 34 pixels across, measured on field_clock_day, centred on the hand's pivot. */

#field-status {
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	width: auto;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
	font-size: 33dp;
}

#field-clock {
	display: block;
	position: absolute;
	left: 69dp;
	top: 78dp;
	width: 156dp;
	height: 156dp;
	margin: 0;
	decorator: image(clock-sun scale-none center top), image(clock-bell-left scale-none left 27.78%),
		image(clock-bell-right scale-none right 27.78%), image(clock-dial scale-none center bottom);
	animation: 0.8s linear infinite clock-sun-turn;
	transition: left 0.1s linear-in-out;
}

#field-clock.night {
	decorator: image(clock-moon scale-none center top), image(clock-bell-left scale-none left 27.78%),
		image(clock-bell-right scale-none right 27.78%), image(clock-dial scale-none center bottom);
	animation: 0.8s linear infinite clock-moon-turn;
}

/* The sun and the moon turn through four frames, one every 4 of the original's 20 frames a second, so a turn takes
   0.8 s (clock.c: renderGameClock, frame = (CURRENT_FRAME % 16) / 4 into CLOCK_TEXCOORD_U and CLOCK_TEXCOORD_V): the
   sun shows its frames 0, 1, 2, 1 and the moon 0, 1, 0, 1. A decorator does not blend between two images, so each
   frame holds until the next keyframe, which starts a hair after the last one ends. */
@keyframes clock-sun-turn {
	0%, 24.9% { decorator: image(clock-sun scale-none center top), image(clock-bell-left scale-none left 27.78%),
		image(clock-bell-right scale-none right 27.78%), image(clock-dial scale-none center bottom); }
	25%, 49.9% { decorator: image(clock-sun-1 scale-none center top), image(clock-bell-left scale-none left 27.78%),
		image(clock-bell-right scale-none right 27.78%), image(clock-dial scale-none center bottom); }
	50%, 74.9% { decorator: image(clock-sun-2 scale-none center top), image(clock-bell-left scale-none left 27.78%),
		image(clock-bell-right scale-none right 27.78%), image(clock-dial scale-none center bottom); }
	75%, 100% { decorator: image(clock-sun-1 scale-none center top), image(clock-bell-left scale-none left 27.78%),
		image(clock-bell-right scale-none right 27.78%), image(clock-dial scale-none center bottom); }
}

@keyframes clock-moon-turn {
	0%, 24.9%, 50%, 74.9% { decorator: image(clock-moon scale-none center top),
		image(clock-bell-left scale-none left 27.78%), image(clock-bell-right scale-none right 27.78%),
		image(clock-dial scale-none center bottom); }
	25%, 49.9%, 75%, 100% { decorator: image(clock-moon-1 scale-none center top),
		image(clock-bell-left scale-none left 27.78%), image(clock-bell-right scale-none right 27.78%),
		image(clock-dial scale-none center bottom); }
}

#field-clock-dial {
	display: block;
	position: absolute;
	left: 24dp;
	top: 51dp;
	width: 102dp;
	height: 102dp;
}

#field-clock-hour-dot {
	position: absolute;
	width: 18dp;
	height: 18dp;
	margin-left: -9dp;
	margin-top: -9dp;
	decorator: image(clock-hour-dot);
}

#field-clock-minute-hand {
	position: absolute;
	left: 42dp;
	top: 12dp;
	width: 24dp;
	height: 48dp;
	transform-origin: 9dp 39dp;
	decorator: image(clock-minute-hand);
}

#field-time, #field-date {
	display: none;
}

/* The time in digits (an engine improvement, on with the option digital_time: the class digital on #field-clock):
   the game time as HH:MM in the frame of the original's windows (theme.rcss, .original-box: its border lines and
   corner sprites) filled black so the figures read over any ground, centred under the dial (the dial's centre is
   78dp from the clock's left), in white in the original-look font at twice its 11-pixel cells (22dp; the bitmap font
   draws only at whole multiples, and three times is too wide for the box). */
#field-clock.digital #field-time {
	display: block;
	position: absolute;
	left: 30dp;
	top: 162dp;
	width: 96dp;
	padding: 2dp 0;
	border: 3dp transparent;
	border-radius: 0;
	background-color: #000000;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
	font-family: original-look;
	font-size: 22dp;
	line-height: 20dp;
	text-align: center;
	color: #ffffff;
}

/* While a menu or a battle stops the field, the original slides the clock out to the left and the bars out to the
   right, 50 pixels a frame each, and back when the field runs again. The clock (clock.c: renderGameClock) moves
   CLOCK_OFFSET_X between -135, where it shows (its left bell at screen x 23, 69dp), and -220, 85 pixels further left
   (-186dp): about
   2 frames, 0.1 s. The bars (partner_impl.c: renderStatusBars) move STATUS_UI_OFFSET_X between 75, where they show
   (screen x 235, 30dp from the right edge), and 240, 165 pixels further right (right: -465dp): about 3 frames,
   0.17 s. On a wide screen they leave from the edges they keep to. */
#field-status #field-clock {
	left: -186dp;
}

#field-status.shown #field-clock {
	left: 69dp;
}

/* The time in digits leaves at once instead: a text out of the window is not one the player reads. */
#field-status #field-clock.digital #field-time {
	visibility: hidden;
}

#field-status.shown #field-clock.digital #field-time {
	visibility: visible;
}

/* ------------------------------------------------------------------------------------------------------------------
   The bars (partner_impl.c: renderStatusBars). Each is the 75 x 8 frame of SYSTEM_W at x 235, y 211 and 223 (the
   decompilation's 205 and 217 plus 6), the icon (11 x 11) at the frame's (3, -2), and 25 pips of 2 pixels from the
   frame's (18, 3), 2 pixels tall: their top line light, their bottom line dark. Pink (#f0b8d0 over #e05890) fills to
   the middle of the range, blue (#90c8f0 over #0080d0) over it from the middle: the script sizes both in whole pips
   (the class pips, which this skin puts on the bars in skin.yaml) and marks the row "low" below the middle, where the
   icon changes. On a wide screen the bars keep the original's 10 pixels to the right edge. */

.field-meter {
	display: block;
	position: absolute;
	right: 30dp;
	width: 225dp;
	height: 24dp;
	margin: 0;
	decorator: image(field-bar-frame);
	transition: right 0.17s linear-in-out;
}

#field-meter-0 { bottom: 63dp; }
#field-meter-1 { bottom: 27dp; }

#field-status .field-meter {
	right: -465dp;
}

#field-status.shown .field-meter {
	right: 30dp;
}

/* The icon hangs over the frame's left end; the label and the number are not drawn. */
#field-status .field-meter .label {
	display: block;
	position: absolute;
	left: 9dp;
	top: -6dp;
	width: 33dp;
	height: 33dp;
	font-size: 0;
	color: transparent;
}

#field-meter-0 .label { decorator: image(face-happy); }
#field-meter-0.low .label { decorator: image(face-sad); }

/* In an area the partner likes or dislikes (hud.partner.area, which the script puts on the status as the class
   area-liked or area-disliked), the face alternates with the one 11 pixels to its left (liked) or right (disliked) in
   SYSTEM_W: that face for 5 of every 10 of the original's 20 frames a second, then the usual one for the other 5
   (partner_impl.c: renderStatusBars, PLAYTIME_FRAMES % 10 < 5). */
#field-status.area-liked #field-meter-0 .label { animation: 0.5s linear infinite face-happy-liked-flicker; }
#field-status.area-liked #field-meter-0.low .label { animation: 0.5s linear infinite face-sad-liked-flicker; }
#field-status.area-disliked #field-meter-0 .label { animation: 0.5s linear infinite face-happy-disliked-flicker; }
#field-status.area-disliked #field-meter-0.low .label { animation: 0.5s linear infinite face-sad-disliked-flicker; }

@keyframes face-happy-liked-flicker {
	0%, 49.9% { decorator: image(face-happy-liked); }
	50%, 100% { decorator: image(face-happy); }
}

@keyframes face-sad-liked-flicker {
	0%, 49.9% { decorator: image(face-sad-liked); }
	50%, 100% { decorator: image(face-sad); }
}

@keyframes face-happy-disliked-flicker {
	0%, 49.9% { decorator: image(face-happy-disliked); }
	50%, 100% { decorator: image(face-happy); }
}

@keyframes face-sad-disliked-flicker {
	0%, 49.9% { decorator: image(face-sad-disliked); }
	50%, 100% { decorator: image(face-sad); }
}
#field-meter-1 .label { decorator: image(discipline-high); }
#field-meter-1.low .label { decorator: image(discipline-low); }

#field-status .field-meter .value {
	display: none;
}

#field-status .field-meter .bar {
	position: absolute;
	left: 54dp;
	top: 9dp;
	width: 150dp;
	height: 6dp;
	margin: 0;
	border-radius: 0;
	background-color: transparent;
}

#field-status .field-meter .fill {
	position: absolute;
	left: 0;
	top: 0;
	height: 3dp;
	border-radius: 0;
	border-top: 3dp #f0b8d0;
	background-color: #e05890;
}

#field-status .field-meter .fill.high {
	border-top-color: #90c8f0;
	background-color: #0080d0;
}

/* HP, MP and the needs panel are not on the original's field: the needs show as the bubble below. */
#field-needs, #field-pools {
	display: none;
}

/* ------------------------------------------------------------------------------------------------------------------
   The need bubble over the partner (bubble.c: the 32 x 32 balloon of FEEL_EF and the need's sprite in it: the meal,
   the toilet, the sleep's three "Z", the tiredness's drops, the injury or the sickness). The shared view places
   #field-partner-bubble where the original's bubble settles, anchored at its bottom centre (ui/hud/structure.rcss;
   the balloon's pivot is its pixel (16, 31)), gives it "shown" while the partner shows a need, the need on its first
   icon (sleep before tiredness before hunger before toilet before injury before sickness: partner_impl.c:
   handleConditionBubble) and the class "frame-<n>" of the original's frame the bubble is on (1 to 60, 20 a second).
   Each sprite sits by its pivot against the balloon's (CONDITION_SPRITES): the meal, the toilet, the injury and the
   sickness (pivot y 26) 5 pixels under the balloon's top, the meal 3 pixels higher on the frame before each of its
   pictures changes; the drop (pivot y 23 + CONDITION_TIRED_FRAME_MY) 1 pixel over the top, falling to 8 under it;
   the three "Z" (pivots (0, 13), (8, 19) and (3, 28)) up and to the right of the middle.

   The frames (bubble.c: tickConditionBubble, renderConditionBubble): the balloon grows from nothing over the first
   10, the need plays its own animation by the bubble's frame count (the meal's four pictures every 19 frames, the
   toilet's three every 13, the injury's every 20, the sickness's two every 20, the drop falling every 13 and the
   "Z" appearing one by one, CONDITION_ICON_SLEEPY), on frame 51 the balloon bursts (CONDITION_SPRITES[10] at 2.5
   times, its middle 23 pixels over the anchor), and it is gone until the game makes it again on frame 60. Its bob of
   12 units is not imitated. Each scale is spelt long on purpose: RmlUi 6.3 compares a transform's last function
   against its longest names (11 characters) without checking the string's end, so a short "scale(1)" at the end
   reads past it. */

#field-partner-bubble {
	display: none;
	width: 96dp;
	height: 96dp;
	transform-origin: 50% 100%;
}

#field-partner-bubble.shown {
	display: block;
	decorator: image(need-bubble);
}

/* Several needs at once (an engine improvement, the option need_bubble_stack): the balloon widens from 32 pixels to
   50 for two needs, 68 for three, 86 for four and 104 for five, in one row, built from its own pieces so nothing is
   stretched: each half is its round edge, one column of its body repeated, and its half of the centre with the tail
   (skin.yaml: need-bubble-left ...). The needs sit 16 pixels each with 2 between them, 8 from the edges like the
   original's one, each at the height the original gives it and on the same frames; the most urgent on the left. One
   row keeps the balloon's height and its tail as the original's, and reads in the order of urgency; at five it is a
   third of the original's screen across, and the HUD moves it in from a side of the window it would cross
   (ui/hud/logic.lua). */
#field-partner-bubble .balloon-half,
#field-partner-bubble .need-icon {
	display: none;
	position: absolute;
	top: 0;
	height: 96dp;
}

#field-partner-bubble.stack-2 { width: 150dp; decorator: none; }
#field-partner-bubble.stack-3 { width: 204dp; decorator: none; }
#field-partner-bubble.stack-4 { width: 258dp; decorator: none; }
#field-partner-bubble.stack-5 { width: 312dp; decorator: none; }

#field-partner-bubble.stack-2 .balloon-half,
#field-partner-bubble.stack-3 .balloon-half,
#field-partner-bubble.stack-4 .balloon-half,
#field-partner-bubble.stack-5 .balloon-half {
	display: block;
	width: 50%;
}

#field-partner-bubble-left {
	left: 0;
	decorator: tiled-horizontal(need-bubble-left, need-bubble-fill-left, need-bubble-middle-left);
}

#field-partner-bubble-right {
	right: 0;
	decorator: tiled-horizontal(need-bubble-middle-right, need-bubble-fill-right, need-bubble-right);
}

#field-partner-bubble .need-icon { width: 48dp; }
#field-partner-bubble .need-icon.hunger,
#field-partner-bubble .need-icon.toilet,
#field-partner-bubble .need-icon.tired,
#field-partner-bubble .need-icon.sleep,
#field-partner-bubble .need-icon.injured,
#field-partner-bubble .need-icon.sick { display: block; }
#field-partner-bubble-icon-0 { left: 24dp; }
#field-partner-bubble-icon-1 { left: 78dp; }
#field-partner-bubble-icon-2 { left: 132dp; }
#field-partner-bubble-icon-3 { left: 186dp; }
#field-partner-bubble-icon-4 { left: 240dp; }

/* Each need's first picture, for a frame the rules below do not name. */
#field-partner-bubble .need-icon.hunger { decorator: image(need-hunger scale-none center 31.25%); }
#field-partner-bubble .need-icon.toilet { decorator: image(need-toilet scale-none center 31.25%); }
#field-partner-bubble .need-icon.tired { decorator: image(need-tired scale-none center -6.25%); }
#field-partner-bubble .need-icon.sleep { decorator: image(need-sleep scale-none right 75%); }
#field-partner-bubble .need-icon.injured { decorator: image(need-injured scale-none center 31.25%); }
#field-partner-bubble .need-icon.sick { decorator: image(need-sick scale-none center 31.25%); }

/* The growth. */
#field-partner-bubble.frame-1 { transform: translate(-50%, -100%) scale(0.000, 0.000); }
#field-partner-bubble.frame-2 { transform: translate(-50%, -100%) scale(0.100, 0.100); }
#field-partner-bubble.frame-3 { transform: translate(-50%, -100%) scale(0.200, 0.200); }
#field-partner-bubble.frame-4 { transform: translate(-50%, -100%) scale(0.300, 0.300); }
#field-partner-bubble.frame-5 { transform: translate(-50%, -100%) scale(0.400, 0.400); }
#field-partner-bubble.frame-6 { transform: translate(-50%, -100%) scale(0.500, 0.500); }
#field-partner-bubble.frame-7 { transform: translate(-50%, -100%) scale(0.600, 0.600); }
#field-partner-bubble.frame-8 { transform: translate(-50%, -100%) scale(0.700, 0.700); }
#field-partner-bubble.frame-9 { transform: translate(-50%, -100%) scale(0.800, 0.800); }
#field-partner-bubble.frame-10 { transform: translate(-50%, -100%) scale(0.900, 0.900); }

/* Each need's picture on each frame (renderConditionBubble). */
#field-partner-bubble.frame-1 .need-icon.hunger, #field-partner-bubble.frame-2 .need-icon.hunger,
#field-partner-bubble.frame-3 .need-icon.hunger, #field-partner-bubble.frame-19 .need-icon.hunger,
#field-partner-bubble.frame-20 .need-icon.hunger, #field-partner-bubble.frame-21 .need-icon.hunger,
#field-partner-bubble.frame-22 .need-icon.hunger, #field-partner-bubble.frame-38 .need-icon.hunger,
#field-partner-bubble.frame-39 .need-icon.hunger, #field-partner-bubble.frame-40 .need-icon.hunger,
#field-partner-bubble.frame-41 .need-icon.hunger {
	decorator: image(need-hunger scale-none center 31.25%);
}
#field-partner-bubble.frame-4 .need-icon.hunger, #field-partner-bubble.frame-23 .need-icon.hunger,
#field-partner-bubble.frame-42 .need-icon.hunger {
	decorator: image(need-hunger-1 scale-none center 12.5%);
}
#field-partner-bubble.frame-5 .need-icon.hunger, #field-partner-bubble.frame-6 .need-icon.hunger,
#field-partner-bubble.frame-7 .need-icon.hunger, #field-partner-bubble.frame-8 .need-icon.hunger,
#field-partner-bubble.frame-24 .need-icon.hunger, #field-partner-bubble.frame-25 .need-icon.hunger,
#field-partner-bubble.frame-26 .need-icon.hunger, #field-partner-bubble.frame-27 .need-icon.hunger,
#field-partner-bubble.frame-43 .need-icon.hunger, #field-partner-bubble.frame-44 .need-icon.hunger,
#field-partner-bubble.frame-45 .need-icon.hunger, #field-partner-bubble.frame-46 .need-icon.hunger {
	decorator: image(need-hunger-1 scale-none center 31.25%);
}
#field-partner-bubble.frame-9 .need-icon.hunger, #field-partner-bubble.frame-28 .need-icon.hunger,
#field-partner-bubble.frame-47 .need-icon.hunger {
	decorator: image(need-hunger-2 scale-none center 12.5%);
}
#field-partner-bubble.frame-10 .need-icon.hunger, #field-partner-bubble.frame-11 .need-icon.hunger,
#field-partner-bubble.frame-12 .need-icon.hunger, #field-partner-bubble.frame-13 .need-icon.hunger,
#field-partner-bubble.frame-29 .need-icon.hunger, #field-partner-bubble.frame-30 .need-icon.hunger,
#field-partner-bubble.frame-31 .need-icon.hunger, #field-partner-bubble.frame-32 .need-icon.hunger,
#field-partner-bubble.frame-48 .need-icon.hunger, #field-partner-bubble.frame-49 .need-icon.hunger,
#field-partner-bubble.frame-50 .need-icon.hunger {
	decorator: image(need-hunger-2 scale-none center 31.25%);
}
#field-partner-bubble.frame-14 .need-icon.hunger, #field-partner-bubble.frame-33 .need-icon.hunger {
	decorator: image(need-hunger-3 scale-none center 12.5%);
}
#field-partner-bubble.frame-15 .need-icon.hunger, #field-partner-bubble.frame-16 .need-icon.hunger,
#field-partner-bubble.frame-17 .need-icon.hunger, #field-partner-bubble.frame-18 .need-icon.hunger,
#field-partner-bubble.frame-34 .need-icon.hunger, #field-partner-bubble.frame-35 .need-icon.hunger,
#field-partner-bubble.frame-36 .need-icon.hunger, #field-partner-bubble.frame-37 .need-icon.hunger {
	decorator: image(need-hunger-3 scale-none center 31.25%);
}

#field-partner-bubble.frame-1 .need-icon.toilet, #field-partner-bubble.frame-2 .need-icon.toilet,
#field-partner-bubble.frame-3 .need-icon.toilet, #field-partner-bubble.frame-4 .need-icon.toilet,
#field-partner-bubble.frame-5 .need-icon.toilet, #field-partner-bubble.frame-6 .need-icon.toilet,
#field-partner-bubble.frame-13 .need-icon.toilet, #field-partner-bubble.frame-14 .need-icon.toilet,
#field-partner-bubble.frame-15 .need-icon.toilet, #field-partner-bubble.frame-16 .need-icon.toilet,
#field-partner-bubble.frame-17 .need-icon.toilet, #field-partner-bubble.frame-18 .need-icon.toilet,
#field-partner-bubble.frame-19 .need-icon.toilet, #field-partner-bubble.frame-26 .need-icon.toilet,
#field-partner-bubble.frame-27 .need-icon.toilet, #field-partner-bubble.frame-28 .need-icon.toilet,
#field-partner-bubble.frame-29 .need-icon.toilet, #field-partner-bubble.frame-30 .need-icon.toilet,
#field-partner-bubble.frame-31 .need-icon.toilet, #field-partner-bubble.frame-32 .need-icon.toilet,
#field-partner-bubble.frame-39 .need-icon.toilet, #field-partner-bubble.frame-40 .need-icon.toilet,
#field-partner-bubble.frame-41 .need-icon.toilet, #field-partner-bubble.frame-42 .need-icon.toilet,
#field-partner-bubble.frame-43 .need-icon.toilet, #field-partner-bubble.frame-44 .need-icon.toilet,
#field-partner-bubble.frame-45 .need-icon.toilet {
	decorator: image(need-toilet scale-none center 31.25%);
}
#field-partner-bubble.frame-7 .need-icon.toilet, #field-partner-bubble.frame-12 .need-icon.toilet,
#field-partner-bubble.frame-20 .need-icon.toilet, #field-partner-bubble.frame-25 .need-icon.toilet,
#field-partner-bubble.frame-33 .need-icon.toilet, #field-partner-bubble.frame-38 .need-icon.toilet,
#field-partner-bubble.frame-46 .need-icon.toilet {
	decorator: image(need-toilet-1 scale-none center 31.25%);
}
#field-partner-bubble.frame-8 .need-icon.toilet, #field-partner-bubble.frame-9 .need-icon.toilet,
#field-partner-bubble.frame-10 .need-icon.toilet, #field-partner-bubble.frame-11 .need-icon.toilet,
#field-partner-bubble.frame-21 .need-icon.toilet, #field-partner-bubble.frame-22 .need-icon.toilet,
#field-partner-bubble.frame-23 .need-icon.toilet, #field-partner-bubble.frame-24 .need-icon.toilet,
#field-partner-bubble.frame-34 .need-icon.toilet, #field-partner-bubble.frame-35 .need-icon.toilet,
