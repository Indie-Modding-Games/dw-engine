/* The burst, alone, and the gap until the next bubble. */
#field-partner-bubble.frame-51 {
	decorator: image(need-bubble-burst scale-none center bottom);
	transform: translate(-50%, -100%) translate(0dp, -9dp) scale(2.500, 2.500);
}

#field-partner-bubble.frame-51 .need-icon,
#field-partner-bubble.frame-51 .balloon-half {
	visibility: hidden;
}

