#field-partner-bubble.frame-41 .need-icon.evolving, #field-partner-bubble.frame-42 .need-icon.evolving,
#field-partner-bubble.frame-43 .need-icon.evolving {
	decorator: image(need-evolving scale-none center 54.1667%);
}
#field-partner-bubble.frame-6 .need-icon.evolving, #field-partner-bubble.frame-7 .need-icon.evolving,
#field-partner-bubble.frame-25 .need-icon.evolving, #field-partner-bubble.frame-26 .need-icon.evolving,
#field-partner-bubble.frame-44 .need-icon.evolving, #field-partner-bubble.frame-45 .need-icon.evolving {
	decorator: image(need-evolving-1 scale-none center 31.25%);
}
