#scrim.tech-editing #tech-message { left: 12dp; top: 300dp; width: 225dp; font-size: 18dp; }

/* Pestañas trapezoidales de renderMenuTab; la imagen se aporta con el disco del usuario. */
#scrim.digimon-screen #tabs { position: relative; }
#scrim.digimon-screen .tab, #scrim.digimon-screen .tab:focus {
    position: absolute; top: 0; height: 45dp; margin: 0; padding: 0;
    border-width: 0; background-color: transparent; box-sizing: border-box; text-align: left;
}
#scrim.digimon-screen #tab-status { left: 0; width: 222dp; }
#scrim.digimon-screen #tab-tech { left: 225dp; width: 186dp; }
#scrim.digimon-screen .tab.selected { height: 48dp; }
.tab-edge { position: absolute; display: block; top: 0; height: 100%; pointer-events: none; }
.tab-left { left: 0; width: 21dp; decorator: image(digimon-tab-left-idle); }
.tab-middle { left: 21dp; right: 21dp; decorator: image(digimon-tab-middle-idle); }
.tab-right { right: 0; width: 21dp; decorator: image(digimon-tab-right-idle); }
.tab .tab-edge { opacity: 0.45; }
.tab.selected .tab-edge { opacity: 1; }
.tab.selected .tab-left { decorator: image(digimon-tab-left-active); }
.tab.selected .tab-middle { decorator: image(digimon-tab-middle-active); }
.tab.selected .tab-right { decorator: image(digimon-tab-right-active); }
.tab-label { position: relative; left: 21dp; top: 6dp; }
#page-tech { height: 570dp; box-sizing: border-box; }

#scrim.digimon-screen .tab.selected { background-color: transparent; }
.tab .tab-edge { opacity: 0.25; }

#tech-info.hidden { display: none; }
#tech-info { position: absolute; left: 0; top: 0; width: 894dp; height: 570dp; pointer-events: none; }
#tech-info-name, #tech-info-stats { position: absolute; background-color: #323280; border: 3dp #90d9fa; box-sizing: border-box; }
#tech-info-name { left: 21dp; top: 276dp; width: 384dp; height: 57dp; padding: 9dp 12dp; font-size: 33dp; }
#tech-info-stats { left: 21dp; top: 339dp; width: 261dp; height: 207dp; }
#tech-info.info-right #tech-info-name { left: 492dp; }
#tech-info.info-right #tech-info-stats { left: 630dp; }
.info-label, .info-value { position: absolute; display: block; }
.info-label { left: 9dp; width: 72dp; height: 21dp; font-size: 0; color: transparent; }
.info-value { left: 129dp; width: 123dp; font-size: 21dp; }
.info-power { top: 9dp; }
.info-mp { top: 60dp; }
.info-range { top: 111dp; }
.info-effect { top: 162dp; }
.info-label.info-power { decorator: image(tech-power-label); }
.info-label.info-mp { width: 33dp; decorator: image(tech-mp-label); }
.info-label.info-range { width: 57dp; decorator: image(tech-range-label); }
.info-label.info-effect { width: 48dp; decorator: image(tech-effect-label); }

#tech-info { display: block; }

/* Detalles de renderDigimonMovesSelected: encabezado, separadores y cinco esquinas. */
#tech-info-heading { position: absolute; left: 30dp; top: 261dp; width: 111dp; height: 21dp; decorator: image(tech-info-heading); }
#tech-info.info-right #tech-info-heading { left: 501dp; }
.info-colon { position: absolute; left: 90dp; width: 30dp; height: 30dp; decorator: image(tech-info-colon); }
.info-colon.info-power { top: 9dp; }
.info-colon.info-mp { top: 60dp; }
.info-colon.info-range { top: 111dp; }
.info-colon.info-effect { top: 162dp; }
.info-value.info-power, .info-value.info-mp { font-size: 33dp; white-space: nowrap; }
.info-corner { position: absolute; width: 12dp; height: 12dp; }
#tech-info-tl { left: 15dp; top: 270dp; decorator: image(tech-info-tl); }
#tech-info-tr { left: 402dp; top: 270dp; decorator: image(tech-info-tr); }
#tech-info-bl { left: 15dp; top: 543dp; decorator: image(tech-info-bl); }
#tech-info-br { left: 264dp; top: 543dp; decorator: image(tech-info-br); }
#tech-info-notch { left: 402dp; top: 330dp; decorator: image(tech-info-br); }
#tech-info.info-right #tech-info-tl { left: 486dp; }
#tech-info.info-right #tech-info-tr { left: 873dp; }
#tech-info.info-right #tech-info-bl { left: 624dp; }
#tech-info.info-right #tech-info-br { left: 873dp; }
#tech-info.info-right #tech-info-notch { left: 486dp; decorator: image(tech-info-bl); }

.info-value.info-range, .info-value.info-effect, .tech-row .tech-range { font-size: 33dp; }

/* Profile: insets nativos de STATS_VIEW_INSETS y rótulos de STATS_VIEW_ELEMENTS.
   Los offsets descuentan el borde de 1px de la página. */
#status-head { left: 117dp; top: 60dp; }
#status-name { width: 294dp; height: 42dp; box-sizing: border-box; padding: 0; line-height: 36dp; }
#status-species-line { left: 0; top: 108dp; width: 894dp; }
#status-age-line, #status-weight-line { left: 0; top: 156dp; width: 894dp; }
#status-species, #status-age, #status-weight {
    position: absolute; top: 0; height: 42dp; box-sizing: border-box; margin: 0; padding: 0; line-height: 36dp;
}
#status-species { left: 117dp; width: 732dp; }
#status-age { left: 117dp; width: 78dp; }
#status-weight { left: 333dp; width: 78dp; }
#status-name-label, #status-species-label, #status-age-label, #status-weight-label {
    position: absolute; display: block; height: 30dp; color: transparent; font-size: 0;
}
#status-name-label { left: 33dp; top: 66dp; width: 78dp; decorator: image(status-name-label); }
#status-species-label { left: 33dp; top: 6dp; width: 78dp; decorator: image(status-species-label); }
#status-age-label { left: 48dp; top: 6dp; width: 57dp; decorator: image(status-age-label); }
#status-weight-label { left: 246dp; top: 6dp; width: 84dp; decorator: image(status-weight-label); }
#no-condition { display: none; }

#status-species-line #status-species { width: 732dp; }

/* Datos de especie y actividad dentro de Profile; condiciones en su fila nativa inferior. */
.profile-meta { position: absolute; display: block; }
#status-special-heading, #status-type-heading, #status-active-heading { top: 78dp; width: 75dp; height: 24dp; }
#status-special-heading { left: 474dp; decorator: image(status-special-heading); }
#status-type-heading { left: 603dp; decorator: image(status-type-heading); }
#status-active-heading { left: 702dp; decorator: image(status-active-heading); }
#status-specials { left: 474dp; top: 111dp; width: 108dp; height: 36dp; }
.status-special { display: inline-block; width: 36dp; height: 36dp; }
.status-special.hidden, #status-type.hidden { display: none; }
#status-type { left: 624dp; top: 111dp; width: 36dp; height: 36dp; }
#status-active { left: 702dp; top: 111dp; width: 144dp; height: 36dp; font-size: 33dp; }
#conditions { left: 33dp; top: 294dp; width: 315dp; height: 36dp; }
#conditions .condition { position: absolute; display: block; width: 36dp; height: 36dp; margin: 0; font-size: 0; color: transparent; }
#conditions .condition.hidden { display: none; }
.profile-special-0 { decorator: image(tech-glyph-0-0); }
#scrim.status-alternate .profile-special-0 { decorator: image(tech-glyph-0-1); }
.profile-special-1 { decorator: image(tech-glyph-1-0); }
#scrim.status-alternate .profile-special-1 { decorator: image(tech-glyph-1-1); }
.profile-special-2 { decorator: image(tech-glyph-2-0); }
#scrim.status-alternate .profile-special-2 { decorator: image(tech-glyph-2-1); }
.profile-special-3 { decorator: image(tech-glyph-3-0); }
#scrim.status-alternate .profile-special-3 { decorator: image(tech-glyph-3-1); }
.profile-special-4 { decorator: image(tech-glyph-4-0); }
#scrim.status-alternate .profile-special-4 { decorator: image(tech-glyph-4-1); }
.profile-special-5 { decorator: image(tech-glyph-5-0); }
#scrim.status-alternate .profile-special-5 { decorator: image(tech-glyph-5-1); }
.profile-special-6 { decorator: image(tech-glyph-6-0); }
#scrim.status-alternate .profile-special-6 { decorator: image(tech-glyph-6-1); }
.profile-type-1 { decorator: image(status-type-1); }
.profile-type-2 { decorator: image(status-type-2); }
.profile-type-3 { decorator: image(status-type-3); }
#conditions .profile-condition-sick { left: 0dp; decorator: image(status-condition-sick); }
#conditions .profile-condition-injured { left: 45dp; decorator: image(status-condition-injured); }
#conditions .profile-condition-hungry { left: 90dp; decorator: image(status-condition-hungry); }
#conditions .profile-condition-sleepy { left: 135dp; decorator: image(status-condition-sleepy); }
#conditions .profile-condition-sulking { left: 180dp; decorator: image(status-condition-sulking); }
#conditions .profile-condition-tired { left: 225dp; decorator: image(status-condition-tired); }
#conditions .profile-condition-needs_toilet { left: 270dp; decorator: image(status-condition-toilet); }

.profile-meta { z-index: 1; }

/* Condition: vidas y medidores, con sus posiciones y dimensiones nativas. */
#status-lives { display: none; }
.status-native-life { display: block; position: absolute; }
#status-life-label { left: 33dp; top: 366dp; width: 144dp; font-size: 33dp; color: #fff371; }
#status-life-hearts { left: 195dp; top: 366dp; width: 126dp; height: 33dp; }
.life-heart { position: absolute; display: block; top: 0; width: 36dp; height: 33dp; }
#life-heart-0 { left: 0; } #life-heart-1 { left: 42dp; } #life-heart-2 { left: 84dp; }
.life-fill, .life-outline { position: absolute; display: block; width: 36dp; height: 33dp; }
.life-fill { decorator: image(status-life-full); }
.life-outline { decorator: image(status-life-outline); }
.life-fill.hidden { display: none; }
#status-condition { left: 33dp; top: 417dp; width: 330dp; }
#status-condition .bar-row { display: block; position: relative; height: 45dp; }
#status-condition .label { position: absolute; left: 0; top: -6dp; width: 159dp; height: 36dp; padding: 0 0 0 36dp; box-sizing: border-box; font-size: 33dp; }
#meter-0-label { color: transparent; decorator: image(status-happy scale-none left top); }
#meter-0-label.negative { decorator: image(status-sad scale-none left top); }
#meter-1-label { decorator: image(discipline-high scale-none left top); }
#meter-1-label.low { decorator: image(discipline-low scale-none left top); }
#meter-2-label { decorator: image(status-virus scale-none left top); }
.status-native-happiness { display: block; position: absolute; left: 36dp; top: -6dp; width: 108dp; height: 36dp; decorator: image(status-happiness-name); }
#status-condition .meter { position: absolute; left: 159dp; top: 0; width: 150dp; height: 24dp; box-sizing: border-box; margin: 0; overflow: hidden; border: 3dp #020202; border-right-color: #6987a0; border-bottom-color: #6987a0; background-color: #354b5c; decorator: none; }
#status-condition .meter .fill { position: absolute; left: 0; top: 3dp; height: 18dp; decorator: vertical-gradient(#e04080 #f0c0e8); }
#status-condition .meter .fill.high { decorator: vertical-gradient(#3060a0 #b0d0e0); }
#status-condition #meter-2-fill { decorator: none; background-color: #c8c83c; }
