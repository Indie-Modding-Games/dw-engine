/* The shop's money box in the original look: the original's box (theme.rcss .original-box) and ink. */

body #bits-box, body #description {
	border: 3dp transparent;
	background-color: #2d384080;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
	font-family: original-look;
	color: #d0d0d0;
}

/* The shop's window opens under the money box (24,66 246 x 99 in the 960dp frame, money_box/structure.rcss), not over
   it: the pause menu's panel it borrows starts at 120dp, where the centred window ran over the box's right side. */
#panel {
	top: 180dp;
}
