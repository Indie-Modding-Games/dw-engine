/* The story's textboxes in the original look: the original's box (ui.c: renderUIBoxBorder) as the pause menu's, a
   light cyan rim (#90D9FA, the right side #4A9FC5), the corner sprites and the fill #2D3840 at half opacity, so the
   field shows through (capture cp09-arrival-first-dialog). A selection's row is marked by the original's grey bar
   (script_textbox.c: renderDialogueSelectionCursor, renderSelectionCursor; capture cp02-q1-choice-yes): #525A63 with
   a light top line (#B5B5B5), not by a square. */

body #box {
	border: 3dp transparent;
	background-color: #2d384080;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
}

/* The opening's questions are over a black screen: the box is opaque there (capture cp01-jijimon-first-line). */
body #box.top {
	background-color: #2d3840;
}

body .row.selected .cursor {
	width: 0dp;
	height: 0dp;
	margin-right: 0dp;
	background-color: transparent;
}

/* The bar starts a pixel left of the text and its light top line 2 pixels above the letters' tops (US build: 2 above
   the row), 13 pixels high under that line,
   as wide as the page's longest line (script_textbox.c: scriptShowSelection; gym sign: cursorWidth 86 for "Explain",
   7 x 12 + 2). A box without that width keeps the bar under the option's words. */
body .row {
	position: relative;
}

body .row.barred .bar {
	display: block;
	position: absolute;
	left: -3dp;
	top: -3dp;
	height: 39dp;
	background-color: #525a63;
	border-top: 3dp #b5b5b5;
	z-index: -1;
}

body .row.selected .run {
	background-color: #525a63;
	border-top: 3dp #b5b5b5;
}

body .row.barred .run {
	background-color: transparent;
	border-top: 0dp;
}

/* The confirm button of a box that waits for the player (script_textbox.c: renderUIBox, drawn by the speech box while
   it waits, renderScriptDialogueBox, and by the award and item notices): 16 x 12 pixels at 239 right of the box's left
   side and 43 below its top (the box's border box; its 3dp transparent border is a pixel), one of three drawings for
   4 frames each of the field's 20 a second (TEXTBOX_OPEN_TIMER / 4 % 3): a turn every 0.6 s, the button's top sinking
   a pixel a drawing. It is the glyph of the device in use (element:set_prompt("confirm", true)): with the original's
   pad, the original's own button (the confirm-icon sprites, the cross); with another device, the engine's drawing of
   its key or button in the same style and animation (/glyph/classic/..., dwe/ui/glyph_art.hpp). A key cap wider than
   the button grows to the left from the button's right side. The drawings are stacked and each shows for its third of
   the turn (a decorator does not blend between two images). The .glyph class makes these rules outweigh the modern
   badge's (../../../story_textbox/structure.rcss). */
body .prompt-icon.glyph {
	display: block;
	position: absolute;
	left: 762dp;
	top: 126dp;
	right: auto;
	bottom: auto;
	width: 0dp;
	min-width: 0dp;
	height: 36dp;
	padding: 0dp;
	border-width: 0dp;
	background-color: transparent;
	animation: none;
	opacity: 1;
}

body .prompt-icon.glyph.hidden,
body .prompt-icon.glyph-none {
	display: none;
}

body .prompt-icon .glyph-label,
body .prompt-icon .glyph-char,
body .prompt-icon .glyph-art {
	display: none;
}

body .prompt-icon .glyph-frame {
	display: block;
	position: absolute;
	right: 0dp;
	top: 0dp;
	height: 36dp;
	opacity: 0;
}

body .prompt-icon.glyph-face .glyph-frame {
	width: 48dp;
}

body .prompt-icon .frame-0 { animation: 0.6s linear infinite prompt-frame-0; }
body .prompt-icon .frame-1 { animation: 0.6s linear infinite prompt-frame-1; }
body .prompt-icon .frame-2 { animation: 0.6s linear infinite prompt-frame-2; }

body .prompt-icon.shape-cross .frame-0 { decorator: image(confirm-icon-0); }
body .prompt-icon.shape-cross .frame-1 { decorator: image(confirm-icon-1); }
body .prompt-icon.shape-cross .frame-2 { decorator: image(confirm-icon-2); }
body .prompt-icon.shape-circle .frame-0 { decorator: image(/glyph/classic/button/@circle/0); }
body .prompt-icon.shape-circle .frame-1 { decorator: image(/glyph/classic/button/@circle/1); }
body .prompt-icon.shape-circle .frame-2 { decorator: image(/glyph/classic/button/@circle/2); }
body .prompt-icon.shape-square .frame-0 { decorator: image(/glyph/classic/button/@square/0); }
body .prompt-icon.shape-square .frame-1 { decorator: image(/glyph/classic/button/@square/1); }
body .prompt-icon.shape-square .frame-2 { decorator: image(/glyph/classic/button/@square/2); }
body .prompt-icon.shape-triangle .frame-0 { decorator: image(/glyph/classic/button/@triangle/0); }
body .prompt-icon.shape-triangle .frame-1 { decorator: image(/glyph/classic/button/@triangle/1); }
body .prompt-icon.shape-triangle .frame-2 { decorator: image(/glyph/classic/button/@triangle/2); }

@keyframes prompt-frame-0 {
	0%, 33.2% { opacity: 1; }
	33.3%, 100% { opacity: 0; }
}

@keyframes prompt-frame-1 {
	0%, 33.2% { opacity: 0; }
	33.3%, 66.5% { opacity: 1; }
	66.6%, 100% { opacity: 0; }
}

@keyframes prompt-frame-2 {
	0%, 66.5% { opacity: 0; }
	66.6%, 100% { opacity: 1; }
}
