/* The battle in the original look: the partner's HP and MP at the top right, the finisher gauge under them, the
   tamer's commands at the top left, the enemies' HP bars and the end boxes, all over the undimmed arena.

   Positions are the captures' (battle_hud, battle_hud_enemy_hp_bar, battle_hud_finisher_ready, battle_end_box*):
   the decompilation's screen coordinates less 6 lines in battle. On a wide screen the panels keep to their edges at
   the original's distances; the end boxes stay in the middle. */

#fight {
	background-color: transparent;
}

/* ------------------------------------------------------------------------------------------------------------------
   The partner's bars (BI_IN; command_menu.c and the battle HUD): each the 104 x 8 frame at x 206, y 14 and 26 (the
   decompilation's 20 and 32), the icon (11 x 11) at the frame's (4, -2), the fill from the frame's (18, 3), 50 pixels
   at most and 2 tall (HP #f8d8c8 over #d04848, MP #c8e0f0 over #0068b8), and the value's four digits from the frame's
   x 73 to x 99 (the capture's x 305), in the original's small digits, 8 pixels tall (24dp). The panel ends 10 pixels from the right edge. The partner's name and status are not shown, as the original. */

#partner-panel {
	position: absolute;
	right: 30dp;
	top: 42dp;
	left: auto;
	bottom: auto;
	width: 312dp;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.fighter {
	margin: 0;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.partner .fighter-head {
	display: none;
}

.partner .bar-row {
	display: block;
	position: relative;
	width: 312dp;
	height: 24dp;
	margin: 0 0 12dp 0;
	decorator: image(battle-bar-frame);
}

.partner .bar-label {
	position: absolute;
	left: 12dp;
	top: -6dp;
	width: 33dp;
	height: 33dp;
	font-size: 0;
	color: transparent;
}

#fighter-0-hp-label { decorator: image(battle-hp); }
#fighter-0-mp-label { decorator: image(battle-mp); }

.partner .bar {
	position: absolute;
	left: 54dp;
	top: 9dp;
	width: 150dp;
	height: 6dp;
	margin: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.partner .fill {
	height: 3dp;
	border-radius: 0;
}

.partner .hp .fill {
	border-top: 3dp #f8d8c8;
	background-color: #d04848;
}

.partner .mp .fill {
	border-top: 3dp #c8e0f0;
	background-color: #0068b8;
}

.partner .bar-value {
	position: absolute;
	left: 219dp;
	top: 0;
	width: 78dp;
	font-size: 24dp;
	line-height: 24dp;
	text-align: right;
	color: #d0d0d0;
}

.fighter.fainted {
	opacity: 0.5;
}

/* The finisher's word (battle_hud.c: BTL_renderFinisherGauge; BI_IN, palette 12): "FINISH!!" from x 215, y 35, one
   letter more for each sixth of the gauge and the last two marks once it is full; nothing while it is empty. Once
   full, "PUSH" (palette 2) shows at (270, 39) on a grey box at half opacity from (268, 38), 41 x 11. The original's
   sprite starts with the pad's square button, which calls the finisher; here the box shows the prompt of the action
   that does it (`extra`: its key, or the button of the pad in use) in that place: a documented delta. "PUSH" keeps
   its pixels and its place at the box's right. A name of one or two letters fits where the square was; a longer one
   would run into "FINISH!!", so the box grows to the left one row lower, under the word, and the finisher's
   command, which answers on the box, goes with it. */
#finisher {
	position: absolute;
	left: 0;
	top: 0;
	width: 312dp;
	height: 0;
	margin: 0;
	padding: 0;
	border-width: 0;
	background-color: transparent;
}

#finisher-label {
	display: none;
}

#finisher-segments {
	display: block;
	position: absolute;
	left: 0;
	top: 63dp;
	width: 312dp;
	height: 45dp;
}

.segment, .segment.extra {
	display: block;
	position: absolute;
	top: 0;
	height: 45dp;
	margin: 0;
	border-radius: 0;
	background-color: transparent;
}

.segment.filled, #finisher.ready .segment {
	background-color: transparent;
}

#finisher-0 { left: 27dp; width: 18dp; }
#finisher-0.filled { decorator: image(finish-0); }
#finisher-1 { left: 45dp; width: 12dp; }
#finisher-1.filled { decorator: image(finish-1); }
#finisher-2 { left: 57dp; width: 24dp; }
#finisher-2.filled { decorator: image(finish-2); }
#finisher-3 { left: 81dp; width: 12dp; }
#finisher-3.filled { decorator: image(finish-3); }
#finisher-4 { left: 93dp; width: 24dp; }
#finisher-4.filled { decorator: image(finish-4); }
#finisher-5 { left: 117dp; width: 24dp; }
#finisher-5.filled { decorator: image(finish-5); }
#finisher-6 { left: 141dp; width: 15dp; }
#finisher-6.filled { decorator: image(finish-6); }
#finisher-7 { left: 156dp; width: 15dp; }
#finisher-7.filled { decorator: image(finish-7); }

#finisher-ready {
	display: none;
	position: absolute;
	right: 3dp;
	top: 72dp;
	min-width: 111dp;
	height: 27dp;
	padding: 3dp 6dp;
	white-space: nowrap;
	text-align: right;
	background-color: #80808080;
}

#finisher.ready #finisher-ready {
	display: block;
}

#fight.long-finisher-key #finisher-ready {
	top: 111dp;
}

#prompt-finisher {
	display: inline-block;
	vertical-align: top;
	min-width: 15dp;
	height: 21dp;
	line-height: 21dp;
	padding: 0 3dp;
	margin-right: 3dp;
	text-align: center;
}

#finisher-push {
	display: inline-block;
	vertical-align: top;
	width: 81dp;
	height: 27dp;
	decorator: image(finish-push);
}

/* ------------------------------------------------------------------------------------------------------------------
   The tamer's commands (command_menu.c: BTL_renderCommandMenu): one icon of BTLCOMND per command, 16 x 16, the last
   command's first from (20, 17) and each one 14 pixels to the right, every other one 10 lower; the hovered one swaps
   to its second frame every 8 frames under the cursor (22 x 22, 3 up and left of its icon) and its name shows at (20,
   48) in the ink colour. Behind them runs the strip's frame at half opacity, one piece per command from (17, 14),
   31 pixels tall. Each command answers on the 14 pixels of the strip that are its own, so the pointer and the left
   and right keys find its neighbours; its icon overhangs them. The finisher has no icon: its command answers on the "PUSH" box once the gauge is full. While the
   banner shows, the icons are there without the cursor or the name. */

#commands {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	text-align: left;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

#command-row {
	display: block;
	margin: 0;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.command {
	display: block;
}

.command, .command:focus, .command.current {
	position: absolute;
	top: 42dp;
	width: 42dp;
	height: 66dp;
	margin: 0;
	padding: 0;
	overflow: hidden;
	white-space: nowrap;
	font-size: 22dp;
	color: transparent;
	border-width: 0;
	background-color: transparent;
}

.command.down {
	top: 72dp;
}

.command.unavailable {
	color: transparent;
	opacity: 0.5;
}

.command.no-icon, .command.no-icon:focus {
	left: auto;
	right: 33dp;
	top: 114dp;
	width: 123dp;
	height: 33dp;
}

#fight.long-finisher-key .command.no-icon, #fight.long-finisher-key .command.no-icon:focus {
	top: 153dp;
}

.command.no-icon.unavailable {
	display: none;
}

/* The original draws nothing for the bag in the strip (command_menu.c: BTL_renderCommandMenu draws only the
   commands' icons): the bag opens with its own button, cancel here (Esc, East, or a right click). The entry the
   modern look shows after the strip is left out. */
#open-bag, #open-bag:focus {
	display: none;
}

.command.place-0 { left: 63dp; }
.command.place-1 { left: 105dp; }
.command.place-2 { left: 147dp; }
.command.place-3 { left: 189dp; }
.command.place-4 { left: 231dp; }
.command.place-5 { left: 273dp; }
.command.place-6 { left: 315dp; }
.command.place-7 { left: 357dp; }
.command.place-8 { left: 399dp; }
.command.place-9 { left: 441dp; }
.command.place-10 { left: 483dp; }
.command.place-11 { left: 525dp; }
#command-cursor.place-0 { left: 51dp; }
#command-cursor.place-1 { left: 93dp; }
#command-cursor.place-2 { left: 135dp; }
#command-cursor.place-3 { left: 177dp; }
#command-cursor.place-4 { left: 219dp; }
#command-cursor.place-5 { left: 261dp; }
#command-cursor.place-6 { left: 303dp; }
#command-cursor.place-7 { left: 345dp; }
#command-cursor.place-8 { left: 387dp; }
#command-cursor.place-9 { left: 429dp; }

.command.icon-command-1 { decorator: image(command-1 scale-none center center); }
.command.icon-command-1.blink { decorator: image(command-1-blink scale-none center center); }
.command.icon-command-2 { decorator: image(command-2 scale-none center center); }
.command.icon-command-2.blink { decorator: image(command-2-blink scale-none center center); }
.command.icon-command-3 { decorator: image(command-3 scale-none center center); }
.command.icon-command-3.blink { decorator: image(command-3-blink scale-none center center); }
.command.icon-command-4 { decorator: image(command-4 scale-none center center); }
.command.icon-command-4.blink { decorator: image(command-4-blink scale-none center center); }
.command.icon-command-5 { decorator: image(command-5 scale-none center center); }
.command.icon-command-5.blink { decorator: image(command-5-blink scale-none center center); }
.command.icon-command-6 { decorator: image(command-6 scale-none center center); }
.command.icon-command-6.blink { decorator: image(command-6-blink scale-none center center); }
.command.icon-command-7 { decorator: image(command-7 scale-none center center); }
.command.icon-command-7.blink { decorator: image(command-7-blink scale-none center center); }
.command.icon-special-0 { decorator: image(special-0 scale-none center center); }
.command.icon-special-0.blink { decorator: image(special-0-blink scale-none center center); }
.command.icon-special-1 { decorator: image(special-1 scale-none center center); }
.command.icon-special-1.blink { decorator: image(special-1-blink scale-none center center); }
.command.icon-special-2 { decorator: image(special-2 scale-none center center); }
.command.icon-special-2.blink { decorator: image(special-2-blink scale-none center center); }
.command.icon-special-3 { decorator: image(special-3 scale-none center center); }
.command.icon-special-3.blink { decorator: image(special-3-blink scale-none center center); }
.command.icon-special-4 { decorator: image(special-4 scale-none center center); }
.command.icon-special-4.blink { decorator: image(special-4-blink scale-none center center); }
.command.icon-special-5 { decorator: image(special-5 scale-none center center); }
.command.icon-special-5.blink { decorator: image(special-5-blink scale-none center center); }
.command.icon-special-6 { decorator: image(special-6 scale-none center center); }
.command.icon-special-6.blink { decorator: image(special-6-blink scale-none center center); }

#command-cursor {
	display: block;
	position: absolute;
	top: 42dp;
	width: 66dp;
	height: 66dp;
	decorator: image(command-cursor);
}

#command-cursor.down {
	top: 72dp;
}

.command-frame {
	display: block;
	position: absolute;
	top: 42dp;
	width: 42dp;
	height: 93dp;
	opacity: 0.5;
}

.command-frame.frame-left, .command-frame.frame-right-odd, .command-frame.frame-right-even {
	width: 33dp;
}

.command-frame.frame-left { decorator: image(frame-left); }
.command-frame.frame-odd { decorator: image(frame-odd); }
.command-frame.frame-even { decorator: image(frame-even); }
.command-frame.frame-right-odd { decorator: image(frame-right-odd); }
.command-frame.frame-right-even { decorator: image(frame-right-even); }

#command-frame-0 { left: 51dp; }
#command-frame-1 { left: 84dp; }
#command-frame-2 { left: 126dp; }
#command-frame-3 { left: 168dp; }
#command-frame-4 { left: 210dp; }
#command-frame-5 { left: 252dp; }
#command-frame-6 { left: 294dp; }
#command-frame-7 { left: 336dp; }
#command-frame-8 { left: 378dp; }
#command-frame-9 { left: 420dp; }
#command-frame-10 { left: 462dp; }

#command-name {
	position: absolute;
	left: 60dp;
	top: 144dp;
	width: 600dp;
	margin: 0;
	font-size: 33dp;
	color: #d0d0d0;
}

#fight.opening #command-cursor {
	display: none;
}

/* The strip's slide (command_menu.c: BTL_tickCommandMenu): logic.lua moves and stretches the frame's pieces from their
   top and the icons from theirs (9dp into their boxes) as the game moves the strip's edges. Before the banner and
   once it has gone back up it waits above the screen. After the fight it stays alone, without the cursor or the
   name, through the victory and the end box, until it goes back up. */
.command-frame {
	transform-origin: 50% 0dp 0;
}

.command, .command:focus, .command.current {
	transform-origin: 50% 9dp 0;
}

#fight.after > * {
	display: none;
}

#fight.after > #commands {
	display: block;
}

#fight.after #command-cursor, #fight.after #command-name {
	display: none;
}

/* ------------------------------------------------------------------------------------------------------------------
   The enemies' HP bars (battle_main.c: BTL_renderEnemyHPBars; captures battle_hud_enemy_hp_bar*), each beside its
   enemy and following it: logic.lua puts the bar's corner where apps/screens (enemy_hp_bars) says, from the point its
   enemy's model node 1 shows at. The outline is two green (#0ab40a) line strips round 55 x 7 pixels; the fill starts
   2 pixels in, 3 tall and 50 at most; a line runs from the outline's bottom-left corner to the node; the HP, in the
   battle's 8 x 8 digits 7 apart, right-aligned in four places from the outline's x 33, 9 pixels over its top. The
   first enemy's bar is drawn over the others' and all of them under the partner's bars. The panel at the top middle
   is the other look's. */

#enemies {
	display: none;
}

#hp-bars {
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.hb {
	position: absolute;
	width: 0;
	height: 0;
}

.hb-frame {
	position: absolute;
	width: 165dp;
	height: 21dp;
	box-sizing: border-box;
	border: 3dp #0ab40a;
}

.hb-line {
	position: absolute;
	height: 3dp;
	background-color: #0ab40a;
	transform-origin: 0 0;
}

.hb-fill {
	position: absolute;
	height: 9dp;
	overflow: hidden;
}

/* The fill sprite (BTLCOMND, u 88 and v 236 of the page at 960, 256, palette 3) is a grey ramp, from 0x63 at its left
   to 0xce at its right, tinted by the HP left; logic.lua draws it as up to three gradients, split where the tint
   saturates a channel. */
.hb-segment {
	position: absolute;
	top: 0;
	height: 9dp;
}

.hb-value {
	position: absolute;
	width: 84dp;
	height: 24dp;
}

.hb-value .dd {
	position: absolute;
	top: 0;
	float: none;
	margin: 0;
	width: 24dp;
	height: 24dp;
}

#hd-1-0, #hd-2-0, #hd-3-0 { left: 0; }
#hd-1-1, #hd-2-1, #hd-3-1 { left: 21dp; }
#hd-1-2, #hd-2-2, #hd-3-2 { left: 42dp; }
#hd-1-3, #hd-2-3, #hd-3-3 { left: 63dp; }

/* ------------------------------------------------------------------------------------------------------------------
   The finisher's charge and the revive countdown: one of the original's boxes and the ink colour. */

#charge {
	border-radius: 0;
	border: 3dp transparent;
	background-color: #2d384080;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
}

#charge-title {
	font-size: 33dp;
	color: #fff371;
}

#charge .bar {
	height: 9dp;
	border-radius: 0;
	border: 3dp #020202;
	border-right-color: #6987a0;
	border-bottom-color: #6987a0;
	background-color: #354b5c;
}

#charge .fill {
	border-radius: 0;
	decorator: vertical-gradient(#f8e058 #c8b028);
}

.charge-hint {
	font-size: 22dp;
	color: #b2b2b2;
}

#revive {
	font-size: 33dp;
	color: #d0d0d0;
}

/* The original shows no button hints in battle. */
#prompts {
	display: none;
}

/* The numbers over the fighters (utils2.c: drawEntityText): the digits of BI_IN with palette 4, untinted (TEXT_COLORS
   0, 0x80 each) for a hit's or a block's damage and with no green (TEXT_COLORS 0xc) for the poison's. */
.dd {
	color: transparent;
	font-effect: none;
	background-color: transparent;
}

.dd.d-0 { decorator: image(damage-digit-0); }
.dd.d-1 { decorator: image(damage-digit-1); }
.dd.d-2 { decorator: image(damage-digit-2); }
.dd.d-3 { decorator: image(damage-digit-3); }
.dd.d-4 { decorator: image(damage-digit-4); }
.dd.d-5 { decorator: image(damage-digit-5); }
.dd.d-6 { decorator: image(damage-digit-6); }
.dd.d-7 { decorator: image(damage-digit-7); }
.dd.d-8 { decorator: image(damage-digit-8); }
.dd.d-9 { decorator: image(damage-digit-9); }

.dn.poison .dd {
	image-color: #ff00ff;
}

/* ------------------------------------------------------------------------------------------------------------------
   The battle's opening. The anger mark (btl.c: renderFleeBubble; BI_IN, palette 7): the red bubble, 24 pixels round
   its centre over the enemy, with the angry face inside at two thirds of its size; it grows for 5 frames and then
   pulses. The "BATTLE" banner (battle_hud.c: BTL_renderBattleStartText): its 8 x 12 pieces in one of three red
   textures, each with a black shadow 2 pixels down and right and, while it flies in, a trail at half opacity on the
   side it comes from; once all are in place they flash through palettes 8, 9 and 10. */

.anger {
	width: 72dp;
	height: 72dp;
	margin: -36dp 0 0 -36dp;
	border-radius: 0;
	background-color: transparent;
	decorator: image(anger-mark scale-none center center), image(anger-bubble);
}

.bp {
	background-color: transparent;
}

.bp.texture-0 { decorator: image(banner-0-0); }
.bp.texture-1 { decorator: image(banner-0-1); }
.bp.texture-2 { decorator: image(banner-0-2); }
#banner.flash-1 .bp.texture-0 { decorator: image(banner-1-0); }
#banner.flash-1 .bp.texture-1 { decorator: image(banner-1-1); }
#banner.flash-1 .bp.texture-2 { decorator: image(banner-1-2); }
#banner.flash-2 .bp.texture-0 { decorator: image(banner-2-0); }
#banner.flash-2 .bp.texture-1 { decorator: image(banner-2-1); }
#banner.flash-2 .bp.texture-2 { decorator: image(banner-2-2); }

.bt {
	opacity: 0.5;
	background-color: transparent;
	decorator: image(banner-trail);
}

.bt.left {
	decorator: image(banner-trail flip-horizontal);
}

/* ------------------------------------------------------------------------------------------------------------------
   The bag in battle is the field's (ui/partner_menu); the line while a thrown item flies. */

#item-in-flight {
	font-size: 33dp;
	color: #d0d0d0;
}

/* ------------------------------------------------------------------------------------------------------------------
   The end boxes (battle_ui.c: handleBattleEndBox; capture battle_end_box_stats, battle_end_box_drop), 176 pixels wide
   in the middle of the screen. The stats box (createPostBattleStatsBox: -88, -78, 176 x 96; renderPostBattleStatsBox):
   six rows 13 pixels apart from its y 9, the label at x 10, the value at x 68 over a bar 2 pixels tall from x 64 to
   117 (grey, blue while it rises), the up arrow at x 130 and the raise left at x 142, a line at x 122. The bits box
   under it (createBitsBox: -88, 18, 176 x 66): the label at x 10, the bits at x 70, a line at y 32 and the two rows of
   text from y 36 (BTL_initializeBattleEndText: -78, 54, 156 x 24). The final balance box (createFinalBalanceBox: -88,
   -13, 176 x 31) opens over the stats box's foot once the raises are counted. The names are yellow (#fff371). */

#end {
	display: block;
	background-color: transparent;
}

#end-panel {
	position: absolute;
	left: 50%;
	top: 108dp;
	width: 528dp;
	height: 486dp;
	margin-left: -264dp;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

#end-title {
	display: none;
}

#end-boxes {
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 528dp;
	height: 486dp;
	margin: 0;
}

#gains, #bits, #balance {
	position: absolute;
	left: 0;
	width: 528dp;
	margin: 0;
	padding: 0;
	border-radius: 0;
	border: 3dp transparent;
	background-color: #00000080;
	box-sizing: border-box;
}

/* The rows start 9 pixels into the box (battle_ui.c: handleBattleEndBox), the border's 3dp included. */
#gains {
	top: 0;
	height: 288dp;
	padding-top: 24dp;
}

#gains-divider {
	display: block;
	position: absolute;
	left: 366dp;
	top: 0;
	width: 6dp;
	height: 100%;
	background-color: #90d9fa;
}

.gain {
	display: block;
	position: relative;
	width: 528dp;
	height: 39dp;
	font-size: 33dp;
	line-height: 36dp;
}

.gain-label {
	position: absolute;
	left: 30dp;
	top: 0;
	color: #fff371;
}

.gain-stat {
	position: absolute;
	left: 192dp;
	top: 0;
	width: 120dp;
	text-align: right;
	color: #ffffff;
}

.stat-bar {
	position: absolute;
	left: 192dp;
	top: 33dp;
	width: 159dp;
	height: 6dp;
	border-radius: 0;
	background-color: #282828;
}

.stat-bar.raised {
	background-color: #005a96;
}

.stat-fill {
	width: 0;
	height: 6dp;
	border-radius: 0;
	background-color: #787878;
}

.stat-bar.raised .stat-fill {
	background-color: #69c2ff;
}

.gain-arrow {
	display: block;
	position: absolute;
	left: 390dp;
	top: 0;
	width: 36dp;
	height: 36dp;
	decorator: image(battle-up-arrow);
}

.gain-arrow.hidden {
	display: none;
}

.gain-value {
	position: absolute;
	left: 426dp;
	top: 0;
	color: #69c2ff;
}

/* The bits box is as tall as the balance box, and grows to hold the two rows of text when there is any. */
#bits {
	top: 288dp;
	height: 93dp;
	font-size: 33dp;
	line-height: 36dp;
}

#end-boxes.with-text #bits {
	height: 198dp;
}

#end-boxes.with-text #bits-line {
	display: block;
}

#bits-line {
	position: absolute;
	left: 0;
	top: 93dp;
	width: 100%;
	height: 3dp;
	background-color: #90d9fa;
}

#bits-label, #balance-label {
	position: absolute;
	left: 30dp;
	top: 27dp;
}

#bits-value, #balance-value {
	position: absolute;
	left: 210dp;
	top: 27dp;
	color: #69c2ff;
}

#balance {
	top: 195dp;
	height: 93dp;
	font-size: 33dp;
	line-height: 36dp;
	background-color: #1c2a36;
}

#balance.hidden {
	display: none;
}

#end-text {
	margin: 0;
	position: absolute;
	left: 30dp;
	top: 396dp;
	width: 468dp;
	height: 72dp;
}

.end-row {
	display: block;
	height: 36dp;
	margin: 0;
	padding: 0;
	font-size: 33dp;
	line-height: 36dp;
	white-space: pre;
}

.end-plain {
	color: #e8e8e8;
}

.end-name {
	color: #fff371;
}
