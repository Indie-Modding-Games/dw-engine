/* The battle in the original look: the partner's HP and MP at the top right, the finisher gauge under them, the
   tamer's commands at the top left, the enemies' HP bars and the end boxes, all over the undimmed arena.

   Positions are the captures' (battle_hud, battle_hud_enemy_hp_bar, battle_hud_finisher_ready, battle_end_box*):
   the decompilation's screen coordinates less 6 lines in battle. On a wide screen the panels keep to their edges at
   the original's distances; the end boxes stay in the middle. */

#fight {
	background-color: transparent;
}

/* ------------------------------------------------------------------------------------------------------------------
   The partner's bars (BI_IN; command_menu.c and the battle HUD): each the 104 x 8 frame at x 206, y 14 and 26 (the
   decompilation's 20 and 32), the icon (11 x 11) at the frame's (4, -2), the fill from the frame's (18, 3), 50 pixels
   at most and 2 tall (HP #f8d8c8 over #d04848, MP #c8e0f0 over #0068b8), and the value's four digits from the frame's
   x 73 to x 99 (the capture's x 305), in the original's small digits, 8 pixels tall (24dp). The panel ends 10 pixels from the right edge. The partner's name and status are not shown, as the original. */

#partner-panel {
	position: absolute;
	right: 30dp;
	top: 42dp;
	left: auto;
	bottom: auto;
	width: 312dp;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.fighter {
	margin: 0;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.partner .fighter-head {
	display: none;
}

.partner .bar-row {
	display: block;
	position: relative;
	width: 312dp;
	height: 24dp;
	margin: 0 0 12dp 0;
	decorator: image(battle-bar-frame);
}

.partner .bar-label {
	position: absolute;
	left: 12dp;
	top: -6dp;
	width: 33dp;
	height: 33dp;
	font-size: 0;
	color: transparent;
}

#fighter-0-hp-label { decorator: image(battle-hp); }
#fighter-0-mp-label { decorator: image(battle-mp); }

.partner .bar {
	position: absolute;
	left: 54dp;
	top: 9dp;
	width: 150dp;
	height: 6dp;
	margin: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.partner .fill {
	height: 3dp;
	border-radius: 0;
}

.partner .hp .fill {
	border-top: 3dp #f8d8c8;
	background-color: #d04848;
}

.partner .mp .fill {
	border-top: 3dp #c8e0f0;
	background-color: #0068b8;
}

/* BTL_renderPartnerStatusBars: BTL_renderNumber(0, 4, x0 + 0x49, y0 - 3, value, 0xa), the value as the original's
   digits (.hud-digit, theme.rcss) from the frame's (73, -3), instead of the text. */
.partner .bar-value { display: none; }

.partner .bar-digits {
	position: absolute;
	left: 219dp;
	top: 0;
	width: 84dp;
	height: 24dp;
}

.fighter.fainted {
	opacity: 0.5;
}

/* The finisher's word (battle_hud.c: BTL_renderFinisherGauge; BI_IN, palette 12): "FINISH!!" from x 215, y 35, one
   letter more for each sixth of the gauge and the last two marks once it is full; nothing while it is empty. Once
   full, "PUSH" (palette 2) shows at (270, 39) on a grey box at half opacity from (268, 38), 41 x 11. The original's
   sprite starts with the pad's square button, which calls the finisher; here the box shows the prompt of the action
   that does it (`extra`: its key, or the button of the pad in use) in that place: a documented delta. "PUSH" keeps
   its pixels and its place at the box's right. A name of one or two letters fits where the square was; a longer one
   would run into "FINISH!!", so the box grows to the left one row lower, under the word, and the finisher's
   command, which answers on the box, goes with it. */
#finisher {
	position: absolute;
	left: 0;
	top: 0;
	width: 312dp;
	height: 0;
	margin: 0;
	padding: 0;
	border-width: 0;
	background-color: transparent;
}

#finisher-label {
	display: none;
}

/* In any language but English the gauge's word is battle.finisher_word in the original's font, where the picture
   of "FINISH!!" is, one letter more for each mark the gauge lights (logic.lua: draw_finisher). */
#finisher-word {
	display: block;
	position: absolute;
	left: 27dp;
	top: 63dp;
	height: 45dp;
	line-height: 45dp;
	font-size: 33dp;
	white-space: nowrap;
	color: #f8c800;
}

.use-menu-art #finisher-word {
	display: none;
}

#finisher-word-dim {
	color: #f8c80040;
	font-effect: none;
}

#finisher-segments {
	display: block;
	position: absolute;
	left: 0;
	top: 63dp;
	width: 312dp;
	height: 45dp;
}

.segment, .segment.extra {
	display: block;
	position: absolute;
	top: 0;
	height: 45dp;
	margin: 0;
	border-radius: 0;
	background-color: transparent;
}

.segment.filled, #finisher.ready .segment {
	background-color: transparent;
}

#finisher-0 { left: 27dp; width: 18dp; }
.use-menu-art #finisher-0.filled { decorator: image(finish-0); }
#finisher-1 { left: 45dp; width: 12dp; }
.use-menu-art #finisher-1.filled { decorator: image(finish-1); }
#finisher-2 { left: 57dp; width: 24dp; }
.use-menu-art #finisher-2.filled { decorator: image(finish-2); }
#finisher-3 { left: 81dp; width: 12dp; }
.use-menu-art #finisher-3.filled { decorator: image(finish-3); }
#finisher-4 { left: 93dp; width: 24dp; }
.use-menu-art #finisher-4.filled { decorator: image(finish-4); }
#finisher-5 { left: 117dp; width: 24dp; }
.use-menu-art #finisher-5.filled { decorator: image(finish-5); }
#finisher-6 { left: 141dp; width: 15dp; }
.use-menu-art #finisher-6.filled { decorator: image(finish-6); }
#finisher-7 { left: 156dp; width: 15dp; }
.use-menu-art #finisher-7.filled { decorator: image(finish-7); }

#finisher-ready {
	display: none;
	position: absolute;
	right: 3dp;
	top: 72dp;
	min-width: 111dp;
	height: 27dp;
	padding: 3dp 6dp;
	white-space: nowrap;
	text-align: right;
	background-color: #80808080;
}

#finisher.ready #finisher-ready {
	display: block;
}

#fight.long-finisher-key #finisher-ready {
	top: 111dp;
}

#prompt-finisher {
	display: inline-block;
	vertical-align: top;
	min-width: 15dp;
	height: 21dp;
	line-height: 21dp;
	padding: 0 3dp;
	margin-right: 3dp;
	text-align: center;
}

#finisher-push {
	display: inline-block;
	vertical-align: top;
	min-width: 81dp;
	height: 27dp;
	line-height: 27dp;
	font-family: original-look;
	font-size: 22dp;
	color: #f8a800;
}

.use-menu-art #finisher-push {
	width: 81dp;
	decorator: image(finish-push);
	color: transparent;
}

/* ------------------------------------------------------------------------------------------------------------------
   The tamer's commands (command_menu.c: BTL_renderCommandMenu): one icon of BTLCOMND per command, 16 x 16, the last
   command's first from (20, 17) and each one 14 pixels to the right, every other one 10 lower; the hovered one swaps
   to its second frame every 8 frames under the cursor (22 x 22, 3 up and left of its icon) and its name shows at (20,
   48) in the ink colour. Behind them runs the strip's frame at half opacity, one piece per command from (17, 14),
   31 pixels tall. Each command answers on the 14 pixels of the strip that are its own, so the pointer and the left
   and right keys find its neighbours; its icon overhangs them. The finisher has no icon: its command answers on the "PUSH" box once the gauge is full. While the
   banner shows, the icons are there without the cursor or the name. */

#commands {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	text-align: left;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

#command-row {
	display: block;
	margin: 0;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.command {
	display: block;
}

.command, .command:focus, .command.current {
	position: absolute;
	top: 42dp;
	width: 42dp;
	height: 66dp;
	margin: 0;
	padding: 0;
	overflow: hidden;
	white-space: nowrap;
	font-size: 22dp;
	color: transparent;
	border-width: 0;
	background-color: transparent;
}

.command.down {
	top: 72dp;
}

.command.unavailable {
	color: transparent;
	opacity: 0.5;
}

.command.no-icon, .command.no-icon:focus {
	left: auto;
	right: 33dp;
	top: 114dp;
	width: 123dp;
	height: 33dp;
}

#fight.long-finisher-key .command.no-icon, #fight.long-finisher-key .command.no-icon:focus {
	top: 153dp;
}

.command.no-icon.unavailable {
	display: none;
}

/* The original draws nothing for the bag in the strip (command_menu.c: BTL_renderCommandMenu draws only the
   commands' icons): the bag opens with its own button, cancel here (Esc, East, or a right click). The entry the
   modern look shows after the strip is left out. */
#open-bag, #open-bag:focus {
	display: none;
}

.command.place-0 { left: 63dp; }
.command.place-1 { left: 105dp; }
.command.place-2 { left: 147dp; }
.command.place-3 { left: 189dp; }
.command.place-4 { left: 231dp; }
.command.place-5 { left: 273dp; }
.command.place-6 { left: 315dp; }
.command.place-7 { left: 357dp; }
.command.place-8 { left: 399dp; }
.command.place-9 { left: 441dp; }
.command.place-10 { left: 483dp; }
.command.place-11 { left: 525dp; }
#command-cursor.place-0 { left: 51dp; }
#command-cursor.place-1 { left: 93dp; }
#command-cursor.place-2 { left: 135dp; }
#command-cursor.place-3 { left: 177dp; }
#command-cursor.place-4 { left: 219dp; }
#command-cursor.place-5 { left: 261dp; }
#command-cursor.place-6 { left: 303dp; }
#command-cursor.place-7 { left: 345dp; }
#command-cursor.place-8 { left: 387dp; }
#command-cursor.place-9 { left: 429dp; }

.command.icon-command-1 { decorator: image(command-1 scale-none center center); }
.command.icon-command-1.blink { decorator: image(command-1-blink scale-none center center); }
.command.icon-command-2 { decorator: image(command-2 scale-none center center); }
.command.icon-command-2.blink { decorator: image(command-2-blink scale-none center center); }
.command.icon-command-3 { decorator: image(command-3 scale-none center center); }
.command.icon-command-3.blink { decorator: image(command-3-blink scale-none center center); }
.command.icon-command-4 { decorator: image(command-4 scale-none center center); }
.command.icon-command-4.blink { decorator: image(command-4-blink scale-none center center); }
.command.icon-command-5 { decorator: image(command-5 scale-none center center); }
.command.icon-command-5.blink { decorator: image(command-5-blink scale-none center center); }
.command.icon-command-6 { decorator: image(command-6 scale-none center center); }
.command.icon-command-6.blink { decorator: image(command-6-blink scale-none center center); }
.command.icon-command-7 { decorator: image(command-7 scale-none center center); }
.command.icon-command-7.blink { decorator: image(command-7-blink scale-none center center); }
.command.icon-special-0 { decorator: image(special-0 scale-none center center); }
.command.icon-special-0.blink { decorator: image(special-0-blink scale-none center center); }
.command.icon-special-1 { decorator: image(special-1 scale-none center center); }
.command.icon-special-1.blink { decorator: image(special-1-blink scale-none center center); }
.command.icon-special-2 { decorator: image(special-2 scale-none center center); }
.command.icon-special-2.blink { decorator: image(special-2-blink scale-none center center); }
.command.icon-special-3 { decorator: image(special-3 scale-none center center); }
.command.icon-special-3.blink { decorator: image(special-3-blink scale-none center center); }
.command.icon-special-4 { decorator: image(special-4 scale-none center center); }
.command.icon-special-4.blink { decorator: image(special-4-blink scale-none center center); }
.command.icon-special-5 { decorator: image(special-5 scale-none center center); }
.command.icon-special-5.blink { decorator: image(special-5-blink scale-none center center); }
.command.icon-special-6 { decorator: image(special-6 scale-none center center); }
.command.icon-special-6.blink { decorator: image(special-6-blink scale-none center center); }

#command-cursor {
	display: block;
	position: absolute;
	top: 42dp;
	width: 66dp;
	height: 66dp;
	decorator: image(command-cursor);
}

#command-cursor.down {
	top: 72dp;
}

.command-frame {
	display: block;
	position: absolute;
	top: 42dp;
	width: 42dp;
	height: 93dp;
	opacity: 0.5;
}

.command-frame.frame-left, .command-frame.frame-right-odd, .command-frame.frame-right-even {
	width: 33dp;
}

.command-frame.frame-left { decorator: image(frame-left); }
.command-frame.frame-odd { decorator: image(frame-odd); }
.command-frame.frame-even { decorator: image(frame-even); }
.command-frame.frame-right-odd { decorator: image(frame-right-odd); }
.command-frame.frame-right-even { decorator: image(frame-right-even); }

#command-frame-0 { left: 51dp; }
#command-frame-1 { left: 84dp; }
#command-frame-2 { left: 126dp; }
#command-frame-3 { left: 168dp; }
#command-frame-4 { left: 210dp; }
#command-frame-5 { left: 252dp; }
#command-frame-6 { left: 294dp; }
#command-frame-7 { left: 336dp; }
#command-frame-8 { left: 378dp; }
#command-frame-9 { left: 420dp; }
#command-frame-10 { left: 462dp; }

/* The hovered command's name, white in a black outline so it reads over the bright sand too. */
#command-name {
	position: absolute;
	left: 60dp;
	top: 144dp;
	width: 600dp;
	margin: 0;
	font-size: 33dp;
	color: #ffffff;
	font-effect: outline(3dp #000000);
}

/* The original names the command alone, without a technique's MP cost. */
#command-cost {
	display: none;
}

#fight.opening #command-cursor {
	display: none;
}

/* The strip's slide (command_menu.c: BTL_tickCommandMenu): logic.lua moves and stretches the frame's pieces from their
   top and the icons from theirs (9dp into their boxes) as the game moves the strip's edges. Before the banner and
   once it has gone back up it waits above the screen. After the fight it stays with the partner's bars, without the cursor or the
   name, through the victory and the end box, until it goes back up. */
.command-frame {
	transform-origin: 50% 0dp 0;
}

.command, .command:focus, .command.current {
	transform-origin: 50% 9dp 0;
}

#fight.after > * {
	display: none;
}

/* A cup match's strip (std_main.c: STD_addCommandMenu, STD_renderCommandMenu) stands at lines 68 to 100 from the
   middle, 168 lines under the field battle's, and names the hovered command 14 lines over its top instead of under
   it (STD_renderMoveName). logic.lua sets the class from the edges the game sends. */
#commands.match {
	top: 504dp;
}

#commands.match #command-name {
	top: 0dp;
}

#fight.after > #commands {
	display: block;
}

/* The partner's bars and the finisher gauge stay too (battle_hud.c: BTL_renderPartnerStatusBars draws them until
   BTL_removePartnerStatusBars, once the strip is back up); the bars slide out with the strip (logic.lua: draw_bars). */
#fight.after > #partner-panel {
	display: block;
}

/* A tournament match's clock stays through the winner's pose too (std_main.c: STD_deinitializeCombat removes it after
   STD_removeCommandMenu). */
#fight.after > #match-clock {
	display: block;
}

#fight.after > #match-clock.hidden {
	display: none;
}

#fight.after #command-cursor, #fight.after #command-name {
	display: none;
}

/* ------------------------------------------------------------------------------------------------------------------
   The enemies' HP bars (battle_main.c: BTL_renderEnemyHPBars; captures battle_hud_enemy_hp_bar*), each beside its
   enemy and following it: logic.lua puts the bar's corner where packages/screens (enemy_hp_bars) says, from the point its
   enemy's model node 1 shows at. The outline is two green (#0ab40a) line strips round 55 x 7 pixels; the fill starts
   2 pixels in, 3 tall and 50 at most; a line runs from the outline's bottom-left corner to the node; the HP, in the
   battle's 8 x 8 digits 7 apart, right-aligned in four places from the outline's x 33, 9 pixels over its top. The
   first enemy's bar is drawn over the others' and all of them under the partner's bars. The panel at the top middle
   is the other look's. */

#enemies {
	display: none;
}

#hp-bars {
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.hb {
	position: absolute;
	width: 0;
	height: 0;
}

.hb-frame {
	position: absolute;
	width: 165dp;
	height: 21dp;
	box-sizing: border-box;
	border: 3dp #0ab40a;
}

.hb-line {
	position: absolute;
	height: 3dp;
	background-color: #0ab40a;
	transform-origin: 0 0;
}

.hb-fill {
	position: absolute;
	height: 9dp;
	overflow: hidden;
}

/* The fill sprite (BTLCOMND, u 88 and v 236 of the page at 960, 256, palette 3) is a grey ramp, from 0x63 at its left
   to 0xce at its right, tinted by the HP left; logic.lua draws it as up to three gradients, split where the tint
   saturates a channel. */
.hb-segment {
	position: absolute;
	top: 0;
	height: 9dp;
}

.hb-value {
	position: absolute;
	width: 84dp;
	height: 24dp;
}

.hb-value .dd {
	position: absolute;
	top: 0;
	float: none;
	margin: 0;
	width: 24dp;
	height: 24dp;
}

#hd-1-0, #hd-2-0, #hd-3-0 { left: 0; }
#hd-1-1, #hd-2-1, #hd-3-1 { left: 21dp; }
#hd-1-2, #hd-2-2, #hd-3-2 { left: 42dp; }
#hd-1-3, #hd-2-3, #hd-3-3 { left: 63dp; }

/* Enemy life bars (the enemy_hp_bars option) keep this bar: the modern look's compact bar (#hp-bars.always) would win
   over the rules above by its selectors, so the ones it changes are set again here. */
#hp-bars.always .hb-frame {
	border: 3dp #0ab40a;
	border-radius: 0;
}

#hp-bars.always .hb-line {
	display: block;
}

#hp-bars.always .hb-fill {
	background-color: transparent;
}

#hp-bars.always .hb-value .dd {
	width: 24dp;
}

/* ------------------------------------------------------------------------------------------------------------------
   The finisher's charge (command_menu.c: BTL_initializeFinisherChargeup, BTL_renderFinisherChargeup): no box, the small
   gauge over the partner for the aura's 80 frames, where the game puts its top-left corner: BTLCOMND's 46 x 12 frame and a
   4 x 6 bar every 4 pixels from (3, 3), one for every 8 of the charge. A click charges it as the key does. */

#charge {
	display: none;
}

#charge-gauge {
	display: block;
	position: absolute;
	width: 138dp;
	height: 36dp;
	decorator: image(charge-gauge-frame);
}

#charge-gauge.hidden, .cg-bar.hidden {
	display: none;
}

#charge-gauge-bars {
	position: absolute;
	left: 9dp;
	top: 9dp;
	width: 120dp;
	height: 18dp;
}

.cg-bar {
	display: block;
	float: left;
	width: 12dp;
	height: 18dp;
	decorator: image(charge-gauge-bar);
}

/* The revive countdown: one of the original's boxes and the ink colour (the box rules below are the charge box's, which
   the looks built on this one may bring back). */

#charge {
	border-radius: 0;
	border: 3dp transparent;
	background-color: #2d384080;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
}

#charge-title {
	font-size: 33dp;
	color: #fff371;
}

#charge .bar {
	height: 9dp;
	border-radius: 0;
	border: 3dp #020202;
	border-right-color: #6987a0;
	border-bottom-color: #6987a0;
	background-color: #354b5c;
}

#charge .fill {
	border-radius: 0;
	decorator: vertical-gradient(#f8e058 #c8b028);
}

.charge-hint {
	font-size: 22dp;
	color: #b2b2b2;
}

/* A tournament match's clock (std_main.c: STD_renderCounterDigits(-13, -97, 2, STD_TIMER, 3)), in pixels from the
   screen's centre: TIME.TIM's 66 x 29 panel at (-33, -104), drawn under the rest; the 8 x 18 pieces of STDTIM (832, 0)
   at u 0x78 and 0x88, v 0x30, at (-28, -99) and (20, -99); the digits, 12 x 15 at u = digit x 12, v 0x30, from
   (-13, -97), 14 apart, the tens left out under 10. */
#match-clock {
	position: absolute;
	left: 50%;
	top: 48dp;
	width: 198dp;
	height: 87dp;
	margin-left: -99dp;
	padding: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: image(std-clock-panel);
}

.mc-side {
	display: block;
	position: absolute;
	top: 15dp;
	width: 24dp;
	height: 54dp;
}

#mc-side-1 {
	left: 15dp;
	decorator: image(std-clock-side-1);
}

#mc-side-2 {
	left: 159dp;
	decorator: image(std-clock-side-2);
}

.mc-digit {
	display: block;
	position: absolute;
	top: 21dp;
	width: 36dp;
	height: 45dp;
	font-size: 0;
	color: transparent;
	font-effect: none;
}

#mc-d-0 {
	left: 60dp;
}

#mc-d-1 {
	left: 102dp;
}

.mc-digit.d-0 { decorator: image(std-clock-digit-0); }
.mc-digit.d-1 { decorator: image(std-clock-digit-1); }
.mc-digit.d-2 { decorator: image(std-clock-digit-2); }
.mc-digit.d-3 { decorator: image(std-clock-digit-3); }
.mc-digit.d-4 { decorator: image(std-clock-digit-4); }
.mc-digit.d-5 { decorator: image(std-clock-digit-5); }
.mc-digit.d-6 { decorator: image(std-clock-digit-6); }
.mc-digit.d-7 { decorator: image(std-clock-digit-7); }
.mc-digit.d-8 { decorator: image(std-clock-digit-8); }
.mc-digit.d-9 { decorator: image(std-clock-digit-9); }

/* The fallen partner's countdown is the sign over it (#death-countdown), no text. */
#revive {
	display: none;
}

/* The countdown over the fallen partner (command_menu.c: BTL_initializeDeathCountdown, BTL_tickDeathCountdown,
   BTL_renderDeathCountdown): the star badge of BI_IN (u 0x32, v 0x80; 40 x 40, centred, mx and my 20) with its three
   palettes in turn (CLUT y 0x1ed to 0x1ef), and over it the digit (16 x 16, centred, palette 13). logic.lua places it
   on the partner's node and turns and scales both. */
#death-countdown {
	display: block;
	position: absolute;
	width: 0;
	height: 0;
}

#death-countdown.hidden {
	display: none;
}

#dc-badge {
	position: absolute;
	left: -60dp;
	top: -60dp;
	width: 120dp;
	height: 120dp;
	decorator: image(death-badge-0);
}

#dc-badge.palette-1 { decorator: image(death-badge-1); }
#dc-badge.palette-2 { decorator: image(death-badge-2); }

#dc-digit {
	position: absolute;
	left: -24dp;
	top: -24dp;
	width: 48dp;
	height: 48dp;
}

#dc-digit.digit-5 { decorator: image(death-digit-5); }
#dc-digit.digit-4 { decorator: image(death-digit-4); }
#dc-digit.digit-3 { decorator: image(death-digit-3); }
#dc-digit.digit-2 { decorator: image(death-digit-2); }
#dc-digit.digit-1 { decorator: image(death-digit-1); }

/* The original shows no button hints in battle; a small corner hint keeps the PC keys in sight. */
#prompts {
	right: 16dp;
	bottom: 12dp;
	padding: 2dp 8dp;
	font-size: 13dp;
	color: #c8c8c8;
	background-color: #000000b0;
	border-radius: 0dp;
}

/* The numbers over the fighters (utils2.c: drawEntityText): the digits of BI_IN with palette 4, untinted (TEXT_COLORS
   0, 0x80 each) for a hit's or a block's damage and with no green (TEXT_COLORS 0xc) for the poison's. */
.dd {
	color: transparent;
	font-effect: none;
	background-color: transparent;
}

.dd.d-0 { decorator: image(damage-digit-0); }
.dd.d-1 { decorator: image(damage-digit-1); }
.dd.d-2 { decorator: image(damage-digit-2); }
.dd.d-3 { decorator: image(damage-digit-3); }
.dd.d-4 { decorator: image(damage-digit-4); }
.dd.d-5 { decorator: image(damage-digit-5); }
.dd.d-6 { decorator: image(damage-digit-6); }
.dd.d-7 { decorator: image(damage-digit-7); }
.dd.d-8 { decorator: image(damage-digit-8); }
.dd.d-9 { decorator: image(damage-digit-9); }

.dn.poison .dd {
	image-color: #ff00ff;
}

/* What an item heals or a support move raises: the digits with green only (TEXT_COLORS 0xb), and 8 pixels left of the
   first digit the stat's icon of BI_IN with palette 6, untinted (entity_text.c: ENTITY_TEXT_ICON_U). */
.dn.gain .dd {
	image-color: #00ff00;
}

.di {
	right: auto;
	left: -24dp;
	width: 24dp;
	padding: 0;
	color: transparent;
	font-effect: none;
}

.di.i-hp { decorator: image(number-icon-hp); }
.di.i-mp { decorator: image(number-icon-mp); }
.di.i-offense { decorator: image(number-icon-offense); }
.di.i-defense { decorator: image(number-icon-defense); }
.di.i-speed { decorator: image(number-icon-speed); }

/* ------------------------------------------------------------------------------------------------------------------
   The battle's opening. The anger mark (btl.c: renderFleeBubble; BI_IN, palette 7): the red bubble, 24 pixels round
   its centre over the enemy, with the angry face inside at two thirds of its size; it grows for 5 frames and then
   pulses. The "BATTLE" banner (battle_hud.c: BTL_renderBattleStartText): its 8 x 12 pieces in one of three red
   textures, each with a black shadow 2 pixels down and right and, while it flies in, a trail at half opacity on the
   side it comes from; once all are in place they flash through palettes 8, 9 and 10. */

.anger {
	width: 72dp;
	height: 72dp;
	margin: -36dp 0 0 -36dp;
	border-radius: 0;
	background-color: transparent;
	decorator: image(anger-mark scale-none center center), image(anger-bubble);
}

/* An NPC not fighting runs off (btl.c: setFleeBubble(id, 1)): the next bubble and face in BI_IN. */
.anger.flee {
	decorator: image(flee-mark scale-none center center), image(flee-bubble);
}

.bp {
	background-color: transparent;
}

.bp.texture-0 { decorator: image(banner-0-0); }
.bp.texture-1 { decorator: image(banner-0-1); }
.bp.texture-2 { decorator: image(banner-0-2); }
#banner.flash-1 .bp.texture-0 { decorator: image(banner-1-0); }
#banner.flash-1 .bp.texture-1 { decorator: image(banner-1-1); }
#banner.flash-1 .bp.texture-2 { decorator: image(banner-1-2); }
#banner.flash-2 .bp.texture-0 { decorator: image(banner-2-0); }
#banner.flash-2 .bp.texture-1 { decorator: image(banner-2-1); }
#banner.flash-2 .bp.texture-2 { decorator: image(banner-2-2); }

.bt {
	opacity: 0.5;
	background-color: transparent;
	decorator: image(banner-trail);
}

.bt.left {
	decorator: image(banner-trail flip-horizontal);
}

/* ------------------------------------------------------------------------------------------------------------------
   The end boxes (battle_ui.c: handleBattleEndBox; capture battle_end_box_stats, battle_end_box_drop), 176 pixels wide
   in the middle of the screen. The stats box (createPostBattleStatsBox: -88, -78, 176 x 96; renderPostBattleStatsBox):
   six rows 13 pixels apart from its y 9, the label at x 10, the value at x 68 over a bar 2 pixels tall from x 64 to
   117 (grey, blue while it rises), the up arrow at x 130 and the raise left at x 142, a line at x 122. The bits box
   under it (createBitsBox: -88, 18, 176 x 66): the label at x 10, the bits at x 70, a line at y 32 and the two rows of
   text from y 36 (BTL_initializeBattleEndText: -78, 54, 156 x 24). The final balance box (createFinalBalanceBox: -88,
   -13, 176 x 31) opened over the stats box's foot once the raises were counted; here it goes under the bits box, so
   the last stats stay readable, and the outcome heads the boxes. The names are yellow (#fff371). */

#end {
	display: block;
	background-color: transparent;
}

#end-panel {
	position: absolute;
	left: 50%;
	top: 46dp;
	width: 528dp;
	height: 627dp;
	margin-left: -264dp;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

#end-title {
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 528dp;
	height: 42dp;
	margin: 0;
	font-size: 36dp;
	line-height: 42dp;
	text-align: center;
	color: #fff371;
	font-effect: shadow(3dp 3dp #000000);
}

#end-boxes {
	display: block;
	position: absolute;
	left: 0;
	top: 48dp;
	width: 528dp;
	height: 579dp;
	margin: 0;
}

#gains, #bits, #balance {
	position: absolute;
	left: 0;
	width: 528dp;
	margin: 0;
	padding: 0;
	border-radius: 0;
	border: 3dp transparent;
	background-color: #00000080;
	box-sizing: border-box;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
}

/* The rows start 9 pixels into the box (battle_ui.c: handleBattleEndBox), the border's 3dp included. */
#gains {
	top: 0;
	height: 288dp;
	padding-top: 24dp;
}

/* The line splitting the stats box: one light blue pixel and one black (capture battle_end_box_stats). */
#gains-divider {
	display: block;
	position: absolute;
	left: 366dp;
	top: 0;
	width: 3dp;
	height: 100%;
	border-right: 3dp #000000;
	background-color: #94deff;
}

.gain {
	display: block;
	position: relative;
	width: 528dp;
	height: 39dp;
	font-size: 33dp;
	line-height: 36dp;
}

.gain-label {
	position: absolute;
	left: 30dp;
	top: 0;
	color: #fff371;
}

.gain-stat {
	position: absolute;
	left: 192dp;
	top: 0;
	width: 120dp;
	text-align: right;
	color: #ffffff;
}

.stat-bar {
	position: absolute;
	left: 192dp;
	top: 33dp;
	width: 159dp;
	height: 6dp;
	border-radius: 0;
	background-color: #282828;
}

.stat-bar.raised {
	background-color: #005a96;
}

.stat-fill {
	width: 0;
	height: 6dp;
	border-radius: 0;
	background-color: #787878;
}

.stat-bar.raised .stat-fill {
	background-color: #69c2ff;
}

.gain-arrow {
	display: block;
	position: absolute;
	left: 390dp;
	top: 0;
	width: 36dp;
	height: 36dp;
	decorator: image(battle-up-arrow);
}

.gain-arrow.hidden {
	display: none;
}

.gain-value {
	position: absolute;
	left: 426dp;
	top: 0;
	color: #69c2ff;
}

/* The bits box is as tall as the balance box, and grows to hold the two rows of text when there is any. */
#bits {
	top: 288dp;
	height: 93dp;
	font-size: 33dp;
	line-height: 36dp;
}

#end-boxes.with-text #bits {
	height: 198dp;
}

#end-boxes.with-text #bits-line {
	display: block;
}

/* The line over the text: one grey pixel and one nearly black. */
#bits-line {
	position: absolute;
	left: 0;
	top: 93dp;
	width: 100%;
	height: 3dp;
	border-bottom: 3dp #101010;
	background-color: #8c8c8c;
}

/* The bits box's label is yellow and its bits pale cyan; the balance box's are light grey (captures). */
#bits-label, #balance-label {
	position: absolute;
	left: 30dp;
	top: 27dp;
	color: #ffff52;
}

#bits-value, #balance-value {
	position: absolute;
	left: 210dp;
	top: 27dp;
	color: #adffff;
}

#balance-label, #balance-value {
	color: #d6d6d6;
}

#balance {
	top: 381dp;
	height: 93dp;
	font-size: 33dp;
	line-height: 36dp;
	background-color: #293942;
}

#end-boxes.with-text #balance {
	top: 486dp;
}

#balance.hidden {
	display: none;
}

/* With the total, the boxes go in every skin's order: stats, total, then the bits with the text that continues. */
#end-boxes.with-balance #balance {
	top: 288dp;
}

#end-boxes.with-balance #bits {
	top: 381dp;
}

#end-boxes.with-balance #end-text {
	top: 489dp;
}

#end-text {
	margin: 0;
	position: absolute;
	left: 30dp;
	top: 396dp;
	width: 468dp;
	height: 72dp;
}

.end-row {
	display: block;
	height: 36dp;
	margin: 0;
	padding: 0;
	font-size: 33dp;
	line-height: 36dp;
	white-space: pre;
}

.end-plain {
	color: #e8e8e8;
}

.end-name {
	color: #fff371;
}

/* ------------------------------------------------------------------------------------------------------------------
   The marks over the fighters of a cup match between two of the same species (std_main.c: STD_renderPlayerMarker):
   the «1P» bubble over the partner and the «COM» one over the rival, from STDTIM's page (768, 0) with the CLUT
   (0, 481), 48 x 31 and 47 x 31 pixels, their top-left corner 32 pixels over the anchor logic.lua places. The words
   are in the picture: the text logic.lua writes stays hidden, and the modern look's label (this look goes over it)
   loses its box. */
#player-marks {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

/* Over the modern look's label: no box, no padding, no text. */
.pm {
	position: absolute;
	width: 0;
	height: 0;
	padding: 0;
	border-radius: 0;
	background-color: #00000000;
	color: #00000000;
	font-size: 1dp;
}

.pm.hidden {
	display: none;
}

#pm-0 {
	color: #00000000;
	decorator: image(std-mark-partner);
	margin-top: -96dp;
	width: 144dp;
	height: 93dp;
}

#pm-1 {
	decorator: image(std-mark-rival);
	margin-top: -96dp;
	width: 141dp;
	height: 93dp;
}

/* Quick battles (apps/game battle_speed.hpp, a dwe improvement): x2 in the bottom right corner while the
   fight runs at twice the speed. */
#speed-plate {
	position: absolute;
	right: 16dp;
	bottom: 16dp;
	padding: 2dp 10dp;
	font-size: 20dp;
	color: #ffffff;
	background-color: #000000b0;
	border-radius: 8dp;
}

#speed-plate.hidden {
	display: none;
}

/* ------------------------------------------------------------------------------------------------------------------
   Co-op (not in the original): the other players' partners fighting beside this one (#allies), under the partner's
   bars and finisher gauge at the right edge. Each card is the partner's bars again, with the species name over them
   in the original's font. */
#allies {
	position: absolute;
	right: 30dp;
	top: 192dp;
	left: auto;
	width: 312dp;
}

.ally {
	margin: 0 0 6dp 0;
}

.partner.ally .fighter-head {
	display: block;
	height: 30dp;
	margin: 0 0 3dp 12dp;
}

.ally .fighter-name {
	font-size: 24dp;
	line-height: 30dp;
}

.ally .fighter-status {
	display: none;
}

/* A fallen ally's revive countdown, after its name in the countdown's yellow. */
.ally-revive {
	font-size: 22dp;
	line-height: 30dp;
	margin-left: 12dp;
	color: #f8e050;
}

/* The values in the original's digits, as the partner's (the modern skin shows none on a card). */
.ally .bar-digits {
	display: block;
}

.ally .hp-label { decorator: image(battle-hp); }
.ally .mp-label { decorator: image(battle-mp); }

.partner.ally .fighter-head {
	white-space: nowrap;
}

.ally .fighter-name,
.ally-order {
	font-effect: outline(2dp #101820);
}

.ally-order {
	float: none;
	font-size: 20dp;
	line-height: 30dp;
	margin: 0 0 0 14dp;
	color: #a8d8f8;
}

/* ------------------------------------------------------------------------------------------------------------------
   The Folder battle (not in the original; it follows this skin's boxes): one of the original's boxes (theme.rcss:
   .original-box) at the bottom left, 10 pixels from the edges as the partner's bars are from theirs. "Guard" in the
   headings' yellow and the active order in the ink at full size; the foe and the waiting orders in the descriptions'
   grey at the small size. The bars are this skin's gauge (fishing_hud): a dark track 2 pixels tall, the fill yellow,
   red once the guard breaks; the phase's in the end box's rising blue. */
#folder-panel {
	left: 30dp;
	bottom: 30dp;
	box-sizing: border-box;
	width: 580dp;
	padding: 9dp 18dp;
	border: 3dp transparent;
	border-radius: 0;
	background-color: #10161cdc;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
	font-size: 22dp;
	line-height: 28dp;
	color: #d0d0d0;
}

/* A cup match's strip stands at the bottom left (#commands.match, top 504dp): the box goes up over its name. */
#commands.match ~ #folder-panel {
	bottom: 228dp;
}

.folder-row {
	margin-bottom: 3dp;
}

.folder-label {
	margin-right: 12dp;
	font-size: 33dp;
	line-height: 36dp;
	color: #fff371;
}

.folder-track {
	height: 6dp;
	border-radius: 0;
	background-color: #303030;
}

.folder-fill {
	border-radius: 0;
}

#folder-bar-fill { background-color: #e8d048; }
#folder-bar-fill.broken { background-color: #e04030; }

#folder-phase {
	margin: 3dp 0 6dp 0;
}

#folder-active {
	font-size: 26dp;
	line-height: 30dp;
}

/* The strip names the hovered icon in a Folder battle too (the modern skin's Folder pill does not apply), and says why
   the focused move cannot be ordered now after its name, in red at the small size. */
#fight.folder #command-name,
#fight.folder #command-name.problem {
	display: block;
}

#fight.folder #command-label {
	display: inline;
}

#command-problem {
	margin-left: 18dp;
	font-size: 22dp;
	color: #e04030;
}

#command-problem.hidden {
	display: none;
}

/* A Folder technique's reach takes a line of its own under the name, and the foe list makes room for it. */
#command-reach {
	display: block;
	font-size: 22dp;
	color: #a8b8c8;
}

#command-reach.hidden {
	display: none;
}

/* The key that types on the end box's text, while the text waits for it. */
#end-more {
	display: block;
	position: absolute;
	right: 0;
	bottom: 0;
	font-size: 18dp;
}

#end-more.hidden {
	display: none;
}

/* The Folder plate keeps a fixed height at the bottom left, four rows of one line each: the defense bar, the message
   (a broken defense, else how an order ended, else an altered state), the active order beside its phase, the queue. */
#folder-panel {
	height: 156dp;
	box-sizing: border-box;
	overflow: hidden;
}

#folder-message,
#folder-active,
#folder-queue {
	height: 28dp;
	line-height: 28dp;
	white-space: nowrap;
	overflow: hidden;
}

#folder-message.status { color: #b2b2b2; }
#folder-message.notice { color: #f0a040; }
#folder-message.broken { color: #e03028; }
#folder-queue { color: #b2b2b2; }

#folder-active {
	flex: 0 0 auto;
	max-width: 60%;
	margin-right: 10dp;
}

#folder-phase {
	flex: 1;
	margin: 0;
}

/* The Folder plate's stance chip, phases and queue chips in the boxes' colours; the stances' frames on the strip
   tinted apart from the techniques and the actions. The finisher's word already fills as its gauge does. */
#folder-stance {
	font-size: 20dp;
	line-height: 26dp;
	color: #9fd8ff;
	border: 2dp #69c2ff;
	border-radius: 0;
}

#folder-stance.forced {
	color: #ff8a70;
	border-color: #e04030;
}

.folder-step {
	border-radius: 0;
	background-color: #303030;
}

.folder-step.done { background-color: #3a6a90; }
.folder-step.now { background-color: #69c2ff; }
#folder-lock.locked { background-color: #e8d048; }

.folder-chip {
	font-size: 20dp;
	line-height: 24dp;
	color: #d0d0d0;
	border: 2dp #505050;
	border-radius: 0;
}

.command-frame.kind-stance {
	image-color: #ff9a5c;
}

.hb-tag {
	border-radius: 0;
	font-size: 20dp;
}

#finisher-percent {
	display: none;
}

/* Without an order the target takes the whole row: the phase is hidden. */
#folder-active.alone {
	max-width: 100%;
}

/* A Folder battle names its foes by letter: a compact list at the left under the strip, as the bars hanging from a foe
   high in the field can sit past the screen's top. */
#fight.folder #enemies {
	display: block;
	position: absolute;
	left: 30dp;
	top: 210dp;
	width: 300dp;
}

#fight.folder.reach #enemies {
	top: 240dp;
}

#fight.folder .fighter.enemy {
	padding: 4dp 10dp;
	margin: 0 0 6dp 0;
	background-color: #000000b0;
	color: #e8e8e8;
}

#fight.folder .fighter.enemy .fighter-name {
	font-size: 22dp;
}
