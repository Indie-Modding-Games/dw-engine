/* The battle in the original look: the partner's HP and MP at the top right, the finisher gauge under them, the
   tamer's commands at the top left, the enemies' HP bars and the end boxes, all over the undimmed arena.

   Positions are the captures' (battle_hud, battle_hud_enemy_hp_bar, battle_hud_finisher_ready, battle_end_box*):
   the decompilation's screen coordinates less 6 lines in battle. On a wide screen the panels keep to their edges at
   the original's distances; the end boxes stay in the middle. */

#fight {
	background-color: transparent;
}

/* ------------------------------------------------------------------------------------------------------------------
   The partner's bars (BI_IN; command_menu.c and the battle HUD): each the 104 x 8 frame at x 206, y 14 and 26 (the
   decompilation's 20 and 32), the icon (11 x 11) at the frame's (4, -2), the fill from the frame's (18, 3), 50 pixels
   at most and 2 tall (HP #f8d8c8 over #d04848, MP #c8e0f0 over #0068b8), and the value's four digits from the frame's
   x 73 to x 99 (the capture's x 305), in the original's small digits, 8 pixels tall (24dp). The panel ends 10 pixels from the right edge. The partner's name and status are not shown, as the original. */

#partner-panel {
	position: absolute;
	right: 30dp;
	top: 42dp;
	left: auto;
	bottom: auto;
	width: 312dp;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.fighter {
	margin: 0;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.partner .fighter-head {
	display: none;
}

.partner .bar-row {
	display: block;
	position: relative;
	width: 312dp;
	height: 24dp;
	margin: 0 0 12dp 0;
	decorator: image(battle-bar-frame);
}

.partner .bar-label {
	position: absolute;
	left: 12dp;
	top: -6dp;
	width: 33dp;
	height: 33dp;
	font-size: 0;
	color: transparent;
}

#fighter-0-hp-label { decorator: image(battle-hp); }
#fighter-0-mp-label { decorator: image(battle-mp); }

.partner .bar {
	position: absolute;
	left: 54dp;
	top: 9dp;
	width: 150dp;
	height: 6dp;
	margin: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.partner .fill {
	height: 3dp;
	border-radius: 0;
}

.partner .hp .fill {
	border-top: 3dp #f8d8c8;
	background-color: #d04848;
}

.partner .mp .fill {
	border-top: 3dp #c8e0f0;
	background-color: #0068b8;
}

.partner .bar-value {
	position: absolute;
	left: 219dp;
	top: 0;
	width: 78dp;
	font-size: 24dp;
	line-height: 24dp;
	text-align: right;
	color: #d0d0d0;
}

.fighter.fainted {
	opacity: 0.5;
}

/* The finisher (command_menu.c: 8 segments from x 215, y 35, in the yellows #f8e058 to #c8b028): the original fills
   the letters of its word one by one (capture battle_hud_finisher_ready, "FIN"); its 8 segments are blocks here, the
   word's letters being part of the sprite. */
#finisher {
	width: auto;
	margin: 0 0 0 27dp;
	padding: 0;
	border-width: 0;
	background-color: transparent;
}

#finisher-label {
	display: none;
}

.segment {
	width: 18dp;
	height: 21dp;
	margin: 0;
	border-radius: 0;
	background-color: transparent;
}

.segment.filled, #finisher.ready .segment {
	background-color: transparent;
	decorator: vertical-gradient(#f8e058 #c8b028);
}

/* ------------------------------------------------------------------------------------------------------------------
   The tamer's commands (command_menu.c: BTL_renderCommandMenu): a strip at the top left from x 17, y 14, the
   current command's name under it at (20, 48) in the ink colour, the cursor a yellow outline (#f8d000). The original
   draws each command as a 16 x 16 icon of BTLCOMND; the battle's settings name a command's text, not its icon, so
   the strip shows the names, smaller. */

#commands {
	position: absolute;
	left: 51dp;
	top: 42dp;
	width: auto;
	text-align: left;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

#command-row {
	display: block;
	margin: 0;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

.command {
	display: inline-block;
	margin: 0 6dp 6dp 0;
	padding: 0 9dp;
	font-size: 22dp;
	line-height: 30dp;
	border: 3dp transparent;
	background-color: #00000080;
}

.command:focus, .command.current {
	border-color: #f8d000;
	background-color: #00000080;
	color: #d0d0d0;
}

.command.unavailable {
	color: #828282;
}

#command-name {
	margin: 6dp 0 0 9dp;
	font-size: 33dp;
	color: #d0d0d0;
}

/* ------------------------------------------------------------------------------------------------------------------
   The enemies' HP (capture battle_hud_enemy_hp_bar): a 54 x 6 outline in green (#0AB40A) round a light green fill 3
   pixels tall, the value above its right end. The original hangs each bar beside its enemy; the battle does not yet
   publish where an enemy is on the screen, so the bars stand in a column at the top middle (a documented gap). */

#enemies {
	position: absolute;
	right: auto;
	left: 50%;
	top: 120dp;
	width: 240dp;
	margin-left: -120dp;
	padding: 0;
	border-width: 0;
	background-color: transparent;
}

.enemy {
	width: 240dp;
	margin: 0 0 18dp 0;
}

.enemy .fighter-head {
	font-size: 22dp;
	color: #d0d0d0;
}

.enemy .fighter-status {
	margin-left: 9dp;
	font-size: 22dp;
	color: #fff371;
}

.enemy .bar-row {
	display: block;
	position: relative;
	height: 48dp;
}

.enemy .bar-label {
	display: none;
}

.enemy .bar {
	position: absolute;
	left: 0;
	bottom: 0;
	width: 156dp;
	height: 12dp;
	margin: 0;
	border-radius: 0;
	border: 3dp #0ab40a;
	background-color: transparent;
}

.enemy .fill {
	height: 9dp;
	border-radius: 0;
	decorator: horizontal-gradient(#a0e8a0 #e8ffe8);
}

.enemy .bar-value {
	position: absolute;
	left: 96dp;
	top: 0;
	width: 66dp;
	font-size: 33dp;
	line-height: 30dp;
	text-align: right;
}

/* ------------------------------------------------------------------------------------------------------------------
   The finisher's charge and the revive countdown: one of the original's boxes and the ink colour. */

#charge {
	border-radius: 0;
	border: 3dp #90d9fa;
	border-right-color: #4a9fc5;
	background-color: #2d384080;
	decorator: image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
}

#charge-title {
	font-size: 33dp;
	color: #fff371;
}

#charge .bar {
	height: 9dp;
	border-radius: 0;
	border: 3dp #020202;
	border-right-color: #6987a0;
	border-bottom-color: #6987a0;
	background-color: #354b5c;
}

#charge .fill {
	border-radius: 0;
	decorator: vertical-gradient(#f8e058 #c8b028);
}

.charge-hint {
	font-size: 22dp;
	color: #b2b2b2;
}

#revive {
	font-size: 33dp;
	color: #d0d0d0;
}

#prompts {
	right: 30dp;
	bottom: 18dp;
	padding: 0;
	border-radius: 0;
	font-size: 22dp;
	color: #b2b2b2;
	background-color: transparent;
}

/* ------------------------------------------------------------------------------------------------------------------
   The bag in battle: the field bag's box (inventory.c; capture field_item_bag_1item) at the top, with the
   description under it in grey. */

#bag {
	left: 27dp;
	top: 27dp;
	width: 906dp;
	padding: 18dp 15dp;
	border-radius: 0;
	border: 3dp #90d9fa;
	border-right-color: #4a9fc5;
	background-color: #00000080;
	decorator: image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
}

#bag h2 {
	font-size: 33dp;
	color: #fff371;
}

.bag-slot {
	width: 414dp;
	height: 54dp;
	margin: 0 18dp 0 0;
	padding: 0 9dp 0 66dp;
	font-size: 33dp;
	line-height: 48dp;
	border: 3dp transparent;
}

.bag-slot:focus {
	border-color: #b0b0b0 #121212 #121212 #b0b0b0;
	background-color: #80808080;
}

.bag-slot.unusable {
	color: #828282;
}

#bag-description {
	font-size: 33dp;
	color: #b2b2b2;
}

#item-in-flight {
	font-size: 33dp;
	color: #d0d0d0;
}

.bag-slot:focus .original-look {
	color: #d0d0d0;
}

/* ------------------------------------------------------------------------------------------------------------------
   The end boxes (battle_ui.c: handleBattleEndBox; capture battle_end_box_stats, battle_end_box_drop), 176 pixels wide
   in the middle of the screen. The stats box (createPostBattleStatsBox: -88, -78, 176 x 96; renderPostBattleStatsBox):
   six rows 13 pixels apart from its y 9, the label at x 10, the value at x 68 over a bar 2 pixels tall from x 64 to
   117 (grey, blue while it rises), the up arrow at x 130 and the raise left at x 142, a line at x 122. The bits box
   under it (createBitsBox: -88, 18, 176 x 66): the label at x 10, the bits at x 70, a line at y 32 and the two rows of
   text from y 36 (BTL_initializeBattleEndText: -78, 54, 156 x 24). The final balance box (createFinalBalanceBox: -88,
   -13, 176 x 31) opens over the stats box's foot once the raises are counted. The names are yellow (#fff371). */

#end {
	display: block;
	background-color: transparent;
}

#end-panel {
	position: absolute;
	left: 50%;
	top: 108dp;
	width: 528dp;
	height: 486dp;
	margin-left: -264dp;
	padding: 0;
	border-radius: 0;
	border-width: 0;
	background-color: transparent;
}

#end-title {
	display: none;
}

#end-boxes {
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 528dp;
	height: 486dp;
	margin: 0;
}

#gains, #bits, #balance {
	position: absolute;
	left: 0;
	width: 528dp;
	margin: 0;
	padding: 0;
	border-radius: 0;
	border: 3dp #90d9fa;
	border-right-color: #4a9fc5;
	background-color: #00000080;
	box-sizing: border-box;
}

/* The rows start 9 pixels into the box (battle_ui.c: handleBattleEndBox), the border's 3dp included. */
#gains {
	top: 0;
	height: 288dp;
	padding-top: 24dp;
}

#gains-divider {
	display: block;
	position: absolute;
	left: 366dp;
	top: 0;
	width: 6dp;
	height: 100%;
	background-color: #90d9fa;
}

.gain {
	display: block;
	position: relative;
	width: 528dp;
	height: 39dp;
	font-size: 33dp;
	line-height: 36dp;
}

.gain-label {
	position: absolute;
	left: 30dp;
	top: 0;
	color: #fff371;
}

.gain-stat {
	position: absolute;
	left: 192dp;
	top: 0;
	width: 120dp;
	text-align: right;
	color: #ffffff;
}

.stat-bar {
	position: absolute;
	left: 192dp;
	top: 33dp;
	width: 159dp;
	height: 6dp;
	border-radius: 0;
	background-color: #282828;
}

.stat-bar.raised {
	background-color: #005a96;
}

.stat-fill {
	width: 0;
	height: 6dp;
	border-radius: 0;
	background-color: #787878;
}

.stat-bar.raised .stat-fill {
	background-color: #69c2ff;
}

.gain-arrow {
	display: block;
	position: absolute;
	left: 390dp;
	top: 0;
	width: 36dp;
	height: 36dp;
	decorator: image(battle-up-arrow);
}

.gain-arrow.hidden {
	display: none;
}

.gain-value {
	position: absolute;
	left: 426dp;
	top: 0;
	color: #69c2ff;
}

/* The bits box is as tall as the balance box, and grows to hold the two rows of text when there is any. */
#bits {
	top: 288dp;
	height: 93dp;
	font-size: 33dp;
	line-height: 36dp;
}

#end-boxes.with-text #bits {
	height: 198dp;
}

#end-boxes.with-text #bits-line {
	display: block;
}

#bits-line {
	position: absolute;
	left: 0;
	top: 93dp;
	width: 100%;
	height: 3dp;
	background-color: #90d9fa;
}

#bits-label, #balance-label {
	position: absolute;
	left: 30dp;
	top: 27dp;
}

#bits-value, #balance-value {
	position: absolute;
	left: 210dp;
	top: 27dp;
	color: #69c2ff;
}

#balance {
	top: 195dp;
	height: 93dp;
	font-size: 33dp;
	line-height: 36dp;
	background-color: #1c2a36;
}

#balance.hidden {
	display: none;
}

#end-text {
	margin: 0;
	position: absolute;
	left: 30dp;
	top: 396dp;
	width: 468dp;
	height: 72dp;
}

.end-row {
	display: block;
	height: 36dp;
	margin: 0;
	padding: 0;
	font-size: 33dp;
	line-height: 36dp;
	white-space: pre;
}

.end-plain {
	color: #e8e8e8;
}

.end-name {
	color: #fff371;
}
