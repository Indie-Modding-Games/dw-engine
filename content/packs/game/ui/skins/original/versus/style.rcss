/* The host's setup: the arrows of the options' steppers, the battle's up arrow turned sideways (BI_IN). */
.stepper .arrow { width: 36dp; height: 30dp; image-color: #90d9fa; }
.stepper .arrow.less { decorator: image(battle-up-arrow scale-none center center); transform: rotate(-90deg); }
.stepper .arrow.more { decorator: image(battle-up-arrow scale-none center center); transform: rotate(90deg); }
