/* Mode selection reuses the new game's terminal card and gives each available mode a full-width row. The current
   mode's description follows the list so controller focus and mouse focus reveal the same information. */

#panel {
	width: 780dp;
	margin-left: -390dp;
	padding: 24dp 30dp 18dp 30dp;
}

#title {
	margin-bottom: 12dp;
}

#panel button.mode {
	display: block;
	width: 100%;
	height: 46dp;
	margin: 0 0 5dp 0;
	padding: 0 15dp;
	box-sizing: border-box;
	border: 1dp #345875;
	border-radius: 0;
	background-color: #0a2035;
	color: #d8f1ff;
	font-size: 19dp;
	line-height: 43dp;
	text-align: left;
}

#panel button.mode.hidden {
	display: none;
}

#panel button.mode:hover {
	border-color: #72c7ff;
	background-color: #153653;
}

#panel button.mode:focus {
	border: 2dp #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}

#panel #about {
	min-height: 48dp;
	margin: 12dp 0 0 0;
	padding: 12dp 15dp;
	box-sizing: border-box;
	border-left: 3dp #72c7ff;
	background-color: #0a2035;
	color: #a8c7d9;
	font-size: 16dp;
	line-height: 24dp;
}

#panel #back {
	width: 100%;
	margin: 12dp 0 0 0;
	background-color: #102a40;
}

#panel #back:focus {
	border: 2dp #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}

@media (max-width: 820dp) {
	#panel {
		width: 92%;
		margin-left: -46%;
		padding: 18dp 20dp 15dp 20dp;
	}
}

@media (max-height: 620dp) {
	#panel { top: 12dp; transform: none; }
	#panel button.mode { height: 40dp; line-height: 37dp; }
	#panel #about { min-height: 36dp; margin-top: 6dp; padding: 6dp 12dp; }
	#panel #back { height: 40dp; margin-top: 6dp; line-height: 37dp; }
}
