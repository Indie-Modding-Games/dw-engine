/* The co-op HUD in the DevVago look: the terminal card of the online screens (a light cyan line round a night blue
   gradient) for the notice and the name tag, in the skin's pixel fonts at their sharp sizes. */

.tag,
#notice {
	border: 2dp #72c7ff;
	border-radius: 0;
	background-color: #0b1c2df0;
	decorator: vertical-gradient(#153653 #0a1929);
	color: #d8f1ff;
}

.tag {
	padding: 2dp 12dp;
	font-family: "Pixel Small"; font-size: 26dp;
	line-height: 28dp;
}

#notice {
	padding: 12dp 24dp;
	font-size: 30dp;
	line-height: 39dp;
}
