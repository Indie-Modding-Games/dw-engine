/* Shop screens share the pause menu's terminal palette, with a wider centred layout for the keeper's dialogue,
   choices, item list and quantity prompt. */

#panel {
	position: absolute;
	left: 50%;
	top: 96dp;
	width: 690dp;
	margin-left: -345dp;
	padding: 18dp 24dp 16dp 24dp;
	box-sizing: border-box;
	border: 2dp #72c7ff;
	border-radius: 0;
	background-color: #0b1c2df5;
	decorator: vertical-gradient(#153653 #0a1929);
}

#line {
	min-height: 54dp;
	margin: 0 0 12dp 0;
	padding: 0 9dp 12dp 9dp;
	border-bottom: 2dp #397ca4;
	font-size: 22dp;
	line-height: 30dp;
	color: #d8f1ff;
}

#next, .choice, .row, .page-turn, .back,
#amount button {
	box-sizing: border-box;
	border: 1dp #345875;
	border-radius: 0;
	background-color: #0a2035;
	color: #d8f1ff;
}

#next, .choice, .back, #amount button {
	min-height: 42dp;
	padding: 0 12dp;
	line-height: 40dp;
}

#next, .choice, .back, #amount-confirm {
	border-color: #397ca4;
}

#next:hover, .choice:hover, .row:hover, .page-turn:hover, .back:hover,
#amount button:hover {
	border-color: #72c7ff;
	background-color: #153653;
	color: #ffffff;
}

#next:focus, .choice:focus, .row:focus, .page-turn:focus, .back:focus,
#amount button:focus {
	border: 2dp #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}

#choices {
	margin: 6dp 0 0 0;
	padding-top: 6dp;
}

.choice {
	display: block;
	width: 100%;
	height: 42dp;
	margin: 0 0 6dp 0;
	text-align: left;
	text-transform: uppercase;
}

#list {
	position: relative;
	padding: 6dp 0 0 0;
	border-top: 2dp #397ca4;
}

.row {
	display: block;
	width: 100%;
	height: 39dp;
	margin: 0 0 3dp 0;
	padding: 0 12dp;
	line-height: 36dp;
	text-align: left;
}

.row.disabled {
	color: #7890a2;
}

#empty {
	margin: 9dp 0;
	color: #a8c7d9;
}

#page {
	position: absolute;
	right: 0;
	bottom: 0;
	margin: 0;
	color: #a8c7d9;
	font-size: 14dp;
}

.page-turn {
	min-height: 33dp;
	margin: 6dp 6dp 0 0;
	padding: 0 9dp;
	font-size: 14dp;
	line-height: 30dp;
}

.back {
	margin-top: 9dp;
	color: #a8c7d9;
}

#list-description {
	margin: 9dp 0 0 0;
	padding: 9dp 12dp;
	border-left: 3dp #72c7ff;
	background-color: #0a2035;
	color: #a8c7d9;
	font-size: 14dp;
	line-height: 21dp;
}

#amount {
	position: relative;
	min-height: 300dp;
	padding: 12dp 18dp 60dp 18dp;
	border: 1dp #345875;
	background-color: #0a2035;
}

#amount-name {
	margin: 0 0 12dp 0;
	padding-bottom: 9dp;
	border-bottom: 2dp #397ca4;
	font-size: 24dp;
	font-weight: bold;
	color: #ffe64a;
}

#amount-price, #amount-value, #amount-total, #amount-owned, #amount-after {
	margin: 6dp 0;
	font-size: 18dp;
	color: #d8f1ff;
}

#amount-less, #amount-more, #amount-max {
	min-width: 105dp;
	margin: 6dp 6dp 0 0;
}

#amount-confirm, #amount-back {
	position: absolute;
	bottom: 12dp;
	width: 46%;
	text-align: center;
}

#amount-confirm { left: 2%; }
#amount-back { right: 2%; }

#prompts {
	margin-top: 12dp;
	padding-top: 9dp;
	border-top: 1dp #397ca4;
	color: #a8c7d9;
	font-size: 14dp;
	text-align: right;
}

.prompt { margin-left: 15dp; }
.key { color: #72c7ff; }

/* These overlays sit in the separate 960dp frame and keep the same frame treatment as the shop card. */
body #bits-box, body #description {
	border: 2dp #72c7ff;
	border-radius: 0;
	background-color: #0b1c2df5;
	decorator: vertical-gradient(#153653 #0a1929);
	font-family: original-look;
	color: #d8f1ff;
}

body #bits-box {
	padding-top: 6dp;
}

body #bits-label {
	color: #a8c7d9;
}

body #bits-value {
	color: #ffe64a;
}

body #description {
	color: #d8f1ff;
}

/* The money box stands at the top left of the 4:3 picture: in a wide window the shop moves right of it, as it covered
   the box's figures centred. */
@media (min-width: 1100dp) {
	#panel { margin-left: -200dp; }
}

@media (max-width: 760dp) {
	#panel {
		width: 92%;
		margin-left: -46%;
	}
}

@media (max-height: 600dp) {
	#panel { top: 36dp; }
	#amount { min-height: 240dp; }
}
