/* The shop job's counter in DevVago's look (structure: ../../../shop_haggle/structure.rcss; the rules panel shares this
   sheet for its panel): the shop's terminal panel (shop_menu/style.rcss), a deep blue gradient inside a light cyan
   line, the original-look text at 22dp, insets and rows as dark blue cells with a steel edge, the pointer lighting a
   row's edge in cyan and the focus framing it in gold with gold text, labels in pale blue and buttons in capitals.
     #0b1c2d panel, #153653 -> #0a1929 its gradient, #72c7ff its line, #0a2035 cells, #345875 / #397ca4 their edges
     #d8f1ff text, #a8c7d9 labels, #7890a2 disabled, #ffd51e / #ffe64a focus and headings */

#scrim {
	background-color: #020a12b0;
}

#panel {
	font-family: original-look;
	font-weight: normal;
	font-size: 22dp;
	line-height: 26dp;
	color: #d8f1ff;
	border: 2dp #72c7ff;
	border-radius: 0;
	background-color: #0b1c2df5;
	decorator: vertical-gradient(#153653 #0a1929);
}

#haggle-head {
	border-bottom: 2dp #397ca4;
}

#haggle-title {
	font-size: 33dp;
	font-weight: normal;
	color: #ffe64a;
}

#haggle-summary {
	font-size: 22dp;
	color: #a8c7d9;
}

#haggle-tally {
	font-weight: normal;
	color: #d8f1ff;
}

#haggle-next {
	font-weight: normal;
	color: #ffe64a;
}

#haggle-rules, #haggle-actions button {
	padding: 0 12dp;
	margin: 0;
	border: 2dp #397ca4;
	border-radius: 0;
	background-color: #0a2035;
	font-size: 22dp;
	line-height: 34dp;
	color: #d8f1ff;
	text-transform: uppercase;
}

#haggle-actions button {
	margin-right: 12dp;
	padding: 0 18dp;
}

/* The head's button keeps the mixed case: this font's capitals are twice as wide, and the head is full. */
#haggle-rules {
	text-transform: none;
}

#haggle-rules .key {
	font-size: 22dp;
	line-height: 24dp;
	color: #72c7ff;
}

#haggle-rules:hover, #haggle-actions button:hover {
	border-color: #72c7ff;
	background-color: #153653;
	color: #ffffff;
}

#haggle-rules:focus, #haggle-actions button:focus {
	border-color: #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}

#haggle-talk.disabled, #haggle-talk.disabled:hover {
	color: #7890a2;
}

/* The customer's card and the item: cells with a steel edge. */
#haggle-customer, #haggle-item {
	border: 1dp #345875;
	border-radius: 0;
	background-color: #0a2035;
}

#haggle-portrait {
	border: 2dp #72c7ff;
	border-radius: 0;
	background-color: #071522;
}


#haggle-species {
	font-size: 22dp;
	line-height: 26dp;
	font-weight: normal;
	color: #ffe64a;
}

#haggle-character, #haggle-regular, #haggle-patience-label, #haggle-history-title, #haggle-history {
	font-size: 22dp;
	line-height: 24dp;
	color: #a8c7d9;
}

#haggle-mood, #haggle-reaction {
	font-size: 22dp;
	line-height: 24dp;
	font-weight: normal;
}

#haggle-mood {
	border-radius: 0;
	background-color: #153653;
	color: #d8f1ff;
}

#haggle-mood.mood-cheerful { color: #7ee8a0; }
#haggle-mood.mood-serious { color: #ffa94d; }

#haggle-reaction.face-delighted, #haggle-reaction.face-pleased, #haggle-reaction.face-doubtful,
#haggle-reaction.face-annoyed, #haggle-reaction.face-furious {
	border-radius: 0;
	background-color: #153653;
}

#haggle-reaction.face-delighted, #haggle-reaction.face-pleased { color: #7ee8a0; }
#haggle-reaction.face-doubtful { color: #ffe64a; }
#haggle-reaction.face-annoyed { color: #ffa94d; }
#haggle-reaction.face-furious { color: #ff7775; }

.pip {
	width: 12dp;
	height: 12dp;
	border: 2dp #397ca4;
	border-radius: 0;
	background-color: #071522;
	decorator: none;
}

.pip.on {
	border-color: #ffd51e;
	background-color: #ffd51e;
}

#haggle-wants {
	color: #d8f1ff;
}

#haggle-no-offers {
	color: #7890a2;
}

.haggle-offer .offer-text { color: #d8f1ff; }
.haggle-offer.face-doubtful .offer-text { color: #ffe64a; }
.haggle-offer.face-annoyed .offer-text { color: #ffa94d; }
.haggle-offer.face-furious .offer-text { color: #ff7775; }

/* The table: pale blue headings over the panel's rule, the rows as cells. */
#haggle-columns {
	height: 27dp;
	line-height: 24dp;
	font-size: 22dp;
	color: #a8c7d9;
	border-bottom: 2dp #397ca4;
}

.haggle-row {
	height: 30dp;
	line-height: 28dp;
	padding: 0;
	margin: 0 0 1dp 0;
	border: 2dp #1d3b55;
	border-radius: 0;
	background-color: #0a2035;
	font-size: 22dp;
	color: #d8f1ff;
	decorator: none;
}

.haggle-row:hover {
	border-color: #72c7ff;
	background-color: #153653;
	color: #ffffff;
}

.haggle-row:focus {
	border-color: #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}

.haggle-row .row-price { font-weight: normal; }
.haggle-row.regular .row-price { color: #72c7ff; }
.haggle-row:focus .row-price, .haggle-row:focus .row-adds { color: #ffe64a; }

.row-meter {
	top: 10dp;
	height: 8dp;
	border-radius: 0;
	background-color: #071522;
}

.row-meter-fill {
	border-radius: 0;
}

.chance-1 .row-meter-fill, .chance-2 .row-meter-fill { background-color: #ff7775; }
.chance-3 .row-meter-fill, .chance-4 .row-meter-fill { background-color: #ffa94d; }
.chance-5 .row-meter-fill, .chance-6 .row-meter-fill, .chance-7 .row-meter-fill { background-color: #ffe64a; }
.chance-8 .row-meter-fill, .chance-9 .row-meter-fill { background-color: #6fe08a; }
.chance-10 .row-meter-fill { background-color: #9cffb6; }

.haggle-row .row-chance { font-weight: normal; }
.haggle-row.chance-0 .row-chance, .haggle-row.chance-1 .row-chance, .haggle-row.chance-2 .row-chance { color: #ff7775; }
.haggle-row.chance-3 .row-chance, .haggle-row.chance-4 .row-chance { color: #ffa94d; }
.haggle-row.chance-5 .row-chance, .haggle-row.chance-6 .row-chance, .haggle-row.chance-7 .row-chance { color: #ffe64a; }
.haggle-row.chance-8 .row-chance, .haggle-row.chance-9 .row-chance, .haggle-row.chance-10 .row-chance { color: #6fe08a; }

/* A price refused before: greyed out. */
.haggle-row.offered, .haggle-row.offered .row-price, .haggle-row.offered .row-adds,
.haggle-row.offered .row-chance { color: #7890a2; }
.haggle-row.offered .row-meter-fill { background-color: #345875; }
