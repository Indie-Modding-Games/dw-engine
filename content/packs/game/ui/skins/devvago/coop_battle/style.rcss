#panel {
	border: 3dp transparent;
	border-radius: 0;
	background-color: #0b1c2df2;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
	font-family: original-look;
	font-size: 22dp;
	line-height: 28dp;
	color: #d5eaf7;
}

#title {
	font-size: 22dp;
	color: #ffe64a;
}

#phase {
	color: #a8c7d9;
}

#panel button {
	margin: 3dp;
	padding: 0 9dp;
	border: 2dp #338bb4;
	border-radius: 0;
	background-color: #102a40;
	font-family: original-look-dialogue;
	font-size: 22dp;
	line-height: 30dp;
	color: #d5eaf7;
}

#panel button:hover,
#panel button:focus {
	border-color: #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}
