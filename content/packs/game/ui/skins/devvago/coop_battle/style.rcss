#panel {
	width: 34%;
	border: 3dp transparent;
	border-radius: 0;
	background-color: #0b1c2df2;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
	font-family: original-look;
	font-size: 22dp;
	line-height: 28dp;
	color: #d5eaf7;
}

#title {
	font-size: 22dp;
	color: #ffe64a;
}

#phase,
#items-title,
#no-items {
	color: #a8c7d9;
}

.fighter.partner .name {
	color: #ffe64a;
}

.fighter .bar {
	width: 56%;
	border-radius: 0;
	background-color: #1d3a55;
}

.fighter .fill {
	border-radius: 0;
	background-color: #6fe07a;
}

.fighter .hp,
.fighter .mp,
.fighter .revive {
	font-family: "Pixel Small";
	font-size: 26dp;
}

.fighter .mp {
	color: #72c7ff;
}

.fighter.mine {
	border-left-color: #ffd51e;
}

#panel button {
	margin: 3dp;
	padding: 0 9dp;
	border: 2dp #338bb4;
	border-radius: 0;
	background-color: #102a40;
	font-family: original-look-dialogue;
	font-size: 22dp;
	line-height: 30dp;
	color: #d5eaf7;
}

#panel button:hover,
#panel button:focus {
	border-color: #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}

#panel button.current {
	border-color: #ffd51e;
	background-color: #ffd51e;
	color: #081724;
}

.fighter .revive {
	padding: 0 6dp;
	color: #081724;
	background-color: #ffd51e;
}

.fighter.down .name {
	color: #6c8396;
}

.fighter.down {
	opacity: 1;
}

.fighter.down .name,
.fighter.down .bar,
.fighter.down .hp,
.fighter.down .mp {
	opacity: 0.5;
}
