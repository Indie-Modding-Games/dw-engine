/* The shop job's rules in DevVago's look (structure: ../../../shop_job_rules/structure.rcss), over the counter's
   terminal panel (../shop_haggle/style.rcss): the title in gold over the panel's rule, the pay tiers as cells with the
   HUD bar's fill colour at their left (cyan, gold, white, as the bar; the bonus in green), the faces as a legend in a
   cell, one rule per line with the light cyan at its left, the close button in capitals. */

#panel.rules-panel {
	padding-top: 9dp;
	padding-bottom: 9dp;
	font-size: 22dp;
	line-height: 23dp;
}

#rules-head {
	margin-bottom: 9dp;
	padding-bottom: 6dp;
}

.rules-tier {
	padding-top: 4dp;
	padding-bottom: 4dp;
}

.rules-character, #rules-prices, #rules-faces-text, #rules-talk, #rules-dismiss {
	padding-top: 2dp;
	padding-bottom: 2dp;
}

#rules-foot {
	padding-top: 6dp;
}

#rules-head {
	border-bottom: 2dp #397ca4;
}

#rules-title {
	font-size: 33dp;
	line-height: 33dp;
	font-weight: normal;
	color: #ffe64a;
}

#rules-goal, #rules-original {
	font-size: 22dp;
	color: #a8c7d9;
}

.rules-tier {
	border: 1dp #345875;
	border-left: 6dp #397ca4;
	border-radius: 0;
	background-color: #0a2035;
	color: #d8f1ff;
}

#rules-pay-lowest { border-left-color: #2674a2; }
#rules-pay-better { border-left-color: #c69c15; }
#rules-pay-bonus { border-left-color: #6fe08a; }

.rules-tier.main {
	font-weight: normal;
	color: #ffe64a;
	border-color: #ffd51e;
	border-left-color: #d8f1ff;
	background-color: #153653;
}

#rules-characters-title {
	font-size: 22dp;
	font-weight: normal;
	color: #ffe64a;
}

.rules-character, #rules-prices, #rules-faces-text, #rules-talk, #rules-dismiss {
	border-left: 3dp #72c7ff;
	font-size: 22dp;
	color: #d8f1ff;
}

.rules-character {
	color: #a8c7d9;
}

#rules-faces {
	border: 1dp #345875;
	border-radius: 0;
	background-color: #0a2035;
}

.rules-face {
	font-size: 22dp;
	font-weight: normal;
}

.rules-face.face-delighted span, .rules-face.face-pleased span { color: #7ee8a0; }
.rules-face.face-doubtful span { color: #ffe64a; }
.rules-face.face-annoyed span { color: #ffa94d; }
.rules-face.face-furious span { color: #ff7775; }

#rules-foot {
	border-top: 2dp #397ca4;
}

#rules-close {
	padding: 0 18dp;
	margin: 0;
	border: 2dp #397ca4;
	border-radius: 0;
	background-color: #0a2035;
	font-size: 22dp;
	line-height: 34dp;
	color: #d8f1ff;
	text-transform: uppercase;
}

#rules-close .key {
	font-size: 22dp;
	line-height: 24dp;
	color: #72c7ff;
}

#rules-close:hover {
	border-color: #72c7ff;
	background-color: #153653;
	color: #ffffff;
}

#rules-close:focus {
	border-color: #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}
