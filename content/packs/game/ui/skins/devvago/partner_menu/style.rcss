/* Three fixed tracks (profile 220 / stats 260 / care and techniques 320) with a 20dp gutter.
   Each track owns its coordinates so content cannot drift into a neighboring panel. */
#scrim.compact-partner #page-status { left: 0; top: 48dp; width: 900dp; height: 570dp; }
#scrim.compact-partner #page-tech { left: 0; top: 48dp; width: 900dp; height: 570dp; }
