#scrim.tech-editing #tech-message { left: 12dp; top: 300dp; width: 225dp; font-size: 18dp; }

/* Technique Select Help, the page the extra action opens from the change view (the techniques view, MENU_STATE 8,
   US branch): the heading at (-142, -82); bullets (SYSTEM_W 180, 12, palette 4) at (-129, -65) and (-129, -34)
   before the two help lines; the separator at y -4; the legend cells at (-120, 2 + 16 n) with their labels at
   (-102, 3 + 16 n) and the grid cursor at (-123, 80). Current and the red cell after "deselects tech" are glyph 2 in
   palette 0 at 50 % over red (200, 0, 40); the first Unusable is glyph 3 darkened by a subtractive box. */
#tech-help-page { display: none; position: absolute; left: 0; top: 0; width: 894dp; height: 552dp; }
#scrim.tech-help #page-tech > * { display: none; }
#scrim.tech-help #page-tech > #tech-help-page { display: block; }
#tech-help-title { top: 18dp; }
.tech-help-hint { position: absolute; left: 60dp; height: 36dp; font-size: 36dp; white-space: nowrap; color: #d6d6d6; }
#tech-help-select { top: 69dp; }
#tech-help-cancel { top: 162dp; }
.tech-help-hint span { display: inline-block; vertical-align: top; height: 36dp; }
.tech-help-bullet { width: 36dp; margin-right: 9dp; decorator: image(tech-help-bullet scale-none left top); }
.tech-help-cell { position: relative; width: 36dp; height: 36dp; border: 3dp #000000; }
.tech-help-hint .tech-help-cell { margin-top: -3dp; }
#tech-help-select .tech-help-cell { margin: -3dp 12dp 0 6dp; }
#tech-help-cancel .tech-help-cell { margin-left: 24dp; }
#tech-help-cancel-key { margin: 0 21dp; }
.tech-help-glyph { position: absolute; display: block; left: 0; top: 0; width: 36dp; height: 36dp; }
.legend-cell-0 { background-color: #c80028; }
.legend-cell-0 .tech-help-glyph { decorator: image(tech-help-current); opacity: 0.5; }
.legend-cell-1 .tech-help-glyph { decorator: image(tech-glyph-0-0); }
.legend-cell-2 { background-color: #4e606e; }
.legend-cell-3 { background-color: #000000; }
.legend-cell-3 .tech-help-glyph { decorator: image(tech-glyph-3-0); opacity: 0.45; }
.legend-cell-4 { background-color: #000000; }
.legend-cell-5 .tech-help-glyph { decorator: image(tech-glyph-6-0); }
#tech-help-separator { top: 252dp; }
.tech-help-legend { position: absolute; left: 0; width: 894dp; height: 48dp; font-size: 36dp; color: #d6d6d6; }
.tech-help-legend .tech-help-cell { position: absolute; display: block; left: 84dp; top: 0; }
.tech-help-legend-label { position: absolute; display: block; left: 141dp; top: 6dp; white-space: nowrap; }
#tech-help-legend-0 { top: 267dp; }
#tech-help-legend-1 { top: 315dp; }
#tech-help-legend-2 { top: 363dp; }
#tech-help-legend-3 { top: 411dp; }
#tech-help-legend-4 { top: 459dp; }
#tech-help-legend-5 { top: 507dp; }
#tech-help-cursor { position: absolute; display: block; left: 78dp; top: 504dp; width: 54dp; height: 48dp;
    decorator: image(tech-grid-cursor scale-none left top); }

/* PestaÃ±as trapezoidales de renderMenuTab; la imagen se aporta con el disco del usuario. */
.tab-edge { position: absolute; display: block; top: 0; height: 100%; pointer-events: none; }
/* The partner's portrait is a picture only: its image reaches past its clip, over the tabs, and RmlUi does not clip
   where the pointer hits, so a click there would land on it and not on the tab. */
#partner-portrait-clip, #partner-portrait { pointer-events: none; }
.tab-left { left: 0; width: 21dp; decorator: image(partner-tab-left-idle); }
.tab-middle { left: 21dp; right: 21dp; decorator: image(partner-tab-middle-idle); }
.tab-right { right: 0; width: 21dp; decorator: image(partner-tab-right-idle); }
/* renderMenuTab: an idle tab is the same texture shaded to 0x32/0x80 (renderRectPolyFT4 flag 1). */
.tab .tab-edge { image-color: #646464; }
.tab.selected .tab-edge { image-color: #ffffff; }
.tab.selected .tab-left { decorator: image(partner-tab-left-active); }
.tab.selected .tab-middle { decorator: image(partner-tab-middle-active); }
.tab.selected .tab-right { decorator: image(partner-tab-right-active); }
.tab-label { position: relative; left: 21dp; top: 6dp; }
#page-tech { height: 570dp; box-sizing: border-box; }

/* The focused technique's panel (game_menu.c, the selected technique's view): on the right for the grid's first three
   columns (MOVE_SELECT_BOX_X up to 0xA8, panel 1), on the left for the others (panel 0). */
#tech-info.hidden { display: none; }
#tech-info { position: absolute; left: 0; top: 0; width: 894dp; height: 570dp; pointer-events: none; }
#tech-info-name, #tech-info-stats { position: absolute; background-color: #323280; border: 3dp transparent; box-sizing: border-box; decorator: original-box(3dp) border-box; }
#tech-info-name { left: 21dp; top: 276dp; width: 384dp; height: 57dp; padding: 9dp 12dp; font-size: 33dp; }
#tech-info-stats { left: 21dp; top: 339dp; width: 261dp; height: 207dp; }
#tech-info.info-right #tech-info-name { left: 492dp; }
#tech-info.info-right #tech-info-stats { left: 630dp; }
.info-label, .info-value { position: absolute; display: block; }
.info-label { left: 9dp; width: 72dp; height: 21dp; font-size: 0; color: transparent; }
.info-value { left: 129dp; width: 123dp; font-size: 21dp; }
.info-power { top: 9dp; }
.info-mp { top: 60dp; }
.info-range { top: 111dp; }
.info-effect { top: 162dp; }
.info-label.info-power { decorator: image(tech-power-label); }
.info-label.info-mp { width: 33dp; decorator: image(tech-mp-label); }
.info-label.info-range { width: 57dp; decorator: image(tech-range-label); }
.info-label.info-effect { width: 48dp; decorator: image(tech-effect-label); }

#tech-info { display: block; }

/* Detalles de la vista de la técnica elegida: encabezado, separadores y cinco esquinas. */
#tech-info-heading { position: absolute; left: 30dp; top: 261dp; width: 111dp; height: 21dp; decorator: image(tech-info-heading); }
#tech-info.info-right #tech-info-heading { left: 501dp; }
.info-colon { position: absolute; left: 90dp; width: 30dp; height: 30dp; decorator: image(tech-info-colon); }
.info-colon.info-power { top: 9dp; }
.info-colon.info-mp { top: 60dp; }
.info-colon.info-range { top: 111dp; }
.info-colon.info-effect { top: 162dp; }
.info-value.info-power, .info-value.info-mp { font-size: 33dp; white-space: nowrap; }
.info-corner { position: absolute; width: 12dp; height: 12dp; }
#tech-info-tl { left: 15dp; top: 270dp; decorator: image(tech-info-tl); }
#tech-info-tr { left: 402dp; top: 270dp; decorator: image(tech-info-tr); }
#tech-info-bl { left: 15dp; top: 543dp; decorator: image(tech-info-bl); }
#tech-info-br { left: 264dp; top: 543dp; decorator: image(tech-info-br); }
#tech-info-notch { left: 402dp; top: 330dp; decorator: image(tech-info-br); }
