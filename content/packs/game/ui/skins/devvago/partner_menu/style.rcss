/* Finish the partner screen as a room terminal: a clear active tab, calm status insets, and a brighter readable bag
   selection. Keep the original's fixed field layout and icon sprites intact. */
#tabs {
	height: 48dp;
	margin-bottom: 9dp;
	padding-bottom: 0;
	border-bottom: 2dp #397ca4;
}

.tab {
	position: relative;
	margin-right: 6dp;
	padding: 0 15dp;
	border-bottom-width: 3dp;
	background-color: #0a2035;
	color: #a8c7d9;
}

.tab.selected, .tab.selected:focus {
	border-bottom-color: #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}

.tab:focus {
	border-color: #72c7ff;
	border-bottom-color: #ffd51e;
}

.tab .tab-edge {
	image-color: #397ca4;
}

.tab.selected .tab-edge {
	image-color: #ffd51e;
}

#close {
	padding: 0 12dp;
	color: #a8c7d9;
}

#close:focus {
	color: #ffe64a;
}

#status-head {
	color: #ffe64a;
}

#status-name, .line-value, #status-timers .timer-value, #status-active.active-hours {
	border-color: #345875;
	border-right-color: #72c7ff;
	border-bottom-color: #72c7ff;
}

.bar {
	border-color: #071522;
	border-right-color: #345875;
	border-bottom-color: #345875;
	background-color: #071522;
}

.stat .fill, #status-parameters .fill {
	background-color: #34c9ed;
}

#meter-2-fill {
	background-color: #ffd51e;
}

.slot:hover {
	background-color: #153653;
}

.slot:focus, .slot.picked {
	border: 2dp #ffd51e;
	background-color: #153653;
}

.slot.moving {
	border: 2dp #72c7ff;
	background-color: #12304a;
}

#bag-description {
	color: #d8f1ff;
}

.box button:hover, #scrim.item-screen #options button:hover,
#scrim.item-screen #sort-box button:hover,
#scrim.item-screen #confirm-box button:hover {
	background-color: #153653;
	color: #d8f1ff;
}

.box button:focus, #scrim.item-screen #options button:focus,
#scrim.item-screen #options button.active-option,
#scrim.item-screen #sort-box button:focus,
#scrim.item-screen #confirm-box button:focus {
	border-color: #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}

