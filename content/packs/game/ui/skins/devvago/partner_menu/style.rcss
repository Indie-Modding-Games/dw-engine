/* Align the final-tech label, card, and action to the same outer width. The earlier rules add padding and borders outside their declared width. */
#scrim.compact-partner #final-heading { box-sizing: border-box; }
#scrim.compact-partner #tech-row-3 { top: 462dp; height: 50dp; box-sizing: border-box; border-radius: 3dp; }
#scrim.compact-partner #tech-row-3 .tech-name { left: 9dp; top: 6dp; width: 300dp; height: 36dp; line-height: 36dp; }
#scrim.compact-partner #tech-change { top: 520dp; box-sizing: border-box; }
/* Keep the selectable attack grid above the detail layer and clip both to the editor frame. */
#scrim.compact-partner.tech-editing #page-tech { overflow: hidden; }
#scrim.compact-partner.tech-editing #tech-picker { z-index: 3; }
#scrim.compact-partner.tech-editing #tech-info { z-index: 2; }
/* Compact technique editor: keep the original selectable grid at left and place the selected name inside its data card. */
#scrim.compact-partner.tech-editing #panel { top: 32dp; width: 900dp; height: 560dp; margin-left: -450dp; }
#scrim.compact-partner.tech-editing #page-tech {
	left: 0; top: 48dp; width: 900dp; height: 480dp; box-sizing: border-box; overflow: hidden;
	border: 1dp #72c7ff; background-color: #0b1c2df5; decorator: vertical-gradient(#153653 #0a1929);
}
#scrim.compact-partner.tech-editing #tech-picker {
	left: 108dp; top: 96dp; width: 306dp; height: 254dp; box-sizing: border-box;
	border: 1dp #345875; background-color: #071522; z-index: 3;
}
#scrim.compact-partner.tech-editing .tech-choice {
	position: absolute; display: block; width: 36dp; height: 36dp; min-width: 0;
	margin: 0; padding: 0; overflow: visible; border: 1dp transparent; background-color: transparent;
	font-size: 0; color: transparent; decorator: none;
}
#scrim.compact-partner.tech-editing .tech-choice:focus { border: 2dp #ffd51e; background-color: #1d4968; decorator: none; }
#scrim.compact-partner.tech-editing .tech-cell,
#scrim.compact-partner.tech-editing .tech-cell-shade { left: 0; top: 0; width: 36dp; height: 36dp; }
