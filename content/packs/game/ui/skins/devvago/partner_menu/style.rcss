#tech-info.info-right #tech-info-tr { left: 873dp; }
#tech-info.info-right #tech-info-bl { left: 624dp; }
#tech-info.info-right #tech-info-br { left: 873dp; }
#tech-info.info-right #tech-info-notch { left: 486dp; decorator: image(tech-info-bl); }

.info-value.info-range, .info-value.info-effect { font-size: 33dp; }

/* Profile: insets nativos de STATS_VIEW_INSETS y rÃ³tulos de STATS_VIEW_ELEMENTS.
   Los offsets descuentan el borde de 1px de la pÃ¡gina. */
#status-head { left: 117dp; top: 60dp; }
#status-name { width: 294dp; height: 42dp; box-sizing: border-box; padding: 0; line-height: 36dp; }
/* A name past the 12 letters the box holds (Machinedramon) gets a wider one, short of the profile headings. */
#status-name.long { width: 324dp; }
#status-species-line { left: 0; top: 108dp; width: 894dp; }
#status-age-line, #status-weight-line { left: 0; top: 156dp; width: 894dp; }
#status-species, #status-age, #status-weight {
    position: absolute; top: 0; height: 42dp; box-sizing: border-box; margin: 0; padding: 0; line-height: 36dp;
}
#status-species { left: 117dp; width: 732dp; }
/* Age and weight are right-aligned two-digit fields (game_menu.c: the partner stats view, renderNumber with n = 2):
   a one-digit age stands in the field's second cell (screen x 59 in the capture), not at its left edge. */
#status-age { left: 117dp; width: 78dp; text-align: right; padding-right: 24dp; }
#status-weight { left: 333dp; width: 78dp; text-align: right; padding-right: 18dp; }
#status-name-label, #status-species-label, #status-age-label, #status-weight-label {
    position: absolute; display: block; height: 30dp; color: transparent; font-size: 0;
}
#status-name-label { left: 33dp; top: 66dp; width: 78dp; decorator: image(status-name-label); }
#status-species-label { left: 33dp; top: 6dp; width: 78dp; decorator: image(status-species-label); }
#status-age-label { left: 48dp; top: 6dp; width: 57dp; decorator: image(status-age-label); }
#status-weight-label { left: 246dp; top: 6dp; width: 84dp; decorator: image(status-weight-label); }
#no-condition { display: none; }

#status-species-line #status-species { width: 732dp; }

/* Datos de especie y actividad dentro de Profile; condiciones en su fila nativa inferior. */
.profile-meta { position: absolute; display: block; }
#status-special-heading, #status-type-heading, #status-active-heading { top: 78dp; width: 75dp; height: 24dp; }
#status-special-heading { left: 474dp; decorator: image(status-special-heading); }
#status-type-heading { left: 603dp; decorator: image(status-type-heading); }
#status-active-heading { left: 702dp; decorator: image(status-active-heading); }
#status-specials { left: 474dp; top: 111dp; width: 108dp; height: 36dp; }
.status-special { display: inline-block; width: 36dp; height: 36dp; }
.status-special.hidden, #status-type.hidden { display: none; }
#status-type { left: 624dp; top: 111dp; width: 36dp; height: 36dp; }
#status-active { left: 702dp; top: 111dp; width: 144dp; height: 36dp; font-size: 33dp; }
#conditions { left: 33dp; top: 294dp; width: 315dp; height: 36dp; }
#conditions .condition { position: absolute; display: block; width: 36dp; height: 36dp; margin: 0; font-size: 0; color: transparent; }
#conditions .condition.hidden { display: none; }
.profile-special-0 { decorator: image(tech-glyph-0-0); }
#scrim.status-alternate .profile-special-0 { decorator: image(tech-glyph-0-1); }
.profile-special-1 { decorator: image(tech-glyph-1-0); }
#scrim.status-alternate .profile-special-1 { decorator: image(tech-glyph-1-1); }
.profile-special-2 { decorator: image(tech-glyph-2-0); }
#scrim.status-alternate .profile-special-2 { decorator: image(tech-glyph-2-1); }
.profile-special-3 { decorator: image(tech-glyph-3-0); }
#scrim.status-alternate .profile-special-3 { decorator: image(tech-glyph-3-1); }
.profile-special-4 { decorator: image(tech-glyph-4-0); }
#scrim.status-alternate .profile-special-4 { decorator: image(tech-glyph-4-1); }
.profile-special-5 { decorator: image(tech-glyph-5-0); }
#scrim.status-alternate .profile-special-5 { decorator: image(tech-glyph-5-1); }
.profile-special-6 { decorator: image(tech-glyph-6-0); }
#scrim.status-alternate .profile-special-6 { decorator: image(tech-glyph-6-1); }
.profile-type-1 { decorator: image(status-type-1); }
.profile-type-2 { decorator: image(status-type-2); }
.profile-type-3 { decorator: image(status-type-3); }
#conditions .profile-condition-sick { left: 0dp; decorator: image(status-condition-sick); }
#conditions .profile-condition-injured { left: 45dp; decorator: image(status-condition-injured); }
#conditions .profile-condition-hungry { left: 90dp; decorator: image(status-condition-hungry); }
#conditions .profile-condition-sleepy { left: 135dp; decorator: image(status-condition-sleepy); }
#conditions .profile-condition-sulking { left: 180dp; decorator: image(status-condition-sulking); }
#conditions .profile-condition-tired { left: 225dp; decorator: image(status-condition-tired); }
#conditions .profile-condition-needs_toilet { left: 270dp; decorator: image(status-condition-toilet); }

.profile-meta { z-index: 1; }

/* Condition: vidas y medidores, con sus posiciones y dimensiones nativas. */
#status-lives { display: none; }
.status-native-life { display: block; position: absolute; }
#status-life-label { left: 33dp; top: 366dp; width: 144dp; font-size: 33dp; color: #fff371; }
#status-life-hearts { left: 195dp; top: 366dp; width: 126dp; height: 33dp; }
.life-heart { position: absolute; display: block; top: 0; width: 36dp; height: 33dp; }
#life-heart-0 { left: 0; } #life-heart-1 { left: 42dp; } #life-heart-2 { left: 84dp; }
.life-fill, .life-outline { position: absolute; display: block; width: 36dp; height: 33dp; }
.life-fill { decorator: image(status-life-full); }
.life-outline { decorator: image(status-life-outline); }
.life-fill.hidden { display: none; }
#status-condition { left: 33dp; top: 417dp; width: 330dp; }
#status-condition .bar-row { display: block; position: relative; height: 45dp; }
#status-condition .label { position: absolute; left: 0; top: -6dp; width: 159dp; height: 36dp; padding: 0 0 0 36dp; box-sizing: border-box; font-size: 33dp; }
#meter-0-label { color: transparent; decorator: image(status-happy scale-none left top); }
#meter-0-label.negative { decorator: image(status-sad scale-none left top); }
#meter-1-label { decorator: image(discipline-high scale-none left top); }
#meter-1-label.low { decorator: image(discipline-low scale-none left top); }
#meter-2-label { decorator: image(status-virus scale-none left top); }
.status-native-happiness { display: block; position: absolute; left: 36dp; top: -6dp; width: 108dp; height: 36dp; decorator: image(status-happiness-name); }
/* Art fixes: the word's own rectangle, 41 x 8, two rows lower; it starts where the original's rectangle does (without
   its stray mark) and ends where the meter begins. */
.status-native-happiness.fixed { left: 36dp; top: 0; width: 123dp; height: 24dp; decorator: image(status-happiness-name-fixed); }
/* renderInsetBox includes its right/bottom outline; the fills draw over the right outline at full width. */
#status-condition .meter { position: absolute; left: 159dp; top: 0; width: 153dp; height: 27dp; box-sizing: border-box; margin: 0; overflow: visible; border: 3dp #020202; border-right-color: #6987a0; border-bottom-color: #6987a0; background-color: #354b5c; decorator: none; }
#status-condition .meter .fill { position: absolute; left: 0; top: 3dp; height: 18dp; decorator: image(status-meter-pink scale-none left top); }
#status-condition .meter .fill.high { decorator: image(status-meter-blue scale-none left top); }
#status-condition #meter-2-fill { top: 0; decorator: none; background-color: #c8c83c; }

/* The portrait uses the original full-screen projection, clipped to Condition. */
#partner-portrait-clip { position: absolute; left: 0; top: 216dp; width: 366dp; height: 330dp; overflow: hidden; }
#partner-portrait { position: absolute; left: -33dp; top: -285dp; width: 960dp; height: 720dp; }

/* ------------------------------------------------------------------------------------------------------------------
   Improvements over the original's stats view (docs/modulos/apps/screens.md, "Ficha del compaÃ±ero").

   The model has its own area, right of the Condition heading and above the Life row, drawn at half the original's
   size so that no heart, bar or need icon covers it (the original draws them over it). The need icons go under the
   heading in two rows, and the Life row and the bars move down a little to make room. */
#partner-portrait-clip { left: 192dp; top: 219dp; width: 168dp; height: 159dp; border-radius: 0; background-color: transparent; }
#partner-portrait { left: -62dp; top: -150dp; width: 480dp; height: 360dp; }
#conditions { left: 33dp; width: 156dp; height: 78dp; }
#conditions .profile-condition-sick { left: 0; top: 0; }
#conditions .profile-condition-injured { left: 39dp; top: 0; }
#conditions .profile-condition-hungry { left: 78dp; top: 0; }
#conditions .profile-condition-sleepy { left: 117dp; top: 0; }
#conditions .profile-condition-sulking { left: 0; top: 42dp; }
#conditions .profile-condition-tired { left: 39dp; top: 42dp; }
#conditions .profile-condition-needs_toilet { left: 78dp; top: 42dp; }
#status-life-label, #status-life-hearts { top: 381dp; }
#status-condition { top: 423dp; }
#status-condition .bar-row { height: 42dp; }

/* The numbers are right-aligned in the original's four-digit fields (utils.c: renderNumber, 8 pixels a digit):
   HP and MP now ending at x 75 and at most at x 135, the other stats at x 71. Measured against the status capture
   (2026-11-03): the last digit of HP and MP ends at screen x 224 and 284, the other stats' at 224; the cells sit 9 and
   5 pixels further left than they did. */
#status-parameters .value, #status-parameters .pool-max { text-align: right; }
#status-parameters .value { left: 102dp; width: 150dp; }
#status-parameters .pool .value { left: 102dp; width: 150dp; }
#status-parameters .pool-max { left: 282dp; width: 150dp; }
/* A slash between HP's (and MP's) value now and its maximum, so the two numbers read as one: the Japanese and European
   versions draw one there (game_menu.c, the stats view: a 12-pixel glyph at x 83, ahead of the maximum's field), the
   American one leaves a gap. It sits in the middle of the gap between a four-digit value and a four-digit maximum, so
   9999 / 9999 keep apart. */
#status-parameters .pool-slash {
    display: block; position: absolute; left: 276dp; top: -9dp; width: 36dp; text-align: center; white-space: nowrap;
}

/* The original's labels are English pictures; in other languages the page writes them with the font: headings in
   the yellow of the Tech page's, field labels in the pictures' cyan, the small column headings in capitals with the
   pictures' colours, the condition names in full and the stats with the glossary's abbreviations. */
#status-special-heading, #status-type-heading, #status-active-heading, #tech-info-heading, .tech-category {
    font-size: 0; color: transparent;
}
/* Headings in the yellow of the Tech page's. */
#scrim.status-text #profile-heading, #scrim.status-text #condition-heading, #scrim.status-text #parameter-heading {
    decorator: none; width: 330dp; height: 36dp; font-size: 33dp; line-height: 36dp; color: #fff371; white-space: nowrap;
}
#scrim.status-text #profile-heading, #scrim.status-text #condition-heading { left: 24dp; }
#scrim.status-text #condition-heading { width: 201dp; }
/* The model's area starts after the longer heading. */
#scrim.status-text #partner-portrait-clip { left: 228dp; width: 132dp; }
#scrim.status-text #partner-portrait { left: -80dp; }
#scrim.status-text #parameter-heading { left: 390dp; }
/* The field labels in the pictures' cyan, right-aligned before their insets, which move right to make room. */
#scrim.status-text #status-name-label, #scrim.status-text #status-species-label,
#scrim.status-text #status-age-label, #scrim.status-text #status-weight-label {
    decorator: none; height: 36dp; font-size: 22dp; line-height: 36dp; color: #52def7; text-align: right; white-space: nowrap;
}
#scrim.status-text #status-name-label { left: 6dp; top: 63dp; width: 132dp; }
#scrim.status-text #status-species-label, #scrim.status-text #status-age-label { left: 6dp; top: 3dp; width: 132dp; }
#scrim.status-text #status-weight-label { left: 246dp; top: 3dp; width: 108dp; }
#scrim.status-text #status-head { left: 141dp; }
#scrim.status-text #status-species, #scrim.status-text #status-species-line #status-species { left: 141dp; width: 708dp; }
#scrim.status-text #status-age { left: 141dp; }
#scrim.status-text #status-weight { left: 360dp; }
/* The marks' headings in the pictures' colours, centred over their marks. */
#scrim.status-text #status-special-heading, #scrim.status-text #status-type-heading,
#scrim.status-text #status-active-heading {
    decorator: none; top: 75dp; height: 27dp; font-size: 18dp; line-height: 27dp; text-align: center; white-space: nowrap;
}
#scrim.status-text #status-special-heading { left: 444dp; width: 168dp; color: #18ff10; }
/* A long name keeps a gap before the written Special heading: a snug box and the heading a step right. */
#scrim.status-text #status-name.long { width: 316dp; }
#scrim.status-text.long-name #status-special-heading { left: 452dp; }
#scrim.status-text #status-type-heading { left: 600dp; width: 84dp; color: #ffde00; }
#scrim.status-text #status-active-heading { left: 690dp; width: 168dp; color: #ff39e7; }
/* The condition's names in full: the bars move to the right edge to make room, and Life is one of them. */
#scrim.status-text .status-native-happiness { display: none; }
#scrim.status-text #status-condition .label, #scrim.status-text #status-life-label {
    width: 171dp; color: #fff371; font-size: 22dp; line-height: 36dp; white-space: nowrap;
}
#scrim.status-text #status-condition .meter { left: 174dp; width: 150dp; }
#scrim.status-text #status-life-hearts { left: 207dp; }
/* The stats with the glossary's abbreviations, at the size of HP and MP. */
#scrim.status-text #status-parameters #stat-2-label, #scrim.status-text #status-parameters #stat-3-label {
    width: 153dp; color: #fff371;
}
#scrim.status-text #status-parameters #stat-2-label { decorator: image(stat-speed scale-none left center); }
#scrim.status-text #status-parameters #stat-3-label { decorator: image(stat-brains scale-none left center); }
/* The Tech page's column headings and the details' labels, grey like the pictures. */
#scrim.status-text .tech-columns .tech-power, #scrim.status-text .tech-columns .tech-mp,
#scrim.status-text .tech-columns .tech-range, #scrim.status-text .tech-columns .tech-effect,
#scrim.status-text .info-label, #scrim.status-text #tech-info-heading {
    decorator: none; height: 24dp; font-size: 18dp; line-height: 24dp; color: #d6d6d6; white-space: nowrap;
}
#scrim.status-text .tech-columns .tech-power { left: 486dp; width: 102dp; text-align: right; }
#scrim.status-text .tech-columns .tech-mp { left: 636dp; width: 60dp; }
#scrim.status-text .tech-columns .tech-range { left: 708dp; width: 78dp; }
#scrim.status-text .tech-columns .tech-effect { left: 789dp; width: 99dp; }
#scrim.status-text #tech-info-heading { top: 258dp; width: 111dp; height: 18dp; line-height: 18dp; text-align: center; background-color: #2d3840; }
#scrim.status-text .info-label { width: 120dp; }
#scrim.status-text .info-colon { left: 135dp; }
#scrim.status-text .info-value { left: 165dp; width: 93dp; }
/* The grid's rows by name, on each side of the grid. */
#scrim.status-text .tech-category { decorator: none; height: 36dp; font-size: 22dp; line-height: 36dp; color: #d6d6d6; white-space: nowrap; }
#scrim.status-text .tech-category.category-left { left: -108dp; width: 102dp; text-align: right; }
#scrim.status-text .tech-category.category-right { width: 120dp; }
.tech-columns { text-transform: none; }

/* The page's extras, which the original keeps hidden (the status_extras option, on by default;
   docs/modulos/apps/screens.md). The care mistakes go at the end of the age and weight row, a number in an inset like
   theirs after a label in the cyan of the field labels; the tiredness is a fourth condition bar with the tired need's
   icon and the blue strip, with no number like the others. Life and the bars move up and closer (rows 36dp apart,
   the model's area 6dp shorter) so the four bars fit the page. The modern skin's places for the profile are undone. */
#page-status .status-extra { display: none; }
#scrim.status-extras #page-status .status-extra { display: block; }
#scrim.status-extras #page-status { height: 570dp; }
#scrim.status-extras #status-species-line { top: 108dp; }
#scrim.status-extras #status-age-line, #scrim.status-extras #status-weight-line { top: 156dp; }
#scrim.status-extras #conditions { top: 294dp; }
#scrim.status-extras #status-mistakes { left: 0; top: 156dp; width: 894dp; height: 42dp; font-size: 33dp; }
#scrim.status-extras #status-battles {
    display: block; position: absolute; left: 0; top: 156dp; width: 894dp; height: 42dp; font-size: 33dp;
}
/* Two labels share the row's end, a step smaller than the other field labels, each 6dp before its inset, whose number
   is centred. The bitmap font draws them about 16dp a letter. With the labels written the weight's label and inset
   move 30dp left so that Â«CombatesÂ» starts 9dp after the weight's inset. */
#status-mistakes-label, #status-battles-label {
    position: absolute; top: 0; height: 42dp; font-size: 20dp; line-height: 42dp;
    color: #52def7; text-align: right; white-space: nowrap;
}
#status-battles-label { left: 414dp; width: 118dp; }
#status-mistakes-label { left: 619dp; width: 146dp; }
#scrim.status-text.status-extras #status-weight-label { left: 216dp; }
#scrim.status-text.status-extras #status-weight { left: 330dp; }
#scrim.status-text #status-battles-label { left: 417dp; width: 133dp; }
#scrim.status-text #status-battles-value { left: 556dp; }
#scrim.status-text #status-mistakes-label { left: 640dp; width: 125dp; }
#status-mistakes-value, #status-battles-value {
    position: absolute; float: none; top: 0; height: 42dp; box-sizing: border-box; margin: 0;
    padding: 0; line-height: 36dp; text-align: center; border: 3dp #020202; border-right-color: #6987a0;
    border-bottom-color: #6987a0; background-color: #354b5c;
}
#status-battles-value { left: 538dp; width: 75dp; }
#status-mistakes-value { left: 771dp; width: 78dp; }
#scrim.status-extras #partner-portrait-clip { height: 153dp; }
#scrim.status-extras #status-life-label, #scrim.status-extras #status-life-hearts { top: 375dp; }
#scrim.status-extras #status-condition { top: 414dp; }
#scrim.status-extras #status-condition .bar-row { height: 36dp; }
#tiredness-label { decorator: image(status-condition-tired scale-none left top); }
#status-condition #tiredness-fill { background-color: transparent; decorator: image(status-meter-blue scale-none left top); }

/* More extras (docs/modulos/apps/screens.md, Â«Extras de la fichaÂ»). The battles sit between the weight and the
   mistakes, in an inset like theirs. The Active field writes the hours it is awake today, hour to hour, in place of
   the pattern's word; the modern skin's line for them is not drawn. The care bars are narrower, with their numbers
   after them in white. The hours of life left and the evolution counter (with the hours its level checks from) go in
   the room right of the Off, Def, Speed and Brains bars, each a label in the field labels' cyan over an inset. */
#scrim.status-extras #page-status #status-awake.status-extra { display: none; }
#scrim.status-extras #status-condition .meter { width: 84dp; }
/* Room for the widest number with its percent sign, happiness at "-100%". */
#scrim.status-extras #status-condition .value {
    display: block; position: absolute; left: 246dp; top: 0; width: 84dp; height: 27dp; font-size: 22dp;
    line-height: 27dp; text-align: right; color: #ffffff; white-space: nowrap;
}
#scrim.status-text.status-extras #status-condition .meter { width: 69dp; }
#scrim.status-extras #status-timers { position: absolute; left: 729dp; top: 366dp; width: 153dp; height: 180dp; }
#status-timers .timer-line { display: block; position: absolute; left: 0; width: 153dp; height: 84dp; }
#status-lifetime { top: 0; }
#status-evolution { top: 90dp; }
#status-timers .timer-label {
    display: block; position: absolute; left: 0; top: 0; width: 153dp; height: 36dp; font-size: 22dp;
    line-height: 36dp; color: #52def7; text-align: center; white-space: nowrap;
}
#status-timers .timer-value {
    display: block; position: absolute; left: 0; top: 36dp; width: 153dp; height: 42dp; box-sizing: border-box;
    margin: 0; padding: 0; font-size: 27dp; line-height: 36dp; text-align: center; white-space: nowrap;
    border: 3dp #020202; border-right-color: #6987a0; border-bottom-color: #6987a0; background-color: #354b5c;
}
/* With the extras the Active field writes the waking hours ("08-20"), not the pattern's word: they get an inset of
   their own under the Active heading, centred, and the species' inset ends before it. */
#scrim.status-extras #status-species-line #status-species { width: 570dp; }
#scrim.status-text.status-extras #status-species-line #status-species { width: 546dp; }
#status-active.active-hours {
    left: 696dp; top: 108dp; width: 153dp; height: 42dp; box-sizing: border-box; margin: 0; padding: 0;
    line-height: 36dp; text-align: center; white-space: nowrap;
    border: 3dp #020202; border-right-color: #6987a0; border-bottom-color: #6987a0; background-color: #354b5c;
}

/* Digital field terminal: preserve the original status and inventory layout while carrying the room UI's
   navy surfaces, cyan frame, and yellow selection signal across every partner page. */
#tabs {
	border-bottom: 2dp #397ca4;
}

.tab {
	border-color: #72c7ff;
	background-color: #0b1c2d;
	color: #8eb8d4;
}

.tab.selected, .tab.selected:focus {
	color: #ffe64a;
	background-color: #153653;
}

.tab:focus {
	border-color: #ffd51e;
}

#page-status, #page-care {
	border-color: #72c7ff;
	background-color: #0b1c2d;
	decorator: vertical-gradient(#153653 #0a1929);
}

#status-name, .line-value, #status-timers .timer-value, #status-active.active-hours {
	border-color: #345875;
	background-color: #0a2035;
	color: #d8f1ff;
}

#bag-grid, #bag-description {
	border-color: #72c7ff;
	background-color: #0b1c2de8;
}

.slot:focus, .slot.picked {
	border: 2dp #ffd51e;
	background-color: #153653;
}

.slot.moving {
	border: 2dp #72c7ff;
}

.box, #confirm-box {
	border-color: #72c7ff;
	background-color: #0b1c2df2;
	decorator: vertical-gradient(#153653 #0a1929);
}

.box button:focus, #scrim.item-screen #options button:focus,
#scrim.item-screen #options button.active-option,
#scrim.item-screen #sort-box button:focus,
#scrim.item-screen #confirm-box button:focus {
	border-color: #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}



/* Compact partner dashboard: status and equipped attacks stay visible together. */
body.layout-pages-compact #scrim #panel {
	top: 30dp;
	width: 900dp;
	height: 660dp;
	margin-left: -450dp;
}

body.layout-pages-compact #scrim #tabs {
	position: relative;
	height: 42dp;
	margin: 0 0 6dp;
	padding: 0;
	border-bottom: 1dp #345875;
	display: flex;
	flex-direction: row;
	align-items: flex-end;
}

/* The bag opens as one tall window too: the same dark page box the compact partner dashboard
   draws under the folder tabs. Inside it the field is tidy like the stats dashboard: the money
   rides in a gold chip on the box's head, the items sit in a framed list of two slim columns
   (a longer bag scrolls inside the frame), and the picked item's description takes a framed
   band at the foot. The classic page floated all three over one dark field at 33-point size,
   each in its own frame — which left strips of map showing between them. */
body.layout-pages-compact #scrim #page-items {
	position: absolute;
	left: 0;
	top: 48dp;
	width: 900dp;
	height: 570dp;
	border-color: #72c7ff;
	background-color: #0b1c2df5;
	decorator: vertical-gradient(#153653 #0a1929);
}
body.layout-pages-compact #scrim #bag-foot { position: absolute; left: 0; right: 0; top: 6dp; margin: 0; font-size: 16dp; color: #9cbad0; }
body.layout-pages-compact #scrim #bag-result { float: left; margin: 6dp 0 0 16dp; color: #a8c7d9; }
body.layout-pages-compact #scrim #bag-money { float: right; box-sizing: border-box; height: 32dp; margin: 0 16dp 0 0; padding: 0 12dp; border: 2dp #345875; background-color: #0a2035; color: #ffe64a; font-size: 22dp; line-height: 28dp; }
body.layout-pages-compact #scrim #bag-grid { position: absolute; left: 12dp; right: 12dp; top: 44dp; height: 408dp; min-height: 0; box-sizing: border-box; border: 2dp #345875; background-color: #07182a; padding: 8dp 12dp; decorator: none; overflow-y: auto; }
body.layout-pages-compact #scrim .slot { box-sizing: border-box; width: 400dp; height: 44dp; margin: 0 8dp 4dp 0; padding: 0 8dp 0 54dp; font-size: 20dp; line-height: 40dp; }
body.layout-pages-compact #scrim .slot-icon { left: 6dp; top: 2dp; width: 40dp; height: 40dp; }
body.layout-pages-compact #scrim #bag-grid scrollbarvertical { width: 6dp; margin-left: 4dp; }
body.layout-pages-compact #scrim #bag-grid scrollbarvertical slidertrack { background-color: #0a2035; }
body.layout-pages-compact #scrim #bag-grid scrollbarvertical sliderbar { min-height: 24dp; background-color: #90d9fa; }
body.layout-pages-compact #scrim #bag-description { position: absolute; left: 12dp; right: 12dp; top: 456dp; min-height: 0; height: 100dp; box-sizing: border-box; margin: 0; padding: 10dp 14dp; border: 2dp #345875; background-color: #07182a; color: #b8cfe0; font-size: 16dp; line-height: 22dp; decorator: none; }

/* Each compact window shows only its own section as a folder tab, plus Volver. Techniques are
   merged into the partner page and care is a field-menu action, so neither ever appears as a tab. */
body.layout-pages-compact #scrim .tab {
	position: relative;
	display: none;
	width: auto;
	min-width: 96dp;
	height: 34dp;
	margin: 0 4dp 0 0;
	padding: 0 14dp;
	border: 2dp #4a6b82;
	border-bottom: 0;
	border-radius: 6dp 6dp 0 0;
	background-color: #16293a;
	color: #9cbad0;
	font-size: 16dp;
	line-height: 30dp;
}
body.layout-pages-compact #scrim .tab .tab-edge { display: none; }
body.layout-pages-compact #scrim .tab.selected { display: inline-block; background-color: #24405a; border-color: #72c7ff; color: #eaf6ff; }
body.layout-pages-compact #scrim .tab:focus { border-color: #ffd51e; color: #ffe64a; }
body.layout-pages-compact #scrim #close { display: inline-block; margin-left: auto; margin-right: 0; }

body.layout-pages-compact #scrim .page.hidden { display: none; }

#scrim.compact-partner #page-status,
#scrim.compact-partner #page-tech {
	position: absolute;
	top: 48dp;
	height: 570dp;
	margin: 0;
	padding: 0;
	box-sizing: border-box;
	border: 2dp #72c7ff;
	background-color: #0b1c2df2;
	decorator: vertical-gradient(#153653 #0a1929);
	overflow: hidden;
}

