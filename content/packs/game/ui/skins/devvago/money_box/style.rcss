/* The money box in the original look: the original's box (theme.rcss .original-box) and ink. */

body #bits-box {
	border: 2dp #72c7ff;
	background-color: #0b1c2de8;
	decorator: vertical-gradient(#153653 #0a1929);
}

#bits-box { font-family: original-look; color: #d0d0d0; }

body #bits-box { color: #d5eaf7; }
