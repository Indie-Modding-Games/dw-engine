/* The names box in the new look (concept area A, naming_box: 016-020): the letters in the window with its brackets,
   «Nombre» in gold without a line, the gold four-corner cursor on the focused letter or button, the prompts bare
   under the window and the name in a window of its own with a gold underscore on the next letter. */

#title {
	border-bottom-width: 0;
	color: #efc63c;
}

body .cell,
body .button {
	border: 3dp transparent;
}

body .cell.selected,
body .button.selected {
	border-color: transparent;
	decorator: ninepatch(nb-ocur-outer, nb-ocur-inner, 1) border-box;
}

#prompts {
	border-top-width: 0;
}

body #name-box {
	border: 3dp transparent;
	background-color: transparent;
	decorator: ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

body .letter.current {
	border-bottom: 4dp #efc63c;
}

body #typing {
	margin-top: 6dp;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 27dp;
	color: #93a6bc;
}
