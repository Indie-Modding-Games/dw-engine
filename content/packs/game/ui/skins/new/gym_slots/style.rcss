/* The gym's slot reels in the new look (concept area C, gym_slots: 258-261): the pause menu's panel (panel/style) as
   the box, each reel sunk in a light-blue frame with a dark fill, the rows above and below the middle dimmed, a gold
   line through the middle and the rate in gold under the reels. */

body .reel {
	margin: -3dp 0 0 -3dp;
	border: 3dp #7cb6e2;
	background-color: #0b1424;
}

body .shade.top,
body .shade.bottom {
	background-color: #040812c8;
	decorator: none;
}

/* The gold line through the middle row (y 96 of the reel). */
body .shade.top {
	height: 95dp;
	border-bottom: 2dp #efc63ccc;
}

body .shade.bottom {
	top: 108dp;
}

body .payout {
	display: block;
	line-height: 36dp;
	color: #efc63c;
}

body .payout.hidden {
	display: none;
}

/* The box growing open (258): one light-blue line. */
body #outline {
	border: 3dp #b6e4f7;
}
