/* The pause box in the new look (concept area A, pause_box: 067-068): the half-filled window with its brackets, the
   hint under it in a thin window of its own (area A .ohint), centred on the box. */

body #box {
	border: 3dp transparent;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-half-outer, nb-half-inner, 1) border-box;
}

#hint {
	left: 50%;
	right: auto;
	width: 216dp;
	margin-left: -110dp;
	padding: 4dp 12dp 4dp 4dp;
	box-sizing: border-box;
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 30dp;
	color: #f2f0e1;
}
