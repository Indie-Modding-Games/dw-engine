/* The save list over the title (concept area A, save_slots: 021-028): the list box with its brackets top left and
   the ▶ on the focused slot, the info box under it, light-blue arrows when the list scrolls. Positions from the
   concept's list.html (stage px + 160 = dp, kept from the middle of the window as the original skin does). */

#panel.slots-original {
	left: 50%;
	margin-left: -412dp;
	top: 52dp;
	min-width: 624dp;
	padding: 10dp 24dp 10dp 40dp;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

#panel.slots-original button {
	margin-left: -26dp;
	padding: 3dp 12dp;
	border-width: 0;
	border-left-width: 26dp;
	letter-spacing: 4dp;
}

#panel.slots-original button:focus {
	decorator: image(nb-cursor scale-none left center) border-box, ninepatch(nb-row-outer, nb-row-inner, 1) padding-box;
}

#more-up,
#more-down {
	left: 50%;
	margin-left: -444dp;
	width: 18dp;
	height: 16dp;
	transform: none;
}

#more-up {
	top: 70dp;
	decorator: image(nb-up-blue scale-none center center);
}

#more-down {
	top: 370dp;
	decorator: image(nb-down-blue scale-none center center);
}

#detail {
	left: 50%;
	margin-left: -412dp;
	top: 420dp;
	width: 680dp;
	min-height: 56dp;
	padding: 7dp 24dp 7dp 24dp;
	decorator: ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

#detail-line-2 {
	color: #efc63c;
}
