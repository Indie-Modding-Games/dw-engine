/* The story's textboxes in the new look (concept area A, story_textbox: 046-056): the window with its gold
   brackets (system macros talk), the text in the pixel font on 36dp rows, the original's colours mapped to the
   concept's (area A .otalk .hl / .hl2), a choice as a ▶ with the gold outline around the row, and the waiting
   prompt as a key cap in the bottom right corner instead of the original's animated icon. */

body #box,
body #box.top {
	padding: 12dp 30dp;
	border: 3dp transparent;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
	font-size: 30dp;
	line-height: 36dp;
	color: #f2f0e1;
}

/* A sized box keeps the original's 39dp rows: the script sizes it from them. */
body #box.sized {
	padding: 15dp 24dp;
	line-height: 39dp;
}

body .row {
	height: 36dp;
}

body #box.sized .row {
	height: 39dp;
}

/* The choice: the ▶ before the row and the gold outline as the bar (the script sets its width). */
body .row.selected .cursor {
	display: inline-block;
	position: absolute;
	left: -22dp;
	top: 7dp;
	width: 18dp;
	height: 22dp;
	margin-right: 0;
	background-color: transparent;
	decorator: image(nb-cursor scale-none left center);
}

body .row.barred .bar {
	display: block;
	position: absolute;
	left: -6dp;
	top: 0;
	height: 36dp;
	padding-right: 12dp;
	border-width: 0;
	background-color: transparent;
	decorator: ninepatch(nb-row-outer, nb-row-inner, 1);
	z-index: -1;
}

/* A choice without a bar: the outline around the whole row. */
body .row.selected {
	margin-left: -4dp;
	padding-left: 4dp;
	decorator: ninepatch(nb-row-outer, nb-row-inner, 1);
}

body .row.barred {
	decorator: none;
}

body .row.selected .run {
	background-color: transparent;
	border-top: 0;
}

.color-1, .color-1 .key { color: #f2f0e1; }
.color-3, .color-3 .key { color: #e2483d; }
.color-5, .color-5 .key { color: #5fd36a; }
.color-6, .color-6 .key { color: #7fd6ff; }
.color-7, .color-7 .key { color: #efc63c; }
.color-9, .color-9 .key { color: #93a6bc; }

/* The waiting prompt: the key cap of the device's confirm control, still. */
body .prompt-icon.glyph {
	display: block;
	position: absolute;
	left: auto;
	top: auto;
	right: 18dp;
	bottom: 14dp;
	width: auto;
	min-width: 16dp;
	height: 30dp;
	padding: 0 6dp 4dp 6dp;
	border-width: 0;
	background-color: transparent;
	decorator: ninepatch(nb-key-outer, nb-key-inner, 1);
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 30dp;
	color: #f2f0e1;
	text-align: center;
	animation: none;
	opacity: 1;
}

/* No control for confirm: no cap (the original's rule, which the one above outranks). */
body .prompt-icon.glyph.glyph-none {
	display: none;
}

body .prompt-icon .glyph-label {
	display: inline;
}

body .prompt-icon .glyph-frame {
	display: none;
}

body .prompt-icon.family-shapes .glyph-art,
body .prompt-icon.family-positions .glyph-art {
	display: inline-block;
}
