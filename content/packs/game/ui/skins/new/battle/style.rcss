/* battle in the new look (concept area D, fight.html and end.html). The original skin's layout stays: the strip at
   the top left, the partner's bars at the top right, the enemies' bars beside them, the end boxes in the middle.
   Only the look changes. The damage digits, the banner, the anger marks and the countdown badge keep the original's
   sprites (field_numbers loads this sheet too and keeps its digits). */

/* ------------------------------------------------------------------------------------------------------------------
   The strip (fight.html .strip, .cmd): one thin box round the icons, each icon on a navy tile with a blue rim, the
   hovered one inside a gold rim. The frame's pieces draw the box: top and bottom lines, the ends close it. */
.command-frame {
	box-sizing: border-box;
	opacity: 1;
	border-width: 3dp 0;
	border-color: #b6e4f7;
	background-color: #0a101ceb;
}

.command-frame.frame-left,
.command-frame.frame-odd,
.command-frame.frame-even,
.command-frame.frame-right-odd,
.command-frame.frame-right-even {
	decorator: none;
}

.command-frame.frame-left {
	border-left-width: 3dp;
}

.command-frame.frame-right-odd,
.command-frame.frame-right-even {
	border-right-width: 3dp;
}

/* The tile is 54dp square round the icon's centre (the original's box is 42 x 66 with the icon in its middle). */
.command,
.command:focus,
.command.current {
	width: 48dp;
	height: 48dp;
	margin: 6dp 0 0 -6dp;
	padding: 0;
	border: 3dp #7cb6e2;
	background-color: #1d3150;
	color: transparent;
	font-effect: none;
}

.command.unavailable {
	opacity: 0.4;
}

/* The order the partner follows now (.cmd.cur): a green foot on its tile. */
.command.current {
	border-bottom-color: #5fd36a;
}

/* The finisher answers on the PULSA box: no tile; hovered, the gold four-corner cursor (308). */
.command.no-icon,
.command.no-icon:focus {
	margin: 0;
	border-width: 0;
	background-color: transparent;
	decorator: none;
}

.command.no-icon:focus {
	decorator: ninepatch(nb-ocur-outer, nb-ocur-inner, 1) border-box;
}

#command-cursor {
	width: 48dp;
	height: 48dp;
	margin: 6dp 0 0 6dp;
	border: 3dp #efc63c;
	background-color: #efc63c30;
	decorator: none;
}

/* The hovered command's name (.cname): gold, with an ink drop; dimmed while it cannot be given (.cname.off); a
   technique's MP cost after it in the small font (.cname .mp). */
#command-name {
	font-size: 30dp;
	color: #efc63c;
	font-effect: shadow(3dp 3dp #050c1a);
}

#command-name.short {
	color: #a89a70;
}

#command-cost {
	display: inline;
	margin-left: 18dp;
	font-family: "Pixel Small";
	font-size: 26dp;
	color: #93a6bc;
}

#command-cost.hidden {
	display: none;
}

/* ------------------------------------------------------------------------------------------------------------------
   The partner's bars (.pbar): the HP / MP cap, the bar in its ink and blue rim with the tiled fill, the value in
   the small font. */
.partner .bar-row {
	decorator: none;
}

.partner .bar-label {
	left: -2dp;
	top: -2dp;
	width: 24dp;
	height: 24dp;
	border: 2dp #7cb6e2;
	background-color: #050c1a;
	font-family: "Pixel Small";
	font-size: 13dp;
	line-height: 24dp;
	text-align: center;
	white-space: nowrap;
	color: #f2f0e1;
}

#fighter-0-hp-label,
#fighter-0-mp-label {
	decorator: none;
}

.partner .bar {
	left: 30dp;
	top: 3dp;
	width: 196dp;
	height: 10dp;
	padding: 2dp;
	border: 2dp #557ea8;
	background-color: #050c1a;
	decorator: vertical-gradient(#0b1220 #0b1220) content-box;
}

/* The fills in segments (.bar > i): a strip of 10 dp segments (8 of the colour, 2 of its darker step, the top 2 lit)
   as long as the bar, of which a fill shows its width (skin.yaml, nb-bar-fills). */
.partner .fill,
.partner .mp .fill {
	height: 10dp;
	border-width: 0;
}

.partner .hp .fill {
	background-color: transparent;
	decorator: image(nb-strip-hp scale-none left top);
}

.partner .mp .fill {
	background-color: transparent;
	decorator: image(nb-strip-mp scale-none left top);
}

/* Under a fifth of its HP (.ic.warn, .n.warn, the red bar): the cap in red, the fill and the value red. */
.partner .bar-row.low .bar-label {
	border-color: #e2483d;
	background-color: #6a1410;
	color: #ffd0c8;
}

.partner .bar-row.low .hp .fill {
	decorator: image(nb-strip-rd scale-none left top);
}

.partner .bar-row.low .bar-value {
	color: #e2483d;
}

.partner .bar-value {
	display: block;
	position: absolute;
	right: 0;
	top: -2dp;
	width: 72dp;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 28dp;
	text-align: right;
	color: #f2f0e1;
	font-effect: shadow(2dp 2dp #050c1a);
}

.partner .bar-digits {
	display: none;
}

/* The finisher (.fin, .push): the word in light gold over an orange and an ink drop; once full, PULSA and its key
   in a gold-rimmed ink box. */
#finisher-word {
	top: 63dp;
	height: 36dp;
	font-size: 30dp;
	line-height: 36dp;
	color: #ffe58a;
	font-effect: shadow(3dp 3dp #a33a12);
}

#finisher-ready {
	box-sizing: border-box;
	min-width: 123dp;
	height: 33dp;
	padding: 0 6dp 0 10dp;
	border: 3dp #efc63c;
	background-color: #050c1a;
	text-align: left;
}

#finisher-push {
	min-width: 0;
	height: 27dp;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 27dp;
	color: #f2f0e1;
}

/* In English the original paints FINISH!! and PUSH instead of the words (.use-menu-art); the new look writes them. */
.use-menu-art #finisher-word {
	display: block;
}

.use-menu-art #finisher-0.filled, .use-menu-art #finisher-1.filled, .use-menu-art #finisher-2.filled,
.use-menu-art #finisher-3.filled, .use-menu-art #finisher-4.filled, .use-menu-art #finisher-5.filled,
.use-menu-art #finisher-6.filled, .use-menu-art #finisher-7.filled {
	decorator: none;
}

.use-menu-art #finisher-push {
	width: auto;
	color: #f2f0e1;
	decorator: none;
}

#prompt-finisher {
	float: right;
	min-width: 18dp;
	height: 21dp;
	margin: 1dp 0 0 8dp;
	padding: 0 4dp 3dp 4dp;
	line-height: 22dp;
}

/* ------------------------------------------------------------------------------------------------------------------
   The enemies' bars (.ehp): green rim and line, a plain green fill 3dp in, the HP over the bar's right end in the
   small font (.ehp-n: green with an ink drop) instead of the original's digit sprites. */
.hb-value {
	width: 66dp;
	height: 28dp;
	margin-top: -8dp;
}

.hb-value .dd {
	width: 14dp;
	height: 28dp;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 28dp;
	text-align: right;
	color: #5fd36a;
	font-effect: shadow(2dp 2dp #050c1a);
	decorator: none;
}

#hd-1-0, #hd-2-0, #hd-3-0 { left: 10dp; }
#hd-1-1, #hd-2-1, #hd-3-1 { left: 24dp; }
#hd-1-2, #hd-2-2, #hd-3-2 { left: 38dp; }
#hd-1-3, #hd-2-3, #hd-3-3 { left: 52dp; }
.hb-frame {
	border-color: #5fd36a;
}

.hb-line {
	background-color: #5fd36a;
}

.hb-fill {
	height: 15dp;
	margin: -3dp 0 0 -3dp;
	background-color: #5fd36a;
}

.hb-segment {
	display: none;
}

/* ------------------------------------------------------------------------------------------------------------------
   The finisher's charge (.chg): the half window with brackets in the middle, the title, the gold bar, the hint. */
#charge {
	box-sizing: border-box;
	top: 270dp;
	width: 480dp;
	height: 150dp;
	margin-left: -240dp;
	padding: 18dp 24dp;
	border: 3dp transparent;
	border-radius: 0;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-half-outer, nb-half-inner, 1) border-box;
}

#charge-title {
	font-size: 30dp;
	line-height: 36dp;
	color: #fff371;
}

#charge .bar {
	height: 15dp;
	margin: 14dp 12dp;
}

.charge-hint {
	font-family: "Pixel Small";
	font-size: 26dp;
	color: #b2b2b2;
}

/* The cup clock (.clock, 337): a thin box, the blue 1P and red 2P tabs and the seconds in the body font at 4 times its
   cell, gold. */
#match-clock {
	box-sizing: border-box;
	border: 3dp #b6e4f7;
	background-color: #0a101ceb;
	decorator: none;
}

#match-clock #mc-side-1 {
	decorator: image(nb-clock-1p);
}

#match-clock #mc-side-2 {
	decorator: image(nb-clock-2p);
}

#match-clock .mc-digit {
	top: 12dp;
	height: 60dp;
	font-family: "Pixel Body";
	font-size: 60dp;
	line-height: 60dp;
	text-align: center;
	color: #efc63c;
	font-effect: shadow(3dp 3dp #7a4a10);
	decorator: none;
}

/* The fast plate (.fast). */
#speed-plate {
	padding: 4dp 14dp;
	border: 2dp #4a79a8;
	font-size: 30dp;
	color: #ffffff;
}

/* ------------------------------------------------------------------------------------------------------------------
   The end boxes (end.html): half windows with brackets (the balance box without), the body font, the original's
   colours. */
#gains,
#bits {
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-half-outer, nb-half-inner, 1) border-box;
}

#balance {
	background-color: #293942;
	decorator: ninepatch(nb-half-outer, nb-half-inner, 1) border-box;
}

#gains-divider {
	top: 5dp;
	height: 272dp;
}

.gain,
#bits,
#balance,
.end-row {
	font-size: 30dp;
}

#bits-line {
	left: 3dp;
	top: 87dp;
	width: 516dp;
}

/* end.html .sl: the stat names in gold, the gains in light blue. */
.gain-label {
	color: #efc63c;
}

.gain-value {
	color: #b6e4f7;
}
