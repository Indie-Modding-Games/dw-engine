/* The mode of a new game (concept area A, new_game_mode: 008-010): the box right of the middle with its brackets,
   the gold title over a line, the modes as a ▶ list, the focused mode's description muted, Volver (list.html .mb). */

#panel {
	left: 50%;
	margin-left: -136dp;
	top: 156dp;
	width: 596dp;
	min-height: 282dp;
	padding: 12dp 22dp 12dp 36dp;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

#title {
	margin: 0 -10dp 8dp -24dp;
	padding: 0 12dp 4dp 24dp;
}

#panel button {
	margin-left: -26dp;
	padding: 3dp 12dp;
	border-width: 0;
	border-left-width: 26dp;
}

#panel button:focus {
	decorator: image(nb-cursor scale-none left center) border-box, ninepatch(nb-row-outer, nb-row-inner, 1) padding-box;
}

.about {
	padding: 4dp 12dp 8dp 12dp;
	line-height: 34dp;
	color: #93a6bc;
}
