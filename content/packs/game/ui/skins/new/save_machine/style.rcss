/* The save machine in the new look (concept area A, save_machine: 057-063): the windows on the title's wireframe,
   the heading and the lone notices with brackets, the answers in an opaque window with brackets as a ▶ list, the
   stats' names light blue, empty rows dim, the note gold. */

.box {
	border: 3dp transparent;
	background-color: transparent;
	decorator: ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

#heading,
#slots-prompt,
#no-slot,
#in-training {
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

#heading {
	color: #f2f0e1;
	letter-spacing: 4dp;
}

#answers {
	padding: 12dp 18dp 0 36dp;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-over-outer, nb-over-inner, 1) border-box;
}

.stat {
	color: #b6e4f7;
}

.stat-value {
	left: 273dp;
	color: #f2f0e1;
}

#answers button,
#slots .slot {
	margin-left: -26dp;
	padding: 0 12dp;
	border-width: 0;
	border-left-width: 26dp;
}

#answers button:focus,
#slots .slot:focus {
	decorator: image(nb-cursor scale-none left center) border-box, ninepatch(nb-row-outer, nb-row-inner, 1) padding-box;
}

.slot.empty .slot-name {
	color: #5f6f82;
}

#confirm-note {
	color: #efc63c;
}
