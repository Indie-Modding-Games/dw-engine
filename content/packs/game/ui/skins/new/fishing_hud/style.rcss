/* Fishing tension gauge in the digital field palette. */

body #gauge {
	border: 2dp #72c7ff;
	border-radius: 0;
	background-color: #0b1c2df2;
	decorator: vertical-gradient(#153653 #0a1929);
	color: #d8f1ff;
}

body #track { background-color: #345875; }
body #fill { background-color: #36bce8; }
body #fill.danger { background-color: #ff7775; }

