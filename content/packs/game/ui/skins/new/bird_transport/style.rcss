/* Bird transport: terminal-blue surfaces with clear price columns and a bright travel selector. */

body #window, body #talk, body #bits-box {
	border: 3dp transparent;
	background-color: #0b1c2df2;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box;
}

.row, #talk, #bits-box {
	font-family: original-look;
	color: #d5eaf7;
}

.row, #talk { font-family: original-look-dialogue; }

body .row.unaffordable { color: #ff7775; }
body #speaker { color: #ffe64a; }
body #speaker.player { color: #d5eaf7; }

.label {
	font-family: original-look;
	color: #8edcff;
	font-size: 15dp;
	line-height: 21dp;
	white-space: nowrap;
}

.use-menu-art .label-place { decorator: image(keeper-place-label scale-none left top); color: transparent; }
.use-menu-art .label-point { decorator: image(keeper-point-label scale-none left top); color: transparent; }

body #rule {
	background-color: #338bb4;
	border-top-color: #071421;
	border-bottom-color: #071421;
}

body #track { background-color: #345875; }
body #bar {
	border-left-color: #90d9fa;
	background-color: #2674a2;
}

body #cursor {
	border: 3dp #ffd51e;
	background-color: #153653b8;
}

body #talk .talk-row.selected .run {
	background-color: #153653;
	border-top-color: #ffd51e;
	color: #ffe64a;
}

/* Keep the original's compact row geometry while matching the rest of the terminal skin. */
.row { font-size: 33dp; }
