/* The shop job's counter in the Pixel art look (structure: ../../../shop_haggle/structure.rcss; the rules panel shares
   this sheet for its panel; docs/architecture/ui.md, «El aspecto Pixel art»). The window with its gold brackets
   (nb-box), the gold title over a blue line, the customer and the item in thin boxes (nb-thin), patience as hearts,
   the table in Pixel Body with light blue headings in Pixel Small, the focused row in the gold line with the gold ▶
   outside it (as every list of the look), the pointer leaving the rows as they are, and the chance as a meter from red
   to green. This sheet goes over the original skin's (skin.yaml: extends original), so it sets again every property
   that one gives the counter.
     ink #050c1a, navy #181f2c, light blue #b6e4f7, blue #7cb6e2, low blue #4a79a8, gold #efc63c, light gold #ffe58a,
     cream #f2f0e1, muted #93a6bc, dim #5f6f82, green #5fd36a, red #e2483d */

#scrim {
	background-color: #050c1a99;
}

#panel {
	font-family: "Pixel Body";
	font-weight: normal;
	font-size: 30dp;
	line-height: 32dp;
	color: #f2f0e1;
	border: 3dp transparent;
	border-radius: 0;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box, vertical-gradient(#0c1424e6 #0c1424e6) padding-box;
}

#haggle-head {
	height: 34dp;
	border-bottom: 3dp #7cb6e2;
}

#haggle-title {
	font-size: 30dp;
	font-weight: normal;
	color: #efc63c;
}

#haggle-summary {
	font-family: "Pixel Small";
	font-size: 26dp;
	color: #93a6bc;
}

#haggle-tally {
	font-weight: normal;
	color: #f2f0e1;
}

#haggle-next {
	font-weight: normal;
	color: #ffe58a;
}

/* The rules button: its key cap and its label in the small font, as the prompts of the look. */
#haggle-rules {
	padding: 0;
	margin: 0;
	border: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: none;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 30dp;
	color: #93a6bc;
}

#haggle-rules .key {
	font-size: 26dp;
	line-height: 30dp;
}

#haggle-rules:hover, #haggle-rules:focus {
	background-color: transparent;
	decorator: none;
	color: #f2f0e1;
}

/* Chat and Dismiss: thin boxes; the focused one in the gold line. */
#haggle-actions button {
	margin: 0 18dp 0 0;
	padding: 0 18dp;
	border: 3dp transparent;
	border-radius: 0;
	background-color: transparent;
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
	font-size: 30dp;
	line-height: 36dp;
	color: #f2f0e1;
}

#haggle-actions button:hover {
	background-color: transparent;
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
	color: #f2f0e1;
}

#haggle-actions button:focus {
	background-color: transparent;
	decorator: ninepatch(nb-row-outer, nb-row-inner, 1) border-box;
	color: #ffe58a;
}

#haggle-talk.disabled, #haggle-talk.disabled:hover {
	color: #5f6f82;
}

/* The customer's card and the item: thin boxes. */
#haggle-side {
	flex: 0 0 440dp;
	width: 440dp;
	margin-right: 36dp;
}

#haggle-customer, #haggle-item {
	border: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
}

#haggle-customer {
	padding: 10dp;
}

#haggle-item {
	padding: 8dp 10dp 8dp 56dp;
}

#haggle-portrait {
	left: 10dp;
	top: 10dp;
	border: 3dp #4a79a8;
	border-radius: 0;
	background-color: #050c1a;
}

#haggle-portrait-idle {
	font-size: 30dp;
	line-height: 66dp;
	color: #4a79a8;
}

#haggle-who, #haggle-patience {
	margin-left: 86dp;
}

#haggle-species {
	font-size: 30dp;
	line-height: 32dp;
	font-weight: normal;
	color: #ffe58a;
}

#haggle-character, #haggle-regular, #haggle-patience-label, #haggle-history-title, #haggle-history,
#haggle-wants, #haggle-mood, #haggle-reaction {
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 26dp;
	color: #93a6bc;
}

#haggle-history-title {
	color: #b6e4f7;
}

#haggle-wants {
	color: #f2f0e1;
}

#haggle-mood, #haggle-reaction {
	padding: 0 8dp;
	line-height: 28dp;
	font-weight: normal;
	color: #f2f0e1;
}

#haggle-mood {
	border-radius: 0;
	background-color: #050c1a;
}

#haggle-mood.mood-cheerful { color: #5fd36a; }
#haggle-mood.mood-serious { color: #efc63c; }

#haggle-reaction.face-delighted, #haggle-reaction.face-pleased, #haggle-reaction.face-doubtful,
#haggle-reaction.face-annoyed, #haggle-reaction.face-furious {
	border-radius: 0;
	background-color: #050c1a;
}

#haggle-reaction.face-delighted, #haggle-reaction.face-pleased { color: #5fd36a; }
#haggle-reaction.face-doubtful { color: #ffe58a; }
#haggle-reaction.face-annoyed { color: #efc63c; }
#haggle-reaction.face-furious { color: #e2483d; }

/* Patience as the look's hearts. */
.pip {
	width: 21dp;
	height: 18dp;
	margin-left: 3dp;
	border: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: image(nb-heart-empty contain center);
}

.pip.on {
	border-color: transparent;
	background-color: transparent;
	decorator: image(nb-heart contain center);
}

#haggle-item-icon {
	left: 12dp;
	top: 10dp;
}

#haggle-no-offers {
	color: #5f6f82;
}

.haggle-offer {
	height: 28dp;
	line-height: 28dp;
}

.haggle-offer .offer-text { color: #f2f0e1; }
.haggle-offer.face-doubtful .offer-text { color: #ffe58a; }
.haggle-offer.face-annoyed .offer-text { color: #efc63c; }
.haggle-offer.face-furious .offer-text { color: #e2483d; }

/* The table: light blue headings in the small font over a blue line; the focused row in the gold line with the ▶ in
   its left border, outside the row, so the text does not move (as the look's other lists). */
#haggle-columns {
	height: 30dp;
	line-height: 27dp;
	font-family: "Pixel Small";
	font-size: 26dp;
	color: #b6e4f7;
	border-bottom: 3dp #4a79a8;
}

.haggle-row {
	height: 32dp;
	line-height: 32dp;
	padding: 0;
	margin: 0 0 0 -26dp;
	border: 0;
	border-left: 26dp transparent;
	border-radius: 0;
	background-color: transparent;
	decorator: none;
	font-size: 30dp;
	color: #f2f0e1;
}

.haggle-row:hover {
	background-color: transparent;
	decorator: none;
	color: #f2f0e1;
}

.haggle-row:focus {
	background-color: transparent;
	decorator: image(nb-cursor scale-none left center) border-box, ninepatch(nb-row-outer, nb-row-inner, 1) padding-box;
	color: #ffe58a;
}

.haggle-row .row-price { font-weight: normal; }
.haggle-row.regular .row-price { color: #7cb6e2; }
.haggle-row:focus .row-price, .haggle-row:focus .row-adds { color: #ffe58a; }

.row-meter {
	top: 11dp;
	height: 10dp;
	border-radius: 0;
	background-color: #050c1a;
}

.row-meter-fill {
	border-radius: 0;
}

.chance-1 .row-meter-fill, .chance-2 .row-meter-fill { background-color: #e2483d; }
.chance-3 .row-meter-fill, .chance-4 .row-meter-fill { background-color: #e8873a; }
.chance-5 .row-meter-fill, .chance-6 .row-meter-fill, .chance-7 .row-meter-fill { background-color: #efc63c; }
.chance-8 .row-meter-fill, .chance-9 .row-meter-fill { background-color: #5fd36a; }
.chance-10 .row-meter-fill { background-color: #8ef59a; }

.haggle-row .row-chance { font-weight: normal; }
.haggle-row.chance-0 .row-chance, .haggle-row.chance-1 .row-chance, .haggle-row.chance-2 .row-chance { color: #e2483d; }
.haggle-row.chance-3 .row-chance, .haggle-row.chance-4 .row-chance { color: #e8873a; }
.haggle-row.chance-5 .row-chance, .haggle-row.chance-6 .row-chance, .haggle-row.chance-7 .row-chance { color: #efc63c; }
.haggle-row.chance-8 .row-chance, .haggle-row.chance-9 .row-chance, .haggle-row.chance-10 .row-chance { color: #5fd36a; }

/* A price refused before: dimmed. */
.haggle-row.offered, .haggle-row.offered .row-price, .haggle-row.offered .row-adds,
.haggle-row.offered .row-chance { color: #5f6f82; }
.haggle-row.offered .row-meter-fill { background-color: #2c3d55; }
