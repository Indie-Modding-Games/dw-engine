/* The trade in the new look (concept area C, trade_menu: 228-235): the offer list as half a window with brackets,
   the column titles in light blue over a light-blue rule, the gold line on the focused row, a green mark on what was
   traded, offers you cannot pay greyed; the amount box opaque with its rules and a sunk value field. */

/* Back to the base layout's x (216), which the modern look moved to the left edge. */
body #window,
body #amount {
	left: 216dp;
}

body #window {
	border: 3dp transparent;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-half-outer, nb-half-inner, 1) border-box;
}

.label {
	font-family: "Pixel Body";
	font-size: 30dp;
	color: #b6e4f7;
}

/* The column titles (tr-list): «Quiero» and «Tienes» in place of the story's, at the same spots. */
#label-give,
#label-get {
	display: none;
}

#label-want,
#label-have {
	display: block;
}

#label-want { left: 60dp; }
#label-have { left: 366dp; }

#rule,
#amount .rule {
	height: 9dp;
	border-top: 2dp #050c1a;
	border-bottom: 2dp #050c1a;
	background-color: #7cb6e2;
}

#cursor {
	border-width: 0;
	background-color: transparent;
	decorator: ninepatch(nb-row-outer, nb-row-inner, 1) border-box;
}

.row {
	font-family: "Pixel Body";
	font-size: 30dp;
	color: #f2f0e1;
	line-height: 48dp;
}

body .row .mark {
	color: #5fd36a;
}

body .row.missing,
body .row.missing .give {
	color: #5d6b7c;
}

body #amount {
	border: 3dp transparent;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-over-outer, nb-over-inner, 1) border-box;
	font-family: "Pixel Body";
	font-size: 30dp;
	color: #f2f0e1;
}

#amount-inset {
	border: 2dp #4a79a8;
	background-color: #0b1424;
}

/* The speech box (v1 talk, 90,486 786 x 177): a window with brackets, the speaker in gold, a choice row inside the gold
   line with the ▶ beside it. */
body #talk {
	padding: 12dp 30dp;
	border: 3dp transparent;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
	font-family: "Pixel Body";
	font-size: 30dp;
	line-height: 36dp;
	color: #f2f0e1;
}

#talk .talk-row {
	height: 36dp;
}

body #speaker,
body #speaker.player {
	color: #efc63c;
}

#talk .talk-row .run {
	padding: 0;
}

#talk .talk-row.selected {
	margin-left: -26dp;
	padding: 0 12dp;
	border-left: 26dp transparent;
	decorator: image(nb-cursor scale-none left center) border-box, ninepatch(nb-row-outer, nb-row-inner, 1) padding-box;
}

#talk .talk-row.selected .run {
	border-width: 0;
	background-color: transparent;
}

