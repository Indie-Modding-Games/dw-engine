/* The confirm dialog (concept area A, dialog: 029-045). Over the save list at the title: a box drawn over the list
   (title.html .dl, opaque), the question and Sí / No as a ▶ list. In the field: the pause menu's panel (field.html
   .fd) with the file line and the prompts under a line. */

#panel {
	padding: 14dp 24dp 10dp 44dp;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-over-outer, nb-over-inner, 1) border-box;
}

#scrim.at-title #panel {
	left: 50%;
	margin-left: -136dp;
	top: 244dp;
	width: 596dp;
	padding: 10dp 24dp 14dp 40dp;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-over-outer, nb-over-inner, 1) border-box;
}

#text {
	line-height: 36dp;
	padding: 0 0 6dp 12dp;
}

#file {
	font-family: "Pixel Small";
	font-size: 26dp;
	color: #93a6bc;
	padding: 0 0 6dp 12dp;
}

#panel button {
	margin-left: -26dp;
	padding: 3dp 12dp;
	border-width: 0;
	border-left-width: 26dp;
}

#panel button:focus {
	decorator: image(nb-cursor scale-none left center) border-box, ninepatch(nb-row-outer, nb-row-inner, 1) padding-box;
}

#prompts {
	margin: 12dp -14dp 0 -34dp;
	padding: 8dp 12dp 0 20dp;
}
