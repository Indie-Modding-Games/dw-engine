/* The merit shop in the new look (concept area C, merit_shop: 220-227): the points box and the card or item list
   as half windows with brackets, small light-blue labels, the gold line on the focused row, the speech box. */

body #points-box {
	padding: 8dp 21dp 0 21dp;
	border: 3dp transparent;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-half-outer, nb-half-inner, 1) border-box;
	font-family: "Pixel Body";
	font-size: 30dp;
	color: #f2f0e1;
}

#points-value {
	width: auto;
	text-align: right;
}

body #window {
	border: 3dp transparent;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-half-outer, nb-half-inner, 1) border-box;
}

.label,
.use-menu-art .label-menu,
.use-menu-art .label-count,
.use-menu-art .label-point {
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 27dp;
	width: auto;
	white-space: nowrap;
	color: #b6e4f7;
	decorator: none;
	top: 10dp;
}

#cursor {
	border-width: 0;
	background-color: transparent;
	decorator: ninepatch(nb-row-outer, nb-row-inner, 1) border-box;
}

.row {
	font-family: "Pixel Body";
	font-size: 30dp;
	color: #f2f0e1;
}

.name,
.value {
	top: 12dp;
}

.value {
	right: 12dp;
}

.icon {
	top: 3dp;
	width: 42dp;
	height: 42dp;
}

body .row.stuck {
	color: #5d6b7c;
}



.scrollbar {
	left: 457dp;
	width: 22dp;
	border: 2dp #2c3d55;
	background-color: #0b1322;
}

#frame.list-items .scrollbar {
	left: 529dp;
}

.thumb {
	background-color: #b6e4f7;
}

/* The speech box (v1 talk, 90,486 786 x 177): a window with brackets, the speaker in gold, a choice row inside the gold
   line with the ▶ beside it. */
body #talk {
	padding: 12dp 30dp;
	border: 3dp transparent;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
	font-family: "Pixel Body";
	font-size: 30dp;
	line-height: 36dp;
	color: #f2f0e1;
}

#talk .talk-row {
	height: 36dp;
}

body #speaker,
body #speaker.player {
	color: #efc63c;
}

#talk .talk-row .run {
	padding: 0;
}

#talk .talk-row.selected {
	margin-left: -26dp;
	padding: 0 12dp;
	border-left: 26dp transparent;
	decorator: image(nb-cursor scale-none left center) border-box, ninepatch(nb-row-outer, nb-row-inner, 1) padding-box;
}

#talk .talk-row.selected .run {
	border-width: 0;
	background-color: transparent;
}

