/* The pause menu's panel in the new look, for every screen that shares it (the pause menu, the save list and its
   dialogs, the rules of a new game, the sleep menu, the names box, the save machine, the shop...): the window with
   its gold brackets (orig.css .obox + .brk), the gold title over a light-blue line (area A .isep), the prompts as
   key caps under a line. Each screen's own sheet adds the ▶ to its lists. */

#panel {
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

#title,
#title-date {
	font-size: 30dp;
	color: #efc63c;
	border-bottom: 3dp #7cb6e2;
}

/* The prompts (area A pprompts): key cap and label in the small font, the labels muted. */
#prompts {
	border-top: 3dp #7cb6e2;
	font-family: "Pixel Small";
	font-size: 26dp;
	color: #93a6bc;
}

.prompt {
	margin-right: 14dp;
}

.prompt-key,
.prompt-key.cancel-key {
	color: #f2f0e1;
}

.dimmed,
button.dimmed:focus,
button:disabled {
	color: #5f6f82;
}
