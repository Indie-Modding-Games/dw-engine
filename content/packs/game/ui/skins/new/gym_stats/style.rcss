/* The gym's stats box in the new look (concept area C, gym_stats: 262-265): the pause menu's panel (panel/style), the
   labels in gold in the small font, the values right-aligned, the bars as sunk tracks filled light blue (gold when
   the stat rose), a light-blue line before the gains in blue, and the notes in a window with brackets under it. The
   rows carry each stat's whole name (262: «Ataque», «Velocidad») instead of the original's short label. */

body #divider {
	top: 24dp;
	height: 240dp;
	border-right-width: 0;
	background-color: #7cb6e2;
}

body .row {
	font-family: "Pixel Body";
	font-size: 30dp;
}

body .label {
	display: none;
}

body .name {
	display: block;
	position: absolute;
	z-index: 1;
	left: 24dp;
	top: 2dp;
	font-family: "Pixel Small";
	font-size: 26dp;
	color: #efc63c;
}

body .value {
	left: 150dp;
	width: 78dp;
	color: #f2f0e1;
}

/* The bar starts after the longest name; its track keeps the logic's 150dp scale, shrunk to the narrower frame. */
body .bar {
	left: 234dp;
	top: 12dp;
	width: 124dp;
	height: 12dp;
	padding: 0;
	border: 2dp #557ea8;
	background-color: #0b1220;
}

body .track,
body .bar.raised .track {
	width: 150dp;
	height: 8dp;
	overflow: hidden;
	background-color: transparent;
	transform-origin: left top;
	transform: scaleX(0.8);
}

body .fill {
	height: 8dp;
	background-color: transparent;
	decorator: image(nb-fill-st);
}

body .bar.raised .fill {
	background-color: transparent;
	decorator: image(nb-fill-gd);
}

body .arrow {
	color: transparent;
	decorator: image(nb-tri-u scale-none center center);
	image-color: #69c2ff;
}

body .gain {
	color: #69c2ff;
}

body #notes #notes-panel {
	border: 3dp transparent;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

body .note {
	font-family: "Pixel Body";
	font-size: 30dp;
	line-height: 40dp;
	color: #f2f0e1;
}

body .note.order {
	color: #efc63c;
}
