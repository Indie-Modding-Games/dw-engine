/* The save indicator in the new look (concept area A, save_indicator: 064-066): a thin window, the label in the
   small font. */

#indicator {
	border: 3dp transparent;
	background-color: transparent;
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
	font-family: "Pixel Small";
	font-size: 26dp;
	color: #f2f0e1;
}
