/* The title in the new look (concept area A, main_menu: 001-007): the boot screen, the menu box, the language box
   and the battle mode question. The backdrop and the logo are title/style.rcss. */

/* The screen before the menu (002-003): dark, the logo large at the top, the green «PULSA» line with its key. */
#scrim.boot {
	decorator: image(/ui/skins/new/assets/boot.png cover center center);
	padding: 0;
}

#press-start {
	box-sizing: border-box;
	padding: 70dp 32% 459dp 32%;
	background-color: transparent;
	decorator: image(/ui/skins/new/assets/hero_title.png contain center center) content-box;
}

#press-start:focus {
	decorator: image(/ui/skins/new/assets/hero_title.png contain center center) content-box;
}

#press-start-text {
	color: #3cf060;
	letter-spacing: 6dp;
}

#press-start-text .key {
	color: #3cf060;
}

/* The menu box (004-005): the window with its brackets, capitals 6dp apart, the ▶ in its left padding. */
#panel,
#language-box,
#battle-message {
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

#panel {
	padding: 11dp 30dp 11dp 40dp;
}

#panel button,
#language-box .language-row,
#language-done,
#battle-answers button {
	margin-left: -26dp;
	padding: 3dp 12dp;
	border-width: 0;
	border-left-width: 26dp;
	letter-spacing: 6dp;
}

#panel button:focus,
#language-box .language-row:focus,
#language-done:focus,
#battle-answers button:focus {
	decorator: image(nb-cursor scale-none left center) border-box, ninepatch(nb-row-outer, nb-row-inner, 1) padding-box;
}

.dimmed,
button.dimmed:focus {
	color: #5f6f82;
}

/* The language box (001): the heading small and muted, rows 60dp tall. */
#language-heading {
	font-family: "Pixel Small";
	font-size: 26dp;
	color: #93a6bc;
}

#language-box {
	padding: 18dp 24dp 21dp 40dp;
}

#language-box .language-row {
	margin-left: -8dp;
	letter-spacing: 4dp;
}

/* The battle mode question (006): the heading box without brackets, the message with them, Sí / No as a list. */
#battle-heading,
#battle-answers {
	decorator: ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

#battle-heading {
	letter-spacing: 6dp;
}

#battle-answers {
	padding: 9dp 0 0 36dp;
}

/* Narrow enough that the focused answer's frame stays inside the box. */
#battle-answers button {
	width: 100dp;
}
