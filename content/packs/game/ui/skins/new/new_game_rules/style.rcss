/* The new game's rules in the original look, over the pause menu's (../pause_menu/style.rcss): a box of the title's
   (main_menu.c: renderMenuBox) over the title image, as the slot list's (../save_slots/style.rcss); an addition, the
   original has no such choice. */

#scrim {
	background-color: #000000;
	decorator: image(title-screen contain center center);
}

/* The «widescreen pictures» option, as the title's (../main_menu/style.rcss). */
#scrim.wide {
	decorator: none;
}

#scrim.wide #picture {
	display: block;
	position: absolute;
	decorator: image(title-wide fill);
}

#scrim.wide .picture-fade {
	display: block;
	position: absolute;
	top: 0;
	height: 100%;
}

#picture-fade-left {
	left: 0;
	decorator: horizontal-gradient(#000000b0 #00000000);
}

#picture-fade-right {
	decorator: horizontal-gradient(#00000000 #000000b0);
}

#panel {
	left: 340dp;
	top: 150dp;
	width: 690dp;
	margin-left: 0;
	box-sizing: border-box;
	padding: 12dp 27dp 15dp 27dp;
	background-color: transparent;
	decorator: original-box(3dp) border-box, image(box-tl scale-none left top) border-box, image(box-tr scale-none right top) border-box,
		image(box-bl scale-none left bottom) border-box, image(box-br scale-none right bottom) border-box,
		vertical-gradient(#000060 #000020);
}

#panel button {
	line-height: 30dp;
}

#panel #prompts {
	display: none;
}

/* New rules screen: centred terminal card over the same grid used by the title screen. */
#scrim {
	background-color: #061321;
	decorator: image(/ui/skins/new/assets/main_menu_background fill);
}

#scrim.wide {
	background-color: #061321;
	decorator: image(/ui/skins/new/assets/main_menu_background fill);
}

#picture, .picture-fade,
#scrim.wide #picture, #scrim.wide .picture-fade {
	display: none;
}

#panel {
	left: 50%;
	top: 50%;
	width: 760dp;
	margin-left: -380dp;
	transform: translate(0dp, -50%);
	padding: 24dp 30dp 18dp 30dp;
	box-sizing: border-box;
	border: 2dp #72c7ff;
	border-radius: 0;
	background-color: #0b1c2df5;
	decorator: vertical-gradient(#153653 #0a1929);
}

#title {
	margin: 0 0 18dp 0;
	padding: 0 12dp 12dp 12dp;
	border-bottom: 2dp #397ca4;
	color: #d8f1ff;
	font-size: 28dp;
	font-weight: bold;
}

#panel #rules-hidden, #panel #rules-mega {
	display: block;
	width: 100%;
	height: 48dp;
	margin: 8dp 0 0 0;
	padding: 0 15dp;
	box-sizing: border-box;
	border: 1dp #345875;
	border-radius: 0;
	background-color: #0a2035;
	color: #d8f1ff;
	font-size: 20dp;
	line-height: 45dp;
	text-align: left;
}

#panel #rules-hidden:hover, #panel #rules-mega:hover {
	border-color: #72c7ff;
	background-color: #153653;
}

#panel #rules-hidden:focus, #panel #rules-mega:focus {
	border: 2dp #ffd51e;
	background-color: #153653;
	color: #ffe64a;
}

.about {
	margin: 0 0 12dp 0;
	padding: 9dp 15dp;
	border-left: 3dp #397ca4;
	background-color: #0a2035;
	color: #a8c7d9;
	font-size: 16dp;
	line-height: 24dp;
}

#panel #rules-start, #panel #back {
	display: inline-block;
	width: 48%;
	height: 48dp;
	margin: 18dp 1% 0 0;
	box-sizing: border-box;
	border: 1dp #397ca4;
	border-radius: 0;
	background-color: #102a40;
	color: #d8f1ff;
	font-size: 18dp;
	line-height: 45dp;
	text-align: center;
}

#panel #rules-start {
	border-color: #ffd51e;
	background-color: #ffd51e;
	color: #081724;
	font-weight: bold;
}

#panel #rules-start:focus, #panel #back:focus {
	border: 2dp #72c7ff;
	background-color: #153653;
	color: #ffe64a;
}

#panel #prompts {
	display: block;
	margin-top: 15dp;
	padding-top: 9dp;
	border-top: 1dp #397ca4;
	color: #a8c7d9;
	font-size: 14dp;
	text-align: right;
}

#prompts .prompt { margin-left: 15dp; }
#prompts .key { color: #72c7ff; }

#panel #rules-mega.hidden {
	display: none;
}

@media (max-width: 800dp) {
	#panel {
		width: 92%;
		margin-left: -46%;
	}
}

@media (max-height: 620dp) {
	#panel { top: 18dp; transform: none; }
	#title { margin-bottom: 9dp; padding-bottom: 6dp; }
	#panel #rules-hidden, #panel #rules-mega { height: 42dp; line-height: 39dp; }
	.about { margin-bottom: 6dp; padding-top: 6dp; padding-bottom: 6dp; }
	#panel #rules-start, #panel #back { height: 42dp; margin-top: 9dp; line-height: 39dp; }
}
