/* The rules of a new game (concept area A, new_game_rules: 011-015): a tall box top left with its brackets, the gold
   title over a line, each rule and its muted description, then Empezar / Volver as a ▶ list (rules.html .rb). */

#panel {
	left: 50%;
	margin-left: -440dp;
	top: 36dp;
	width: 760dp;
	padding: 12dp 18dp 12dp 36dp;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

#title {
	margin: 0 -14dp 10dp -24dp;
	padding: 0 12dp 6dp 24dp;
}

#panel button {
	margin-left: -26dp;
	padding: 3dp 12dp;
	border-width: 0;
	border-left-width: 26dp;
	line-height: 30dp;
}

#panel button:focus {
	decorator: image(nb-cursor scale-none left center) border-box, ninepatch(nb-row-outer, nb-row-inner, 1) padding-box;
}

.about {
	padding: 0 12dp 14dp 12dp;
	line-height: 34dp;
	color: #93a6bc;
}

#rules-start {
	margin-top: 20dp;
}

/* Each rule's value (Sí / No) in gold after its label (.rule .v). */
.rule-value {
	color: #efc63c;
}
