/* The boot's skin picker in the new look, as the mode of a new game (../new_game_mode/style.rcss): the box with
   its brackets over the title's backdrop, the gold title over a line, the skins as a ▶ list, each with its hint muted
   under its name. */

#panel {
	left: 50%;
	margin-left: -410dp;
	top: 130dp;
	width: 820dp;
	padding: 12dp 22dp 14dp 36dp;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

#title {
	margin: 0 -10dp 8dp -24dp;
	padding: 0 12dp 4dp 24dp;
}

#panel button {
	margin-left: -26dp;
	padding: 4dp 12dp;
	border-width: 0;
	border-left-width: 26dp;
}

#panel button:focus {
	decorator: image(nb-cursor scale-none left center) border-box, ninepatch(nb-row-outer, nb-row-inner, 1) padding-box;
}

.skin-hint {
	opacity: 1;
	color: #93a6bc;
}
