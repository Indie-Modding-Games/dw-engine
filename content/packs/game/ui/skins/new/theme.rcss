/* The new look over the original's layout (skin.yaml: extends original). Only the look changes: the boxes, the
   text, the cursor and the prompts of every document; the positions stay the original skin's, except where the
   design moves something.

   Source: the design system of the UI concept (system/v1: theme.css, orig.css; areas/<A-D>/area.css). One dp is one
   pixel of the design inside its 960 x 720 stage. The frames, the cursor, the key caps, the tabs, the bar fills and
   the hearts are drawn in assets/frames.png (2 pixels per dp, sprite sheet nb-frames in skin.yaml), because the UI
   has no shadows or clipped shapes.

   Colours (theme.css :root): ink #050c1a, navy #181f2c, light blue #b6e4f7, blue #7cb6e2, low blue #4a79a8,
   gold #efc63c, light gold #ffe58a, cream #f2f0e1 (text), muted #93a6bc, dim #5f6f82, green #5fd36a, red #e2483d,
   mp #4aa6ff.

   Type: two pixel fonts from the public domain X11 fixed fonts, drawn at twice their cell so they stay sharp:
   Pixel Body (9 x 15) at 30dp for everything, Pixel Small (7 x 13) at 26dp for keys, hints and descriptions. */

body {
	font-family: "Pixel Body";
	font-weight: normal;
	font-size: 30dp;
	color: #f2f0e1;
}

.original-look,
.original-look.original-dialogue {
	font-family: "Pixel Body";
	font-weight: normal;
	color: #f2f0e1;
}

/* A window (orig.css .obox): ink, light blue, ink and blue lines and the navy fill, at 94 % over what is behind it.
   The gold corner brackets (.brk) are added per window with nb-brk-tl and nb-brk-br. */
.original-box {
	border: 3dp transparent;
	border-radius: 0;
	background-color: transparent;
	decorator: ninepatch(nb-box-outer, nb-box-inner, 1) border-box;
}

/* A menu entry (orig.css .orow): plain text; the focused one inside a gold line with a gold tint. The ▶ beside it is
   added per list (it sits in the box's left padding, outside the row). */
button {
	padding: 0 12dp;
	border: 3dp transparent;
	border-radius: 0;
	color: #f2f0e1;
	background-color: transparent;
	line-height: 30dp;
	transition: none;
}

button:focus {
	border-color: transparent;
	background-color: transparent;
	color: #f2f0e1;
	decorator: ninepatch(nb-row-outer, nb-row-inner, 1) border-box;
}

button:hover {
	background-color: transparent;
}

button:active {
	background-color: transparent;
}

/* A key cap (theme.css .key, orig.css .okey-sm): light blue rim, blue fill, dark drop under it; the key's name in
   the small font. */
.key {
	display: inline-block;
	min-width: 18dp;
	height: 30dp;
	padding: 0 6dp 4dp 6dp;
	margin-right: 10dp;
	border: 0;
	border-radius: 0;
	font-family: "Pixel Small";
	font-weight: normal;
	font-size: 26dp;
	line-height: 30dp;
	text-align: center;
	color: #f2f0e1;
	background-color: transparent;
	decorator: ninepatch(nb-key-outer, nb-key-inner, 1) border-box;
}

/* Pad buttons (system.css .key.pad): a round cap with the button's letter in its colour. */
.key.glyph-face {
	min-width: 30dp;
	padding: 0 0 4dp 0;
	border-radius: 0;
}

.key.family-shapes,
.key.family-positions {
	min-width: 30dp;
	padding: 0 0 4dp 0;
	margin-right: 10dp;
	border-width: 0;
	font-size: 26dp;
}

/* The pad's shapes and a generic pad's positions are drawn by the engine (.glyph-art) inside the cap; the original
   font's character and the classic animated frames are the original skin's. */
.glyph-char,
.glyph-frame {
	display: none;
}

.family-shapes .glyph-art,
.family-positions .glyph-art {
	display: inline-block;
}

/* The field's digits from the battle sprites stay the original's. */
