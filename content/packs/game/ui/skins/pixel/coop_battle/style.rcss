#panel {
	border: 3dp transparent;
	border-radius: 0;
	background-color: transparent;
	decorator: image(nb-brk-tl scale-none left top) border-box, image(nb-brk-br scale-none right bottom) border-box,
		ninepatch(nb-half-outer, nb-half-inner, 1) border-box;
	font-family: "Pixel Body";
	font-size: 22dp;
	line-height: 26dp;
	color: #f2f0e1;
}

#title {
	font-size: 22dp;
	color: #f2c94c;
}

#phase,
#items-title,
#no-items {
	color: #b6e4f7;
}

.fighter.partner .name {
	color: #f2c94c;
}

.fighter .hp,
.fighter .mp,
.fighter .revive {
	font-family: "Pixel Small";
	font-size: 22dp;
}

.fighter .mp {
	color: #7cb6e2;
}

.fighter .bar {
	border-radius: 0;
	background-color: #0d1a33;
}

.fighter .fill {
	border-radius: 0;
	background-color: #5fd36a;
}

.fighter.mine {
	border-left-color: #f2c94c;
}

button {
	margin: 3dp;
	padding: 2dp 10dp;
	border: 2dp #7cb6e2;
	border-radius: 0;
	background-color: #0d1a33;
	color: #f2f0e1;
	font-family: "Pixel Small";
	font-size: 22dp;
}

button:hover,
button:focus,
button.current {
	border-color: #f2c94c;
}

.fighter .target {
	padding: 0 6dp;
	font-size: 20dp;
}
