/* hud in the new look (concept area B, mockups 097-123): the original's faces, no dial, the small boxes (.obox.thin)
   for the time, the map's name and the menu button, the bars as thin boxes with pink or blue pips, the round
   minimap ringed in the window's blues and the need balloon as a cream pill. On a wide screen everything keeps to
   the window's edges at the stage's distances (mockup 095). */

/* No dial on the left: the time is the minimap's (its box and the day-part chip). The original and modern skins
   keep their clocks; the script still drives this one, hidden. */
#field-status #field-clock,
#field-status.shown #field-clock {
	display: none;
}

/* The bars (.sbar: 225 x 24, a thin box, 25 pips of 4 + 2 from x 54, 12 tall): pink for happiness, blue for
   discipline, whatever the half; the face tells the low half. Solid for now: an image decorator cannot repeat a
   sprite of a sheet, the pips need a tile of their own. */
.field-meter {
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
}

#field-meter-0 { bottom: 66dp; }
#field-meter-1 { bottom: 28dp; }

#field-status .field-meter .bar {
	top: 6dp;
	height: 12dp;
}

#field-status .field-meter .fill,
#field-status .field-meter .fill.high {
	height: 9dp;
	border-top: 3dp #f0b8d0;
	background-color: #f070a8;
	decorator: none;
}

#field-status #field-meter-1 .fill,
#field-status #field-meter-1 .fill.high {
	border-top-color: #90c8f0;
	background-color: #4aa6ff;
}

/* The need meters (the option need_meters): hunger, the toilet and tiredness in a column of thin boxes left of the
   bars, each with its icon over the box's left end and a gold bar that fills as the need comes due, red once the
   partner has it. They slide in and out with the bars. */
#field-gauges {
	display: block;
}

.field-gauge {
	display: block;
	position: absolute;
	right: -465dp;
	width: 180dp;
	height: 24dp;
	margin: 0;
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
	transition: right 0.17s linear-in-out;
}

#field-status.shown .field-gauge {
	right: 265dp;
}

#field-gauge-0 { bottom: 104dp; }
#field-gauge-1 { bottom: 66dp; }
#field-gauge-2 { bottom: 28dp; }

.field-gauge .label {
	display: none;
}

.field-gauge .icon {
	position: absolute;
	left: 4dp;
	top: -6dp;
	width: 32dp;
	height: 32dp;
}

.field-gauge.hunger .icon { decorator: image(nb-gauge-hunger); }
.field-gauge.toilet .icon { decorator: image(nb-gauge-toilet); }
.field-gauge.tired .icon { decorator: image(nb-gauge-tired); }

.field-gauge .bar {
	position: absolute;
	left: 42dp;
	top: 6dp;
	width: 126dp;
	height: 12dp;
	margin: 0;
	background-color: #181f2c;
}

.field-gauge .fill {
	position: absolute;
	left: 0;
	top: 0;
	height: 9dp;
	border-top: 3dp #f7e08a;
	background-color: #efc63c;
}

.field-gauge.active .fill {
	border-top-color: #f29a90;
	background-color: #e2483d;
}

/* The danger mark: the purple devil, 32 dp, a little over the wild monster's head. */
.field-danger .icon {
	width: 32dp;
	height: 32dp;
	decorator: image(nb-danger-devil);
}

/* The need balloon: a cream pill with an ink rim (66 x 60) round the need, as wide as the stack when there are
   several; the balloon's own pictures stay for the burst. */
#field-partner-bubble.shown {
	decorator: none;
}

#field-partner-bubble.shown .balloon-half {
	display: block;
	top: 8dp;
	width: 33dp;
	height: 60dp;
	box-sizing: border-box;
	border: 3dp #050c1a;
	background-color: #f2f0e1;
	decorator: none;
}

#field-partner-bubble.shown #field-partner-bubble-left {
	left: 15dp;
	border-right-width: 0;
	border-radius: 30dp 0 0 30dp;
}

#field-partner-bubble.shown #field-partner-bubble-right {
	right: 15dp;
	border-left-width: 0;
	border-radius: 0 30dp 30dp 0;
}

#field-partner-bubble.stack-2 .balloon-half,
#field-partner-bubble.stack-3 .balloon-half,
#field-partner-bubble.stack-4 .balloon-half,
#field-partner-bubble.stack-5 .balloon-half {
	width: 50%;
	decorator: none;
}

#field-partner-bubble.stack-2 #field-partner-bubble-left,
#field-partner-bubble.stack-3 #field-partner-bubble-left,
#field-partner-bubble.stack-4 #field-partner-bubble-left,
#field-partner-bubble.stack-5 #field-partner-bubble-left {
	left: 0;
}

#field-partner-bubble.stack-2 #field-partner-bubble-right,
#field-partner-bubble.stack-3 #field-partner-bubble-right,
#field-partner-bubble.stack-4 #field-partner-bubble-right,
#field-partner-bubble.stack-5 #field-partner-bubble-right {
	right: 0;
}

/* The map's name over the fade (.bmaptitle): light grey with an ink drop. */
#map-title {
	font-family: "Pixel Body";
	font-size: 30dp;
	color: #d0d0d0;
	font-effect: shadow(3dp 3dp #050c1a);
}

/* The minimap (.mm): the disc 180 across (135 small, 236 large) 30 from the right edge, its name in a thin box
   156 wide at the top, the north mark an ink square with a gold N on the ring, the time in a thin box under it. */
#minimap {
	right: 12dp;
	top: 4dp;
}

#minimap.size-small { width: 171dp; }
#minimap.size-medium { width: 216dp; }
#minimap.size-large { width: 272dp; }

.size-small #minimap-frame { width: 135dp; height: 135dp; }
.size-medium #minimap-frame { width: 180dp; height: 180dp; }
.size-large #minimap-frame { width: 236dp; height: 236dp; }

#minimap-name {
	display: inline-block;
	margin: 0 0 2dp 0;
	min-width: 156dp;
	max-width: 100%;
	white-space: normal;
	word-break: break-word;
	text-align: center;
	padding: 2dp 8dp;
	box-sizing: border-box;
	border-width: 0;
	background-color: transparent;
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 30dp;
	color: #f2f0e1;
}

#minimap-frame {
	decorator: minimap-disc(original #10203af0 #b6e4f7 #00000000 3dp 0dp);
}

#minimap-north {
	top: 3dp;
	width: 28dp;
	height: 28dp;
	margin-left: -17dp;
	border: 3dp #b6e4f7;
	border-radius: 0;
	background-color: #050c1a;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 28dp;
	color: #efc63c;
}

#minimap-player { image-color: #efc63c; }
#minimap-partner { image-color: #b6e4f7; }

#minimap-enemies .enemy {
	width: 12dp;
	height: 12dp;
	margin-left: -6dp;
	margin-top: -6dp;
}

#minimap-items .item {
	width: 12dp;
	height: 12dp;
	margin-left: -6dp;
	margin-top: -6dp;
}

#minimap-clock {
	margin-top: -2dp;
	padding: 2dp 12dp;
	border-width: 0;
	background-color: transparent;
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 30dp;
}

#minimap-time {
	color: #f2f0e1;
}

/* The day-part chip before the time (ui/hud/logic.lua: clock_phase), the concept's icons at the small font's
   height. */
#minimap-phase {
	display: inline-block;
	width: 26dp;
	height: 26dp;
	margin: 2dp 8dp 0 0;
	vertical-align: top;
}

#minimap-phase.phase-morning { decorator: image(/ui/skins/pixel/assets/icon_sources/icon_morning.png contain); }
#minimap-phase.phase-day { decorator: image(/ui/skins/pixel/assets/icon_sources/icon_day.png contain); }
#minimap-phase.phase-late { decorator: image(/ui/skins/pixel/assets/icon_sources/icon_late.png contain); }
#minimap-phase.phase-night { decorator: image(/ui/skins/pixel/assets/icon_sources/icon_night.png contain); }

/* The menu button (.menu-btn: a thin box 40 from the left, 24 from the bottom, the Tab key cap and "Menu"). */
#menu-button,
#menu-button:hover,
#menu-button:focus {
	left: 40dp;
	bottom: 24dp;
	padding: 5dp 12dp 5dp 5dp;
	border-width: 0;
	background-color: transparent;
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 34dp;
	color: #f2f0e1;
}

#menu-button .key {
	margin-right: 10dp;
}

/* The shop job's bar (.bjob): a thin box at the top centre, the small font, the bar on a dark track with a blue rim,
   pink, blue past the better pay, light grey once the shopkeeper joins and gold at the bonus; the marks in light gold,
   the join's (the main one) taller and cream, its label above the bar in light gold next to the bonus item's icon, the
   others under it; the "?" as the look's key cap. This sheet goes over the original skin's, so it sets again every
   property that one gives the bar. */
#shop-job {
	width: 674dp;
	margin-left: -349dp;
	padding: 10dp 12dp 6dp 12dp;
	border-width: 0;
	background-color: transparent;
	decorator: ninepatch(nb-thin-outer, nb-thin-inner, 1) border-box;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 26dp;
	color: #d0d0d0;
}

#shop-job-title {
	color: #efc63c;
}

#shop-job-customers {
	color: #f2f0e1;
}

/* The rules' button: the help key's cap (the theme's nb-key) and a "?", in light gold under the pointer. */
#shop-job-rules {
	width: auto;
	height: auto;
	padding: 0;
	margin: 0 0 0 14dp;
	border: 0;
	border-radius: 0;
	background-color: transparent;
	decorator: none;
	font-family: "Pixel Small";
	font-size: 26dp;
	line-height: 30dp;
	color: #f2f0e1;
}

/* The cap's own size (the original skin's sheet under this one sets a smaller line for its font). */
#shop-job-rules .key {
	margin: 0 6dp 0 0;
	font-size: 26dp;
	line-height: 30dp;
}

#shop-job-rules:hover, #shop-job-rules:focus {
	border-color: transparent;
	background-color: transparent;
	decorator: none;
	color: #ffe58a;
}

#shop-job-bar {
	height: 14dp;
	margin: 34dp 0 0 0;
	border: 2dp #4c6a8c;
	background-color: #1a2230;
}

#shop-job-fill {
	border-top: 4dp #f0b8d0;
	background-color: #e05890;
}

#shop-job-fill.tier-better { border-top-color: #90c8f0; background-color: #0080d0; }
#shop-job-fill.tier-joins { border-top-color: #ffffff; background-color: #d0d0d0; }
#shop-job-fill.tier-bonus { border-top-color: #ffe58a; background-color: #efc63c; }

.shop-job-mark {
	top: -4dp;
	bottom: -4dp;
	width: 4dp;
	margin-left: -2dp;
	background-color: #ffe58a;
}

.shop-job-mark.main {
	top: -8dp;
	bottom: -8dp;
	width: 6dp;
	margin-left: -3dp;
	background-color: #f2f0e1;
}

#shop-job-mark-bonus {
	background-color: #efc63c;
}

.shop-job-mark-label {
	font-size: 26dp;
	line-height: 26dp;
	color: #93a6bc;
}

#shop-job-mark-join .shop-job-mark-label {
	margin-bottom: 6dp;
	color: #ffe58a;
}

#shop-job-mark-bonus .shop-job-mark-label {
	margin-top: 6dp;
	color: #efc63c;
}

#shop-job-mark-pay .shop-job-mark-label {
	margin-top: 6dp;
}

#shop-job-mark-bonus-icon {
	left: -13dp;
	width: 26dp;
	height: 26dp;
	margin-bottom: 6dp;
}

#shop-job-foot {
	height: 26dp;
	margin-top: 36dp;
	font-size: 26dp;
}

#shop-job-tally {
	color: #f2f0e1;
}

#shop-job-next {
	color: #ffe58a;
}

#shop-job.joins #shop-job-next, #shop-job.bonus #shop-job-next {
	color: #5fd36a;
}
