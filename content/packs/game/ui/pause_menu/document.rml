                    <button id="chart-cell-46" class="chart-cell hidden" onclick="chart_pick(document, 46)"><img id="chart-icon-46" class="chart-icon hidden"/></button>
                    <button id="chart-cell-47" class="chart-cell hidden" onclick="chart_pick(document, 47)"><img id="chart-icon-47" class="chart-icon hidden"/></button>
                    <button id="chart-cell-48" class="chart-cell hidden" onclick="chart_pick(document, 48)"><img id="chart-icon-48" class="chart-icon hidden"/></button>
                    <button id="chart-cell-49" class="chart-cell hidden" onclick="chart_pick(document, 49)"><img id="chart-icon-49" class="chart-icon hidden"/></button>
                    <button id="chart-cell-50" class="chart-cell hidden" onclick="chart_pick(document, 50)"><img id="chart-icon-50" class="chart-icon hidden"/></button>
                    <button id="chart-cell-51" class="chart-cell hidden" onclick="chart_pick(document, 51)"><img id="chart-icon-51" class="chart-icon hidden"/></button>
                    <button id="chart-cell-52" class="chart-cell hidden" onclick="chart_pick(document, 52)"><img id="chart-icon-52" class="chart-icon hidden"/></button>
                    <button id="chart-cell-53" class="chart-cell hidden" onclick="chart_pick(document, 53)"><img id="chart-icon-53" class="chart-icon hidden"/></button>
                    <button id="chart-cell-54" class="chart-cell hidden" onclick="chart_pick(document, 54)"><img id="chart-icon-54" class="chart-icon hidden"/></button>
                    <button id="chart-cell-55" class="chart-cell hidden" onclick="chart_pick(document, 55)"><img id="chart-icon-55" class="chart-icon hidden"/></button>
                    <button id="chart-cell-56" class="chart-cell hidden" onclick="chart_pick(document, 56)"><img id="chart-icon-56" class="chart-icon hidden"/></button>
                    <button id="chart-cell-57" class="chart-cell hidden" onclick="chart_pick(document, 57)"><img id="chart-icon-57" class="chart-icon hidden"/></button>
                    <button id="chart-cell-58" class="chart-cell hidden" onclick="chart_pick(document, 58)"><img id="chart-icon-58" class="chart-icon hidden"/></button>
                    <button id="chart-cell-59" class="chart-cell hidden" onclick="chart_pick(document, 59)"><img id="chart-icon-59" class="chart-icon hidden"/></button>
                    <button id="chart-cell-60" class="chart-cell hidden" onclick="chart_pick(document, 60)"><img id="chart-icon-60" class="chart-icon hidden"/></button>
