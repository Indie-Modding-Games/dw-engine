                    <button id="chart-cell-39" class="chart-cell hidden" onclick="chart_pick(document, 39)"><img id="chart-icon-39" class="chart-icon hidden"/></button>
                    <button id="chart-cell-40" class="chart-cell hidden" onclick="chart_pick(document, 40)"><img id="chart-icon-40" class="chart-icon hidden"/></button>
