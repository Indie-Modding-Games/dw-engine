                  <div id="city-cursor" class="hidden"></div>
                  <div id="city-footer">
                    <div id="city-name-box" class="player-inset"></div>
                    <div id="city-name"></div>
                    <div id="city-points"></div>
                  </div>
                  <div id="city-prompts" class="page-prompts"><div class="page-prompt"><span id="city-confirm-key" class="prompt-key confirm-key"></span><span class="prompt-text" text-key="pause_menu.chart_select"></span></div><div class="page-prompt"><span id="city-cancel-key" class="prompt-key cancel-key"></span><span class="prompt-text" text-key="common.cancel"></span></div></div>
