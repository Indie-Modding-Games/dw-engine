					<button id="row-11" class="option hidden" onclick="row_confirm(document, 11)" onfocus="row_focus(document, 11)"><span class="label" id="row-11-label"></span><span class="control"><span class="arrow less" id="row-11-less" onclick="row_arrow(document, event, 11, -1)"></span><span class="bar" id="row-11-bar"><span class="fill" id="row-11-fill"></span></span><span class="value" id="row-11-value"></span><span class="arrow more" id="row-11-more" onclick="row_arrow(document, event, 11, 1)"></span></span></button>
