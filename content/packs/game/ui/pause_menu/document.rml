					<button id="row-18" class="option hidden" onclick="row_confirm(document, 18)" onfocus="row_focus(document, 18)"><span class="label" id="row-18-label"></span><span class="control"><span class="arrow less" id="row-18-less" onclick="row_arrow(document, event, 18, -1)"></span><span class="bar" id="row-18-bar"><span class="fill" id="row-18-fill"></span></span><span class="value" id="row-18-value"></span><span class="arrow more" id="row-18-more" onclick="row_arrow(document, event, 18, 1)"></span></span></button>
					<button id="row-19" class="option hidden" onclick="row_confirm(document, 19)" onfocus="row_focus(document, 19)"><span class="label" id="row-19-label"></span><span class="control"><span class="arrow less" id="row-19-less" onclick="row_arrow(document, event, 19, -1)"></span><span class="bar" id="row-19-bar"><span class="fill" id="row-19-fill"></span></span><span class="value" id="row-19-value"></span><span class="arrow more" id="row-19-more" onclick="row_arrow(document, event, 19, 1)"></span></span></button>
					<button id="row-20" class="option hidden" onclick="row_confirm(document, 20)" onfocus="row_focus(document, 20)"><span class="label" id="row-20-label"></span><span class="control"><span class="arrow less" id="row-20-less" onclick="row_arrow(document, event, 20, -1)"></span><span class="bar" id="row-20-bar"><span class="fill" id="row-20-fill"></span></span><span class="value" id="row-20-value"></span><span class="arrow more" id="row-20-more" onclick="row_arrow(document, event, 20, 1)"></span></span></button>
					<button id="row-21" class="option hidden" onclick="row_confirm(document, 21)" onfocus="row_focus(document, 21)"><span class="label" id="row-21-label"></span><span class="control"><span class="arrow less" id="row-21-less" onclick="row_arrow(document, event, 21, -1)"></span><span class="bar" id="row-21-bar"><span class="fill" id="row-21-fill"></span></span><span class="value" id="row-21-value"></span><span class="arrow more" id="row-21-more" onclick="row_arrow(document, event, 21, 1)"></span></span></button>
					<button id="row-22" class="option hidden" onclick="row_confirm(document, 22)" onfocus="row_focus(document, 22)"><span class="label" id="row-22-label"></span><span class="control"><span class="arrow less" id="row-22-less" onclick="row_arrow(document, event, 22, -1)"></span><span class="bar" id="row-22-bar"><span class="fill" id="row-22-fill"></span></span><span class="value" id="row-22-value"></span><span class="arrow more" id="row-22-more" onclick="row_arrow(document, event, 22, 1)"></span></span></button>
					<button id="row-23" class="option hidden" onclick="row_confirm(document, 23)" onfocus="row_focus(document, 23)"><span class="label" id="row-23-label"></span><span class="control"><span class="arrow less" id="row-23-less" onclick="row_arrow(document, event, 23, -1)"></span><span class="bar" id="row-23-bar"><span class="fill" id="row-23-fill"></span></span><span class="value" id="row-23-value"></span><span class="arrow more" id="row-23-more" onclick="row_arrow(document, event, 23, 1)"></span></span></button>
