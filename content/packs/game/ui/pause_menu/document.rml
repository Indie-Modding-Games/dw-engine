                <div id="player-tools">
				<button id="player-city" onclick="open_city(document)" text-key="pause_menu.player_tab_city"></button>
				<button id="player-minimap" onclick="open_page(document, 'minimap')" text-key="pause_menu.minimap"></button>
				<button id="player-options" onclick="open_page(document, 'options')" text-key="pause_menu.options"></button>
				<button id="player-save" onclick="ui.send('quick_save')" text-key="pause_menu.quick_save"></button>
				<button id="player-to-title" onclick="ui.send('to_title')" text-key="pause_menu.to_title"></button>
				<button id="player-quit" onclick="ui.send('quit')" text-key="pause_menu.quit"></button>
				<button id="player-back" class="back" onclick="back(document)" text-key="common.back"></button>
                </div>
			</div>

			<div id="page-minimap" class="page hidden">
				<button id="minimap-mode" class="option" onclick="adjust(document, 'minimap-mode', 1)">
					<span class="label" text-key="pause_menu.minimap_mode"></span><span class="value" id="minimap-mode-value"></span>
				</button>
				<button id="minimap-size" class="option" onclick="adjust(document, 'minimap-size', 1)">
					<span class="label" text-key="pause_menu.minimap_size"></span><span class="value" id="minimap-size-value"></span>
				</button>
				<button id="minimap-back" class="back" onclick="back(document)" text-key="common.back"></button>
			</div>

			<!-- The options (docs/modulos/apps/game.md, «Opciones en partida»): the tabs, the rows of the tab shown, what the
			     focused row does, and the keys. The rows are one pool the tab shown fills in order (logic.lua: show_tab), each
			     given the id of its option while the tab is shown; the rest stay hidden. -->
			<div id="page-options" class="page hidden">
				<!-- The game's own actions lead the page (docs/architecture/guardar-y-cargar.md, 3.8): up from the first row
				     reaches them, left and right step through them; the settings by tabs follow. -->
				<div id="options-quick">
					<button id="options-save" class="quick-action" onclick="ui.send('quick_save')" onfocus="action_focus(document, 'save')" text-key="pause_menu.quick_save"></button>
					<button id="options-to-title" class="quick-action" onclick="ui.send('to_title')" onfocus="action_focus(document, 'to_title')" text-key="pause_menu.to_title"></button>
					<button id="options-quit" class="quick-action" onclick="ui.send('quit')" onfocus="action_focus(document, 'quit')" text-key="pause_menu.quit"></button>
				</div>
				<div id="menu-tabs">
					<span id="tabs-previous-key" class="key tab-key" onclick="step_tab(document, -1)"></span>
					<div id="tab-game" class="option-tab" onclick="show_tab(document, 'game')"><span class="option-tab-left"></span><span class="option-tab-middle"></span><span class="option-tab-right"></span><span class="option-tab-label" text-key="pause_menu.tab.game"></span></div>
					<div id="tab-graphics" class="option-tab" onclick="show_tab(document, 'graphics')"><span class="option-tab-left"></span><span class="option-tab-middle"></span><span class="option-tab-right"></span><span class="option-tab-label" text-key="pause_menu.tab.graphics"></span></div>
					<div id="tab-sound" class="option-tab" onclick="show_tab(document, 'sound')"><span class="option-tab-left"></span><span class="option-tab-middle"></span><span class="option-tab-right"></span><span class="option-tab-label" text-key="pause_menu.tab.sound"></span></div>
					<div id="tab-interface" class="option-tab" onclick="show_tab(document, 'interface')"><span class="option-tab-left"></span><span class="option-tab-middle"></span><span class="option-tab-right"></span><span class="option-tab-label" text-key="pause_menu.tab.interface"></span></div>
					<span id="tabs-next-key" class="key tab-key" onclick="step_tab(document, 1)"></span>
				</div>
				<div id="option-list">
					<button id="row-1" class="option hidden" onclick="row_confirm(document, 1)" onfocus="row_focus(document, 1)"><span class="label" id="row-1-label"></span><span class="control"><span class="arrow less" id="row-1-less" onclick="row_arrow(document, event, 1, -1)"></span><span class="bar" id="row-1-bar"><span class="fill" id="row-1-fill"></span></span><span class="value" id="row-1-value"></span><span class="arrow more" id="row-1-more" onclick="row_arrow(document, event, 1, 1)"></span></span></button>
					<button id="row-2" class="option hidden" onclick="row_confirm(document, 2)" onfocus="row_focus(document, 2)"><span class="label" id="row-2-label"></span><span class="control"><span class="arrow less" id="row-2-less" onclick="row_arrow(document, event, 2, -1)"></span><span class="bar" id="row-2-bar"><span class="fill" id="row-2-fill"></span></span><span class="value" id="row-2-value"></span><span class="arrow more" id="row-2-more" onclick="row_arrow(document, event, 2, 1)"></span></span></button>
					<button id="row-3" class="option hidden" onclick="row_confirm(document, 3)" onfocus="row_focus(document, 3)"><span class="label" id="row-3-label"></span><span class="control"><span class="arrow less" id="row-3-less" onclick="row_arrow(document, event, 3, -1)"></span><span class="bar" id="row-3-bar"><span class="fill" id="row-3-fill"></span></span><span class="value" id="row-3-value"></span><span class="arrow more" id="row-3-more" onclick="row_arrow(document, event, 3, 1)"></span></span></button>
					<button id="row-4" class="option hidden" onclick="row_confirm(document, 4)" onfocus="row_focus(document, 4)"><span class="label" id="row-4-label"></span><span class="control"><span class="arrow less" id="row-4-less" onclick="row_arrow(document, event, 4, -1)"></span><span class="bar" id="row-4-bar"><span class="fill" id="row-4-fill"></span></span><span class="value" id="row-4-value"></span><span class="arrow more" id="row-4-more" onclick="row_arrow(document, event, 4, 1)"></span></span></button>
