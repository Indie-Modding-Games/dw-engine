                    <button id="chart-cell-69" class="chart-cell hidden" onclick="chart_pick(document, 69)"><img id="chart-icon-69" class="chart-icon hidden"/></button>
                    <button id="chart-cell-70" class="chart-cell hidden" onclick="chart_pick(document, 70)"><img id="chart-icon-70" class="chart-icon hidden"/></button>
                    <button id="chart-cell-71" class="chart-cell hidden" onclick="chart_pick(document, 71)"><img id="chart-icon-71" class="chart-icon hidden"/></button>
                    <img id="chart-cursor" class="hidden" src="/texture/etcdat/sboy?palette=15" rect="0 232 24 20"/>
                  </div></div>
                  <div id="chart-less" class="chart-arrow" onclick="chart_less(document)"></div><div id="chart-page"></div><div id="chart-more" class="chart-arrow" onclick="chart_more(document)"></div>
                  <div id="chart-prompts" class="page-prompts"><div class="page-prompt"><span id="chart-confirm-key" class="prompt-key confirm-key"></span><span class="prompt-text" text-key="pause_menu.chart_select"></span></div><div class="page-prompt"><span id="chart-cancel-key" class="prompt-key cancel-key"></span><span class="prompt-text" text-key="common.cancel"></span></div></div>
                </div>
                <div id="chart-detail" class="player-native">
                  <div id="chart-detail-inset-0" class="player-inset"></div>
                  <div id="chart-detail-inset-1" class="player-inset"></div>
                  <div id="chart-detail-inset-2" class="player-inset"></div>
                  <div id="chart-detail-inset-3" class="player-inset"></div>
                  <div id="chart-detail-inset-4" class="player-inset"></div>
                  <div id="chart-detail-inset-5" class="player-inset"></div>
                  <div id="chart-detail-line-0" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-1" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-2" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-3" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-4" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-5" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-6" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-7" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-8" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-9" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-10" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-11" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-12" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-13" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-14" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-15" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-16" class="chart-detail-line hidden"></div>
                  <div id="chart-detail-line-17" class="chart-detail-line hidden"></div>
