					<button id="row-13" class="option hidden" onclick="row_confirm(document, 13)" onfocus="row_focus(document, 13)"><span class="label" id="row-13-label"></span><span class="control"><span class="arrow less" id="row-13-less" onclick="row_arrow(document, event, 13, -1)"></span><span class="bar" id="row-13-bar"><span class="fill" id="row-13-fill"></span></span><span class="value" id="row-13-value"></span><span class="arrow more" id="row-13-more" onclick="row_arrow(document, event, 13, 1)"></span></span></button>
					<button id="row-14" class="option hidden" onclick="row_confirm(document, 14)" onfocus="row_focus(document, 14)"><span class="label" id="row-14-label"></span><span class="control"><span class="arrow less" id="row-14-less" onclick="row_arrow(document, event, 14, -1)"></span><span class="bar" id="row-14-bar"><span class="fill" id="row-14-fill"></span></span><span class="value" id="row-14-value"></span><span class="arrow more" id="row-14-more" onclick="row_arrow(document, event, 14, 1)"></span></span></button>
					<button id="row-15" class="option hidden" onclick="row_confirm(document, 15)" onfocus="row_focus(document, 15)"><span class="label" id="row-15-label"></span><span class="control"><span class="arrow less" id="row-15-less" onclick="row_arrow(document, event, 15, -1)"></span><span class="bar" id="row-15-bar"><span class="fill" id="row-15-fill"></span></span><span class="value" id="row-15-value"></span><span class="arrow more" id="row-15-more" onclick="row_arrow(document, event, 15, 1)"></span></span></button>
					<button id="row-16" class="option hidden" onclick="row_confirm(document, 16)" onfocus="row_focus(document, 16)"><span class="label" id="row-16-label"></span><span class="control"><span class="arrow less" id="row-16-less" onclick="row_arrow(document, event, 16, -1)"></span><span class="bar" id="row-16-bar"><span class="fill" id="row-16-fill"></span></span><span class="value" id="row-16-value"></span><span class="arrow more" id="row-16-more" onclick="row_arrow(document, event, 16, 1)"></span></span></button>
