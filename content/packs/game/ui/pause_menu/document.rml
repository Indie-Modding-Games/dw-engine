				</div>
				<div id="option-info"><span id="option-tag" class="hidden"></span><span id="option-help"></span></div>
				<div id="option-foot">
					<div id="option-actions">
						<button id="options-reset" class="action" onclick="ask_reset(document)" onfocus="action_focus(document, 'reset')" text-key="pause_menu.options_reset"></button>
						<button id="options-back" class="back" onclick="back(document)" onfocus="action_focus(document, 'back')" text-key="common.back"></button>
					</div>
					<div id="options-hints">
						<span class="hint"><span class="key" id="hint-tab-previous"></span><span class="key" id="hint-tab-next"></span><span text-key="pause_menu.hint.tabs"></span></span>
						<span class="hint" id="hint-change"><span class="key arrow-key" id="hint-change-less"><span class="glyph-art"></span></span><span class="key arrow-key" id="hint-change-more"><span class="glyph-art"></span></span><span class="key pad-key" id="hint-change-pad-less"></span><span class="key pad-key" id="hint-change-pad-more"></span><span text-key="pause_menu.hint.change"></span></span>
						<span class="hint"><span class="key" id="hint-confirm"></span><span text-key="common.accept"></span></span>
						<span class="hint"><span class="key" id="hint-cancel"></span><span text-key="common.back"></span></span>
					</div>
				</div>
				<!-- «Reset to defaults» asks first; the question covers the list until it is answered. -->
				<div id="reset-confirm" class="hidden">
					<p id="reset-question"></p>
					<p id="reset-note" text-key="pause_menu.reset_note"></p>
					<div id="reset-buttons"><button id="reset-yes" onclick="confirm_reset(document)" text-key="pause_menu.reset_confirm"></button><button id="reset-no" onclick="close_reset(document)" text-key="common.cancel"></button></div>
				</div>
			</div>

			<div id="prompts">
				<span class="prompt"><span class="key" id="prompt-confirm"></span><span text-key="common.accept"></span></span>
				<span class="prompt"><span class="key" id="prompt-cancel"></span><span text-key="common.back"></span></span>
			</div>
		</div>
	</div>
	<div id="box-outline" class="box-outline hidden"></div>
</body>
</rml>
