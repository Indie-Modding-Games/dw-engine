<rml>
<head>
	<title>Pause menu</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="../common/ui_skin_choice.lua"></script>
	<script src="../common/original_box.lua"></script>
	<script src="../common/panel_enter.lua"></script>
	<script src="../common/game_options.lua"></script>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="scrim">
		<div id="panel">
			<h1 id="title"></h1>
			<h1 id="title-date"><span id="field-year-label" text-key="pause_menu.year_label"></span><span id="field-year-digits"><span id="field-year-1" class="date-digit"></span><span id="field-year-2" class="date-digit"></span><span id="field-year-3" class="date-digit"></span></span><span id="field-day-label" text-key="pause_menu.day_label"></span><span id="field-day-digits"><span id="field-day-1" class="date-digit"></span><span id="field-day-2" class="date-digit"></span></span><span id="field-season" class="hidden"></span><span id="field-date-separator"></span></h1>

			<div id="page-main" class="page">
				<button id="continue" class="menu-utility" autofocus="autofocus" onclick="resume()" text-key="pause_menu.continue"></button>
				<button id="open-minimap" class="menu-utility" onclick="open_page(document, 'minimap')" text-key="pause_menu.minimap"></button>
				<button id="open-options" class="menu-utility" onclick="open_page(document, 'options')" text-key="pause_menu.options"></button>
				<button id="open-items" class="field-entry" onclick="open_partner('items')"><span class="field-menu-focus"><span class="cursor-part cursor-left"></span><span class="cursor-part cursor-right"></span><span class="cursor-part cursor-top"></span><span class="cursor-part cursor-bottom"></span><span class="cursor-part cursor-tl"></span><span class="cursor-part cursor-tr"></span><span class="cursor-part cursor-bl"></span><span class="cursor-part cursor-br"></span></span><span class="field-menu-icon menu-item"></span><span class="menu-label menu-item-label" text-key="pause_menu.items"></span></button>
				<button id="open-partner" class="field-entry" onclick="open_partner('status')"><span class="field-menu-focus"><span class="cursor-part cursor-left"></span><span class="cursor-part cursor-right"></span><span class="cursor-part cursor-top"></span><span class="cursor-part cursor-bottom"></span><span class="cursor-part cursor-tl"></span><span class="cursor-part cursor-tr"></span><span class="cursor-part cursor-bl"></span><span class="cursor-part cursor-br"></span></span><span class="field-menu-icon menu-digimon"></span><span class="menu-label menu-digimon-label" text-key="pause_menu.digimon"></span></button>
				<button id="open-player" class="field-entry" onclick="open_player(document)"><span class="field-menu-focus"><span class="cursor-part cursor-left"></span><span class="cursor-part cursor-right"></span><span class="cursor-part cursor-top"></span><span class="cursor-part cursor-bottom"></span><span class="cursor-part cursor-tl"></span><span class="cursor-part cursor-tr"></span><span class="cursor-part cursor-bl"></span><span class="cursor-part cursor-br"></span></span><span class="field-menu-icon menu-player"></span><span class="menu-label menu-player-label" text-key="pause_menu.player"></span></button>
				<button id="praise" class="field-entry" onclick="ui.send('praise')"><span class="field-menu-focus"><span class="cursor-part cursor-left"></span><span class="cursor-part cursor-right"></span><span class="cursor-part cursor-top"></span><span class="cursor-part cursor-bottom"></span><span class="cursor-part cursor-tl"></span><span class="cursor-part cursor-tr"></span><span class="cursor-part cursor-bl"></span><span class="cursor-part cursor-br"></span></span><span class="field-menu-icon menu-praise"></span><span class="menu-label menu-praise-label" text-key="pause_menu.praise"></span></button>
				<button id="scold" class="field-entry" onclick="ui.send('scold')"><span class="field-menu-focus"><span class="cursor-part cursor-left"></span><span class="cursor-part cursor-right"></span><span class="cursor-part cursor-top"></span><span class="cursor-part cursor-bottom"></span><span class="cursor-part cursor-tl"></span><span class="cursor-part cursor-tr"></span><span class="cursor-part cursor-bl"></span><span class="cursor-part cursor-br"></span></span><span class="field-menu-icon menu-scold"></span><span class="menu-label menu-scold-label" text-key="pause_menu.scold"></span></button>
				<button id="sleep" class="field-entry" onclick="sleep()"><span class="field-menu-focus"><span class="cursor-part cursor-left"></span><span class="cursor-part cursor-right"></span><span class="cursor-part cursor-top"></span><span class="cursor-part cursor-bottom"></span><span class="cursor-part cursor-tl"></span><span class="cursor-part cursor-tr"></span><span class="cursor-part cursor-bl"></span><span class="cursor-part cursor-br"></span></span><span class="field-menu-icon menu-sleep"></span><span class="menu-label menu-sleep-label" text-key="pause_menu.sleep"></span></button>
				<button id="fish" class="field-entry hidden" onclick="fish()"><span class="field-menu-focus"><span class="cursor-part cursor-left"></span><span class="cursor-part cursor-right"></span><span class="cursor-part cursor-top"></span><span class="cursor-part cursor-bottom"></span><span class="cursor-part cursor-tl"></span><span class="cursor-part cursor-tr"></span><span class="cursor-part cursor-bl"></span><span class="cursor-part cursor-br"></span></span><span class="field-menu-icon menu-fish"></span><span class="menu-label menu-fish-label" text-key="pause_menu.fish"></span></button>
				<button id="quick-save" class="menu-utility" onclick="ui.send('quick_save')" text-key="pause_menu.quick_save"></button>
				<button id="to-title" class="menu-utility" onclick="ui.send('to_title')" text-key="pause_menu.to_title"></button>
				<button id="quit" class="menu-utility" onclick="ui.send('quit')" text-key="pause_menu.quit"></button>
			</div>

			<div id="page-player" class="page hidden">
                <div id="player-tabs" class="player-native">
                  <button id="player-tab-player" class="player-tab selected" onclick="show_player_tab(document, 'player')"><span class="player-tab-left"></span><span class="player-tab-middle"></span><span class="player-tab-right"></span><span class="player-tab-label" text-key="pause_menu.player"></span></button>
                  <button id="player-tab-chart" class="player-tab" onclick="show_player_tab(document, 'chart')"><span class="player-tab-left"></span><span class="player-tab-middle"></span><span class="player-tab-right"></span><span class="player-tab-label" text-key="pause_menu.player_tab_chart"></span></button>
                  <button id="player-tab-medals" class="player-tab" onclick="show_player_tab(document, 'medals')"><span class="player-tab-left"></span><span class="player-tab-middle"></span><span class="player-tab-right"></span><span class="player-tab-label" text-key="pause_menu.player_tab_medals"></span></button>
                  <button id="player-tab-card" class="player-tab" onclick="show_player_tab(document, 'card')"><span class="player-tab-left"></span><span class="player-tab-middle"></span><span class="player-tab-right"></span><span class="player-tab-label" text-key="pause_menu.player_tab_card"></span></button>
                  <button id="player-tab-city" class="player-tab" onclick="show_player_tab(document, 'city')"><span class="player-tab-left"></span><span class="player-tab-middle"></span><span class="player-tab-right"></span><span class="player-tab-label" text-key="pause_menu.player_tab_city"></span></button>
                </div>
                <div id="player-profile">
                <div id="player-portrait-clip" class="player-native"><img id="player-portrait" src="/runtime/player-portrait"/></div>
                <div id="player-name-box" class="player-inset player-native"></div>
                <div id="player-level-box" class="player-inset player-native"></div>
                <div id="player-rank-box" class="player-inset player-native"></div>
                <div id="player-raised-box" class="player-inset player-native"></div>
                <div id="player-bits-box" class="player-inset player-native"></div>
                <div id="player-time-box" class="player-inset player-native"></div>
                <div id="player-medals-box" class="player-inset player-native"></div>
                <div id="player-item-box-0" class="player-inset player-item-box player-native"><div id="player-item-0" class="player-item-icon hidden"></div></div><div id="player-item-box-1" class="player-inset player-item-box player-native"><div id="player-item-1" class="player-item-icon hidden"></div></div><div id="player-item-box-2" class="player-inset player-item-box player-native"><div id="player-item-2" class="player-item-icon hidden"></div></div><div id="player-item-box-3" class="player-inset player-item-box player-native"><div id="player-item-3" class="player-item-icon hidden"></div></div>
                <div id="player-header-line" class="player-separator player-native"><span class="rule-first"></span><span class="rule-light"></span><span class="rule-last"></span></div><div id="player-vertical-line" class="player-separator player-native"><span class="rule-first"></span><span class="rule-light"></span><span class="rule-last"></span><span class="rule-tail"></span></div><div id="player-items-line" class="player-separator player-native"><span class="rule-first"></span><span class="rule-light"></span><span class="rule-last"></span></div>
                <div id="player-raised-line" class="player-line player-native"><span text-key="pause_menu.player_raised"></span><span class="player-value" id="player-raised"></span></div>
                <div id="player-items-line-label" class="player-line player-native"><span text-key="pause_menu.player_items"></span></div>
                <div id="player-medals-line" class="player-line player-native"><span text-key="pause_menu.player_medals"></span><span class="player-value" id="player-medals"></span></div>
				<div class="player-line" id="player-name-line"><span text-key="pause_menu.player_name"></span><span class="player-value" id="player-name"></span></div>
				<div class="player-line" id="player-level-line"><span text-key="pause_menu.player_level"></span><span class="player-value" id="player-level"></span><span class="player-rank" id="player-rank"></span></div>
				<div class="player-line" id="player-bits-line"><span text-key="pause_menu.player_bits"></span><span class="player-value" id="player-bits"></span></div>
				<div class="player-line" id="player-time-line"><span text-key="pause_menu.player_time"></span><span class="player-value" id="player-time"></span></div>
                </div>
                <div id="player-chart" class="player-native" onmousescroll="chart_wheel(document, event)">
                  <div id="chart-clip"><div id="chart-pages">
                    <div class="chart-stage stage-0" id="chart-stage-0"></div><div class="chart-stage stage-1" id="chart-stage-1"></div><div class="chart-stage stage-2" id="chart-stage-2"></div><div class="chart-stage stage-3" id="chart-stage-3"></div><div class="chart-stage stage-4" id="chart-stage-4"></div><div class="chart-stage stage-5" id="chart-stage-5"></div>
                    <div class="chart-stage stage-0 off-page" id="chart-stage-other-0"></div><div class="chart-stage stage-1 off-page" id="chart-stage-other-1"></div><div class="chart-stage stage-2 off-page" id="chart-stage-other-2"></div><div class="chart-stage stage-3 off-page" id="chart-stage-other-3"></div><div class="chart-stage stage-4 off-page" id="chart-stage-other-4"></div><div class="chart-stage stage-5 off-page" id="chart-stage-other-5"></div>
                    <button id="chart-cell-0" class="chart-cell hidden" onclick="chart_pick(document, 0)"><img id="chart-icon-0" class="chart-icon hidden"/></button>
                    <button id="chart-cell-1" class="chart-cell hidden" onclick="chart_pick(document, 1)"><img id="chart-icon-1" class="chart-icon hidden"/></button>
                    <button id="chart-cell-2" class="chart-cell hidden" onclick="chart_pick(document, 2)"><img id="chart-icon-2" class="chart-icon hidden"/></button>
                    <button id="chart-cell-3" class="chart-cell hidden" onclick="chart_pick(document, 3)"><img id="chart-icon-3" class="chart-icon hidden"/></button>
                    <button id="chart-cell-4" class="chart-cell hidden" onclick="chart_pick(document, 4)"><img id="chart-icon-4" class="chart-icon hidden"/></button>
                    <button id="chart-cell-5" class="chart-cell hidden" onclick="chart_pick(document, 5)"><img id="chart-icon-5" class="chart-icon hidden"/></button>
                    <button id="chart-cell-6" class="chart-cell hidden" onclick="chart_pick(document, 6)"><img id="chart-icon-6" class="chart-icon hidden"/></button>
                    <button id="chart-cell-7" class="chart-cell hidden" onclick="chart_pick(document, 7)"><img id="chart-icon-7" class="chart-icon hidden"/></button>
                    <button id="chart-cell-8" class="chart-cell hidden" onclick="chart_pick(document, 8)"><img id="chart-icon-8" class="chart-icon hidden"/></button>
                    <button id="chart-cell-9" class="chart-cell hidden" onclick="chart_pick(document, 9)"><img id="chart-icon-9" class="chart-icon hidden"/></button>
