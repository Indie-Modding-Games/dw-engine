<rml>
<head>
	<title>Pause menu</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="../common/ui_skin_choice.lua"></script>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="scrim">
		<div id="panel">
			<h1 id="title"></h1>
			<h1 id="title-date"></h1>

			<div id="page-main" class="page">
				<button id="continue" autofocus="autofocus" onclick="resume()" text-key="pause_menu.continue"></button>
				<button id="open-minimap" onclick="open_page(document, 'minimap')" text-key="pause_menu.minimap"></button>
				<button id="open-options" onclick="open_page(document, 'options')" text-key="pause_menu.options"></button>
				<button id="open-partner" onclick="ui.send('open_partner_menu')" text-key="pause_menu.partner"></button>
				<button id="praise" onclick="ui.send('praise')" text-key="pause_menu.praise"></button>
				<button id="scold" onclick="ui.send('scold')" text-key="pause_menu.scold"></button>
				<button id="sleep" onclick="sleep()" text-key="pause_menu.sleep"></button>
				<button id="fish" class="hidden" onclick="fish()" text-key="pause_menu.fish"></button>
				<button id="to-title" onclick="ui.send('to_title')" text-key="pause_menu.to_title"></button>
				<button id="quit" onclick="ui.send('quit')" text-key="pause_menu.quit"></button>
			</div>

			<div id="page-minimap" class="page hidden">
				<button id="minimap-mode" class="option" onclick="adjust(document, 'minimap-mode', 1)">
					<span class="label" text-key="pause_menu.minimap_mode"></span><span class="value" id="minimap-mode-value"></span>
				</button>
				<button id="minimap-size" class="option" onclick="adjust(document, 'minimap-size', 1)">
					<span class="label" text-key="pause_menu.minimap_size"></span><span class="value" id="minimap-size-value"></span>
				</button>
				<button id="minimap-back" class="back" onclick="back(document)" text-key="common.back"></button>
			</div>

			<div id="page-options" class="page hidden">
				<button id="display-mode" class="option" onclick="adjust(document, 'display-mode', 1)">
					<span class="label" text-key="pause_menu.display_mode"></span><span class="value" id="display-mode-value"></span>
				</button>
				<button id="ui-scale" class="option" onclick="adjust(document, 'ui-scale', 1)">
					<span class="label" text-key="pause_menu.ui_scale"></span><span class="value" id="ui-scale-value"></span>
				</button>
				<button id="vsync" class="option" onclick="adjust(document, 'vsync', 1)">
					<span class="label" text-key="pause_menu.vsync"></span><span class="value" id="vsync-value"></span>
				</button>
				<button id="ui-skin" class="option" onclick="adjust(document, 'ui-skin', 1)">
					<span class="label" text-key="pause_menu.ui_skin"></span><span class="value" id="ui-skin-value"></span>
				</button>
				<button id="free-exploration" class="option" onclick="adjust(document, 'free-exploration', 1)">
					<span class="label" text-key="pause_menu.free_exploration"></span><span class="value" id="free-exploration-value"></span>
				</button>
				<button id="options-back" class="back" onclick="back(document)" text-key="common.back"></button>
			</div>

			<div id="prompts">
				<span class="prompt"><span class="key" id="prompt-confirm"></span><span text-key="common.accept"></span></span>
				<span class="prompt"><span class="key" id="prompt-cancel"></span><span text-key="common.back"></span></span>
			</div>
		</div>
	</div>
</body>
</rml>
