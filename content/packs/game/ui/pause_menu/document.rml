                    <button id="chart-cell-12" class="chart-cell hidden" onclick="chart_pick(document, 12)"><img id="chart-icon-12" class="chart-icon hidden"/></button>
                    <button id="chart-cell-13" class="chart-cell hidden" onclick="chart_pick(document, 13)"><img id="chart-icon-13" class="chart-icon hidden"/></button>
                    <button id="chart-cell-14" class="chart-cell hidden" onclick="chart_pick(document, 14)"><img id="chart-icon-14" class="chart-icon hidden"/></button>
                    <button id="chart-cell-15" class="chart-cell hidden" onclick="chart_pick(document, 15)"><img id="chart-icon-15" class="chart-icon hidden"/></button>
                    <button id="chart-cell-16" class="chart-cell hidden" onclick="chart_pick(document, 16)"><img id="chart-icon-16" class="chart-icon hidden"/></button>
                    <button id="chart-cell-17" class="chart-cell hidden" onclick="chart_pick(document, 17)"><img id="chart-icon-17" class="chart-icon hidden"/></button>
                    <button id="chart-cell-18" class="chart-cell hidden" onclick="chart_pick(document, 18)"><img id="chart-icon-18" class="chart-icon hidden"/></button>
                    <button id="chart-cell-19" class="chart-cell hidden" onclick="chart_pick(document, 19)"><img id="chart-icon-19" class="chart-icon hidden"/></button>
                    <button id="chart-cell-20" class="chart-cell hidden" onclick="chart_pick(document, 20)"><img id="chart-icon-20" class="chart-icon hidden"/></button>
                    <button id="chart-cell-21" class="chart-cell hidden" onclick="chart_pick(document, 21)"><img id="chart-icon-21" class="chart-icon hidden"/></button>
                    <button id="chart-cell-22" class="chart-cell hidden" onclick="chart_pick(document, 22)"><img id="chart-icon-22" class="chart-icon hidden"/></button>
                    <button id="chart-cell-23" class="chart-cell hidden" onclick="chart_pick(document, 23)"><img id="chart-icon-23" class="chart-icon hidden"/></button>
                    <button id="chart-cell-24" class="chart-cell hidden" onclick="chart_pick(document, 24)"><img id="chart-icon-24" class="chart-icon hidden"/></button>
                    <button id="chart-cell-25" class="chart-cell hidden" onclick="chart_pick(document, 25)"><img id="chart-icon-25" class="chart-icon hidden"/></button>
                    <button id="chart-cell-26" class="chart-cell hidden" onclick="chart_pick(document, 26)"><img id="chart-icon-26" class="chart-icon hidden"/></button>
                    <button id="chart-cell-27" class="chart-cell hidden" onclick="chart_pick(document, 27)"><img id="chart-icon-27" class="chart-icon hidden"/></button>
                    <button id="chart-cell-28" class="chart-cell hidden" onclick="chart_pick(document, 28)"><img id="chart-icon-28" class="chart-icon hidden"/></button>
                    <button id="chart-cell-29" class="chart-cell hidden" onclick="chart_pick(document, 29)"><img id="chart-icon-29" class="chart-icon hidden"/></button>
                    <button id="chart-cell-30" class="chart-cell hidden" onclick="chart_pick(document, 30)"><img id="chart-icon-30" class="chart-icon hidden"/></button>
                    <button id="chart-cell-31" class="chart-cell hidden" onclick="chart_pick(document, 31)"><img id="chart-icon-31" class="chart-icon hidden"/></button>
                    <button id="chart-cell-32" class="chart-cell hidden" onclick="chart_pick(document, 32)"><img id="chart-icon-32" class="chart-icon hidden"/></button>
                    <button id="chart-cell-33" class="chart-cell hidden" onclick="chart_pick(document, 33)"><img id="chart-icon-33" class="chart-icon hidden"/></button>
                    <button id="chart-cell-34" class="chart-cell hidden" onclick="chart_pick(document, 34)"><img id="chart-icon-34" class="chart-icon hidden"/></button>
                    <button id="chart-cell-35" class="chart-cell hidden" onclick="chart_pick(document, 35)"><img id="chart-icon-35" class="chart-icon hidden"/></button>
                    <button id="chart-cell-36" class="chart-cell hidden" onclick="chart_pick(document, 36)"><img id="chart-icon-36" class="chart-icon hidden"/></button>
                    <button id="chart-cell-37" class="chart-cell hidden" onclick="chart_pick(document, 37)"><img id="chart-icon-37" class="chart-icon hidden"/></button>
