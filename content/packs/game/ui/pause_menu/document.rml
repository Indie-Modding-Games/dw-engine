                  <button id="chart-cell-60" class="chart-cell hidden" onclick="chart_pick(document, 60)"><img id="chart-icon-60" class="chart-icon hidden"/></button>
                  <img id="chart-cursor" class="hidden" src="/texture/etcdat/sboy?palette=15" rect="0 232 24 20"/>
                  <div id="chart-select-help"><span id="chart-cross"></span><span class="chart-help-text" text-key="pause_menu.chart_select"></span></div>
                  <div id="chart-cancel-help"><span id="chart-triangle"></span><span class="chart-help-text" text-key="common.cancel"></span></div>
