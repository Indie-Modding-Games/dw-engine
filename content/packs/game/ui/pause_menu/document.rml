                  </div></div>
                  <div id="chart-more" onclick="chart_more(document)"></div>
                  <div id="chart-prompts" class="page-prompts"><div class="page-prompt"><span id="chart-confirm-key" class="prompt-key confirm-key"></span><span class="prompt-text" text-key="pause_menu.chart_select"></span></div><div class="page-prompt"><span id="chart-cancel-key" class="prompt-key cancel-key"></span><span class="prompt-text" text-key="common.cancel"></span></div></div>
                </div>
                <div id="chart-detail" class="player-native">
                  <div id="chart-detail-inset-0" class="player-inset"></div>
                  <div id="chart-detail-inset-1" class="player-inset"></div>
                  <div id="chart-detail-inset-2" class="player-inset"></div>
                  <div id="chart-detail-inset-3" class="player-inset"></div>
