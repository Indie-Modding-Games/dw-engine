/* How the pause menu behaves whatever the skin: each page's list wraps around, up from the first entry to the last
   and down from the last to the first. The look is the skin's (docs/architecture/ui.md#aspectos). */

#continue { nav-up: #quit; }
#quit { nav-down: #continue; }
#minimap-mode { nav-up: #minimap-back; }
#minimap-back { nav-down: #minimap-mode; }
/* The options page (logic.lua: show_tab): its list wraps round as the others, through the nav-up of its first row and
   the nav-down of Back, which the tab shown sets. The tabs and the key glyphs beside them answer clicks but are not in the
   keyboard's order, so up and down only walk the rows. Only the parts a row's kind uses show: the arrows of a list or a number,
   the bar of a number. The reset's question takes the input until it is answered (logic.lua: options_action): the list
   under it takes no pointer. */
.option-tab, .tab-key { tab-index: none; }
#page-options .option .arrow, #page-options .option .bar { display: none; }
#page-options .option.kind-list .arrow, #page-options .option.kind-range .arrow { display: inline-block; }
#page-options .option.kind-range .bar { display: inline-block; }
#page-options .option.hidden, #option-tag.hidden, #reset-confirm.hidden { display: none; }
#panel.on-options #prompts { display: none; }
#panel.reset-open #option-list, #panel.reset-open #menu-tabs, #panel.reset-open #option-actions { pointer-events: none; }
/* The change hint shows the keyboard's arrows, or on a pad the glyphs of its directions. */
.arrow-key .glyph-art { decorator: image(/glyph/modern/@left); }
#hint-change-more .glyph-art { decorator: image(/glyph/modern/@right); }
#hint-change .pad-key, #hint-change.pad .arrow-key { display: none; }
#hint-change.pad .pad-key { display: inline-block; }
/* Sleep is greyed while the partner is not sleepy, as in the original. */
#sleep.unavailable { opacity: 0.45; focus: none; tab-index: none; }
#fish.unavailable { opacity: 0.45; focus: none; tab-index: none; }
/* The date over the main page is the original look's; other skins keep the page title. */
#title-date { display: none; }
/* The calendar's season next to the day (the Seasons option): only the modern skin shows it. */
#field-season.hidden { display: none; }
.field-menu-icon { display: none; }
.player-line { margin: 9dp 0; }
.player-value { float: right; }

.field-menu-focus { display: none; pointer-events: none; }

.player-rank { display: none; }

.player-native { display: none; }

#chart-detail { display: none; }

#chart-detail-transition { display: none; }

#player-medals-view { display: none; }
#medal-figure { display: none; }
#player-cards-view { display: none; }

/* The player page's City tab (a dwe addition): shown while the panel has the class "player-city"; each skin places it. */
#player-city-view { display: none; }
#panel.player-city #player-city-view { display: block; }
.city-cell.hidden, #city-cursor.hidden, .city-icon.hidden { display: none; }
