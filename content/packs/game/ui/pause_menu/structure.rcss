/* How the pause menu behaves whatever the skin: each page's list wraps around, up from the first entry to the last
   and down from the last to the first. The look is the skin's (docs/architecture/ui.md#aspectos). */

#continue { nav-up: #quit; }
#quit { nav-down: #continue; }
#minimap-mode { nav-up: #minimap-back; }
#minimap-back { nav-down: #minimap-mode; }
#display-mode { nav-up: #options-back; }
#options-back { nav-down: #display-mode; }
/* Sleep is greyed while the partner is not sleepy, as in the original. */
#sleep.unavailable { opacity: 0.45; focus: none; tab-index: none; }
#fish.unavailable { opacity: 0.45; focus: none; tab-index: none; }
/* The date over the main page is the original look's; other skins keep the page title. */
#title-date { display: none; }
.field-menu-icon { display: none; }
.player-line { margin: 9dp 0; }
.player-value { float: right; }

.field-menu-focus { display: none; pointer-events: none; }
