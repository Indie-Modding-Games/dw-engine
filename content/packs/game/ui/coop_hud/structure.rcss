/* The co-op game's own HUD (apps/game/src/coop_hud.hpp): the other player's name over their head, and a notice at the
   top of the screen. This is the plain look; each skin restyles it (skins/<skin>/coop_hud/style.rcss). It takes no
   input. Over the field and the title, under the interface's own notice (ui_notice). */
body {
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: 105;
}

/* Anchored at its bottom centre on the point over the head. */
.tag {
	position: absolute;
	transform: translate(-50%, -100%);
	padding: 2dp 8dp;
	border-radius: 6dp;
	background-color: #1a1f27c0;
	color: #f2f4f7;
	font-size: 16dp;
	white-space: nowrap;
}

/* The trade key's hint under a name. */
.tag .trade {
	display: block;
	font-size: 13dp;
	color: #ffd479;
	text-align: center;
}

/* The line that says the player trains at the gym (#365). */
.tag .training {
	display: block;
	font-size: 13dp;
	color: #8fd8ff;
	text-align: center;
}

/* The class rules above outrank .hidden on their own. */
.tag .trade.hidden,
.tag .training.hidden {
	display: none;
}

#notice {
	position: absolute;
	left: 15%;
	right: 15%;
	top: 24dp;
	padding: 10dp 18dp;
	border: 3dp #c9d3de;
	border-radius: 8dp;
	background-color: #1a1f27f0;
	color: #f2f4f7;
	text-align: center;
	font-size: 20dp;
}

@media (max-width: 560dp) {
	#notice { left: 3%; right: 3%; top: 8dp; }
}
