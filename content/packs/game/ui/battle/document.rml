			</div>
			<p id="bag-description" class="original-look"></p>
		</div>

		<p id="item-in-flight" class="original-look hidden" text-key="battle.item_in_flight"></p>

		<div id="prompts">
			<span class="prompt"><span class="key" id="prompt-confirm"></span><span text-key="battle.prompt.command"></span></span>
			<span class="prompt" id="prompt-bag"><span class="key" id="prompt-cancel"></span><span text-key="battle.prompt.bag"></span></span>
		</div>
	</div>

