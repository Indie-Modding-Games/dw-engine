			<div id="command-frame-9" class="command-frame hidden"></div>
			<div id="command-frame-10" class="command-frame hidden"></div>
			<div id="command-row">
				<button id="command-0" class="command original-look hidden" onclick="choose(0)"></button>
				<button id="command-1" class="command original-look hidden" onclick="choose(1)"></button>
				<button id="command-2" class="command original-look hidden" onclick="choose(2)"></button>
				<button id="command-3" class="command original-look hidden" onclick="choose(3)"></button>
