				<div class="bar-row" id="fighter-1-hp-row"><span class="bar-label original-look" id="fighter-1-hp-label"></span><div class="bar hp"><div class="fill" id="fighter-1-hp-fill"></div></div><span class="bar-value original-look" id="fighter-1-hp"></span></div>
			</div>
