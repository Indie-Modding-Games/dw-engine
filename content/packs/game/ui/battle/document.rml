				<button id="command-10" class="command original-look hidden" onclick="choose(10)"></button>
				<button id="open-bag" class="command bag-button" onclick="open_bag()" text-key="battle.bag.open"></button>
			</div>
			<div id="command-cursor" class="hidden"></div>
			<p id="command-name" class="original-look"></p>
		</div>

		<div id="enemies">
