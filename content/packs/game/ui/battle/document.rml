				<div class="bar-row"><span class="bar-label original-look" id="fighter-0-hp-label"></span><div class="bar hp"><div class="fill" id="fighter-0-hp-fill"></div></div><span class="bar-value original-look" id="fighter-0-hp"></span></div>
				<div class="bar-row"><span class="bar-label original-look" id="fighter-0-mp-label"></span><div class="bar mp"><div class="fill" id="fighter-0-mp-fill"></div></div><span class="bar-value original-look" id="fighter-0-mp"></span></div>
			</div>
			<div id="finisher">
				<span class="original-look" id="finisher-label" text-key="battle.finisher"></span>
				<div id="finisher-segments"><div class="segment" id="finisher-0"></div><div class="segment" id="finisher-1"></div><div class="segment" id="finisher-2"></div><div class="segment" id="finisher-3"></div><div class="segment" id="finisher-4"></div><div class="segment" id="finisher-5"></div><div class="segment extra" id="finisher-6"></div><div class="segment extra" id="finisher-7"></div></div>
				<div id="finisher-ready"><span class="key" id="prompt-finisher"></span><div id="finisher-push"></div></div>
			</div>
		</div>

		<div id="charge" class="hidden" onclick="charge()">
			<p class="original-look" id="charge-title" text-key="battle.charge"></p>
			<div class="bar charge"><div class="fill" id="charge-fill"></div></div>
			<p class="charge-hint"><span class="key" id="prompt-charge"></span><span text-key="battle.charge_hint"></span></p>
		</div>

		<p id="revive" class="original-look hidden"></p>

		<p id="item-in-flight" class="original-look hidden" text-key="battle.item_in_flight"></p>

		<div id="prompts">
