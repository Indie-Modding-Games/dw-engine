<rml>
<head>
	<title>Merit shop</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="frame">
		<div id="points-box" class="original-box original-look hidden">
			<div class="points-row" id="points-label"></div>
			<div class="points-row" id="points-value"></div>
		</div>
		<div id="window" class="original-box">
			<div class="label label-menu" text-key="list_labels.menu"></div><div class="label label-count" text-key="list_labels.count"></div><div class="label label-point" text-key="list_labels.point"></div>
			<div class="cursor" id="cursor"></div>
			<div class="row" id="row-0"><div class="rarity hidden" id="rarity-0"></div><img class="icon hidden" id="icon-0"/><span class="name" id="name-0"></span><span class="value" id="value-0"></span></div><div class="row" id="row-1"><div class="rarity hidden" id="rarity-1"></div><img class="icon hidden" id="icon-1"/><span class="name" id="name-1"></span><span class="value" id="value-1"></span></div><div class="row" id="row-2"><div class="rarity hidden" id="rarity-2"></div><img class="icon hidden" id="icon-2"/><span class="name" id="name-2"></span><span class="value" id="value-2"></span></div><div class="row" id="row-3"><div class="rarity hidden" id="rarity-3"></div><img class="icon hidden" id="icon-3"/><span class="name" id="name-3"></span><span class="value" id="value-3"></span></div><div class="row" id="row-4"><div class="rarity hidden" id="rarity-4"></div><img class="icon hidden" id="icon-4"/><span class="name" id="name-4"></span><span class="value" id="value-4"></span></div><div class="row" id="row-5"><div class="rarity hidden" id="rarity-5"></div><img class="icon hidden" id="icon-5"/><span class="name" id="name-5"></span><span class="value" id="value-5"></span></div>
			<div class="scrollbar"><div class="thumb" id="thumb"></div></div>
		</div>
		<div id="talk" class="original-box original-look">
			<div class="talk-row speaker" id="speaker"></div>
			<div class="talk-row" id="talk-0"><span class="run" id="talk-run-0"></span></div>
			<div class="talk-row" id="talk-1"><span class="run" id="talk-run-1"></span></div>
			<div class="talk-row" id="talk-2"><span class="run" id="talk-run-2"></span></div>
		</div>
	</div>
</body>
</rml>
