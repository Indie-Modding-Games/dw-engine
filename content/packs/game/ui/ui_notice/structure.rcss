/* The notice that the game's own UI came back: a box at the top of the screen, over every other document, that
   takes no input. Its look is its own, whatever the skin, so it reads on any of them. */
body {
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: 110;
}

#box {
	position: absolute;
	left: 10%;
	right: 10%;
	top: 24dp;
	padding: 12dp 18dp;
	border: 3dp #c9d3de;
	border-radius: 8dp;
	background-color: #1a1f27f0;
	color: #f2f4f7;
	text-align: center;
}

#title {
	font-size: 24dp;
}

#reason {
	margin-top: 6dp;
	font-size: 16dp;
	color: #c9d3de;
}
