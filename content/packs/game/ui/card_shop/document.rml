<rml>
<head>
	<title>Card shop</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="frame">
		<div id="window" class="original-box">
			<div class="label label-menu"></div><div class="label label-price"></div><div class="label label-count"></div>
			<div class="cursor" id="cursor"></div>
			<div class="row" id="row-0"><div class="rarity hidden" id="rarity-0"></div><span class="name" id="name-0"></span><span class="price" id="price-0"></span><span class="count" id="count-0"></span></div><div class="row" id="row-1"><div class="rarity hidden" id="rarity-1"></div><span class="name" id="name-1"></span><span class="price" id="price-1"></span><span class="count" id="count-1"></span></div><div class="row" id="row-2"><div class="rarity hidden" id="rarity-2"></div><span class="name" id="name-2"></span><span class="price" id="price-2"></span><span class="count" id="count-2"></span></div><div class="row" id="row-3"><div class="rarity hidden" id="rarity-3"></div><span class="name" id="name-3"></span><span class="price" id="price-3"></span><span class="count" id="count-3"></span></div><div class="row" id="row-4"><div class="rarity hidden" id="rarity-4"></div><span class="name" id="name-4"></span><span class="price" id="price-4"></span><span class="count" id="count-4"></span></div><div class="row" id="row-5"><div class="rarity hidden" id="rarity-5"></div><span class="name" id="name-5"></span><span class="price" id="price-5"></span><span class="count" id="count-5"></span></div>
			<div class="scrollbar"><div class="thumb" id="thumb"></div></div>
		</div>
		<div id="talk" class="original-box original-look">
			<div class="talk-row speaker" id="speaker"></div>
			<div class="talk-row" id="talk-0"></div>
			<div class="talk-row" id="talk-1"></div>
			<div class="talk-row" id="talk-2"></div>
		</div>
		<div id="confirm" class="original-box original-look">
			<div id="question"></div>
			<div class="answer" id="yes"></div>
			<div class="answer" id="no"></div>
		</div>
		<div id="amount" class="original-box original-look">
			<div class="rarity" id="amount-rarity"></div>
			<div id="amount-name"></div>
			<div class="rule" id="amount-rule-top"></div>
			<div id="amount-price"></div>
			<div id="amount-inset"></div>
			<div id="amount-value"></div>
			<div class="rule" id="amount-rule-bottom"></div>
			<div id="amount-total"></div>
		</div>
	</div>
</body>
</rml>
