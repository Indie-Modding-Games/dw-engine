<rml>
<head>
	<title>Bird transport</title>
	<link type="text/rcss" href="../common/base.rcss"/>
	<link type="text/rcss" href="structure.rcss"/>
	<script src="logic.lua"></script>
</head>
<body>
	<div id="frame">
		<div id="bits-box" class="original-box original-look">
			<div class="bits-row" id="bits-label"></div>
			<div class="bits-row" id="bits-value"></div>
		</div>
		<div id="window" class="original-box">
			<div class="label label-place"></div><div class="label label-point"></div>
			<div id="rule"></div>
			<div id="track"></div><div id="bar"></div>
			<div class="cursor" id="cursor"></div>
			<div class="row" id="row-0"><span class="name" id="name-0"></span><span class="cost" id="cost-0"></span></div>
			<div class="row" id="row-1"><span class="name" id="name-1"></span><span class="cost" id="cost-1"></span></div>
			<div class="row" id="row-2"><span class="name" id="name-2"></span><span class="cost" id="cost-2"></span></div>
			<div class="row" id="row-3"><span class="name" id="name-3"></span><span class="cost" id="cost-3"></span></div>
			<div class="row" id="row-4"><span class="name" id="name-4"></span><span class="cost" id="cost-4"></span></div>
			<div class="row" id="row-5"><span class="name" id="name-5"></span><span class="cost" id="cost-5"></span></div>
		</div>
		<div id="talk" class="original-box original-look">
			<div class="talk-row speaker" id="speaker"></div>
			<div class="talk-row" id="talk-0"><span class="run" id="talk-run-0"></span></div>
			<div class="talk-row" id="talk-1"><span class="run" id="talk-run-1"></span></div>
			<div class="talk-row" id="talk-2"><span class="run" id="talk-run-2"></span></div>
		</div>
	</div>
</body>
</rml>
