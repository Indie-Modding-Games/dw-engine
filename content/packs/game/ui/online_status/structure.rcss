/* Getting into a room and why it failed, whatever the skin: one panel in the middle of the window (kept inside it by
   common/screen_fit.lua) with the title, the waiting dots or nothing, the text, a smaller line under it, and the
   buttons. The skins give the look (ui/skins/<id>/online_status/); the plain colours here are the fallback of a skin
   without a sheet for it. */

#scrim {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: #08121ef2;
}

#panel {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 680dp;
	height: 340dp;
	margin-left: -340dp;
	margin-top: -170dp;
	box-sizing: border-box;
	padding: 16dp 24dp;
	border: 2dp #5c91bd;
	background-color: #0c1d2ee8;
}

#title {
	margin: 0 0 10dp 0;
	font-size: 33dp;
	line-height: 48dp;
	white-space: nowrap;
}

#status-icon {
	height: 20dp;
	margin: 6dp 0 10dp 0;
	text-align: center;
}

.dot {
	display: inline-block;
	width: 14dp;
	height: 14dp;
	margin: 0 8dp;
	background-color: #2c4a68;
}

.dot.lit { background-color: #efc63c; }

#status-text {
	margin: 0;
	font-size: 24dp;
	line-height: 32dp;
}

.closed #status-text { color: #ffb070; }

#status-detail {
	margin: 8dp 0 0 0;
	font-size: 18dp;
	line-height: 24dp;
	opacity: 0.75;
}

#buttons {
	position: absolute;
	left: 24dp;
	right: 24dp;
	bottom: 56dp;
	text-align: center;
}

.status-button {
	display: inline-block;
	width: 220dp;
	height: 44dp;
	margin: 0 10dp;
	font-size: 22dp;
	line-height: 44dp;
	text-align: center;
}

#prompts {
	position: absolute;
	left: 24dp;
	right: 24dp;
	bottom: 12dp;
	font-size: 18dp;
	white-space: nowrap;
}

.prompt { margin-right: 14dp; }

/* A hidden button is hidden, whatever its display above. */
.status-button.hidden { display: none; }
