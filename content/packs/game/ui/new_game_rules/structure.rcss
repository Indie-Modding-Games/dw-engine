/* How the new game's rules behave whatever the skin: the list wraps around. The look is the pause menu's (the skins'
   pause_menu style). */

#rules-all { nav-up: #back; }
#back { nav-down: #rules-all; }
#title { margin-bottom: 6dp; }
.about { margin: 0 0 12dp 18dp; }
/* The title picture filling the window (../common/title_picture.lua): only a skin that draws it shows it. */
#picture, .picture-fade { display: none; pointer-events: none; }
