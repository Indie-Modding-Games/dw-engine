# Build output
/build/
/out/
/.cache/
compile_commands.json

# vcpkg
/vcpkg_installed/

# Content generated from the user's own disc: never versioned
/content/base/
/content/cooked/

# Local settings
CMakeUserPresets.json
# The editor settings of the repository (format on save) are versioned; anyone's own are not.
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
/.idea/

# The dev assets config (--dev-assets): paths of one machine, never versioned
dev-assets.yaml

# The documentation site's packages live in the development image; a local install never gets versioned
node_modules/

# Python bytecode of the scripts (scripts/gate)
__pycache__/
