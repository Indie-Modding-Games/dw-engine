# Build output
/build/
/out/
/.cache/
/.dwe-studio/
compile_commands.json

# vcpkg
/vcpkg_installed/

# Content generated from the user's own disc: never versioned
/content/base/
/content/cooked/

# Local settings
CMakeUserPresets.json
# The editor settings of the repository (format on save) are versioned; anyone's own are not.
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
/.idea/

# The dev assets config (--dev-assets): paths of one machine, never versioned
dev-assets.yaml

# The documentation site's packages live in the development image; a local install never gets versioned
node_modules/

# Python bytecode of the scripts (scripts/gate)
__pycache__/

# The run logs of a local game, redirected from its console (game-out.txt, game-err.txt): never versioned
/*-err.txt
/*-out.txt

# The launcher's fonts and notices are written at build time (scripts/launcher.sh)
/apps/launcher/ui/fonts/
/apps/launcher/src-tauri/notices/
# Tauri's generated schemas
/apps/launcher/src-tauri/gen/
