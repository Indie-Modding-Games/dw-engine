# Writes a SPIR-V module as a C++ header: cmake -DINPUT=<file.spv> -DOUTPUT=<file.hpp> -DNAME=<Name> -P embed_spirv.cmake
# SPIR-V is a stream of little-endian 32-bit words; the header holds the words, so they need no realignment.
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" length)
math(EXPR remainder "${length} % 8")
if(length EQUAL 0 OR NOT remainder EQUAL 0)
    message(FATAL_ERROR "${INPUT} is not SPIR-V: its size is not a whole number of 32-bit words")
endif()
math(EXPR count "${length} / 8")
string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1U,\n" words "${hex}")
file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/embed_spirv.cmake from ${INPUT}. Do not edit.
#pragma once

#include <array>
#include <cstdint>

namespace dwe::shaders {

inline constexpr std::array<std::uint32_t, ${count}> ${NAME}{
${words}};

} // namespace dwe::shaders
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
