{
  "name": "dwe",
  "version": "0.1.0",
  "builtin-baseline": "664933b8d385dfc01f4e0cdff4c7c74e71f6a740",
  "dependencies": [
    { "name": "sdl3", "features": ["vulkan"] },
    "vulkan",
    {
      "name": "vulkan-loader",
      "features": [
        { "name": "xcb", "platform": "linux" },
        { "name": "xlib", "platform": "linux" },
        { "name": "wayland", "platform": "linux" }
      ]
    },
    "vk-bootstrap",
    "vulkan-memory-allocator",
    { "name": "shader-slang", "host": true },
    "lua",
    "sol2",
    "libyaml",
    "glm",
    "cgltf",
    { "name": "imgui", "features": ["sdl3-binding", "vulkan-binding", "docking-experimental"] },
    "doctest",
    "lodepng",
    "zstd",
    "opus",
    "libopusenc",
    "ktx",
    "entt"
  ],
  "default-features": ["validation"],
  "features": {
    "validation": {
      "description": "The Vulkan validation layers, to check the renderer while developing; the CI leaves them out",
      "dependencies": ["vulkan-validationlayers"]
    }
  }
}
