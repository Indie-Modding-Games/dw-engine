root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

# shfmt reads its style from here (scripts/dev.sh format and the editors): operators that continue
# a line start the next one, and the patterns of a case are indented.
[*.sh]
binary_next_line = true
switch_case_indent = true

[scripts/hooks/*]
binary_next_line = true
switch_case_indent = true

[*.py]
indent_size = 4
